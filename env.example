# Activation — same backend as admin-panel Activate (Worker).
# Default URL if unset: https://app.7themotion.com/api/v1/activate
# Body sent: { mac: "MK:XX:XX:XX:XX:XX", plan: "yearly"|"lifetime", app_id }
# Site form fields: S code → plan, M2 → mac.
ACTIVATION_API_URL=https://app.7themotion.com/api/v1/activate
ACTIVATION_API_KEY=
# Optional: X-Admin-Secret fallback → POST /admin/clients/:mac/action
ACTIVATION_ADMIN_SECRET=
# Optional JSON map of customer S codes → plan, e.g. {"ABC123":"yearly","LIFE99":"lifetime"}
ACTIVATION_S_CODES=
ACTIVATION_DEFAULT_PLAN=yearly
ACTIVATION_APP_ID=app_7motion
