@@ -0,0 +1,253 @@
+// Vrai serveur, vraies sockets et vrai décodeur : aucun mock HTTP.
+// Les mêmes objets traversent ensuite la décision d'alerte de but.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/features/sports/data/live_scores_service.dart';
+import 'package:tv_king/features/sports/data/public_football_repository.dart';
+import 'package:tv_king/features/sports/domain/sport_models.dart';
+
+Map<String, Object?> fixture({int id = 42, int home = 1, int away = 0,
+    bool finished = false, bool score = true, DateTime? kickoff}) => <String, Object?>{
+  'matchID': id,
+  'matchDateTimeUTC': (kickoff ?? DateTime.utc(2026, 10, 8, 16)).toIso8601String(),
+  'matchIsFinished': finished,
+  'leagueName': 'Championnat de test',
+  'team1': <String, Object?>{'teamName': 'Équipe A'},
+  'team2': <String, Object?>{'teamName': 'Équipe B'},
+  'matchResults': <Object?>[
+    if (score) <String, Object?>{'resultTypeID': 2, 'pointsTeam1': home, 'pointsTeam2': away},
+    <String, Object?>{'resultTypeID': 1, 'pointsTeam1': 0, 'pointsTeam2': 0},
+  ],
+  'goals': <Object?>[<String, Object?>{'matchMinute': 21, 'goalGetterName': 'Joueur de test'}],
+};
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  HttpServer? server;
+  HttpOverrides? oldOverrides;
+  late Uri publicBase;
+  late Uri legacyBase;
+  late List<String> paths;
+  late List<Map<String, List<String>>> headers;
+  late Future<void> Function(HttpRequest) respond;
+
+  setUp(() async {
+    oldOverrides = HttpOverrides.current;
+    HttpOverrides.global = null;
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await RepairFlags.load();
+    LiveScoresService.instance.debugResetGoals();
+    paths = <String>[];
+    headers = <Map<String, List<String>>>[];
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    publicBase = Uri.parse('http://127.0.0.1:${server!.port}/public/');
+    legacyBase = Uri.parse('http://127.0.0.1:${server!.port}/legacy/');
+    respond = (HttpRequest r) async {
+      if (r.uri.path.startsWith('/legacy/')) {
+        r.response.statusCode = HttpStatus.notFound;
+      } else {
+        r.response.headers.contentType = ContentType.json;
+        r.response.write(jsonEncode(<Object?>[fixture()]));
+      }
+      await r.response.close();
+    };
+    server!.listen((HttpRequest r) async {
+      paths.add(r.uri.path);
+      final Map<String, List<String>> h = <String, List<String>>{};
+      r.headers.forEach((String name, List<String> values) { h[name] = values; });
+      headers.add(h);
+      await respond(r);
+    });
+  });
+
+  tearDown(() async {
+    await server?.close(force: true);
+    HttpOverrides.global = oldOverrides;
+    RepairFlags.mobileSportsLegacy = false;
+    LiveScoresService.instance.debugResetGoals();
+  });
+
+  PublicFootballRepository repo({List<String> competitions = const <String>['bl1']}) =>
+      PublicFootballRepository.forTesting(publicBase: publicBase,
+        legacyBase: legacyBase, competitions: competitions);
+
+  test('routes historiques 404 ; source publique reçue sans clé', () async {
+    expect(RepairFlags.mobileSportsLegacy, isFalse);
+    final FootballLoad r = await repo().load();
+    expect(r.available, isTrue);
+    expect(r.diagnostic, isNull);
+    expect(r.matches.single.id, 'oldb:42');
+    expect(r.matches.single.homeScore, '1');
+    expect(r.matches.single.awayScore, '0');
+    // Le score 0-0 de mi-temps vient APRÈS le score du match dans la réponse.
+    expect(r.matches.single.startsAt!.toUtc(), DateTime.utc(2026, 10, 8, 16));
+    expect(r.matches.single.isLive, isFalse); // pas de statut inventé à l'horloge
+    expect(paths, <String>['/public/getmatchdata/bl1']);
+    for (final Map<String, List<String>> h in headers) {
+      expect(h.containsKey('authorization'), isFalse);
