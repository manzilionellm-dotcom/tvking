@@ -0,0 +1,42 @@
+// Android ne corrige pas le son d'un canal existant. La migration doit
+// utiliser un autre identifiant et le repli doit conserver celui déjà créé.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/core/notifications/notification_service.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  tearDown(() {
+    RepairFlags.mobileNotificationsLegacy = false;
+    RepairFlags.mobileSportsLegacy = false;
+  });
+  test('installation et préférences vides quittent le canal Android cassé', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await RepairFlags.load();
+    expect(RepairFlags.mobileNotificationsLegacy, isFalse);
+    expect(NotificationService.goalChannelId, isNot('goal_roar_v1'),
+      reason: 'Android conserverait sinon son ancienne URI sonore /0');
+  });
+  test('le repli persistant reprend le canal historique sans changer Sport', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      RepairFlags.mobileNotificationsLegacyKey: true,
+      RepairFlags.mobileSportsLegacyKey: false,
+    });
+    await RepairFlags.load();
+    expect(NotificationService.goalChannelId, 'goal_roar_v1');
+    expect(RepairFlags.mobileSportsLegacy, isFalse);
+  });
+  test('couper le repli migre vers un canal nouveau après relecture', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      RepairFlags.mobileNotificationsLegacyKey: true,
+    });
+    await RepairFlags.load();
+    final String before = NotificationService.goalChannelId;
+    await (await SharedPreferences.getInstance())
+      .setBool(RepairFlags.mobileNotificationsLegacyKey, false);
+    await RepairFlags.load();
+    expect(NotificationService.goalChannelId, isNot(before));
+    expect(NotificationService.goalChannelId, 'goal_roar_v2');
+  });
+}
diff --git a/test/features/channels/channel_metadata_isolate_test.dart b/test/features/channels/channel_metadata_isolate_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..e8b062fcd3a135a3b4432085586d9dc7a8b2ec37
--- /dev/null
+++ b/test/features/channels/channel_metadata_isolate_test.dart
@@ -0,0 +1,85 @@
+// Les vraies regex tournent dans un vrai isolate, sans classifier simulé.
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/curation/title_curator.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+
+Channel _channel(String id, String name, String category) => Channel(
+      id: id,
+      name: name,
+      category: category,
+      streamUrl: 'https://channels.invalid/$id',
+      isLive: true,
+    );
+
+void main() {
+  tearDown(Channel.clearComputedCaches);
+
+  test('le calcul isolé conserve les quatre résultats du classifier réel',
+      () async {
+    final List<Channel> channels = <Channel>[
+      _channel('sport', 'FR | Sport HD', 'Sports'),
+      _channel('cinema', 'UK | Cinema FHD', 'Movies'),
+      _channel('inconnu', 'Chaîne inconnue', 'Divers'),
+    ];
+    final ChannelComputedSnapshot snapshot =
+        await Channel.prepareComputedSnapshot(channels);
+    Channel.installComputedSnapshot(snapshot);
+    for (final Channel channel in channels) {
+      expect(Channel.debugHasComputedValues(channel), isTrue);
+      expect(channel.genre,
+          ChannelClassifier.classifyGenre(channel.name, channel.category));
+      expect(channel.country?.code,
+          ChannelClassifier.detectCountry(channel.name, channel.category)?.code);
+      expect(channel.quality, ChannelClassifier.detectQuality(channel.name));
+      expect(channel.cleanName, TitleCurator.curate(channel.name));
+    }
+  });
+
+  test('50 000 chaînes laissent passer un événement UI pendant le calcul',
+      () async {
+    final List<Channel> channels = List<Channel>.generate(
+      50000,
+      (int index) =>
+          _channel('large-$index', 'FR | Sport $index HD', 'Sports'),
+      growable: false,
+    );
+    bool prepared = false;
+    final Completer<bool> heartbeat = Completer<bool>();
+    final Future<ChannelComputedSnapshot> work =
+        Channel.prepareComputedSnapshot(channels).then((snapshot) {
+      prepared = true;
+      return snapshot;
+    });
+    // Un calcul bloquant termine avant cet événement, même sans seuil de temps.
+    Timer.run(() => heartbeat.complete(!prepared));
+    expect(await heartbeat.future, isTrue,
+        reason: 'Le calcul ne doit pas monopoliser le fil de l’écran.');
+    Channel.installComputedSnapshot(await work);
+    expect(channels.every(Channel.debugHasComputedValues), isTrue);
+  }, timeout: const Timeout(Duration(minutes: 2)));
+
+  test('un identifiant réutilisé reprend le nouveau nom et le nouveau genre',
+      () async {
+    final Channel old = _channel('reused', 'FR | Sport HD', 'Sports');
+    final Channel next = _channel('reused', 'UK | Cinema FHD', 'Movies');
+    Channel.installComputedSnapshot(
+        await Channel.prepareComputedSnapshot(<Channel>[old]));
+    final ChannelGenre previousGenre = old.genre;
+    Channel.installComputedSnapshot(
+        await Channel.prepareComputedSnapshot(<Channel>[next]));
+    expect(next.genre, isNot(previousGenre));
+    expect(next.genre, ChannelClassifier.classifyGenre(next.name, next.category));
+    expect(next.cleanName, TitleCurator.curate(next.name));
+  });
+
+  test('le remplacement retire les métadonnées de la liste supprimée', () async {
+    final Channel removed = _channel('removed', 'Sport HD', 'Sports');
+    Channel.installComputedSnapshot(
+        await Channel.prepareComputedSnapshot(<Channel>[removed]));
+    Channel.installComputedSnapshot(
+        await Channel.prepareComputedSnapshot(const <Channel>[]));
+    expect(Channel.debugHasComputedValues(removed), isFalse);
+  });
+}
diff --git a/test/features/playlists/mobile_metadata_delivery_test.dart b/test/features/playlists/mobile_metadata_delivery_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..321965f226199e7da899526ccf269894f47b3241
--- /dev/null
+++ b/test/features/playlists/mobile_metadata_delivery_test.dart
@@ -0,0 +1,143 @@
+// SQLite, schéma, requêtes et pré-calcul réels : aucun chemin difficile simulé.
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  final PlaylistRepository repo = PlaylistRepository.instance;
+  late Database database;
+
+  Future<int> seed(int count, {bool active = true}) async {
+    final int id = await database.insert('playlists', <String, Object?>{
+      'name': 'Liste de test',
+      'type': 'm3u',
+      'm3u_url': 'https://playlist.invalid/list.m3u',
+      'created_at': DateTime.now().millisecondsSinceEpoch,
+      'is_active': active ? 1 : 0,
+    });
+    final Batch batch = database.batch();
+    for (int index = 0; index < count; index++) {
+      batch.insert('channels', <String, Object?>{
+        'playlist_id': id,
+        'external_id': '$id-$index',
+        'name': 'FR | Sport $index HD',
+        'category': 'Sports',
+        'stream_url': 'https://channels.invalid/$id/$index',
+      });
+    }
+    await batch.commit(noResult: true);
+    return id;
+  }
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await RepairFlags.load();
+    FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+    Channel.clearComputedCaches();
+    repo.debugSeedChannels(const <Channel>[]);
+    repo.debugSeedPlaylists(const []);
+    database = await databaseFactoryFfi.openDatabase(inMemoryDatabasePath);
+    await PlaylistDatabase.instance.debugCreate(database);
+    PlaylistDatabase.instance.debugUseDatabase(database);
+  });
+
+  tearDown(() async {
+    repo.debugMetadataPreparationStarted = null;
+    repo.debugSeedChannels(const <Channel>[]);
+    repo.debugSeedPlaylists(const []);
+    PlaylistDatabase.instance.debugUseDatabase(null);
+    await database.close();
+    RepairFlags.mobileChannelMetadataLegacy = false;
+    Channel.clearComputedCaches();
+    FlavorConfig.resetForTesting();
+  });
+
+  test('livraison : chaque chaîne émise arrive déjà classée', () async {
+    await seed(40);
+    expect(RepairFlags.mobileChannelMetadataLegacy, isFalse);
+    // La CI rejoue cette même assertion avec le vrai repli pour la preuve rouge.
+    if (const bool.fromEnvironment('METADATA_LEGACY_PROOF')) {
+      RepairFlags.mobileChannelMetadataLegacy = true;
+    }
+    final Future<List<Channel>> delivered = repo.channelsStream.first;
+    await repo.debugEmitCurrentState();
+    final List<Channel> channels = await delivered;
+    expect(channels, hasLength(40));
+    expect(channels.every(Channel.debugHasComputedValues), isTrue,
+        reason: 'Les écrans ne doivent plus classer la liste à froid.');
+  });
+
+  test('le repli persistant restitue la livraison ancienne à froid', () async {
+    await seed(5);
+    await (await SharedPreferences.getInstance())
+        .setBool(RepairFlags.mobileChannelMetadataLegacyKey, true);
+    await RepairFlags.load();
+    expect(RepairFlags.mobileChannelMetadataLegacy, isTrue);
+    await repo.debugEmitCurrentState();
+    final Channel channel = repo.currentChannels.first;
+    expect(Channel.debugHasComputedValues(channel), isFalse);
+    expect(channel.genre, ChannelGenre.sports);
+    expect(Channel.debugHasComputedValues(channel), isFalse,
+        reason: 'Le repli ne prépare pas les trois autres valeurs.');
+    await (await SharedPreferences.getInstance())
+        .setBool(RepairFlags.mobileChannelMetadataLegacyKey, false);
+    await RepairFlags.load();
+    await repo.debugEmitCurrentState();
+    expect(repo.currentChannels.every(Channel.debugHasComputedValues), isTrue);
+  });
+
+  test('supprimer pendant le vrai calcul ne ressuscite jamais la liste',
+      () async {
+    final int id = await seed(8000);
+    final Completer<void> started = Completer<void>();
+    repo.debugMetadataPreparationStarted = () {
+      repo.debugMetadataPreparationStarted = null;
+      started.complete();
+    };
+    final List<int> emittedCounts = <int>[];
+    final StreamSubscription<List<Channel>> sub =
+        repo.channelsStream.listen((channels) => emittedCounts.add(channels.length));
+    final Future<void> oldRead = repo.debugEmitCurrentState();
+    await started.future;
+    final Future<void> deletion = repo.deletePlaylist(id);
+    expect(repo.currentChannels, isEmpty);
+    await Future.wait(<Future<void>>[oldRead, deletion]);
+    await Future<void>.delayed(Duration.zero);
+    await sub.cancel();
+    expect(emittedCounts, isNotEmpty);
+    expect(emittedCounts.every((count) => count == 0), isTrue);
+    expect(repo.currentChannels, isEmpty);
+    expect(await database.query('channels'), isEmpty);
+    expect(await database.query('playlists'), isEmpty);
+  });
+
+  test('une lecture plus récente conserve sa liste malgré le calcul précédent',
+      () async {
+    await seed(8000);
+    final int next = await seed(1, active: false);
+    final Completer<void> started = Completer<void>();
+    repo.debugMetadataPreparationStarted = () {
+      repo.debugMetadataPreparationStarted = null;
+      started.complete();
+    };
+    final Future<void> oldRead = repo.debugEmitCurrentState();
+    await started.future;
+    await database.update('playlists', <String, Object?>{'is_active': 0});
+    await database.update('playlists', <String, Object?>{'is_active': 1},
+        where: 'id = ?', whereArgs: <Object>[next]);
+    await repo.debugEmitCurrentState();
+    await oldRead;
+    expect(repo.currentChannels, hasLength(1));
+    expect(repo.currentChannels.single.playlistId, next);
+    expect(Channel.debugHasComputedValues(repo.currentChannels.single), isTrue);
+  });
+}
diff --git a/test/features/sports/public_football_http_test.dart b/test/features/sports/public_football_http_test.dart
