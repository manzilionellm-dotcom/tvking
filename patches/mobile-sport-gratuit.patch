+// Replis du téléphone : éteints par défaut, conservés entre deux lancements.
+// Le repli Sport remet les routes du Worker historiques, y compris leur panne.
+import 'package:shared_preferences/shared_preferences.dart';
+
+class RepairFlags {
+  static const String mobileSportsLegacyKey = 'zuno.mobile.sports_legacy';
+  static bool mobileSportsLegacy = false;
+  // L'ancien canal peut garder un son invalide après une mise à jour.
+  static const String mobileNotificationsLegacyKey = 'zuno.mobile.notifications_legacy';
+  static bool mobileNotificationsLegacy = false;
+  // Le repli restitue le classement paresseux sur le fil de l'écran.
+  static const String mobileChannelMetadataLegacyKey =
+      'zuno.mobile.channel_metadata_legacy';
+  static bool mobileChannelMetadataLegacy = false;
+
+  static Future<void> load() async {
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    mobileSportsLegacy = prefs.getBool(mobileSportsLegacyKey) ?? false;
+    mobileNotificationsLegacy = prefs.getBool(mobileNotificationsLegacyKey) ?? false;
+    mobileChannelMetadataLegacy =
+        prefs.getBool(mobileChannelMetadataLegacyKey) ?? false;
+  }
+}
