+  test('une compétition en panne ne jette pas les autres scores', () async {
+    respond = (HttpRequest r) async {
+      if (r.uri.path.endsWith('bl2')) { r.response.statusCode = 503; }
+      else { r.response.write(jsonEncode(<Object?>[fixture()])); }
+      await r.response.close();
+    };
+    final FootballLoad r = await repo(competitions: <String>['bl1', 'bl2']).load();
+    expect(r.available, isTrue);
+    expect(r.matches.single.id, 'oldb:42');
+    expect(r.diagnostic, 'Sport : HTTP 503');
+    expect(paths.length, 2);
+  });
+
+  test('JSON illisible, schéma erroné et réponse trop grosse ont une raison', () async {
+    for (final String body in <String>['{', '{"other":[]}', 'x' * (PublicFootballRepository.maxResponseBytes + 1)]) {
+      respond = (HttpRequest r) async {
+        r.response.write(body);
+        await r.response.close();
+      };
+      final FootballLoad r = await repo().load();
+      expect(r.available, isFalse);
+      expect(r.diagnostic, body.length > PublicFootballRepository.maxResponseBytes
+        ? 'Sport : réponse trop volumineuse' : 'Sport : réponse illisible');
+    }
+  });
