+
+ChannelComputedSnapshot _computeChannelSnapshot(
+  List<(String, String, String)> rows,
+) {
+  final ChannelComputedSnapshot result = ChannelComputedSnapshot();
+  for (final (String id, String name, String category) in rows) {
+    result.genres[id] = ChannelClassifier.classifyGenre(name, category);
+    result.countries[id] = ChannelClassifier.detectCountry(name, category);
+    result.qualities[id] = ChannelClassifier.detectQuality(name);
+    result.cleanNames[id] = TitleCurator.curate(name);
+  }
