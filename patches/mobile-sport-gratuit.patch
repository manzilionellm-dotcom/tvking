diff --git a/lib/features/sports/data/public_football_repository.dart b/lib/features/sports/data/public_football_repository.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a56afc50fdfdf78558e55e67b039e48f23e4d6a4
--- /dev/null
+++ b/lib/features/sports/data/public_football_repository.dart
@@ -0,0 +1,268 @@
+// OpenLigaDB est un service communautaire public, sans clé ni abonnement.
+// Documentation : https://github.com/OpenLigaDB/OpenLigaDB-Samples
+// Données ODbL : https://www.openligadb.de/lizenz
+// Une relecture toutes les 60 s ne garantit pas le délai de saisie des scores.
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:http/http.dart' as http;
+
+import '../../../core/app/repair_flags.dart';
+import '../../../core/observability/structured_logger.dart';
+import '../../subscription/data/subscription_backend.dart' show kSubscriptionBaseUrl;
+import '../domain/sport_models.dart';
+import '../domain/match_detail.dart';
+
+class FootballLoad {
+  const FootballLoad({this.matches = const <SportEvent>[], this.diagnostic,
+    this.receivedAt, this.available = false});
+  final List<SportEvent> matches;
+  final String? diagnostic;
+  final DateTime? receivedAt;
+  final bool available;
+}
+
+class _FootballFailure implements Exception {
+  const _FootballFailure(this.reason);
+  final String reason;
+}
+
+class PublicFootballRepository {
+  PublicFootballRepository._()
+      : _publicBase = Uri.parse('https://api.openligadb.de/'),
+        _legacyBase = null,
+        _competitions = const <String>['bl1', 'bl2', 'la1', 'pl', 'ucl'];
+  static final PublicFootballRepository instance = PublicFootballRepository._();
+
+  // Le banc ne remplace pas HTTP : seule l'adresse devient 127.0.0.1.
+  @visibleForTesting
+  PublicFootballRepository.forTesting({required Uri publicBase,
+    required Uri legacyBase, List<String> competitions = const <String>['bl1']})
+      : _publicBase = publicBase, _legacyBase = legacyBase,
+        _competitions = competitions;
+  final Uri _publicBase;
+  final Uri? _legacyBase;
+  final List<String> _competitions;
+  static const int maxResponseBytes = 1024 * 1024;
+  static const Duration _cacheAge = Duration(seconds: 60);
+  FootballLoad? _cache;
+  Future<FootballLoad>? _inFlight;
+  bool _paused = false;
+  String? get diagnostic => _cache?.diagnostic;
+
+  Future<FootballLoad> load({bool scores = false, bool manual = false,
+      Iterable<SportEvent> followed = const <SportEvent>[]}) async {
+    if (RepairFlags.mobileSportsLegacy) return _legacy(scores);
+    // Affiches, sentinelle et rappels partagent le même téléchargement.
+    if (_inFlight != null) return _inFlight!;
+    if (!manual && _cache != null && (_paused ||
+        DateTime.now().difference(_cache!.receivedAt!) < _cacheAge)) return _cache!;
+    if (manual) _paused = false;
+    final Future<FootballLoad> pending = _fresh(followed);
+    _inFlight = pending;
+    try { return await pending; } finally { _inFlight = null; }
+  }
+
+  Future<FootballLoad> _fresh(Iterable<SportEvent> followed) async {
+    final Map<String, SportEvent> found = <String, SportEvent>{};
+    final List<String> failures = <String>[];
+    int successes = 0;
+    // Cinq petites réponses en parallèle, pas un fichier annuel ni une
+    // compétition choisie à partir d'un nom ambigu ou d'une clé récupérée.
+    await Future.wait(_competitions.map((String code) async {
+      try {
+        final String body = await _get(_publicBase.resolve('getmatchdata/$code'));
+        final List<SportEvent> matches = await compute(decodePublicFootball, body);
+        for (final SportEvent e in matches) { found[e.id] = e; }
+        successes++;
+      } catch (error) { failures.add(_reason(error)); }
+    }));
+    // Une journée peut changer pendant un match reporté. On relit aussi
+    // les IDs publics suivis proches du coup d'envoi, par petits lots.
+    final DateTime now = DateTime.now();
+    final Set<String> missing = <String>{};
+    for (final SportEvent e in followed) {
+      final DateTime? k = e.startsAt;
+      if (!RegExp(r'^oldb:[0-9]+$').hasMatch(e.id) || found.containsKey(e.id) ||
+          k == null || now.isBefore(k.subtract(const Duration(minutes: 5))) ||
+          now.isAfter(k.add(const Duration(hours: 3)))) continue;
+      missing.add(e.id.substring(5));
+    }
+    final List<String> ids = missing.toList();
+    for (int i = 0; i < ids.length; i += 4) {
+      await Future.wait(ids.skip(i).take(4).map((String id) async {
+        try {
+          final String body = await _get(_publicBase.resolve('getmatchdata/$id'));
+          final List<SportEvent> matches = await compute(decodePublicFootball, body);
+          for (final SportEvent e in matches) { found[e.id] = e; }
+          successes++;
+        } catch (error) { failures.add(_reason(error)); }
+      }));
+    }
+    // Garder les scores reçus des sources en panne ; ne pas prétendre
+    // qu'ils ont été actualisés. Réessayer est un geste explicite.
+    if (failures.isNotEmpty) {
+      for (final SportEvent e in _cache?.matches ?? const <SportEvent>[]) {
+        found.putIfAbsent(e.id, () => e);
+      }
+      _paused = true;
+    }
+    final List<SportEvent> matches = found.values.toList()
+      ..sort((SportEvent a, SportEvent b) => a.timestamp.compareTo(b.timestamp));
+    final String? diagnostic = failures.isEmpty ? null : failures.first;
+    final FootballLoad result = FootballLoad(matches: List<SportEvent>.unmodifiable(matches),
+        available: successes > 0, diagnostic: diagnostic,
+        receivedAt: successes > 0 ? DateTime.now() : _cache?.receivedAt ?? DateTime.now());
+    _cache = result;
+    _log(result, failures.length);
+    return result;
+  }
+
+  Future<FootballLoad> _legacy(bool scores) async {
+    final Uri base = _legacyBase ?? Uri.parse('$kSubscriptionBaseUrl/');
+    try {
+      final String body = await _get(base.resolve('api/sports/${scores ? 'live' : 'big'}'),
+          timeout: Duration(seconds: scores ? 7 : 12));
+      final Object? decoded = jsonDecode(body);
+      if (decoded is! Map<String, dynamic> || decoded[scores ? 'live' : 'matches'] is! List) {
+        throw const FormatException('Sport invalide');
+      }
+      final List<SportEvent> matches = <SportEvent>[];
+      for (final Object? item in decoded[scores ? 'live' : 'matches'] as List) {
+        if (item is! Map<String, dynamic>) throw const FormatException('Match invalide');
+        matches.add(SportEvent.fromJson(item));
+      }
+      return FootballLoad(matches: matches,
+          available: scores ? decoded['available'] != false : decoded['upstream_ok'] != 0,
+          receivedAt: DateTime.now());
+    } catch (error) {
+      final FootballLoad result = FootballLoad(diagnostic: _reason(error));
+      _log(result, 1);
+      return result;
+    }
+  }
+
+  Future<String> _get(Uri uri, {Duration timeout = const Duration(seconds: 20)}) async {
+    final http.Client client = http.Client();
+    try { return await _download(client, uri).timeout(timeout); }
+    finally { client.close(); }
+  }
+
+  Future<String> _download(http.Client client, Uri uri) async {
+    final http.StreamedResponse response = await client.send(http.Request('GET', uri)
+      ..headers['Accept'] = 'application/json');
+    if (response.statusCode != 200) {
+      throw _FootballFailure('Sport : HTTP ${response.statusCode}');
+    }
+    if ((response.contentLength ?? 0) > maxResponseBytes) {
+      throw const _FootballFailure('Sport : réponse trop volumineuse');
+    }
+    final List<int> bytes = <int>[];
+    await for (final List<int> chunk in response.stream) {
+      if (bytes.length + chunk.length > maxResponseBytes) {
+        throw const _FootballFailure('Sport : réponse trop volumineuse');
+      }
+      bytes.addAll(chunk);
+    }
+    return utf8.decode(bytes);
+  }
+
+  static String _reason(Object error) {
+    if (error is _FootballFailure) return error.reason;
+    if (error is TimeoutException) return 'Sport : délai dépassé';
+    if (error is FormatException || error is TypeError) return 'Sport : réponse illisible';
+    if (error is http.ClientException) return 'Sport : connexion impossible';
+    return 'Sport : service indisponible';
+  }
+
+  static void _log(FootballLoad r, int failures) {
+    StructuredLogger.instance.info(domain: 'sport', event: 'public.loaded',
+      ctx: <String, Object?>{'matches': r.matches.length, 'failed_sources': failures,
+        'reason': r.diagnostic ?? 'scores reçus', 'legacy': RepairFlags.mobileSportsLegacy});
+  }
+
+  // Un score partiel n'est pas un résultat final. Le fournisseur gratuit
+  // donne explicitement matchIsFinished, sans minute ni statut EN DIRECT.
+  static bool canAnnounceFinal(SportEvent e) =>
+      !e.id.startsWith('oldb:') || e.status == 'FT';
+
+  Future<MatchDetail?> detail(String id) async {
+    if (!RegExp(r'^oldb:[0-9]+$').hasMatch(id)) return null;
+    try {
+      final String body = await _get(_publicBase.resolve('getmatchdata/${id.substring(5)}'));
+      return await compute(decodePublicFootballDetail, body);
+    } catch (error) {
+      StructuredLogger.instance.warn(domain: 'sport', event: 'public.detail_failed',
+        ctx: <String, Object?>{'reason': _reason(error)});
+      return null;
+    }
+  }
+}
+
+// Le décodage travaille hors du fil UI. On choisit resultTypeID=2 et
+// jamais le premier élément (qui est souvent le score de la mi-temps).
+List<SportEvent> decodePublicFootball(String body) {
+  final Object? json = jsonDecode(body);
+  final List<dynamic> rows;
+  if (json is List) { rows = json; }
+  else if (json is Map<String, dynamic>) { rows = <dynamic>[json]; }
+  else { throw const FormatException('Sport invalide'); }
+  final List<SportEvent> out = <SportEvent>[];
+  for (final Object? item in rows) {
+    if (item is! Map<String, dynamic> || item['team1'] is! Map || item['team2'] is! Map ||
+        item['matchResults'] is! List || item['matchIsFinished'] is! bool) {
+      throw const FormatException('Match invalide');
+    }
+    final int? id = int.tryParse('${item['matchID']}');
+    final String utc = '${item['matchDateTimeUTC'] ?? ''}';
+    final DateTime? kickoff = DateTime.tryParse(utc);
+    final String home = '${(item['team1'] as Map)['teamName'] ?? ''}';
+    final String away = '${(item['team2'] as Map)['teamName'] ?? ''}';
+    if (id == null || id <= 0 || kickoff == null ||
+        !RegExp(r'(Z|[+-][0-9]{2}:[0-9]{2})$').hasMatch(utc) || home.isEmpty || away.isEmpty) {
+      throw const FormatException('Match incomplet');
+    }
+    String? h;
+    String? a;
+    for (final Object? score in item['matchResults'] as List) {
+      if (score is! Map) throw const FormatException('Score invalide');
+      if (int.tryParse('${score['resultTypeID']}') != 2) continue;
+      final int? ph = int.tryParse('${score['pointsTeam1']}');
+      final int? pa = int.tryParse('${score['pointsTeam2']}');
+      if (ph == null || pa == null || ph < 0 || pa < 0) {
+        throw const FormatException('Score invalide');
+      }
+      h = '$ph'; a = '$pa';
+    }
+    final String local = kickoff.toLocal().toIso8601String();
+    out.add(SportEvent(id: 'oldb:$id', home: home, away: away, homeScore: h, awayScore: a,
+      timestamp: kickoff.toUtc().toIso8601String(), date: local.substring(0, 10),
+      time: local.substring(11, 19), status: item['matchIsFinished'] == true ? 'FT' : '',
+      league: '${item['leagueName'] ?? ''}', sport: 'Soccer', tier: 2));
+  }
+  return out;
+}
+
+MatchDetail decodePublicFootballDetail(String body) {
+  final List<SportEvent> events = decodePublicFootball(body);
+  if (events.length != 1) throw const FormatException('Fiche invalide');
+  final Object? decoded = jsonDecode(body);
+  final Map<String, dynamic> row = (decoded is List ? decoded.single : decoded) as Map<String, dynamic>;
+  final SportEvent e = events.single;
+  final Object? goals = row['goals'];
+  final List<MatchIncident> timeline = <MatchIncident>[];
+  if (goals is List) {
+    for (final Object? item in goals) {
+      if (item is! Map) throw const FormatException('But invalide');
+      timeline.add(MatchIncident(type: 'Goal',
+        minute: int.tryParse('${item['matchMinute']}'),
+        player: '${item['goalGetterName'] ?? ''}',
+        detail: item['isPenalty'] == true ? 'Penalty' : '',
+        comment: item['isOwnGoal'] == true ? 'Own goal' : ''));
+    }
+  }
+  return MatchDetail(id: e.id, home: e.home, away: e.away, homeScore: e.homeScore,
+    awayScore: e.awayScore, status: e.status, league: e.league,
+    timeline: timeline, timelineAvailable: goals is List);
+}
