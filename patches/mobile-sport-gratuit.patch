+// Android ne corrige pas le son d'un canal existant. La migration doit
+// utiliser un autre identifiant et le repli doit conserver celui déjà créé.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/core/notifications/notification_service.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  tearDown(() {
+    RepairFlags.mobileNotificationsLegacy = false;
+    RepairFlags.mobileSportsLegacy = false;
+  });
+  test('installation et préférences vides quittent le canal Android cassé', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await RepairFlags.load();
+    expect(RepairFlags.mobileNotificationsLegacy, isFalse);
+    expect(NotificationService.goalChannelId, isNot('goal_roar_v1'),
+      reason: 'Android conserverait sinon son ancienne URI sonore /0');
+  });
+  test('le repli persistant reprend le canal historique sans changer Sport', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      RepairFlags.mobileNotificationsLegacyKey: true,
+      RepairFlags.mobileSportsLegacyKey: false,
+    });
+    await RepairFlags.load();
+    expect(NotificationService.goalChannelId, 'goal_roar_v1');
+    expect(RepairFlags.mobileSportsLegacy, isFalse);
+  });
+  test('couper le repli migre vers un canal nouveau après relecture', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      RepairFlags.mobileNotificationsLegacyKey: true,
+    });
+    await RepairFlags.load();
+    final String before = NotificationService.goalChannelId;
+    await (await SharedPreferences.getInstance())
+      .setBool(RepairFlags.mobileNotificationsLegacyKey, false);
+    await RepairFlags.load();
+    expect(NotificationService.goalChannelId, isNot(before));
+    expect(NotificationService.goalChannelId, 'goal_roar_v2');
+  });
+}
