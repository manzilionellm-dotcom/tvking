diff --git a/lib/features/simple_home/presentation/widgets/adult_access_dialog.dart b/lib/features/simple_home/presentation/widgets/adult_access_dialog.dart
new file mode 100644
index 00000000..f5127259
--- /dev/null
+++ b/lib/features/simple_home/presentation/widgets/adult_access_dialog.dart
@@ -0,0 +1,159 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../../../../core/i18n/l10n_extension.dart';
+import '../../../../core/theme/app_colors.dart';
+import '../../../../core/theme/app_text_styles.dart';
+import '../../../security/data/app_pin_settings.dart';
+
+/// Point d'entrée 18+ de l'accueil.
+///
+/// Sans code parental personnel, l'espace s'ouvre par une confirmation d'âge
+/// en un geste, sans mot de passe. Dès qu'un code personnel a été défini
+/// dans Réglages → Contrôle parental, ce code est exigé, avec son
+/// anti-brute-force. L'entrée reste masquée en mode Enfants et l'accès est
+/// révoqué au changement de profil par l'appelant, qui doit revérifier le
+/// profil après cet await.
+Future<bool> requestHomeAdultAccess(BuildContext context) async {
+  final bool protected = !await AppPinSettings.instance.isUsingDefault();
+  if (!context.mounted) return false;
+  return await showDialog<bool>(
+        context: context,
+        builder: (_) =>
+            protected ? const _AdultPinDialog() : const _AdultConfirmDialog(),
+      ) ??
+      false;
+}
+
+/// Confirmation d'âge en un geste : aucun code, aucune saisie.
+class _AdultConfirmDialog extends StatelessWidget {
+  const _AdultConfirmDialog();
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final colors = AppColors.lumiere(context);
+    return AlertDialog(
+      scrollable: true,
+      title: Column(
+        children: <Widget>[
+          Container(
+            width: 48,
+            height: 48,
+            alignment: Alignment.center,
+            decoration: BoxDecoration(
+              shape: BoxShape.circle,
+              color: colors.textPrimary,
+            ),
+            child: Text('18+',
+                style: AppTextStyles.bodyMedium.copyWith(
+                    color: colors.canvas, fontWeight: FontWeight.w800)),
+          ),
+          const SizedBox(height: 14),
+          Text(l.homeAdultConfirmTitle, textAlign: TextAlign.center),
+        ],
+      ),
+      content: Text(l.homeAdultConfirmHint,
+          textAlign: TextAlign.center,
+          style:
+              AppTextStyles.bodyMedium.copyWith(color: colors.textSecondary)),
+      actionsAlignment: MainAxisAlignment.center,
+      actionsOverflowAlignment: OverflowBarAlignment.center,
+      actions: <Widget>[
+        FilledButton.icon(
+          onPressed: () => Navigator.of(context).pop(true),
+          icon: const Icon(Icons.check_rounded, size: 18),
+          label: Text(l.homeAdultConfirmButton),
+        ),
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(false),
+          child: Text(l.buttonBack),
+        ),
+      ],
+    );
+  }
+}
+
+class _AdultPinDialog extends StatefulWidget {
+  const _AdultPinDialog();
+
+  @override
+  State<_AdultPinDialog> createState() => _AdultPinDialogState();
+}
+
+class _AdultPinDialogState extends State<_AdultPinDialog> {
+  final TextEditingController _pin = TextEditingController();
+  bool _checking = false;
+  String? _error;
+
+  @override
+  void dispose() {
+    _pin.dispose();
+    super.dispose();
+  }
+
+  Future<void> _verify() async {
+    if (_checking) return;
+    if (_pin.text.length < 4) {
+      setState(() => _error = context.l10n.lockPinTooShort);
+      return;
+    }
+    setState(() => _checking = true);
+    final bool accepted = await AppPinSettings.instance.verify(_pin.text);
+    if (!mounted) return;
+    if (accepted) {
+      Navigator.of(context).pop(true);
+      return;
+    }
+    final Duration lock = await AppPinSettings.instance.lockoutRemaining();
+    if (!mounted) return;
+    setState(() {
+      _checking = false;
+      _error = lock > Duration.zero
+          ? context.l10n.lockPinLocked(lock.inSeconds + 1)
+          : context.l10n.tvParentalWrongCode;
+      _pin.clear();
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+        scrollable: true,
+        title: Text(context.l10n.homeTabAdult),
+        content: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: <Widget>[
+            Text(context.l10n.tvParentalEnterCode,
+                style: AppTextStyles.bodyMedium),
+            const SizedBox(height: 12),
+            TextField(
+              controller: _pin,
+              autofocus: true,
+              obscureText: true,
+              maxLength: 8,
+              keyboardType: TextInputType.number,
+              inputFormatters: <TextInputFormatter>[
+                FilteringTextInputFormatter.digitsOnly,
+              ],
+              decoration: InputDecoration(
+                labelText: context.l10n.tvParentalEnterCode,
+                errorText: _error,
+                errorMaxLines: 3,
+              ),
+              onSubmitted: (_) => _verify(),
+            ),
+          ],
+        ),
+        actions: <Widget>[
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: Text(context.l10n.buttonCancel),
+          ),
+          FilledButton(
+            onPressed: _checking ? null : _verify,
+            child: Text(context.l10n.buttonContinue),
+          ),
+        ],
+      );
+}
