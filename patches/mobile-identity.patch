diff --git a/test/core/theme/accent_controller_test.dart b/test/core/theme/accent_controller_test.dart
new file mode 100644
index 00000000..bff37681
--- /dev/null
+++ b/test/core/theme/accent_controller_test.dart
@@ -0,0 +1,129 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:tv_king/core/theme/accent_controller.dart';
+import 'package:tv_king/core/theme/app_colors.dart';
+import 'package:tv_king/core/theme/app_text_styles.dart';
+import 'package:tv_king/core/theme/app_theme.dart';
+import 'package:tv_king/core/theme/lumiere_tokens.dart';
+import 'package:tv_king/core/theme/theme_mode_repository.dart';
+import 'package:tv_king/core/theme/tv_palette.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  final AccentController controller = AccentController.instance;
+  final ThemeModeRepository modes = ThemeModeRepository.instance;
+
+  test('la nouvelle installation utilise la charte noire et blanche exacte',
+      () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await controller.initialize();
+    await modes.initialize();
+
+    expect(AppColors.background, const Color(0xFF000000));
+    expect(AppColors.surface, const Color(0xFF121212));
+    expect(AppColors.border, const Color(0xFF242424));
+    expect(AppColors.textPrimary, const Color(0xFFFFFFFF));
+    expect(AppColors.textSecondary, const Color(0xFF8E8E93));
+    expect(AppColors.accent, Colors.white);
+    expect(AppColors.onAccent, Colors.black);
+    expect(controller.current.id, 'motion');
+    expect(controller.current.accent, Colors.white);
+    expect(controller.isDaily, isFalse);
+    expect(modes.mode, ThemeMode.dark);
+    expect((await SharedPreferences.getInstance()).getKeys(), isEmpty);
+  });
+
+  test('les anciens accents et modes clairs restent stockés sans recoloriser',
+      () async {
+    for (final String oldMode in <String>['light', 'system', 'dark']) {
+      for (final String oldAccentMode in <String>['fixed', 'daily']) {
+        final Map<String, Object> saved = <String, Object>{
+          'accent_theme_id': 'emerald',
+          'accent_mode': oldAccentMode,
+          'theme.mode.v1': oldMode,
+        };
+        SharedPreferences.setMockInitialValues(saved);
+        await controller.initialize();
+        await modes.initialize();
+        controller.refreshDailyIfNeeded();
+
+        expect(controller.current.accent, Colors.white);
+        expect(controller.isDaily, isFalse);
+        expect(modes.mode, ThemeMode.dark);
+        final SharedPreferences prefs = await SharedPreferences.getInstance();
+        for (final MapEntry<String, Object> value in saved.entries) {
+          expect(prefs.get(value.key), value.value);
+        }
+      }
+    }
+  });
+
+  test('le panel et les anciennes commandes ne réactivent pas les couleurs',
+      () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'accent_theme_id': 'ocean',
+      'accent_mode': 'daily',
+      'theme.mode.v1': 'light',
+    });
+    await controller.initialize();
+    controller.applyCustom(const Color(0xFF2EF2C8));
+    await controller.enableDaily();
+    await controller.select(AccentTheme.derive(
+      id: 'emerald',
+      label: 'Ancien choix',
+      accent: Colors.green,
+    ));
+    await modes.setMode(ThemeMode.light);
+
+    expect(controller.current.accent, Colors.white);
+    expect(controller.isDaily, isFalse);
+    expect(AppTheme.daylight.brightness, Brightness.dark);
+    expect(modes.mode, ThemeMode.dark);
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    expect(prefs.getString('accent_theme_id'), 'ocean');
+    expect(prefs.getString('accent_mode'), 'daily');
+    expect(prefs.getString('theme.mode.v1'), 'light');
+  });
+
+  test('Material ne réintroduit pas de tons colorés depuis une graine blanche',
+      () {
+    final ThemeData theme = AppTheme.cinema;
+    final ColorScheme colors = theme.colorScheme;
+    expect(colors.primary, Colors.white);
+    expect(colors.onPrimary, Colors.black);
+    expect(colors.outline, const Color(0xFF242424));
+    expect(colors.onSurfaceVariant, const Color(0xFF8E8E93));
+    for (final Color color in <Color>[
+      colors.primary,
+      colors.primaryContainer,
+      colors.secondary,
+      colors.secondaryContainer,
+      colors.tertiary,
+      colors.tertiaryContainer,
+      colors.error,
+      colors.errorContainer,
+      colors.surface,
+      colors.surfaceContainer,
+      colors.surfaceContainerHighest,
+      colors.outline,
+    ]) {
+      expect(color.r, color.g);
+      expect(color.g, color.b);
+    }
+    expect(theme.extension<LumiereColors>()!.canvas, AppColors.background);
+    expect((theme.cardTheme.shape! as RoundedRectangleBorder).side,
+        const BorderSide(color: AppColors.border, width: 1));
+    expect(theme.snackBarTheme.contentTextStyle!.color, Colors.black);
+    expect(AppTextStyles.headlineLarge.fontFamily, contains('Inter'));
+    expect(AppTextStyles.maisonHeroTitle.fontFamily, contains('Inter'));
+    expect(AppTextStyles.brandTagline.letterSpacing, 3);
+  });
+
+  test('la palette TV explicite conserve son accent violet', () {
+    expect(AppTheme.tvViolet.colorScheme.primary, TvRoyal.accent);
+    expect(AppTheme.tvViolet.scaffoldBackgroundColor, TvRoyal.background);
+  });
+}
diff --git a/test/core/widgets/premium_motion_test.dart b/test/core/widgets/premium_motion_test.dart
new file mode 100644
index 00000000..1e008385
--- /dev/null
+++ b/test/core/widgets/premium_motion_test.dart
@@ -0,0 +1,197 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/theme/premium_page_transitions.dart';
+import 'package:tv_king/core/widgets/premium_press.dart';
+
+Widget _host(Widget child, {bool reduceMotion = false}) => MaterialApp(
+      builder: (context, child) => MediaQuery(
+        data: MediaQuery.of(context).copyWith(disableAnimations: reduceMotion),
+        child: child!,
+      ),
+      home: Scaffold(body: Center(child: child)),
+    );
+
+void main() {
+  testWidgets(
+      'L’appui conserve sa cible et déclenche une seule action immédiate',
+      (tester) async {
+    int actions = 0;
+    await tester.pumpWidget(_host(PremiumPress(
+      onTap: () => actions++,
+      child: const Text('Ouvrir'),
+    )));
+    final press = find.byType(PremiumPress);
+    final Size initialSize = tester.getSize(press);
+    expect(initialSize.width, greaterThanOrEqualTo(48));
+    expect(initialSize.height, greaterThanOrEqualTo(48));
+    final gesture = await tester.startGesture(tester.getCenter(press));
+    await tester.pump(const Duration(milliseconds: 130));
+    expect(
+        tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 0.98);
+    expect(tester.getSize(press), initialSize);
+    expect(actions, 0);
+    await gesture.up();
+    expect(actions, 1); // L'action n'attend pas la fin de l'animation.
+    await tester.pumpAndSettle();
+    expect(tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 1);
+    expect(actions, 1);
+  });
+
+  testWidgets('Un geste annulé ne déclenche aucune navigation', (tester) async {
+    int actions = 0;
+    await tester.pumpWidget(_host(PremiumPress(
+      onTap: () => actions++,
+      child: const Text('Ouvrir'),
+    )));
+    final gesture =
+        await tester.startGesture(tester.getCenter(find.byType(PremiumPress)));
+    await tester.pump(const Duration(milliseconds: 130));
+    await gesture.cancel();
+    await tester.pumpAndSettle();
+    expect(actions, 0);
+    expect(tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 1);
+  });
+
+  testWidgets('Entrée clavier anime et active une seule fois', (tester) async {
+    int actions = 0;
+    final focusNode = FocusNode();
+    addTearDown(focusNode.dispose);
+    await tester.pumpWidget(_host(PremiumPress(
+      focusNode: focusNode,
+      onTap: () => actions++,
+      child: const Text('Ouvrir'),
+    )));
+    focusNode.requestFocus();
+    await tester.pump();
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.enter);
+    expect(actions, 1);
+    await tester.pump(const Duration(milliseconds: 40));
+    expect(
+        tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 0.98);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.enter);
+    await tester.pumpAndSettle();
+    expect(actions, 1);
+    expect(tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 1);
+  });
+
+  testWidgets('Réduire les animations conserve les actions sans contraction',
+      (tester) async {
+    int actions = 0;
+    await tester.pumpWidget(_host(
+      PremiumPress(onTap: () => actions++, child: const Text('Ouvrir')),
+      reduceMotion: true,
+    ));
+    final gesture =
+        await tester.startGesture(tester.getCenter(find.byType(PremiumPress)));
+    await tester.pump(const Duration(milliseconds: 130));
+    final scale = tester.widget<AnimatedScale>(find.byType(AnimatedScale));
+    expect(scale.scale, 1);
+    expect(scale.duration, Duration.zero);
+    await gesture.up();
+    expect(actions, 1);
+    await tester.pumpAndSettle();
+  });
+
+  testWidgets('Désactiver une commande pendant l’appui annule sans exception',
+      (tester) async {
+    int actions = 0;
+    bool enabled = true;
+    late StateSetter change;
+    await tester.pumpWidget(_host(StatefulBuilder(builder: (context, setState) {
+      change = setState;
+      return PremiumPress(
+        onTap: enabled ? () => actions++ : null,
+        child: const Text('Ouvrir'),
+      );
+    })));
+    final gesture =
+        await tester.startGesture(tester.getCenter(find.byType(PremiumPress)));
+    await tester.pump(const Duration(milliseconds: 130));
+    change(() => enabled = false);
+    await tester.pump();
+    await gesture.up();
+    await tester.pumpAndSettle();
+    expect(actions, 0);
+    expect(tester.takeException(), isNull);
+    expect(tester.widget<AnimatedScale>(find.byType(AnimatedScale)).scale, 1);
+  });
+
+  testWidgets('Les deux pages respectent la réduction des animations',
+      (tester) async {
+    const transitions = PremiumPageTransitionsBuilder();
+    expect(transitions.transitionDuration, const Duration(milliseconds: 240));
+    const content = SizedBox(width: 100, height: 100);
+    await tester.pumpWidget(_host(Builder(builder: (context) {
+      final route = MaterialPageRoute<void>(builder: (_) => content);
+      const animation = AlwaysStoppedAnimation<double>(0.5);
+      expect(
+          transitions.buildTransitions(
+              route, context, animation, animation, content),
+          same(content));
+      expect(
+          transitions.delegatedTransition!(
+              context, animation, animation, false, content),
+          same(content));
+      return content;
+    }), reduceMotion: true));
+  });
+
+  testWidgets('Un bouton imbriqué ne déclenche pas l’action de la ligne',
+      (tester) async {
+    int plays = 0;
+    int favorites = 0;
+    await tester.pumpWidget(_host(PremiumPress(
+      onTap: () => plays++,
+      child: Row(mainAxisSize: MainAxisSize.min, children: <Widget>[
+        const Text('Station'),
+        IconButton(
+          tooltip: 'Favori',
+          onPressed: () => favorites++,
+          icon: const Icon(Icons.favorite_border),
+        ),
+      ]),
+    )));
+    await tester.tap(find.byTooltip('Favori'));
+    await tester.pumpAndSettle();
+    expect(favorites, 1);
+    expect(plays, 0);
+    await tester.tap(find.text('Station'));
+    expect(plays, 1);
+    expect(favorites, 1);
+    await tester.pumpAndSettle();
+  });
+
+  testWidgets(
+      'Le halo apparaît seulement au focus clavier et reste immobile en mode réduit',
+      (tester) async {
+    final focusNode = FocusNode();
+    final strategy = FocusManager.instance.highlightStrategy;
+    FocusManager.instance.highlightStrategy =
+        FocusHighlightStrategy.alwaysTraditional;
+    addTearDown(() {
+      focusNode.dispose();
+      FocusManager.instance.highlightStrategy = strategy;
+    });
+    int actions = 0;
+    await tester.pumpWidget(_host(
+        PremiumPress(
+          focusNode: focusNode,
+          onTap: () => actions++,
+          child: const Text('Ouvrir'),
+        ),
+        reduceMotion: true));
+    AnimatedContainer container() =>
+        tester.widget<AnimatedContainer>(find.byType(AnimatedContainer));
+    expect((container().decoration! as BoxDecoration).boxShadow, isEmpty);
+    focusNode.requestFocus();
+    await tester.pumpAndSettle();
+    expect((container().decoration! as BoxDecoration).boxShadow, hasLength(1));
+    expect(container().duration, Duration.zero);
+    expect(actions, 0);
+    focusNode.unfocus();
+    await tester.pumpAndSettle();
+    expect((container().decoration! as BoxDecoration).boxShadow, isEmpty);
+    expect(actions, 0);
+  });
+}
