diff --git a/lib/core/theme/premium_page_transitions.dart b/lib/core/theme/premium_page_transitions.dart
new file mode 100644
index 00000000..0b35f55e
--- /dev/null
+++ b/lib/core/theme/premium_page_transitions.dart
@@ -0,0 +1,37 @@
+import 'package:flutter/material.dart';
+
+/// Le fondu Android existant reste familier, avec une durée plus vive.
+/// Le réglage système « Réduire les animations » supprime le mouvement des
+/// deux pages, y compris la transition déléguée à la route précédente.
+class PremiumPageTransitionsBuilder extends FadeForwardsPageTransitionsBuilder {
+  const PremiumPageTransitionsBuilder();
+
+  @override
+  Duration get transitionDuration => const Duration(milliseconds: 240);
+
+  @override
+  DelegatedTransitionBuilder? get delegatedTransition {
+    final delegate = super.delegatedTransition;
+    if (delegate == null) return null;
+    return (context, animation, secondaryAnimation, allowSnapshotting, child) {
+      if (MediaQuery.disableAnimationsOf(context)) return child;
+      return delegate(
+          context, animation, secondaryAnimation, allowSnapshotting, child);
+    };
+  }
+
+  @override
+  Widget buildTransitions<T>(
+    PageRoute<T>? route,
+    BuildContext? context,
+    Animation<double> animation,
+    Animation<double> secondaryAnimation,
+    Widget child,
+  ) {
+    if (context != null && MediaQuery.disableAnimationsOf(context)) {
+      return child;
+    }
+    return super
+        .buildTransitions(route, context, animation, secondaryAnimation, child);
+  }
+}
