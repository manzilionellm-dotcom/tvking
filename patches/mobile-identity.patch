@@ -0,0 +1,37 @@
+import 'package:flutter/material.dart';
+
+/// Désature uniquement le visuel fourni par le catalogue. La matrice conserve
+/// sa luminance et son canal alpha : les PNG transparents gardent leur découpe,
+/// sans rectangle blanc ajouté ni substitution par un logo inventé.
+class MonochromeArtwork extends StatelessWidget {
+  const MonochromeArtwork({super.key, required this.child});
+
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) => ColorFiltered(
+        colorFilter: const ColorFilter.matrix(<double>[
+          0.2126,
+          0.7152,
+          0.0722,
+          0,
+          0,
+          0.2126,
+          0.7152,
+          0.0722,
+          0,
+          0,
+          0.2126,
+          0.7152,
+          0.0722,
+          0,
+          0,
+          0,
+          0,
+          0,
+          1,
+          0,
+        ]),
+        child: child,
+      );
+}
diff --git a/lib/core/widgets/premium_press.dart b/lib/core/widgets/premium_press.dart
new file mode 100644
index 00000000..4a4c4c44
--- /dev/null
+++ b/lib/core/widgets/premium_press.dart
@@ -0,0 +1,133 @@
+import 'package:flutter/material.dart';
+
+import '../theme/app_colors.dart';
+
+/// Retour tactile discret des commandes mobiles : le contenu s'enfonce de 2 %,
+/// puis revient sans rebond. La zone de toucher, elle, ne rétrécit jamais.
+///
+/// Un seul InkWell gère le doigt, le clavier et les technologies d'assistance.
+/// Aucun délai n'est ajouté à l'action : l'animation accompagne l'appui, elle
+/// ne retarde ni la navigation ni le lancement d'un flux.
+class PremiumPress extends StatefulWidget {
+  const PremiumPress({
+    super.key,
+    required this.child,
+    required this.onTap,
+    this.onLongPress,
+    this.borderRadius,
+    this.focusNode,
+    this.autofocus = false,
+    this.excludeFromSemantics = false,
+  });
+
+  final Widget child;
+  final VoidCallback? onTap;
+  final VoidCallback? onLongPress;
+  final BorderRadius? borderRadius;
+  final FocusNode? focusNode;
+  final bool autofocus;
+  final bool excludeFromSemantics;
+
+  @override
+  State<PremiumPress> createState() => _PremiumPressState();
+}
+
+class _PremiumPressState extends State<PremiumPress> {
+  bool _pressed = false;
+  bool _focused = false;
+
+  @override
+  void initState() {
+    super.initState();
+    FocusManager.instance.addHighlightModeListener(_focusModeChanged);
+  }
+
+  @override
+  void dispose() {
+    FocusManager.instance.removeHighlightModeListener(_focusModeChanged);
+    super.dispose();
+  }
+
+  void _focusModeChanged(FocusHighlightMode mode) {
+    if (mounted && _focused) setState(() {});
+  }
+
+  void _focusChanged(bool focused) {
+    if (mounted && focused != _focused) setState(() => _focused = focused);
+  }
+
+  @override
+  void didUpdateWidget(PremiumPress oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    // InkWell signale aussi la fin de l'appui pendant son build si la commande
+    // devient indisponible. Réinitialiser ici évite un setState dans ce build.
+    if (widget.onTap == null && widget.onLongPress == null) {
+      _pressed = false;
+      _focused = false;
+    }
+  }
+
+  void _highlightChanged(bool pressed) {
+    if (!mounted || pressed == _pressed) return;
+    setState(() => _pressed = pressed);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final bool reduceMotion = MediaQuery.disableAnimationsOf(context);
+    final bool showFocus = _focused &&
+        FocusManager.instance.highlightMode == FocusHighlightMode.traditional;
+    final foreground = AppColors.lumiere(context).textPrimary;
+    return Semantics(
+      button: true,
+      enabled: widget.onTap != null || widget.onLongPress != null,
+      child: AnimatedContainer(
+        // Le halo n'existe qu'au focus clavier. Le liseré est peint au premier
+        // plan, donc il ne déplace jamais le contenu ni la cible tactile.
+        duration:
+            reduceMotion ? Duration.zero : const Duration(milliseconds: 160),
+        curve: Curves.easeOutCubic,
+        decoration: BoxDecoration(
+          borderRadius: widget.borderRadius ?? BorderRadius.circular(16),
+          boxShadow: showFocus
+              ? <BoxShadow>[
+                  BoxShadow(
+                      color: foreground.withValues(alpha: 0.14),
+                      blurRadius: 12,
+                      spreadRadius: 1),
+                ]
+              : const <BoxShadow>[],
+        ),
+        foregroundDecoration: BoxDecoration(
+          borderRadius: widget.borderRadius ?? BorderRadius.circular(16),
+          border: Border.all(
+              color: showFocus
+                  ? foreground.withValues(alpha: 0.70)
+                  : Colors.transparent,
+              width: 1.5),
+        ),
+        child: InkWell(
+          onTap: widget.onTap,
+          onLongPress: widget.onLongPress,
+          onHighlightChanged: _highlightChanged,
+          onFocusChange: _focusChanged,
+          borderRadius: widget.borderRadius,
+          focusNode: widget.focusNode,
+          autofocus: widget.autofocus,
+          excludeFromSemantics: widget.excludeFromSemantics,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(minWidth: 48, minHeight: 48),
+            child: AnimatedScale(
+              scale: _pressed && !reduceMotion ? 0.98 : 1,
+              duration: reduceMotion
+                  ? Duration.zero
+                  : Duration(milliseconds: _pressed ? 110 : 160),
+              curve: Curves.easeOutCubic,
+              child: widget.child,
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
