diff --git a/lib/core/widgets/country_flag.dart b/lib/core/widgets/country_flag.dart
new file mode 100644
index 00000000..8cbc42b4
--- /dev/null
+++ b/lib/core/widgets/country_flag.dart
@@ -0,0 +1,54 @@
+import 'package:flutter/material.dart';
+
+import '../theme/app_text_styles.dart';
+
+/// Drapeau d'un pays à partir de son code ISO 3166-1 alpha-2.
+///
+/// Le drapeau est composé des deux symboles indicateurs régionaux Unicode :
+/// Android les rend avec sa police emoji système, sans aucune image
+/// embarquée ni requête réseau. Un code inconnu ou malformé renvoie une
+/// chaîne vide, et le widget retombe alors sur le code texte.
+String countryFlagEmoji(String code) {
+  final String iso =
+      code.trim().toUpperCase() == 'UK' ? 'GB' : code.trim().toUpperCase();
+  if (!RegExp(r'^[A-Z]{2}$').hasMatch(iso)) return '';
+  const int base = 0x1F1E6 - 0x41;
+  return String.fromCharCodes(
+      <int>[base + iso.codeUnitAt(0), base + iso.codeUnitAt(1)]);
+}
+
+/// Petit drapeau textuel, lisible par les lecteurs d'écran via le nom du pays
+/// fourni par l'appelant. Sans drapeau disponible, affiche le code ISO.
+class CountryFlag extends StatelessWidget {
+  const CountryFlag(this.code,
+      {super.key, required this.semanticLabel, this.size = 18, this.color});
+
+  final String code;
+  final String semanticLabel;
+  final double size;
+
+  /// Couleur du code texte de repli uniquement ; un emoji garde ses couleurs.
+  final Color? color;
+
+  @override
+  Widget build(BuildContext context) {
+    final String flag = countryFlagEmoji(code);
+    return Semantics(
+      label: semanticLabel,
+      excludeSemantics: true,
+      child: Text(
+        flag.isEmpty ? code.toUpperCase() : flag,
+        style: flag.isEmpty
+            ? AppTextStyles.bodySmall
+                .copyWith(color: color, fontWeight: FontWeight.w600)
+            // Famille explicite de repli : la police emoji couleur d'Android.
+            // Absente, le système choisit lui-même sa police emoji.
+            : TextStyle(
+                fontSize: size,
+                height: 1,
+                fontFamilyFallback: const <String>['Noto Color Emoji']),
+        textScaler: TextScaler.noScaling,
+      ),
+    );
+  }
+}
