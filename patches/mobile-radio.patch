diff --git a/test/features/radio/radio_browser_http_test.dart b/test/features/radio/radio_browser_http_test.dart
new file mode 100644
--- /dev/null
+++ b/test/features/radio/radio_browser_http_test.dart
@@ -0,0 +1,251 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/features/radio/data/radio_browser_client.dart';
+import 'package:tv_king/features/radio/data/radio_catalog_controller.dart';
+import 'package:tv_king/features/radio/domain/radio_station.dart';
+
+// Le transport, les délais, la lecture du corps et le contrôleur sont réels.
+// Seul le fournisseur externe est remplacé par un serveur HTTP sur loopback.
+Map<String, Object?> station(int n, {bool online = true}) => <String, Object?>{
+  'stationuuid': '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}',
+  'name': 'Radio $n', 'url_resolved': 'https://radio.invalid/audio/$n',
+  'countrycode': 'SE', 'language': 'swedish', 'tags': 'jazz',
+  'codec': 'MP3', 'bitrate': 128, 'lastcheckok': online ? 1 : 0,
+};
+
+Future<HttpServer> serve(Future<void> Function(HttpRequest) handler) async {
+  final HttpServer server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+  server.listen(handler);
+  addTearDown(() => server.close(force: true));
+  return server;
+}
+
+Uri mirror(HttpServer server) => Uri.parse('http://127.0.0.1:${server.port}');
+
+Future<void> reply(HttpRequest request, Object body) async {
+  request.response.headers.contentType = ContentType.json;
+  request.response.write(jsonEncode(body));
+  await request.response.close();
+}
+
+void main() {
+  setUp(() => RepairFlags.mobileRadioLegacy = false);
+  tearDown(() => RepairFlags.mobileRadioLegacy = false);
+
+  test('catalogue : une requête HTTP réelle charge une radio', () async {
+    int requests = 0;
+    final HttpServer server = await serve((HttpRequest request) async {
+      requests++;
+      expect(request.uri.path, '/json/stations/search');
+      expect(request.uri.queryParameters['hidebroken'], 'true');
+      expect(request.headers.value(HttpHeaders.userAgentHeader), contains('7MOTION'));
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    RepairFlags.mobileRadioLegacy = const bool.fromEnvironment('RADIO_LEGACY_PROOF');
+    await controller.load(const RadioQuery());
+    expect(controller.stations.length, 1,
+      reason: 'Le catalogue actif doit livrer une station du vrai serveur HTTP.');
+    expect(requests, 1);
+    expect(controller.stations.single.name, 'Radio 1');
+    expect(controller.error, isNull);
+  });
+
+  test('repli : aucun catalogue, aucun appel réseau', () async {
+    int requests = 0;
+    final HttpServer server = await serve((HttpRequest request) async {
+      requests++;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    RepairFlags.mobileRadioLegacy = true;
+    await controller.load(const RadioQuery());
+    expect(requests, 0);
+    expect(controller.stations, isEmpty);
+    expect(controller.error, RadioFailureCode.disabled);
+    expect(controller.loading, isFalse);
+  });
+
+  test('filtres et pagination sont transmis au vrai serveur', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      expect(request.uri.queryParameters, <String, String>{
+        'hidebroken': 'true', 'order': 'votes', 'reverse': 'true', 'limit': '51',
+        'offset': '100', 'name': 'Étoile & radio', 'countrycode': 'BI',
+        'language': 'kirundi', 'tag': 'gospel',
+      });
+      await reply(request, List<Object>.generate(51, (int i) => station(i + 1)));
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.search(const RadioQuery(name: 'Étoile & radio',
+      countryCode: 'BI', language: 'kirundi', genre: 'gospel', page: 2));
+    expect(page.stations.length, 50);
+    expect(page.hasNext, isTrue);
+  });
+
+  test('doublons et radios déclarées hors ligne sont exclus', () async {
+    final HttpServer server = await serve((HttpRequest r) => reply(r,
+      <Object>[station(1), station(1), station(2, online: false), <String, Object?>{'name': 'invalide'}]));
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.search(const RadioQuery());
+    expect(page.stations.map((RadioStation s) => s.name), <String>['Radio 1']);
+    expect(page.hasNext, isFalse);
+  });
+
+  test('pays, langues et genres utilisent les routes documentées', () async {
+    final List<String> routes = <String>[];
+    final HttpServer server = await serve((HttpRequest request) async {
+      routes.add(request.uri.path);
+      if (request.uri.path.endsWith('countries')) {
+        await reply(request, <Object>[
+          <String, Object?>{'name': 'Burundi', 'iso_3166_1': 'BI'},
+          <String, Object?>{'name': 'Sweden', 'iso_3166_1': 'SE'},
+        ]);
+      } else {
+        await reply(request, <Object>[<String, Object?>{'name': 'jazz'}]);
+      }
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    expect((await client.countries()).map((RadioCountry c) => c.code), <String>['BI', 'SE']);
+    expect(await client.languages(), <String>['jazz']);
+    expect(await client.genres(), <String>['jazz']);
+    expect(routes, <String>['/json/countries', '/json/languages', '/json/tags']);
+  });
+
+  test('favoris : recharge par UUID, sans stocker une adresse', () async {
+    final String id = station(1)['stationuuid']! as String;
+    final HttpServer server = await serve((HttpRequest request) async {
+      expect(request.uri.path, '/json/stations/byuuid');
+      expect(request.uri.queryParameters['uuids'], id);
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.favorites(<String>[id, 'invalide'], 0);
+    expect(page.stations.single.id, id);
+    expect(page.hasNext, isFalse);
+  });
+
+  test('panne 503 : bascule bornée vers un autre miroir réel', () async {
+    int attempts = 0;
+    final HttpServer failed = await serve((HttpRequest request) async {
+      attempts++;
+      request.response.statusCode = 503;
+      await request.response.close();
+    });
+    final HttpServer healthy = await serve((HttpRequest r) => reply(r, <Object>[station(1)]));
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(failed), mirror(healthy)]);
+    addTearDown(client.close);
+    expect((await client.search(const RadioQuery())).stations.length, 1);
+    expect(attempts, 1);
+  });
+
+  test('refus 429 : aucune répétition sur les autres miroirs', () async {
+    int bypassAttempts = 0;
+    final HttpServer refused = await serve((HttpRequest request) async {
+      request.response.statusCode = 429;
+      await request.response.close();
+    });
+    final HttpServer other = await serve((HttpRequest request) async {
+      bypassAttempts++;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(refused), mirror(other)]);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()));
+    expect(bypassAttempts, 0);
+  });
+
+  test('JSON invalide : erreur explicite, sans valeur vide inventée', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      request.response.write('ceci ne forme pas un JSON');
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.invalidResponse)));
+  });
+
+  test('réponse trop grande : arrêt même sans Content-Length', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      request.response.bufferOutput = false;
+      request.response.write('["${'x' * 2048}"]');
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)], maxBytes: 128);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.responseTooLarge)));
+  });
+
+  test('timeout : requête réelle interrompue avec une raison sûre', () async {
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      await release.future;
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)],
+      timeout: const Duration(milliseconds: 80));
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.timeout)));
+    release.complete();
+  });
+
+  test('course : une recherche ancienne ne remplace pas la suivante', () async {
+    final Completer<void> entered = Completer<void>();
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      if (request.uri.queryParameters['name'] == 'ancienne') {
+        entered.complete();
+        await release.future;
+        await reply(request, <Object>[station(1)]);
+      } else {
+        await reply(request, <Object>[station(2)]);
+      }
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    final Future<void> first = controller.load(const RadioQuery(name: 'ancienne'));
+    await entered.future;
+    await controller.load(const RadioQuery(name: 'nouvelle'));
+    release.complete();
+    await first;
+    expect(controller.stations.single.name, 'Radio 2');
+    expect(controller.query.name, 'nouvelle');
+    expect(controller.loading, isFalse);
+  });
+
+  test('retrait : une relecture ancienne ne fait pas revenir le favori', () async {
+    final String id = station(1)['stationuuid']! as String;
+    final Completer<void> entered = Completer<void>();
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      entered.complete();
+      await release.future;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    final Future<void> old = controller.load(const RadioQuery(), favorites: <String>[id]);
+    await entered.future;
+    await controller.load(const RadioQuery(), favorites: <String>[]);
+    release.complete();
+    await old;
+    expect(controller.stations, isEmpty);
+    expect(controller.loading, isFalse);
+  });
+}
diff --git a/test/features/radio/radio_favorites_test.dart b/test/features/radio/radio_favorites_test.dart
new file mode 100644
--- /dev/null
+++ b/test/features/radio/radio_favorites_test.dart
@@ -0,0 +1,45 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/features/radio/data/radio_favorites_store.dart';
+
+const String firstId = '00000000-0000-4000-8000-000000000001';
+const String secondId = '00000000-0000-4000-8000-000000000002';
+
+void main() {
+  // Ce remplacement concerne uniquement le canal système de préférences,
+  // indisponible dans flutter test. Le carnet et le repli réels sont exécutés.
+  setUp(() => SharedPreferences.setMockInitialValues(<String, Object>{}));
+
+  test('favoris : ajout, relecture et retrait définitif', () async {
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    final RadioFavoritesStore store = RadioFavoritesStore(prefs);
+    await store.write(<String>[firstId, firstId, secondId, 'https://radio.invalid/private']);
+    expect(RadioFavoritesStore(prefs).read(), <String>[firstId, secondId]);
+    await store.write(<String>[secondId]);
+    expect(RadioFavoritesStore(prefs).read(), <String>[secondId]);
+    expect(prefs.getStringList(store.key), <String>[secondId]);
+  });
+
+  test('favoris : chaque profil conserve son carnet', () async {
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    final RadioFavoritesStore family = RadioFavoritesStore(prefs);
+    final RadioFavoritesStore child = RadioFavoritesStore(prefs, profileSuffix: '.child');
+    await family.write(<String>[firstId]);
+    await child.write(<String>[secondId]);
+    expect(family.read(), <String>[firstId]);
+    expect(child.read(), <String>[secondId]);
+  });
+
+  test('repli radio : éteint par défaut, relu depuis les préférences', () async {
+    await RepairFlags.load();
+    expect(RepairFlags.mobileRadioLegacy, isFalse);
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    await prefs.setBool(RepairFlags.mobileRadioLegacyKey, true);
+    await RepairFlags.load();
+    expect(RepairFlags.mobileRadioLegacy, isTrue);
+    await prefs.remove(RepairFlags.mobileRadioLegacyKey);
+    await RepairFlags.load();
+    expect(RepairFlags.mobileRadioLegacy, isFalse);
+  });
+}
