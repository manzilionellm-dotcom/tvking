+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../domain/radio_station.dart';
+
+// Un carnet par profil ; seuls les identifiants publics sont persistés.
+// La lecture et la validation sont communes à l'écran et aux tests.
+class RadioFavoritesStore {
+  RadioFavoritesStore(this.preferences, {this.profileSuffix = ''});
+  final SharedPreferences preferences;
+  final String profileSuffix;
+  String get key => 'zuno.mobile.radio_favorites.v1$profileSuffix';
+
+  List<String> read() => (preferences.getStringList(key) ?? const <String>[])
+      .where(RadioStation.validId).toSet().take(500).toList(growable: false);
+
+  Future<void> write(Iterable<String> ids) async {
+    final List<String> safe = ids.where(RadioStation.validId).toSet().take(500).toList();
+    final bool saved = await preferences.setStringList(key, safe);
+    if (!saved) throw const RadioFailure(RadioFailureCode.favoritesUnavailable);
+  }
+}
diff --git a/lib/features/radio/data/radio_recent_store.dart b/lib/features/radio/data/radio_recent_store.dart
new file mode 100644
index 00000000..05d360db
--- /dev/null
+++ b/lib/features/radio/data/radio_recent_store.dart
@@ -0,0 +1,47 @@
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../domain/radio_station.dart';
+
+// Un historique local par profil, limité aux 30 dernières stations distinctes.
+// Comme les favoris, il ne conserve que les UUID publics : les adresses de
+// diffusion sont relues auprès du catalogue lors du prochain accès.
+class RadioRecentStore {
+  RadioRecentStore(this.preferences, {this.profileSuffix = ''});
+
+  static const int maxEntries = 30;
+  final SharedPreferences preferences;
+  final String profileSuffix;
+  String get key => 'zuno.mobile.radio_recents.v1$profileSuffix';
+  Future<void> _pending = Future<void>.value();
+
+  List<String> read() {
+    // Une ancienne préférence mal typée ne doit jamais empêcher d'écouter.
+    // getStringList ferait un cast avant que nous puissions la nettoyer.
+    final Object? stored = preferences.get(key);
+    if (stored is! List) return const <String>[];
+    return stored
+        .whereType<String>()
+        .where(RadioStation.validId)
+        .map((String id) => id.toLowerCase())
+        .toSet()
+        .take(maxEntries)
+        .toList(growable: false);
+  }
+
+  Future<void> record(String id) {
+    if (!RadioStation.validId(id)) return Future<void>.value();
+    final String normalized = id.toLowerCase();
+    // Une écoute rapide de deux radios conserve les deux entrées, dans l'ordre
+    // des actions. Une écriture échouée n'empêche pas les suivantes d'essayer.
+    final Future<void> operation = _pending.then((_) async {
+      final List<String> recent = <String>[
+        normalized,
+        ...read().where((String previous) => previous != normalized),
+      ].take(maxEntries).toList(growable: false);
+      final bool saved = await preferences.setStringList(key, recent);
+      if (!saved) throw const RadioFailure(RadioFailureCode.unavailable);
+    });
+    _pending = operation.catchError((Object _) {});
+    return operation;
+  }
+}
diff --git a/lib/features/radio/domain/radio_station.dart b/lib/features/radio/domain/radio_station.dart
new file mode 100644
index 00000000..275d8361
--- /dev/null
+++ b/lib/features/radio/domain/radio_station.dart
@@ -0,0 +1,121 @@
+// Le catalogue fournit les adresses à la demande ; aucune radio n'est codée en dur.
+// Les favoris ne conservent que les UUID, jamais une adresse de diffusion.
+class RadioStation {
+  const RadioStation({
+    required this.id,
+    required this.name,
+    required this.streamUri,
+    required this.countryCode,
+    required this.language,
+    required this.tags,
+    required this.codec,
+    required this.bitrate,
+    this.logoUri,
+  });
+
+  final String id;
+  final String name;
+  final Uri streamUri;
+  final String countryCode;
+  final String language;
+  final String tags;
+  final String codec;
+  final int bitrate;
+  final Uri? logoUri;
+
+  static final RegExp _uuid = RegExp(
+    r'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$',
+  );
+
+  static bool validId(String id) => _uuid.hasMatch(id);
+
+  static RadioStation? fromJson(Map<String, dynamic> json) {
+    final String id = _text(json, 'stationuuid');
+    final String name = _text(json, 'name');
+    final Uri? address = _address(json['url_resolved']) ?? _address(json['url']);
+    // Les stations déclarées hors ligne et les données mal formées sont exclues.
+    if (!validId(id) || name.isEmpty || address == null ||
+        json['lastcheckok'].toString() != '1') {
+      return null;
+    }
+    return RadioStation(
+      id: id,
+      name: name,
+      streamUri: address,
+      logoUri: _address(json['favicon']),
+      countryCode: _text(json, 'countrycode').toUpperCase(),
+      language: _text(json, 'language'),
+      tags: _text(json, 'tags'),
+      codec: _text(json, 'codec'),
+      bitrate: int.tryParse(json['bitrate'].toString()) ?? 0,
+    );
+  }
+
+  static String _text(Map<String, dynamic> json, String key) {
+    final Object? value = json[key];
+    if (value is! String) return '';
+    final String cleaned = value.replaceAll(RegExp(r'[\r\n\x00-\x1f]'), ' ').trim();
+    return cleaned.length > 180 ? cleaned.substring(0, 180) : cleaned;
+  }
+
+  static Uri? _address(Object? value) {
+    if (value is! String || value.length > 4096) return null;
+    final Uri? uri = Uri.tryParse(value.trim());
+    if (uri == null || !const <String>{'http', 'https'}.contains(uri.scheme) ||
+        uri.host.isEmpty || uri.userInfo.isNotEmpty) {
+      return null;
+    }
+    return uri;
+  }
+}
+
+class RadioCountry {
+  const RadioCountry(this.code, this.name, {this.stationCount});
+  final String code;
+  final String name;
+  // Fourni par le catalogue au moment du chargement, jamais gravé dans l'app.
+  // null signifie « inconnu », ce qui est différent d'un pays sans station.
+  final int? stationCount;
+}
+
+// Popularité durable, écoutes récentes, puis dernières fiches mises à jour.
+// Ces choix restent indépendants du pays : le catalogue mondial est le défaut.
+enum RadioSort { popular, trending, newest }
+
+class RadioQuery {
+  const RadioQuery({this.name = '', this.countryCode = '', this.language = '',
+    this.genre = '', this.page = 0, this.sort = RadioSort.popular});
+  final String name;
+  final String countryCode;
+  final String language;
+  final String genre;
+  final int page;
+  final RadioSort sort;
+
+  RadioQuery copyWith({String? name, String? countryCode, String? language,
+    String? genre, int? page, RadioSort? sort}) => RadioQuery(
+    name: name ?? this.name,
+    countryCode: countryCode ?? this.countryCode,
+    language: language ?? this.language,
+    genre: genre ?? this.genre,
+    page: page ?? this.page,
+    sort: sort ?? this.sort,
+  );
+}
+
+class RadioPage {
+  const RadioPage(this.stations, {required this.hasNext});
+  final List<RadioStation> stations;
+  final bool hasNext;
+}
+
+enum RadioFailureCode { disabled, offline, timeout, unavailable, invalidResponse,
+  responseTooLarge, favoritesUnavailable }
+
+// Une erreur publique ne contient ni URL ni texte brut de l'exception réseau.
+class RadioFailure implements Exception {
+  const RadioFailure(this.code);
+  final RadioFailureCode code;
+  @override
+  String toString() => 'RadioFailure(${code.name})';
+}
diff --git a/lib/features/radio/presentation/radio_entry.dart b/lib/features/radio/presentation/radio_entry.dart
new file mode 100644
index 00000000..aef6b2e8
--- /dev/null
+++ b/lib/features/radio/presentation/radio_entry.dart
@@ -0,0 +1,55 @@
+import 'package:flutter/material.dart';
+
+import '../../../core/app/repair_flags.dart';
+import '../../../core/i18n/l10n_extension.dart';
+import '../../../core/theme/app_colors.dart';
+import '../../../core/theme/app_text_styles.dart';
+import 'radio_screen.dart';
+
+// Accessible même sans playlist : la radio utilise un catalogue public distinct.
+// Le repli enlève toute l'entrée et ne crée ni lecteur ni appel réseau.
+class RadioEntry extends StatelessWidget {
+  const RadioEntry({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    if (RepairFlags.mobileRadioLegacy) return const SizedBox.shrink();
+    final colors = AppColors.lumiere(context);
+    final bool largeText = MediaQuery.textScalerOf(context).scale(16) >= 24;
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 10),
+      child: Material(
+        color: colors.elevated,
+        shape: RoundedRectangleBorder(
+            borderRadius: BorderRadius.circular(22),
+            side: BorderSide(color: colors.border)),
+        child: ListTile(
+          contentPadding:
+              const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+          leading: largeText
+              ? null
+              : Container(
