+import 'dart:io';
+
+import '../lib/features/radio/data/radio_browser_client.dart';
+import '../lib/features/radio/domain/radio_station.dart';
+
+// Preuve de livraison contre le service public réel : aucune adresse de
+// diffusion ni nom de station n'est affiché. Ce n'est pas un test audio Android.
+Future<void> main() async {
+  final RadioBrowserClient client = RadioBrowserClient();
+  try {
+    final RadioPage page = await client.search(const RadioQuery());
+    final List<RadioCountry> countries = await client.countries();
+    if (page.stations.isEmpty || countries.isEmpty) {
+      stderr.writeln('NON PROUVÉ : catalogue public ou liste de pays vide');
+      exitCode = 1;
+      return;
+    }
+    stdout.writeln('PROUVÉ : API Radio Browser réelle, '
+      '${page.stations.length} stations sur la page, ${countries.length} pays');
+  } on RadioFailure catch (failure) {
+    stderr.writeln('NON PROUVÉ : API publique Radio Browser, ${failure.code.name}');
+    exitCode = 1;
+  } finally {
+    client.close();
+  }
+}
