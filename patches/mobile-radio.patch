diff --git a/lib/features/radio/data/radio_browser_client.dart b/lib/features/radio/data/radio_browser_client.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/radio/data/radio_browser_client.dart
@@ -0,0 +1,207 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math';
+
+import '../domain/radio_station.dart';
+
+// Recherche et pagination côté serveur : on ne télécharge jamais tout le monde.
+// La bascule de miroir concerne seulement les GET de catalogue, jamais un flux.
+class RadioBrowserClient {
+  RadioBrowserClient({List<Uri>? mirrors,
+    this.timeout = const Duration(seconds: 7), this.maxBytes = 1024 * 1024})
+      : _suppliedMirrors = mirrors == null ? null : List<Uri>.unmodifiable(mirrors);
+
+  static const int pageSize = 50;
+  final Duration timeout;
+  final int maxBytes;
+  final List<Uri>? _suppliedMirrors;
+  final Set<HttpClient> _activeClients = <HttpClient>{};
+  Future<List<Uri>>? _discovery;
+  bool _closed = false;
+
+  Future<List<Uri>> _discover() async {
+    if (_suppliedMirrors != null) return _suppliedMirrors;
+    final List<Uri> servers = <Uri>[];
+    try {
+      final List<InternetAddress> addresses = await InternetAddress.lookup(
+        'all.api.radio-browser.info', type: InternetAddressType.IPv4,
+      ).timeout(const Duration(seconds: 2));
+      addresses.shuffle(Random());
+      for (final InternetAddress address in addresses.take(3)) {
+        try {
+          final InternetAddress reversed = await address.reverse()
+              .timeout(const Duration(seconds: 1));
+          final String host = reversed.host.toLowerCase().replaceFirst(RegExp(r'\.$'), '');
+          if (host.endsWith('.api.radio-browser.info')) {
+            servers.add(Uri.https(host, ''));
+          }
+        } on SocketException {
+          // Un PTR absent n'invalide pas les autres miroirs découverts.
+        } on TimeoutException {
+          // Chaque résolution a sa limite, aucune boucle sans fin.
+        }
+      }
+    } on SocketException {
+      // Le miroir officiel reste utilisable quand le DNS SRV/PTR est filtré.
+    } on TimeoutException {
+      // Le démarrage de l'app ne dépend jamais de cette découverte.
+    }
+    servers.add(Uri.https('de1.api.radio-browser.info', ''));
+    return servers.toSet().take(3).toList(growable: false);
+  }
+
+  Future<RadioPage> search(RadioQuery query) async {
+    if (query.page < 0 || query.page > 100000) {
+      throw const RadioFailure(RadioFailureCode.invalidResponse);
+    }
+    final List<dynamic> rows = await _get('/json/stations/search', <String, String>{
+      'hidebroken': 'true', 'order': 'votes', 'reverse': 'true',
+      'limit': '${pageSize + 1}', 'offset': '${query.page * pageSize}',
+      if (query.name.trim().isNotEmpty) 'name': query.name.trim(),
+      if (query.countryCode.isNotEmpty) 'countrycode': query.countryCode,
+      if (query.language.trim().isNotEmpty) 'language': query.language.trim(),
+      if (query.genre.trim().isNotEmpty) 'tag': query.genre.trim(),
+    });
+    // Les doublons du catalogue ne doublent pas les cartes à l'écran.
+    return RadioPage(_stations(rows.take(pageSize)), hasNext: rows.length > pageSize);
+  }
+
+  Future<RadioPage> favorites(List<String> ids, int page) async {
+    final List<String> valid = ids.where(RadioStation.validId).toList(growable: false);
+    final List<String> slice = valid.skip(page * pageSize).take(pageSize).toList();
+    if (slice.isEmpty) return const RadioPage(<RadioStation>[], hasNext: false);
+    final List<dynamic> rows = await _get('/json/stations/byuuid', <String, String>{
+      'uuids': slice.join(','), 'hidebroken': 'true', 'limit': '$pageSize',
+    });
+    return RadioPage(_stations(rows.take(pageSize)),
+      hasNext: valid.length > (page + 1) * pageSize);
+  }
+
+  List<RadioStation> _stations(Iterable<dynamic> rows) {
+    final Map<String, RadioStation> result = <String, RadioStation>{};
+    for (final dynamic value in rows) {
+      if (value is! Map<String, dynamic>) continue;
+      final RadioStation? station = RadioStation.fromJson(value);
+      if (station != null) result[station.id] = station;
+    }
+    return List<RadioStation>.unmodifiable(result.values);
+  }
+
+  Future<List<RadioCountry>> countries() async {
+    final List<dynamic> rows = await _get('/json/countries', <String, String>{
+      'hidebroken': 'true', 'order': 'name', 'limit': '300',
+    });
+    final Map<String, RadioCountry> result = <String, RadioCountry>{};
+    for (final dynamic value in rows.take(300)) {
+      if (value is! Map<String, dynamic>) continue;
+      final Object? code = value['iso_3166_1'];
+      final Object? name = value['name'];
+      if (code is String && RegExp(r'^[A-Z]{2}$').hasMatch(code) && name is String) {
+        result[code] = RadioCountry(code, name);
+      }
+    }
+    return List<RadioCountry>.unmodifiable(result.values);
+  }
+
+  Future<List<String>> languages() async {
+    final List<dynamic> rows = await _get('/json/languages', <String, String>{
+      'hidebroken': 'true', 'order': 'stationcount', 'reverse': 'true', 'limit': '500',
+    });
+    return rows.take(500).whereType<Map<String, dynamic>>()
+        .map((Map<String, dynamic> row) => row['name'])
+        .whereType<String>().where((String s) => s.isNotEmpty && s.length < 100)
+        .toSet().toList(growable: false);
+  }
+
+  Future<List<String>> genres() async {
+    final List<dynamic> rows = await _get('/json/tags', <String, String>{
+      'hidebroken': 'true', 'order': 'stationcount', 'reverse': 'true', 'limit': '500',
+    });
+    return rows.take(500).whereType<Map<String, dynamic>>()
+        .map((Map<String, dynamic> row) => row['name'])
+        .whereType<String>().where((String s) => s.isNotEmpty && s.length < 100)
+        .toSet().toList(growable: false);
+  }
+
+  Future<List<dynamic>> _get(String path, Map<String, String> params) async {
+    if (_closed) throw const RadioFailure(RadioFailureCode.unavailable);
+    final List<Uri> servers = await (_discovery ??= _discover());
+    RadioFailure last = const RadioFailure(RadioFailureCode.unavailable);
+    for (final Uri server in servers.take(3)) {
+      if (_closed) throw const RadioFailure(RadioFailureCode.unavailable);
+      try {
+        return await _fetch(server.replace(path: path, queryParameters: params));
+      } on _RadioRequestRejected {
+        rethrow;
+      } on RadioFailure catch (failure) {
+        last = failure;
+        // Une requête refusée ou trop volumineuse n'est pas répétée ailleurs.
+        if (failure.code == RadioFailureCode.responseTooLarge) rethrow;
+      }
+    }
+    throw last;
+  }
+
+  Future<List<dynamic>> _fetch(Uri uri) async {
+    final HttpClient client = HttpClient()..connectionTimeout = timeout;
+    _activeClients.add(client);
+    try {
+      return await (() async {
+        final HttpClientRequest request = await client.getUrl(uri);
+        request.headers.set(HttpHeaders.userAgentHeader, '7MOTION/0.3.6 (Radio Browser)');
+        request.headers.set(HttpHeaders.acceptHeader, 'application/json');
+        final HttpClientResponse response = await request.close();
+        if (response.statusCode >= 400 && response.statusCode < 500) {
+          throw const _RadioRequestRejected();
+        }
+        if (response.statusCode != HttpStatus.ok) {
+          throw const RadioFailure(RadioFailureCode.unavailable);
+        }
+        if (response.contentLength > maxBytes) {
+          throw const RadioFailure(RadioFailureCode.responseTooLarge);
+        }
+        final List<int> bytes = <int>[];
+        await for (final List<int> chunk in response) {
+          if (bytes.length + chunk.length > maxBytes) {
+            throw const RadioFailure(RadioFailureCode.responseTooLarge);
+          }
+          bytes.addAll(chunk);
+        }
+        final dynamic decoded = jsonDecode(utf8.decode(bytes));
+        if (decoded is! List<dynamic>) {
+          throw const RadioFailure(RadioFailureCode.invalidResponse);
+        }
+        return decoded;
+      })().timeout(timeout);
+    } on RadioFailure {
+      rethrow;
+    } on TimeoutException {
+      throw const RadioFailure(RadioFailureCode.timeout);
+    } on SocketException {
+      throw const RadioFailure(RadioFailureCode.offline);
+    } on HandshakeException {
+      throw const RadioFailure(RadioFailureCode.unavailable);
+    } on HttpException {
+      throw const RadioFailure(RadioFailureCode.unavailable);
+    } on FormatException {
+      throw const RadioFailure(RadioFailureCode.invalidResponse);
+    } finally {
+      _activeClients.remove(client);
+      client.close(force: true);
+    }
+  }
+
+  void close() {
+    _closed = true;
+    for (final HttpClient client in _activeClients) {
+      client.close(force: true);
+    }
+    _activeClients.clear();
+  }
+}
+
+// Un refus 4xx (dont 429) est respecté : changer de miroir ne le contourne pas.
+class _RadioRequestRejected extends RadioFailure {
+  const _RadioRequestRejected() : super(RadioFailureCode.unavailable);
+}
diff --git a/lib/features/radio/data/radio_catalog_controller.dart b/lib/features/radio/data/radio_catalog_controller.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/radio/data/radio_catalog_controller.dart
@@ -0,0 +1,61 @@
+import 'package:flutter/foundation.dart';
+
+import '../../../core/app/repair_flags.dart';
+import '../domain/radio_station.dart';
+import 'radio_browser_client.dart';
+
+// La révision protège la recherche rapide : une réponse ancienne ne peut
+// jamais écraser le nouveau pays, ni faire revenir un favori supprimé.
+class RadioCatalogController extends ChangeNotifier {
+  RadioCatalogController(this.client);
+  final RadioBrowserClient client;
+  RadioQuery query = const RadioQuery();
+  List<RadioStation> stations = const <RadioStation>[];
+  bool loading = false;
+  bool hasNext = false;
+  RadioFailureCode? error;
+  int _revision = 0;
+  bool _disposed = false;
+
+  Future<void> load(RadioQuery next, {List<String>? favorites}) async {
+    if (_disposed) return;
+    final int revision = ++_revision;
+    query = next;
+    stations = const <RadioStation>[];
+    hasNext = false;
+    error = null;
+    // Allumer le repli restitue l'ancienne app sans accès au catalogue.
+    if (RepairFlags.mobileRadioLegacy) {
+      loading = false;
+      error = RadioFailureCode.disabled;
+      notifyListeners();
+      return;
+    }
+    loading = true;
+    notifyListeners();
+    try {
+      final RadioPage page = favorites == null
+          ? await client.search(next)
+          : await client.favorites(List<String>.of(favorites), next.page);
+      if (_disposed || revision != _revision) return;
+      stations = page.stations;
+      hasNext = page.hasNext;
+    } on RadioFailure catch (failure) {
+      if (_disposed || revision != _revision) return;
+      error = failure.code;
+    } finally {
+      if (!_disposed && revision == _revision) {
+        loading = false;
+        notifyListeners();
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _revision++;
+    client.close();
+    super.dispose();
+  }
+}
diff --git a/lib/features/radio/data/radio_favorites_store.dart b/lib/features/radio/data/radio_favorites_store.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/radio/data/radio_favorites_store.dart
@@ -0,0 +1,21 @@
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../domain/radio_station.dart';
+
+// Un carnet par profil ; seuls les identifiants publics sont persistés.
+// La lecture et la validation sont communes à l'écran et aux tests.
+class RadioFavoritesStore {
+  RadioFavoritesStore(this.preferences, {this.profileSuffix = ''});
+  final SharedPreferences preferences;
+  final String profileSuffix;
+  String get key => 'zuno.mobile.radio_favorites.v1$profileSuffix';
+
+  List<String> read() => (preferences.getStringList(key) ?? const <String>[])
+      .where(RadioStation.validId).toSet().take(500).toList(growable: false);
+
+  Future<void> write(Iterable<String> ids) async {
+    final List<String> safe = ids.where(RadioStation.validId).toSet().take(500).toList();
+    final bool saved = await preferences.setStringList(key, safe);
+    if (!saved) throw const RadioFailure(RadioFailureCode.favoritesUnavailable);
+  }
+}
diff --git a/lib/features/radio/domain/radio_station.dart b/lib/features/radio/domain/radio_station.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/radio/domain/radio_station.dart
@@ -0,0 +1,108 @@
+// Le catalogue fournit les adresses à la demande ; aucune radio n'est codée en dur.
+// Les favoris ne conservent que les UUID, jamais une adresse de diffusion.
+class RadioStation {
+  const RadioStation({
+    required this.id,
+    required this.name,
+    required this.streamUri,
+    required this.countryCode,
+    required this.language,
+    required this.tags,
+    required this.codec,
+    required this.bitrate,
+    this.logoUri,
+  });
+
+  final String id;
+  final String name;
+  final Uri streamUri;
+  final String countryCode;
+  final String language;
+  final String tags;
+  final String codec;
+  final int bitrate;
+  final Uri? logoUri;
+
+  static final RegExp _uuid = RegExp(
+    r'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$',
+  );
+
+  static bool validId(String id) => _uuid.hasMatch(id);
+
+  static RadioStation? fromJson(Map<String, dynamic> json) {
+    final String id = _text(json, 'stationuuid');
+    final String name = _text(json, 'name');
+    final Uri? address = _address(json['url_resolved']) ?? _address(json['url']);
+    // Les stations déclarées hors ligne et les données mal formées sont exclues.
+    if (!validId(id) || name.isEmpty || address == null ||
+        json['lastcheckok'].toString() != '1') return null;
+    return RadioStation(
+      id: id,
+      name: name,
+      streamUri: address,
+      logoUri: _address(json['favicon']),
+      countryCode: _text(json, 'countrycode').toUpperCase(),
+      language: _text(json, 'language'),
+      tags: _text(json, 'tags'),
+      codec: _text(json, 'codec'),
+      bitrate: int.tryParse(json['bitrate'].toString()) ?? 0,
+    );
+  }
+
+  static String _text(Map<String, dynamic> json, String key) {
+    final Object? value = json[key];
+    if (value is! String) return '';
+    final String cleaned = value.replaceAll(RegExp(r'[\r\n\x00-\x1f]'), ' ').trim();
+    return cleaned.length > 180 ? cleaned.substring(0, 180) : cleaned;
+  }
+
+  static Uri? _address(Object? value) {
+    if (value is! String || value.length > 4096) return null;
+    final Uri? uri = Uri.tryParse(value.trim());
+    if (uri == null || !const <String>{'http', 'https'}.contains(uri.scheme) ||
+        uri.host.isEmpty || uri.userInfo.isNotEmpty) return null;
+    return uri;
+  }
+}
+
+class RadioCountry {
+  const RadioCountry(this.code, this.name);
+  final String code;
+  final String name;
+}
+
+class RadioQuery {
+  const RadioQuery({this.name = '', this.countryCode = '', this.language = '',
+    this.genre = '', this.page = 0});
+  final String name;
+  final String countryCode;
+  final String language;
+  final String genre;
+  final int page;
+
+  RadioQuery copyWith({String? name, String? countryCode, String? language,
+    String? genre, int? page}) => RadioQuery(
+    name: name ?? this.name,
+    countryCode: countryCode ?? this.countryCode,
+    language: language ?? this.language,
+    genre: genre ?? this.genre,
+    page: page ?? this.page,
+  );
+}
+
+class RadioPage {
+  const RadioPage(this.stations, {required this.hasNext});
+  final List<RadioStation> stations;
+  final bool hasNext;
+}
+
+enum RadioFailureCode { disabled, offline, timeout, unavailable, invalidResponse,
+  responseTooLarge, favoritesUnavailable }
+
+// Une erreur publique ne contient ni URL ni texte brut de l'exception réseau.
+class RadioFailure implements Exception {
+  const RadioFailure(this.code);
+  final RadioFailureCode code;
+  @override
+  String toString() => 'RadioFailure(${code.name})';
+}
