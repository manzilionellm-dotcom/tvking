diff --git a/test/features/profile/premium_profile_preview_test.dart b/test/features/profile/premium_profile_preview_test.dart
new file mode 100644
index 00000000..833bff28
--- /dev/null
+++ b/test/features/profile/premium_profile_preview_test.dart
@@ -0,0 +1,172 @@
+// Vérification des vrais écrans : petit écran, texte agrandi,
+// identité lisible/copiable et navigation retour. Les données sont fictives.
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:google_fonts/google_fonts.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/core/theme/app_theme.dart';
+import 'package:tv_king/features/about/presentation/about_screen.dart';
+import 'package:tv_king/features/device/data/device_identity.dart';
+import 'package:tv_king/features/profile/presentation/profile_screen.dart';
+import 'package:tv_king/l10n/generated/app_localizations.dart';
+
+import '../../support/premium_capture_fonts.dart';
+
+const String fixtureMac = 'AA:BB:CC:DD:EE';
+const String fixtureVersion = '0.3.6-preview';
+const String fixtureBuild = '1988120';
+final GlobalKey captureKey = GlobalKey();
+
+Future<void> mount(WidgetTester tester, Widget screen,
+    {required bool light, double scale = 1, bool pushed = false}) async {
+  tester.view.physicalSize = const Size(360, 800);
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  await tester.pumpWidget(RepaintBoundary(
+    key: captureKey,
+    child: MaterialApp(
+      debugShowCheckedModeBanner: false,
+      locale: const Locale('fr'),
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      theme: light ? AppTheme.daylight : AppTheme.cinema,
+      builder: (BuildContext context, Widget? child) => MediaQuery(
+        data: MediaQuery.of(context)
+            .copyWith(textScaler: TextScaler.linear(scale)),
+        child: child!,
+      ),
+      home: pushed
+          ? Builder(
+              builder: (BuildContext context) => Scaffold(
+                    body: Center(
+                        child: TextButton(
+                      onPressed: () => Navigator.of(context).push<void>(
+                          MaterialPageRoute<void>(builder: (_) => screen)),
+                      child: const Text('Ouvrir le profil'),
+                    )),
+                  ))
+          : screen,
+    ),
+  ));
+  await tester.runAsync(() async => await GoogleFonts.pendingFonts());
+  await tester.pumpAndSettle();
+  if (pushed) {
+    await tester.tap(find.text('Ouvrir le profil'));
+    await tester.pumpAndSettle();
+    await tester.runAsync(() async => await GoogleFonts.pendingFonts());
+    await tester.pumpAndSettle();
+  }
+}
+
+Future<void> capture(WidgetTester tester, String name) async {
+  const String output = String.fromEnvironment('PREMIUM_CAPTURE_DIR');
+  if (output.isEmpty) return;
+  await tester.runAsync(() => precacheImage(
+      const AssetImage('assets/branding/logo_7motion.jpg'),
+      captureKey.currentContext!));
+  await tester.pumpAndSettle();
+  final RenderRepaintBoundary boundary =
+      captureKey.currentContext!.findRenderObject()! as RenderRepaintBoundary;
+  await tester.runAsync(() async {
+    final ui.Image image = await boundary.toImage(pixelRatio: 2);
+    final ByteData? bytes =
+        await image.toByteData(format: ui.ImageByteFormat.png);
+    File('$output/$name.png').writeAsBytesSync(bytes!.buffer.asUint8List());
+    image.dispose();
+  });
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUpAll(() async {
+    await preparePremiumCaptureFonts();
+    FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+  });
+  String? clipboard;
+  setUp(() {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'device.virtual_mac.v1': 'MK:$fixtureMac',
+    });
+    DeviceIdentity.instance.debugResetCache();
+    PackageInfo.setMockInitialValues(
+      appName: '7 MOTION',
+      packageName: 'com.example.preview',
+      version: fixtureVersion,
+      buildNumber: fixtureBuild,
+      buildSignature: '',
+    );
+    clipboard = null;
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(SystemChannels.platform,
+            (MethodCall call) async {
+      if (call.method == 'Clipboard.setData') {
+        clipboard =
+            (call.arguments as Map<Object?, Object?>)['text'] as String?;
+      }
+      return null;
+    });
+  });
+
+  for (final bool light in <bool>[false, true]) {
+    for (final double scale in <double>[1, 2]) {
+      final String mode = light ? 'light' : 'dark';
+      final String label = '${mode}_${scale.toInt()}x';
+      testWidgets('profil $label : identité et retour à 360 px',
+          (WidgetTester tester) async {
+        await mount(tester, const ProfileScreen(),
+            light: light, scale: scale, pushed: true);
+        expect(tester.takeException(), isNull);
+        expect(find.text(fixtureMac), findsOneWidget);
+        expect(find.byType(BackButton), findsOneWidget);
+        await capture(tester, 'profile_$label');
+        await tester.tap(find.byIcon(Icons.copy_rounded));
+        await tester.pumpAndSettle();
+        expect(clipboard, fixtureMac);
+        ScaffoldMessenger.of(tester.element(find.byType(ProfileScreen)))
+            .hideCurrentSnackBar();
+        await tester.pumpAndSettle();
+        await tester.drag(find.byType(ListView), const Offset(0, -900));
+        await tester.pumpAndSettle();
+        expect(tester.takeException(), isNull);
+        await capture(tester, 'profile_${label}_bottom');
+        await tester.drag(find.byType(ListView), const Offset(0, 1600));
+        await tester.pumpAndSettle();
+        await capture(tester, 'profile_$label');
+        await tester.tap(find.byType(BackButton));
+        await tester.pumpAndSettle();
+        expect(find.text('Ouvrir le profil'), findsOneWidget);
+      });
+      testWidgets('à propos $label : identifiant et version lisibles à 360 px',
+          (WidgetTester tester) async {
+        await mount(tester, const AboutScreen(), light: light, scale: scale);
+        expect(tester.takeException(), isNull);
+        await capture(tester, 'about_$label');
+        await tester.scrollUntilVisible(find.text(fixtureMac), 180,
+            scrollable: find.byType(Scrollable).first);
+        expect(find.text(fixtureMac), findsOneWidget);
+        await tester.scrollUntilVisible(find.text(fixtureBuild), 180,
+            scrollable: find.byType(Scrollable).first);
+        expect(find.text(fixtureBuild), findsOneWidget);
+        await tester.drag(find.byType(ListView), const Offset(0, -500));
+        await tester.pumpAndSettle();
+        expect(tester.takeException(), isNull);
+        await capture(tester, 'about_${label}_updates');
+        await tester.drag(find.byType(ListView), const Offset(0, -1000));
+        await tester.pumpAndSettle();
+        expect(tester.takeException(), isNull);
+        await tester.tap(find.byType(ExpansionTile).last);
+        await tester.pumpAndSettle();
+        expect(tester.takeException(), isNull);
+        await capture(tester, 'about_${label}_credits');
+      });
+    }
+  }
+}
diff --git a/test/features/radio/radio_browser_http_test.dart b/test/features/radio/radio_browser_http_test.dart
new file mode 100644
index 00000000..11f8e7fe
--- /dev/null
+++ b/test/features/radio/radio_browser_http_test.dart
@@ -0,0 +1,313 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/features/radio/data/radio_browser_client.dart';
+import 'package:tv_king/features/radio/data/radio_catalog_controller.dart';
+import 'package:tv_king/features/radio/domain/radio_station.dart';
+
+// Le transport, les délais, la lecture du corps et le contrôleur sont réels.
+// Seul le fournisseur externe est remplacé par un serveur HTTP sur loopback.
+Map<String, Object?> station(int n, {bool online = true}) => <String, Object?>{
+  'stationuuid': '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}',
+  'name': 'Radio $n', 'url_resolved': 'https://radio.invalid/audio/$n',
+  'countrycode': 'SE', 'language': 'swedish', 'tags': 'jazz',
+  'codec': 'MP3', 'bitrate': 128, 'lastcheckok': online ? 1 : 0,
+};
+
+Future<HttpServer> serve(Future<void> Function(HttpRequest) handler) async {
+  final HttpServer server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+  server.listen(handler);
+  addTearDown(() => server.close(force: true));
+  return server;
+}
+
+Uri mirror(HttpServer server) => Uri.parse('http://127.0.0.1:${server.port}');
+
+Future<void> reply(HttpRequest request, Object body) async {
+  request.response.headers.contentType = ContentType.json;
+  request.response.write(jsonEncode(body));
+  await request.response.close();
+}
+
+void main() {
+  setUp(() => RepairFlags.mobileRadioLegacy = false);
+  tearDown(() => RepairFlags.mobileRadioLegacy = false);
+
+  test('catalogue : une requête HTTP réelle charge une radio', () async {
+    int requests = 0;
+    final HttpServer server = await serve((HttpRequest request) async {
+      requests++;
+      expect(request.uri.path, '/json/stations/search');
+      expect(request.uri.queryParameters['hidebroken'], 'true');
+      expect(request.headers.value(HttpHeaders.userAgentHeader), contains('7MOTION'));
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    RepairFlags.mobileRadioLegacy = const bool.fromEnvironment('RADIO_LEGACY_PROOF');
+    await controller.load(const RadioQuery());
+    expect(controller.stations.length, 1,
+      reason: 'Le catalogue actif doit livrer une station du vrai serveur HTTP.');
+    expect(requests, 1);
+    expect(controller.stations.single.name, 'Radio 1');
+    expect(controller.error, isNull);
+  });
+
+  test('repli : aucun catalogue, aucun appel réseau', () async {
+    int requests = 0;
+    final HttpServer server = await serve((HttpRequest request) async {
+      requests++;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    RepairFlags.mobileRadioLegacy = true;
+    await controller.load(const RadioQuery());
+    expect(requests, 0);
+    expect(controller.stations, isEmpty);
+    expect(controller.error, RadioFailureCode.disabled);
+    expect(controller.loading, isFalse);
+  });
+
+  test('filtres et pagination sont transmis au vrai serveur', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      expect(request.uri.queryParameters, <String, String>{
+        'hidebroken': 'true', 'order': 'votes', 'reverse': 'true', 'limit': '51',
+        'offset': '100', 'name': 'Étoile & radio', 'countrycode': 'BI',
+        'language': 'kirundi', 'tag': 'gospel',
+      });
+      await reply(request, List<Object>.generate(51, (int i) => station(i + 1)));
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.search(const RadioQuery(name: 'Étoile & radio',
+      countryCode: 'BI', language: 'kirundi', genre: 'gospel', page: 2));
+    expect(page.stations.length, 50);
+    expect(page.hasNext, isTrue);
+  });
+
+  test('doublons et radios déclarées hors ligne sont exclus', () async {
+    final HttpServer server = await serve((HttpRequest r) => reply(r,
+      <Object>[station(1), station(1), station(2, online: false), <String, Object?>{'name': 'invalide'}]));
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.search(const RadioQuery());
+    expect(page.stations.map((RadioStation s) => s.name), <String>['Radio 1']);
+    expect(page.hasNext, isFalse);
+  });
+
+  test('découverte : chaque tri porte sur le monde entier par défaut', () async {
+    final List<Map<String, String>> queries = <Map<String, String>>[];
+    final HttpServer server = await serve((HttpRequest request) async {
+      queries.add(request.uri.queryParameters);
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    const RadioQuery worldwide = RadioQuery(name: 'radio');
+    for (final RadioSort sort in RadioSort.values) {
+      await client.search(worldwide.copyWith(sort: sort));
+    }
+    expect(queries.map((Map<String, String> q) => q['order']),
+      <String>['votes', 'clickcount', 'changetimestamp']);
+    for (final Map<String, String> query in queries) {
+      expect(query.containsKey('countrycode'), isFalse,
+        reason: 'Un raccourci régional ne doit pas limiter la recherche mondiale.');
+      expect(query['name'], 'radio');
+      expect(query['hidebroken'], 'true');
+      expect(query['reverse'], 'true');
+    }
+  });
+
+  test('pays, langues et genres utilisent les routes documentées', () async {
+    final List<String> routes = <String>[];
+    final HttpServer server = await serve((HttpRequest request) async {
+      routes.add(request.uri.path);
+      if (request.uri.path.endsWith('countries')) {
+        await reply(request, <Object>[
+          <String, Object?>{'name': 'Burundi', 'iso_3166_1': 'BI', 'stationcount': 4},
+          <String, Object?>{'name': 'Sweden', 'iso_3166_1': 'SE'},
+          <String, Object?>{'name': 'Rwanda', 'iso_3166_1': 'RW', 'stationcount': -1},
+        ]);
+      } else {
+        await reply(request, <Object>[<String, Object?>{'name': 'jazz'}]);
+      }
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final List<RadioCountry> countries = await client.countries();
+    expect(countries.map((RadioCountry c) => c.code), <String>['BI', 'SE', 'RW']);
+    expect(countries.map((RadioCountry c) => c.stationCount), <int?>[4, null, null]);
+    expect(await client.languages(), <String>['jazz']);
+    expect(await client.genres(), <String>['jazz']);
+    expect(routes, <String>['/json/countries', '/json/languages', '/json/tags']);
+  });
+
+  test('favoris : recharge par UUID, sans stocker une adresse', () async {
+    final String id = station(1)['stationuuid']! as String;
+    final HttpServer server = await serve((HttpRequest request) async {
+      expect(request.uri.path, '/json/stations/byuuid');
+      expect(request.uri.queryParameters['uuids'], id);
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.favorites(<String>[id, 'invalide'], 0);
+    expect(page.stations.single.id, id);
+    expect(page.hasNext, isFalse);
+  });
+
+  test('récents : l’ordre demandé résiste au tri du serveur et aux doublons', () async {
+    final String first = station(1)['stationuuid']! as String;
+    final String second = station(2)['stationuuid']! as String;
+    final String offline = station(3)['stationuuid']! as String;
+    final HttpServer server = await serve((HttpRequest request) async {
+      expect(request.uri.queryParameters['uuids'], '$second,$first,$offline');
+      // Ordre différent, doublon et une station jamais demandée.
+      await reply(request, <Object>[
+        station(1), station(1), station(2), station(3, online: false), station(4),
+      ]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    final RadioPage page = await client.favorites(<String>[
+      second, first, second, offline, 'https://radio.invalid/stream',
+    ], 0);
+    expect(page.stations.map((RadioStation s) => s.id), <String>[second, first]);
+    expect(page.hasNext, isFalse);
+  });
+
+  test('carnets : page invalide rejetée avant tout accès réseau', () async {
+    int requests = 0;
+    final HttpServer server = await serve((HttpRequest request) async {
+      requests++;
+      await reply(request, <Object>[]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    for (final int page in <int>[-1, 100001]) {
+      await expectLater(client.favorites(<String>[], page),
+        throwsA(isA<RadioFailure>().having((RadioFailure e) => e.code,
+          'code', RadioFailureCode.invalidResponse)));
+    }
+    expect(requests, 0);
+  });
+
+  test('panne 503 : bascule bornée vers un autre miroir réel', () async {
+    int attempts = 0;
+    final HttpServer failed = await serve((HttpRequest request) async {
+      attempts++;
+      request.response.statusCode = 503;
+      await request.response.close();
+    });
+    final HttpServer healthy = await serve((HttpRequest r) => reply(r, <Object>[station(1)]));
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(failed), mirror(healthy)]);
+    addTearDown(client.close);
+    expect((await client.search(const RadioQuery())).stations.length, 1);
+    expect(attempts, 1);
+  });
+
+  test('refus 429 : aucune répétition sur les autres miroirs', () async {
+    int bypassAttempts = 0;
+    final HttpServer refused = await serve((HttpRequest request) async {
+      request.response.statusCode = 429;
+      await request.response.close();
+    });
+    final HttpServer other = await serve((HttpRequest request) async {
+      bypassAttempts++;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(refused), mirror(other)]);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()));
+    expect(bypassAttempts, 0);
+  });
+
+  test('JSON invalide : erreur explicite, sans valeur vide inventée', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      request.response.write('ceci ne forme pas un JSON');
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)]);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.invalidResponse)));
+  });
+
+  test('réponse trop grande : arrêt même sans Content-Length', () async {
+    final HttpServer server = await serve((HttpRequest request) async {
+      request.response.bufferOutput = false;
+      request.response.write('["${'x' * 2048}"]');
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)], maxBytes: 128);
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.responseTooLarge)));
+  });
+
+  test('timeout : requête réelle interrompue avec une raison sûre', () async {
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      await release.future;
+      await request.response.close();
+    });
+    final RadioBrowserClient client = RadioBrowserClient(mirrors: <Uri>[mirror(server)],
+      timeout: const Duration(milliseconds: 80));
+    addTearDown(client.close);
+    await expectLater(client.search(const RadioQuery()), throwsA(isA<RadioFailure>()
+      .having((RadioFailure e) => e.code, 'code', RadioFailureCode.timeout)));
+    release.complete();
+  });
+
+  test('course : une recherche ancienne ne remplace pas la suivante', () async {
+    final Completer<void> entered = Completer<void>();
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      if (request.uri.queryParameters['name'] == 'ancienne') {
+        entered.complete();
+        await release.future;
+        await reply(request, <Object>[station(1)]);
+      } else {
+        await reply(request, <Object>[station(2)]);
+      }
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    final Future<void> first = controller.load(const RadioQuery(name: 'ancienne'));
+    await entered.future;
+    await controller.load(const RadioQuery(name: 'nouvelle'));
+    release.complete();
+    await first;
+    expect(controller.stations.single.name, 'Radio 2');
+    expect(controller.query.name, 'nouvelle');
+    expect(controller.loading, isFalse);
+  });
+
+  test('retrait : une relecture ancienne ne fait pas revenir le favori', () async {
+    final String id = station(1)['stationuuid']! as String;
+    final Completer<void> entered = Completer<void>();
+    final Completer<void> release = Completer<void>();
+    final HttpServer server = await serve((HttpRequest request) async {
+      entered.complete();
+      await release.future;
+      await reply(request, <Object>[station(1)]);
+    });
+    final RadioCatalogController controller = RadioCatalogController(
+      RadioBrowserClient(mirrors: <Uri>[mirror(server)]));
+    addTearDown(controller.dispose);
+    final Future<void> old = controller.load(const RadioQuery(), favorites: <String>[id]);
+    await entered.future;
+    await controller.load(const RadioQuery(), favorites: <String>[]);
+    release.complete();
+    await old;
+    expect(controller.stations, isEmpty);
+    expect(controller.loading, isFalse);
+  });
+}
