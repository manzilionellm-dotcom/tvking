+  Player _ensurePlayer() {
+    if (_player != null) return _player!;
+    final Player player = widget.playerFactory?.call() ??
+        Player(
+            configuration: const PlayerConfiguration(
+          title: '7 MOTION Radio',
+          logLevel: MPVLogLevel.error,
+        ));
+    _player = player;
+    final int generation = _playbackGeneration;
+    bool current() =>
+        mounted &&
+        generation == _playbackGeneration &&
+        identical(player, _player);
+    _subscriptions.add(player.stream.playing.listen((bool value) {
+      if (current()) setState(() => _playing = value);
+    }));
+    _subscriptions.add(player.stream.buffering.listen((bool value) {
+      if (current()) setState(() => _buffering = value);
+    }));
+    _subscriptions.add(player.stream.error.listen((String _) {
+      // Les messages natifs peuvent inclure l'adresse : on ne les recopie pas.
+      if (!current()) return;
+      setState(() {
+        _playbackError = true;
+        _playing = false;
+        _buffering = false;
+      });
+      _logFailure('playback.failed', RadioFailureCode.unavailable);
+    }));
+    // Une ouverture ne suffit pas : l'historique est enregistré seulement
+    // après progression du média courant. Les échecs ne polluent pas Récents.
+    _subscriptions.add(player.stream.position.listen((Duration position) {
+      final RadioStation? station = _current;
+      if (!current() ||
+          _opening ||
+          _playbackError ||
+          station == null ||
+          position <= Duration.zero ||
+          _recordedId == station.id) {
+        return;
+      }
+      final Playlist playlist = player.state.playlist;
+      if (playlist.medias.isEmpty ||
+          playlist.index < 0 ||
+          playlist.index >= playlist.medias.length ||
+          playlist.medias[playlist.index].uri != station.streamUri.toString()) {
+        return;
+      }
+      _recordedId = station.id;
+      unawaited(_remember(station.id));
+    }));
+    return player;
+  }
+
+  Future<void> _remember(String id) async {
