diff --git a/lib/features/simple_home/presentation/widgets/home_navigation_bar.dart b/lib/features/simple_home/presentation/widgets/home_navigation_bar.dart
new file mode 100644
index 00000000..b8bcac57
--- /dev/null
+++ b/lib/features/simple_home/presentation/widgets/home_navigation_bar.dart
@@ -0,0 +1,154 @@
+import 'package:flutter/material.dart';
+
+import '../../../../core/i18n/l10n_extension.dart';
+import '../../../../core/theme/app_colors.dart';
+import '../../../../core/theme/app_text_styles.dart';
+
+/// Dock de l'accueil mobile. Les destinations restent des routes : l'état
+/// sélectionné décrit donc l'accueil, sans simuler des onglets persistants.
+/// Chaque cible garde au moins 48 dp, même sur un téléphone de 320 dp.
+class HomeNavigationBar extends StatelessWidget {
+  const HomeNavigationBar({
+    super.key,
+    required this.onFavorites,
+    required this.onSport,
+    required this.onSearch,
+    required this.onAdd,
+  });
+
+  final VoidCallback onFavorites;
+  final VoidCallback onSport;
+  final VoidCallback onSearch;
+  final VoidCallback onAdd;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = AppColors.lumiere(context);
+    return Container(
+      margin: const EdgeInsets.fromLTRB(12, 6, 12, 8),
+      decoration: BoxDecoration(
+        color: colors.elevated,
+        borderRadius: BorderRadius.circular(24),
+        border: Border.all(color: colors.border),
+      ),
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 8),
+        child: Row(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: <Widget>[
+            Expanded(
+              child: _Destination(
+                icon: Icons.home_rounded,
+                label: context.l10n.navHome,
+                selected: true,
+                onTap: () {},
+              ),
+            ),
+            Expanded(
+              child: _Destination(
+                icon: Icons.favorite_border_rounded,
+                label: context.l10n.navFavorites,
+                onTap: onFavorites,
+              ),
+            ),
+            Expanded(
+              child: _Destination(
+                icon: Icons.sports_soccer_outlined,
+                label: context.l10n.navSport,
+                onTap: onSport,
+              ),
+            ),
+            Expanded(
+              child: _Destination(
+                icon: Icons.search_rounded,
+                label: context.l10n.navSearch,
+                onTap: onSearch,
+              ),
+            ),
+            Expanded(
+              child: _Destination(
+                icon: Icons.add_circle_outline_rounded,
+                label: context.l10n.buttonAdd,
+                onTap: onAdd,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _Destination extends StatelessWidget {
+  const _Destination({
+    required this.icon,
+    required this.label,
+    required this.onTap,
+    this.selected = false,
+  });
+
+  final IconData icon;
+  final String label;
+  final VoidCallback onTap;
+  final bool selected;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = AppColors.lumiere(context);
+    final Color foreground =
+        selected ? colors.textPrimary : colors.textSecondary;
+    return Semantics(
+      button: true,
+      selected: selected,
+      label: label,
+      onTap: onTap,
+      excludeSemantics: true,
+      child: Tooltip(
+        message: label,
+        child: Material(
+          color: Colors.transparent,
+          child: InkWell(
+            onTap: onTap,
+            borderRadius: BorderRadius.circular(18),
+            child: ConstrainedBox(
+              constraints: const BoxConstraints(minHeight: 56),
+              child: Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 2, vertical: 4),
+                child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  children: <Widget>[
+                    Container(
+                      padding: const EdgeInsets.symmetric(
+                          horizontal: 12, vertical: 5),
+                      decoration: BoxDecoration(
+                        color: selected
+                            ? AppColors.accent.withValues(alpha: 0.14)
+                            : Colors.transparent,
+                        borderRadius: BorderRadius.circular(12),
+                      ),
+                      child: Icon(icon,
+                          size: 23,
+                          color: selected ? AppColors.accent : foreground),
+                    ),
+                    const SizedBox(height: 4),
+                    Text(
+                      label,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      textAlign: TextAlign.center,
+                      style: AppTextStyles.bodySmall.copyWith(
+                        color: foreground,
+                        fontWeight:
+                            selected ? FontWeight.w600 : FontWeight.w400,
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
