+// Charge les vraies fontes embarquées pour les tests de lisibilité.
+// Le test ne dépend ni d'Internet, ni du chemin d'installation du SDK.
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:google_fonts/google_fonts.dart';
+
+Future<void> preparePremiumCaptureFonts() async {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  GoogleFonts.config.allowRuntimeFetching = false;
+  final FontLoader icons = FontLoader('MaterialIcons');
+  icons.addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'));
+  await icons.load();
+  // Flutter test utilise Ahem pour le texte système. Inter lui sert ici
+  // de repli lisible pour les contrôles Material ; les styles applicatifs
+  // chargent directement leur famille et leur graisse depuis assets/fonts.
+  final FontLoader materialFallback = FontLoader('Roboto');
+  materialFallback.addFont(rootBundle.load('assets/fonts/Inter-Regular.ttf'));
+  // Facultatif pour les captures Linux seulement : Android fournit déjà
+  // sa police emoji. Aucun chemin machine n'est imposé aux tests de CI.
+  const String emojiPath = String.fromEnvironment('PREMIUM_EMOJI_FONT');
+  if (emojiPath.isNotEmpty) {
+    final ByteData emoji =
+        ByteData.sublistView(File(emojiPath).readAsBytesSync());
+    materialFallback.addFont(Future<ByteData>.value(emoji));
+    final FontLoader interFallback = FontLoader('Inter');
+    interFallback.addFont(rootBundle.load('assets/fonts/Inter-Regular.ttf'));
+    interFallback.addFont(Future<ByteData>.value(emoji));
+    await interFallback.load();
+  }
+  await materialFallback.load();
+}
