+        .complete(RadioPage(client.fixtures.take(2).toList(), hasNext: false));
+    await tester.pumpAndSettle();
+    await _tapVisible(tester, _collection('Favoris'));
+    expect(client.savedRequests.last, <String>[_id(2)]);
