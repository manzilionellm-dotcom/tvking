+
+    // Le sélecteur mondial permet aussi de sortir de la mise en avant régionale.
+    await _tapVisible(tester, _collection('Rwanda'));
+    await _tapVisible(tester, find.widgetWithText(ActionChip, 'Rwanda'));
+    await _tapVisible(tester, find.widgetWithText(ListTile, 'Tous les pays'));
