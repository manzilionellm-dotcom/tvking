@@ -0,0 +1,74 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/features/radio/data/radio_recent_store.dart';
+
+String stationId(int n) =>
+    '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}';
+
+void main() {
+  setUp(() => SharedPreferences.setMockInitialValues(<String, Object>{}));
+
+  test(
+    'historique : réécouter remonte la radio, sans doubler ni stocker un flux',
+    () async {
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      final RadioRecentStore store = RadioRecentStore(prefs);
+      // Les appels simultanés simulent un changement rapide de radio.
+      await Future.wait(<Future<void>>[
+        store.record(stationId(1)),
+        store.record(stationId(2)),
+        store.record(stationId(1)),
+        store.record('https://radio.invalid/private-stream'),
+      ]);
+      expect(RadioRecentStore(prefs).read(), <String>[
+        stationId(1),
+        stationId(2),
+      ]);
+      expect(prefs.getStringList(store.key), <String>[
+        stationId(1),
+        stationId(2),
+      ]);
+    },
+  );
+
+  test(
+    'historique : trente stations au maximum et isolation des profils',
+    () async {
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      final RadioRecentStore family = RadioRecentStore(prefs);
+      final RadioRecentStore child = RadioRecentStore(
+        prefs,
+        profileSuffix: '.child',
+      );
+      await child.record(stationId(99));
+      for (int i = 1; i <= 35; i++) {
+        await family.record(stationId(i));
+      }
+      expect(
+        family.read(),
+        List<String>.generate(30, (int i) => stationId(35 - i)),
+      );
+      expect(child.read(), <String>[stationId(99)]);
+    },
+  );
+
+  test(
+    'historique : préférence corrompue récupérée lors de la prochaine écoute',
+    () async {
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      final RadioRecentStore store = RadioRecentStore(prefs);
+      await prefs.setString(store.key, 'ancienne valeur mal typée');
+      expect(store.read(), isEmpty);
+      await store.record(stationId(1));
+      expect(store.read(), <String>[stationId(1)]);
+      await prefs.setStringList(store.key, <String>[
+        stationId(2),
+        'invalid',
+        stationId(2),
+        'https://radio.invalid/private',
+        stationId(1),
+      ]);
+      expect(store.read(), <String>[stationId(2), stationId(1)]);
+    },
+  );
+}
