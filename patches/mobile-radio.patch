+  Future<void> _play(RadioStation station) async {
+    if (_opening) return;
+    final int generation = ++_playbackGeneration;
+    setState(() {
+      _current = station;
+      _recordedId = null;
+      _playing = false;
+      _buffering = true;
+      _opening = true;
+      _playbackError = false;
+    });
+    try {
+      // Fermer l'ancien lecteur avant d'en créer un nouveau isole ses
+      // événements tardifs et évite deux connexions audio simultanées.
+      await _disposePlayer();
+      if (!mounted || generation != _playbackGeneration) return;
+      final Player player = _ensurePlayer();
+      await player.open(Media(station.streamUri.toString()));
+      StructuredLogger.instance
+          .info(domain: 'radio', event: 'playback.requested');
+    } catch (_) {
+      if (mounted) setState(() => _playbackError = true);
+      _logFailure('playback.failed', RadioFailureCode.unavailable);
+    } finally {
+      if (mounted && generation == _playbackGeneration) {
+        setState(() => _opening = false);
+      }
+    }
+  }
+
+  Future<void> _pauseOrResume() async {
+    try {
+      if (_playbackError && _current != null) {
+        await _play(_current!);
+      } else {
+        await _player?.playOrPause();
+      }
+    } catch (_) {
+      if (mounted) setState(() => _playbackError = true);
+      _logFailure('playback.control', RadioFailureCode.unavailable);
+    }
+  }
+
+  Future<void> _stop() async {
+    if (_opening) return;
+    final int generation = ++_playbackGeneration;
+    setState(() => _opening = true);
+    await _disposePlayer();
+    if (!mounted || generation != _playbackGeneration) return;
+    setState(() {
+      _current = null;
+      _playing = false;
+      _buffering = false;
+      _playbackError = false;
+      _opening = false;
+    });
+  }
+
+  void _logFailure(String event, RadioFailureCode code) {
+    StructuredLogger.instance
+        .warn(domain: 'radio', event: event, ctx: <String, Object?>{
+      'reason': switch (code) {
+        RadioFailureCode.offline => 'Radio : aucune connexion au catalogue',
+        RadioFailureCode.timeout => 'Radio : délai de réponse dépassé',
+        RadioFailureCode.invalidResponse =>
+          'Radio : réponse du catalogue invalide',
+        RadioFailureCode.responseTooLarge =>
+          'Radio : réponse du catalogue trop volumineuse',
+        RadioFailureCode.favoritesUnavailable =>
+          'Radio : favoris non enregistrés',
+        RadioFailureCode.disabled => 'Radio : repli activé, catalogue coupé',
+        RadioFailureCode.unavailable => event.startsWith('playback')
+            ? 'Radio : station indisponible ou format non lisible'
+            : 'Radio : catalogue temporairement indisponible',
+      }
+    });
+  }
+
+  void _message(String text) {
+    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
+  }
+
+  String _failureText(RadioFailureCode code) {
+    final l = context.l10n;
+    return switch (code) {
+      RadioFailureCode.offline => l.radioOffline,
+      RadioFailureCode.timeout => l.radioTimeout,
+      RadioFailureCode.invalidResponse ||
