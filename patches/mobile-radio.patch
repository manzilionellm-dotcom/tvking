+    final Widget fallback =
+        Icon(Icons.radio_rounded, color: colors.textSecondary);
+    return ExcludeSemantics(
+        child: Container(
+            width: 48,
+            height: 48,
+            decoration: BoxDecoration(
+                color: colors.canvas, borderRadius: BorderRadius.circular(12)),
+            clipBehavior: Clip.antiAlias,
+            child: uri == null
+                ? fallback
+                : Image.network(uri.toString(),
+                    fit: BoxFit.contain,
+                    cacheWidth: 128,
+                    errorBuilder: (_, __, ___) => fallback)));
+  }
+}
+
+class _RadioChoiceDelegate extends SearchDelegate<String?> {
+  _RadioChoiceDelegate(this.choices, String hint,
+      {this.aliases = const <String, String>{}})
+      : super(searchFieldLabel: hint);
+  final Map<String, String> choices;
+  final Map<String, String> aliases;
+  @override
+  List<Widget> buildActions(BuildContext context) => <Widget>[
+        IconButton(
+            tooltip: context.l10n.radioClearSearch,
+            onPressed: () => query = '',
+            icon: const Icon(Icons.clear_rounded)),
+      ];
+  @override
+  Widget buildLeading(BuildContext context) => IconButton(
+      tooltip: MaterialLocalizations.of(context).backButtonTooltip,
+      onPressed: () => close(context, null),
+      icon: const Icon(Icons.arrow_back_rounded));
+  @override
+  Widget buildResults(BuildContext context) => buildSuggestions(context);
+  @override
+  Widget buildSuggestions(BuildContext context) {
+    final colors = AppColors.lumiere(context);
+    final List<MapEntry<String, String>> matches = choices.entries
+        .where(
+          (MapEntry<String, String> item) =>
+              item.value.toLowerCase().contains(query.toLowerCase()) ||
+              item.key.toLowerCase() == query.toLowerCase() ||
+              (aliases[item.key]?.toLowerCase().contains(query.toLowerCase()) ??
+                  false),
+        )
+        .toList(growable: false);
+    if (matches.isEmpty) {
+      return Center(
+          child: Padding(
+              padding: const EdgeInsets.all(24),
+              child: Text(context.l10n.radioNoFilterResults,
+                  textAlign: TextAlign.center,
+                  style: AppTextStyles.bodyLarge
+                      .copyWith(color: colors.textSecondary))));
+    }
+    return ListView.builder(
+        itemCount: matches.length,
+        itemBuilder: (_, int index) {
+          final MapEntry<String, String> item = matches[index];
+          return ListTile(
+              title: Text(item.value,
+                  style: AppTextStyles.bodyLarge
+                      .copyWith(color: colors.textPrimary)),
+              leading: RegExp(r'^[A-Z]{2}$').hasMatch(item.key)
+                  ? Text(item.key,
+                      style: AppTextStyles.bodyMedium
+                          .copyWith(color: colors.textSecondary))
+                  : null,
+              onTap: () => close(context, item.key));
+        });
+  }
+}
