+    // Laisser également les futures de nettoyage du lecteur sortir de la
+    // zone d'horloge simulée avant de vérifier le nouveau rendu.
+    await tester.runAsync(() async => Future<void>.delayed(Duration.zero));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 500));
+    expect(players.first.disposed, isTrue);
+    await tester.pumpAndSettle();
+    expect(find.byTooltip('Arrêter'), findsNothing);
+
+    await _tapVisible(tester, find.byTooltip('Écouter · Studio Nairobi'));
+    expect(players.length, 2);
+    players.last.fail('fixture unavailable');
+    players.last.progress(const Duration(seconds: 3));
+    await tester.pumpAndSettle();
+    expect(find.text('Cette radio est momentanément indisponible.'),
