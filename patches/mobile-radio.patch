+      unawaited(_load(_catalog.query.copyWith(name: text, page: 0)));
+    });
+  }
+
+  Future<void> _choose(String type) async {
+    if (_choosing) return;
+    setState(() => _choosing = true);
+    try {
+      final List<RadioCountry> countries = type == 'country'
+          ? await _catalog.client.countries()
+          : const <RadioCountry>[];
+      final List<String> names = type == 'language'
+          ? await _catalog.client.languages()
+          : type == 'genre'
+              ? await _catalog.client.genres()
+              : <String>[];
+      if (!mounted) return;
+      final Map<String, String> choices = <String, String>{
+        '': type == 'country' ? context.l10n.radioWorld : context.l10n.radioAll,
+        for (final RadioCountry country in countries)
+          country.code: _countryLabel(country.code, country.name),
+        for (final String name in names) name: name,
+      };
+      final String? selected = await showSearch<String?>(
+          context: context,
+          delegate: _RadioChoiceDelegate(
+              choices, context.l10n.radioFilterSearch, aliases: {
+            for (final country in countries) country.code: country.name
+          }));
+      if (selected == null || !mounted) return;
+      _debounce?.cancel();
+      if (type == 'country') _countryName = choices[selected];
+      final RadioQuery next = _catalog.query.copyWith(
+          page: 0,
+          name: _search.text,
+          countryCode: type == 'country' ? selected : null,
+          language: type == 'language' ? selected : null,
+          genre: type == 'genre' ? selected : null);
+      await _load(next);
+    } on RadioFailure catch (failure) {
+      _logFailure('filter.failed', failure.code);
+      if (mounted) _message(_failureText(failure.code));
+    } finally {
