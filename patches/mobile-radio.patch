+  }
+
+  @override
+  void dispose() {
+    _debounce?.cancel();
+    _search.dispose();
+    _catalog.removeListener(_catalogChanged);
+    _catalog.dispose();
+    _playbackGeneration++;
+    unawaited(_disposePlayer());
+    super.dispose();
+  }
+
+  Future<void> _disposePlayer() async {
+    final Player? previous = _player;
+    _player = null;
+    final List<StreamSubscription<dynamic>> listeners = List.of(_subscriptions);
+    _subscriptions.clear();
+    await Future.wait(listeners
+        .map((StreamSubscription<dynamic> listener) => listener.cancel()));
+    try {
+      await previous?.dispose();
+    } catch (_) {
+      _logFailure('playback.dispose', RadioFailureCode.unavailable);
+    }
+  }
