+
+  testWidgets('capture du vrai écran Flutter avec catalogue de démonstration',
+      (WidgetTester tester) async {
+    const String path = String.fromEnvironment('RADIO_PREVIEW_PATH');
+    final GlobalKey capture = GlobalKey();
+    await _mount(tester, _FixtureRadioClient(),
+        captureKey: capture, size: const Size(430, 932));
+    expect(tester.takeException(), isNull);
+    if (path.isEmpty) return;
+    final RenderRepaintBoundary boundary =
+        capture.currentContext!.findRenderObject()! as RenderRepaintBoundary;
