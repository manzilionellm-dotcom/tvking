+// Fixtures d'interface uniquement. Les tests radio_browser_http_test utilisent
+// déjà un vrai serveur HTTP : ici nous vérifions les gestes, pas le transport.
+// Aucun flux natif ni logo distant n'est ouvert par ces scénarios.
+String _id(int n) => '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}';
+
+RadioStation _station(int n, String name, String country) => RadioStation(
+      id: _id(n),
+      name: name,
+      streamUri: Uri.parse('https://radio.invalid/fixture/$n'),
+      countryCode: country,
+      language: country == 'RW' ? 'kinyarwanda' : 'français',
+      tags: 'musique',
+      codec: 'MP3',
+      bitrate: 128,
+    );
+
+class _FixtureRadioClient extends RadioBrowserClient {
+  final List<RadioQuery> searches = <RadioQuery>[];
+  final List<List<String>> savedRequests = <List<String>>[];
+  final List<RadioStation> fixtures = <RadioStation>[
+    _station(1, 'Studio Kigali', 'RW'),
+    _station(2, 'Studio Nairobi', 'KE'),
+    _station(3, 'Studio Paris', 'FR'),
+  ];
+  Completer<RadioPage>? holdNextSaved;
+
+  @override
+  Future<RadioPage> search(RadioQuery query) async {
+    searches.add(query);
+    return RadioPage(
+        fixtures
+            .where((RadioStation station) =>
+                query.countryCode.isEmpty ||
+                station.countryCode == query.countryCode)
+            .toList(growable: false),
+        hasNext: false);
+  }
+
+  @override
+  Future<RadioPage> favorites(List<String> ids, int page) async {
+    savedRequests.add(List<String>.of(ids));
+    final Completer<RadioPage>? held = holdNextSaved;
+    holdNextSaved = null;
+    if (held != null) return held.future;
+    return RadioPage(<RadioStation>[
+      for (final String id in ids)
+        ...fixtures.where((RadioStation station) => station.id == id),
+    ], hasNext: false);
+  }
+
+  @override
+  Future<List<RadioCountry>> countries() async => const <RadioCountry>[
+        RadioCountry('RW', 'Rwanda'),
+        RadioCountry('KE', 'Kenya'),
+        RadioCountry('FR', 'France'),
+      ];
+}
+
+// Uniquement les événements publics de media_kit, sans bibliothèque native.
+// Une fermeture retenue permet de reproduire les courses stop/zapping réelles.
+class _FixturePlayer extends PlatformPlayer {
+  _FixturePlayer() : super(configuration: const PlayerConfiguration());
+  Completer<void>? holdDispose;
+  bool disposing = false;
+  bool disposed = false;
+
+  void progress(Duration position) => positionController.add(position);
+  void fail(String message) => errorController.add(message);
+
+  @override
+  Future<void> open(Playable playable, {bool play = true}) async {
+    final Media media = playable as Media;
+    state = state.copyWith(playlist: Playlist(<Media>[media]), playing: play);
+    playingController.add(play);
+    bufferingController.add(false);
+  }
+
+  @override
+  Future<void> dispose() async {
+    disposing = true;
+    await holdDispose?.future;
+    await super.dispose();
+    disposed = true;
+  }
+}
+
+Future<void> _mount(WidgetTester tester, _FixtureRadioClient client,
+    {Size size = const Size(390, 844),
+    double scale = 1,
+    GlobalKey? captureKey,
+    Locale locale = const Locale('fr'),
+    Player Function()? playerFactory}) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = size;
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  await tester.pumpWidget(RepaintBoundary(
+    key: captureKey,
+    child: MaterialApp(
+      debugShowCheckedModeBanner: false,
+      locale: locale,
+      supportedLocales: AppLocalizations.supportedLocales,
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      theme: AppTheme.cinema,
+      builder: (BuildContext context, Widget? child) => MediaQuery(
+        data: MediaQuery.of(context)
+            .copyWith(textScaler: TextScaler.linear(scale)),
+        child: child!,
+      ),
+      home: RadioScreen(client: client, playerFactory: playerFactory),
+    ),
+  ));
+  await tester.pumpAndSettle();
+}
+
+Finder _collection(String name) => find.widgetWithText(ChoiceChip, name);
+
+Future<void> _tapVisible(WidgetTester tester, Finder target) async {
+  await tester.ensureVisible(target);
+  await tester.pumpAndSettle();
+  await tester.tap(target);
+  await tester.pumpAndSettle();
+}
+
+void main() {
