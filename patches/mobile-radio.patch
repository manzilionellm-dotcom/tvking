+import 'package:flutter/material.dart';
+
+import '../../../core/app/repair_flags.dart';
+import '../../../core/i18n/l10n_extension.dart';
+import '../../../core/theme/app_colors.dart';
+import '../../../core/theme/app_text_styles.dart';
+import 'radio_screen.dart';
+
+// Accessible même sans playlist : la radio utilise un catalogue public distinct.
+// Le repli enlève toute l'entrée et ne crée ni lecteur ni appel réseau.
+class RadioEntry extends StatelessWidget {
+  const RadioEntry({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    if (RepairFlags.mobileRadioLegacy) return const SizedBox.shrink();
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+      child: Material(
+        color: AppColors.surfaceHigh,
+        borderRadius: BorderRadius.circular(16),
+        child: ListTile(
+          leading: Icon(Icons.radio_rounded, color: AppColors.accent),
+          title: Text(context.l10n.radioTitle, style: AppTextStyles.bodyLarge),
+          subtitle: Text(context.l10n.radioEntryHint, style: AppTextStyles.bodySmall),
+          trailing: const Icon(Icons.chevron_right_rounded),
+          onTap: () => Navigator.of(context).push<void>(MaterialPageRoute<void>(
+            builder: (_) => const RadioScreen(),
+          )),
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/features/radio/presentation/radio_screen.dart b/lib/features/radio/presentation/radio_screen.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/radio/presentation/radio_screen.dart
@@ -0,0 +1,417 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:media_kit/media_kit.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../../../core/i18n/l10n_extension.dart';
+import '../../../core/observability/structured_logger.dart';
+import '../../../core/profiles/profiles_repository.dart';
+import '../../../core/theme/app_colors.dart';
+import '../../../core/theme/app_text_styles.dart';
+import '../data/radio_browser_client.dart';
+import '../data/radio_catalog_controller.dart';
+import '../data/radio_favorites_store.dart';
+import '../domain/radio_station.dart';
+
+class RadioScreen extends StatefulWidget {
+  const RadioScreen({super.key, this.client});
+  // Les tests utilisent un vrai serveur HTTP local, pas un catalogue simulé.
+  final RadioBrowserClient? client;
+  @override
+  State<RadioScreen> createState() => _RadioScreenState();
+}
+
+class _RadioScreenState extends State<RadioScreen> {
+  late final RadioCatalogController _catalog;
+  final TextEditingController _search = TextEditingController();
+  Timer? _debounce;
+  RadioFavoritesStore? _favorites;
+  List<String> _favoriteIds = <String>[];
+  bool _onlyFavorites = false;
+  bool _saving = false;
+  bool _choosing = false;
+  String? _countryName;
+  Player? _player;
+  RadioStation? _current;
+  bool _playing = false;
+  bool _buffering = false;
+  bool _opening = false;
+  bool _playbackError = false;
+  final List<StreamSubscription<dynamic>> _subscriptions = <StreamSubscription<dynamic>>[];
+
+  @override
+  void initState() {
+    super.initState();
+    _catalog = RadioCatalogController(widget.client ?? RadioBrowserClient());
+    _catalog.addListener(_catalogChanged);
+    unawaited(_initialize());
+  }
+
+  Future<void> _initialize() async {
+    try {
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      if (!mounted) return;
+      _favorites = RadioFavoritesStore(prefs,
+        profileSuffix: ProfilesRepository.instance.keySuffix);
+      setState(() => _favoriteIds = _favorites!.read());
+    } catch (_) {
+      // Le catalogue reste accessible ; le bouton favori reste désactivé.
+      _logFailure('favorites.load', RadioFailureCode.favoritesUnavailable);
+    }
+    if (mounted) await _load(const RadioQuery());
+  }
+
+  void _catalogChanged() {
+    if (mounted) setState(() {});
+  }
+
+  Future<void> _load(RadioQuery query) async {
+    await _catalog.load(query, favorites: _onlyFavorites ? _favoriteIds : null);
+    if (!mounted) return;
+    if (_catalog.error != null) {
+      _logFailure('catalog.failed', _catalog.error!);
+    } else {
+      // Aucun nom de station ni adresse de diffusion n'entre dans le journal.
+      StructuredLogger.instance.info(domain: 'radio', event: 'catalog.loaded',
+        ctx: <String, Object?>{'count': _catalog.stations.length, 'page': query.page + 1});
+    }
+  }
+
+  void _scheduleSearch(String text) {
+    _debounce?.cancel();
+    _debounce = Timer(const Duration(milliseconds: 400), () {
+      unawaited(_load(_catalog.query.copyWith(name: text, page: 0)));
+    });
+  }
+
+  Future<void> _choose(String type) async {
+    if (_choosing) return;
+    setState(() => _choosing = true);
+    try {
+      final List<RadioCountry> countries = type == 'country'
+          ? await _catalog.client.countries() : const <RadioCountry>[];
+      final List<String> names = type == 'language'
+          ? await _catalog.client.languages() : type == 'genre'
+          ? await _catalog.client.genres() : <String>[];
+      if (!mounted) return;
+      final Map<String, String> choices = <String, String>{
+        '': context.l10n.radioAll,
+        for (final RadioCountry country in countries) country.code: country.name,
+        for (final String name in names) name: name,
+      };
+      final String? selected = await showSearch<String?>(context: context,
+        delegate: _RadioChoiceDelegate(choices, context.l10n.radioFilterSearch));
+      if (selected == null || !mounted) return;
+      _debounce?.cancel();
+      if (type == 'country') _countryName = choices[selected];
+      final RadioQuery next = _catalog.query.copyWith(page: 0, name: _search.text,
+        countryCode: type == 'country' ? selected : null,
+        language: type == 'language' ? selected : null,
+        genre: type == 'genre' ? selected : null);
+      await _load(next);
+    } on RadioFailure catch (failure) {
+      _logFailure('filter.failed', failure.code);
+      if (mounted) _message(_failureText(failure.code));
+    } finally {
+      if (mounted) setState(() => _choosing = false);
+    }
+  }
+
+  Future<void> _toggleFavorite(RadioStation station) async {
+    if (_saving || _favorites == null) return;
+    final List<String> next = List<String>.of(_favoriteIds);
+    if (!next.remove(station.id)) next.add(station.id);
+    setState(() => _saving = true);
+    try {
+      await _favorites!.write(next);
+      if (!mounted) return;
+      setState(() => _favoriteIds = _favorites!.read());
+      if (_onlyFavorites) await _load(_catalog.query.copyWith(page: 0));
+    } catch (_) {
+      _logFailure('favorites.save', RadioFailureCode.favoritesUnavailable);
+      if (mounted) _message(context.l10n.radioFavoritesFailed);
+    } finally {
+      if (mounted) setState(() => _saving = false);
+    }
+  }
+
+  Player _ensurePlayer() {
+    if (_player != null) return _player!;
+    final Player player = Player(configuration: const PlayerConfiguration(
+      title: '7 MOTION Radio', logLevel: MPVLogLevel.error,
+    ));
+    _player = player;
+    _subscriptions.add(player.stream.playing.listen((bool value) {
+      if (mounted) setState(() => _playing = value);
+    }));
+    _subscriptions.add(player.stream.buffering.listen((bool value) {
+      if (mounted) setState(() => _buffering = value);
+    }));
+    _subscriptions.add(player.stream.error.listen((String _) {
+      // Les messages natifs peuvent inclure l'adresse : on ne les recopie pas.
+      if (mounted) setState(() => _playbackError = true);
+      _logFailure('playback.failed', RadioFailureCode.unavailable);
+    }));
+    return player;
+  }
+
+  Future<void> _play(RadioStation station) async {
+    if (_opening) return;
+    setState(() {
+      _current = station;
+      _opening = true;
+      _playbackError = false;
+    });
+    try {
+      await _ensurePlayer().open(Media(station.streamUri.toString()));
+      StructuredLogger.instance.info(domain: 'radio', event: 'playback.requested');
+    } catch (_) {
+      if (mounted) setState(() => _playbackError = true);
+      _logFailure('playback.failed', RadioFailureCode.unavailable);
+    } finally {
+      if (mounted) setState(() => _opening = false);
+    }
+  }
+
+  Future<void> _pauseOrResume() async {
+    try {
+      if (_playbackError && _current != null) {
+        await _play(_current!);
+      } else {
+        await _player?.playOrPause();
+      }
+    } catch (_) {
+      if (mounted) setState(() => _playbackError = true);
+      _logFailure('playback.control', RadioFailureCode.unavailable);
+    }
+  }
+
+  Future<void> _stop() async {
+    try {
+      await _player?.stop();
+      if (mounted) setState(() {
+        _current = null;
+        _playbackError = false;
+      });
+    } catch (_) {
+      _logFailure('playback.stop', RadioFailureCode.unavailable);
+    }
+  }
+
+  void _logFailure(String event, RadioFailureCode code) {
+    StructuredLogger.instance.warn(domain: 'radio', event: event,
+      ctx: <String, Object?>{'reason': switch (code) {
+        RadioFailureCode.offline => 'Radio : aucune connexion au catalogue',
+        RadioFailureCode.timeout => 'Radio : délai de réponse dépassé',
+        RadioFailureCode.invalidResponse => 'Radio : réponse du catalogue invalide',
+        RadioFailureCode.responseTooLarge => 'Radio : réponse du catalogue trop volumineuse',
+        RadioFailureCode.favoritesUnavailable => 'Radio : favoris non enregistrés',
+        RadioFailureCode.disabled => 'Radio : repli activé, catalogue coupé',
+        RadioFailureCode.unavailable => event.startsWith('playback')
+          ? 'Radio : station indisponible ou format non lisible'
+          : 'Radio : catalogue temporairement indisponible',
+      }});
+  }
+
+  void _message(String text) {
+    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
+  }
+
+  String _failureText(RadioFailureCode code) {
+    final l = context.l10n;
+    return switch (code) {
+      RadioFailureCode.offline => l.radioOffline,
+      RadioFailureCode.timeout => l.radioTimeout,
+      RadioFailureCode.invalidResponse || RadioFailureCode.responseTooLarge => l.radioInvalidResponse,
+      RadioFailureCode.favoritesUnavailable => l.radioFavoritesFailed,
+      RadioFailureCode.disabled => l.radioDisabled,
+      RadioFailureCode.unavailable => l.radioUnavailable,
+    };
+  }
+
+  @override
+  void dispose() {
+    _debounce?.cancel();
+    _search.dispose();
+    _catalog.removeListener(_catalogChanged);
+    _catalog.dispose();
+    for (final StreamSubscription<dynamic> subscription in _subscriptions) {
+      unawaited(subscription.cancel());
+    }
+    unawaited(_disposePlayer());
+    super.dispose();
+  }
+
+  Future<void> _disposePlayer() async {
+    try {
+      await _player?.dispose();
+    } catch (_) {
+      _logFailure('playback.dispose', RadioFailureCode.unavailable);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = context.l10n;
+    final RadioQuery query = _catalog.query;
+    return Scaffold(
+      backgroundColor: AppColors.background,
+      appBar: AppBar(title: Text(l.radioTitle, style: AppTextStyles.headlineMedium),
+        actions: <Widget>[IconButton(tooltip: l.radioRefresh,
+          onPressed: _catalog.loading ? null : () => unawaited(_load(query)),
+          icon: const Icon(Icons.refresh_rounded))]),
+      body: SafeArea(child: Column(children: <Widget>[
+        Padding(padding: const EdgeInsets.fromLTRB(16, 8, 16, 4), child: Text(
+          l.radioCatalogNote, style: AppTextStyles.bodySmall)),
+        Padding(padding: const EdgeInsets.all(12), child: TextField(
+          controller: _search, enabled: !_onlyFavorites,
+          style: AppTextStyles.bodyLarge, onChanged: _scheduleSearch,
+          decoration: InputDecoration(hintText: l.radioSearchHint,
+            prefixIcon: const Icon(Icons.search_rounded), border: OutlineInputBorder(
+              borderRadius: BorderRadius.circular(16))),
+        )),
+        Padding(padding: const EdgeInsets.symmetric(horizontal: 12), child: Wrap(
+          spacing: 8, runSpacing: 4, children: <Widget>[
+            FilterChip(label: Text(l.radioFavorites), selected: _onlyFavorites,
+              avatar: const Icon(Icons.favorite_border_rounded),
+              onSelected: (_) {
+                _debounce?.cancel();
+                setState(() => _onlyFavorites = !_onlyFavorites);
+                unawaited(_load(query.copyWith(page: 0)));
+              }),
+            if (!_onlyFavorites) ...<Widget>[
+              ActionChip(label: Text(query.countryCode.isEmpty ? l.radioCountry
+                : (_countryName ?? query.countryCode)),
+                avatar: const Icon(Icons.public_rounded),
+                onPressed: _choosing ? null : () => unawaited(_choose('country'))),
+              ActionChip(label: Text(query.language.isEmpty ? l.radioLanguage : query.language),
+                onPressed: _choosing ? null : () => unawaited(_choose('language'))),
+              ActionChip(label: Text(query.genre.isEmpty ? l.radioGenre : query.genre),
+                onPressed: _choosing ? null : () => unawaited(_choose('genre'))),
+            ],
+          ],
+        )),
+        if (_choosing) const LinearProgressIndicator(),
+        Expanded(child: _catalog.loading
+          ? const Center(child: CircularProgressIndicator())
+          : _catalog.error != null ? _status(_failureText(_catalog.error!), retry: true)
+          : _catalog.stations.isEmpty ? _status(_onlyFavorites ? l.radioNoFavorites : l.radioNoResults)
+          : ListView.builder(key: const Key('radio-stations'), padding: const EdgeInsets.all(12),
+            itemCount: _catalog.stations.length,
+            itemBuilder: (BuildContext context, int index) {
+              final RadioStation station = _catalog.stations[index];
+              final bool favorite = _favoriteIds.contains(station.id);
+              return Card(color: AppColors.surface, child: ListTile(
+                leading: _StationLogo(station.logoUri),
+                title: Text(station.name, maxLines: 1, overflow: TextOverflow.ellipsis,
+                  style: AppTextStyles.bodyLarge),
+                subtitle: Text(<String>[
+                  if (station.countryCode.isNotEmpty) station.countryCode,
+                  if (station.language.isNotEmpty) station.language,
+                  if (station.codec.isNotEmpty) station.codec,
+                  if (station.bitrate > 0) '${station.bitrate} kbps',
+                ].join(' · '), maxLines: 2, overflow: TextOverflow.ellipsis,
+                  style: AppTextStyles.bodySmall),
+                onTap: _opening ? null : () => unawaited(_play(station)),
+                trailing: IconButton(tooltip: favorite ? l.radioRemoveFavorite : l.radioAddFavorite,
+                  onPressed: _saving || _favorites == null ? null
+                    : () => unawaited(_toggleFavorite(station)),
+                  icon: Icon(favorite ? Icons.favorite_rounded : Icons.favorite_border_rounded,
+                    color: favorite ? AppColors.accent : AppColors.textSecondary)),
+              ));
+            },
+          )),
+        if (!_catalog.loading && _catalog.error == null)
+          Padding(padding: const EdgeInsets.symmetric(horizontal: 12), child: Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween, children: <Widget>[
+              IconButton(tooltip: l.radioPrevious,
+                onPressed: query.page == 0 ? null : () => unawaited(_load(query.copyWith(page: query.page - 1))),
+                icon: const Icon(Icons.chevron_left_rounded)),
+              Text(l.radioPage(query.page + 1), style: AppTextStyles.labelSmall),
+              IconButton(tooltip: l.radioNext,
+                onPressed: !_catalog.hasNext ? null : () => unawaited(_load(query.copyWith(page: query.page + 1))),
+                icon: const Icon(Icons.chevron_right_rounded)),
+            ])),
+        if (_current != null) _nowPlaying(),
+        Padding(padding: const EdgeInsets.all(8), child: Text(l.radioAttribution,
+          style: AppTextStyles.bodySmall)),
+      ])),
+    );
+  }
+
+  Widget _status(String message, {bool retry = false}) => Center(child: Padding(
+    padding: const EdgeInsets.all(24), child: Column(mainAxisSize: MainAxisSize.min,
+      children: <Widget>[
+        Icon(Icons.radio_rounded, color: AppColors.textSecondary, size: 48),
+        const SizedBox(height: 12),
+        Text(message, textAlign: TextAlign.center, style: AppTextStyles.bodyMedium),
+        if (retry) TextButton(onPressed: () => unawaited(_load(_catalog.query)),
+          child: Text(context.l10n.radioRetry)),
+      ]),
+  ));
+
+  Widget _nowPlaying() {
+    final l = context.l10n;
+    final RadioStation station = _current!;
+    return Material(color: AppColors.surfaceHigh, child: Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+      child: Row(children: <Widget>[
+        _StationLogo(station.logoUri), const SizedBox(width: 12),
+        Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start,
+          children: <Widget>[
+            Text(station.name, maxLines: 1, overflow: TextOverflow.ellipsis,
+              style: AppTextStyles.bodyLarge),
+            Text(_playbackError ? l.radioPlaybackFailed : _opening || _buffering
+              ? l.radioConnecting : _playing ? l.radioLive : l.radioPaused,
+              style: AppTextStyles.bodySmall),
+          ])),
+        IconButton(tooltip: _playing ? l.radioPause : l.radioListen,
+          onPressed: _opening ? null : () => unawaited(_pauseOrResume()),
+          icon: Icon(_playbackError ? Icons.refresh_rounded : _playing
+            ? Icons.pause_rounded : Icons.play_arrow_rounded)),
+        IconButton(tooltip: l.radioStop, onPressed: () => unawaited(_stop()),
+          icon: const Icon(Icons.stop_rounded)),
+      ]),
+    ));
+  }
+}
+
+class _StationLogo extends StatelessWidget {
+  const _StationLogo(this.uri);
+  final Uri? uri;
+  @override
+  Widget build(BuildContext context) {
+    final Widget fallback = Icon(Icons.radio_rounded, color: AppColors.accent);
+    return SizedBox(width: 44, height: 44, child: ClipRRect(
+      borderRadius: BorderRadius.circular(10), child: uri == null ? fallback
+        : Image.network(uri.toString(), fit: BoxFit.contain, cacheWidth: 96,
+          errorBuilder: (_, __, ___) => fallback),
+    ));
+  }
+}
+
+class _RadioChoiceDelegate extends SearchDelegate<String?> {
+  _RadioChoiceDelegate(this.choices, String hint) : super(searchFieldLabel: hint);
+  final Map<String, String> choices;
+  @override
+  List<Widget> buildActions(BuildContext context) => <Widget>[
+    IconButton(onPressed: () => query = '', icon: const Icon(Icons.clear_rounded)),
+  ];
+  @override
+  Widget buildLeading(BuildContext context) => IconButton(
+    onPressed: () => close(context, null), icon: const Icon(Icons.arrow_back_rounded));
+  @override
+  Widget buildResults(BuildContext context) => buildSuggestions(context);
+  @override
+  Widget buildSuggestions(BuildContext context) {
+    final List<MapEntry<String, String>> matches = choices.entries.where(
+      (MapEntry<String, String> item) => item.value.toLowerCase().contains(query.toLowerCase()),
+    ).toList(growable: false);
+    return ListView.builder(itemCount: matches.length, itemBuilder: (_, int index) {
+      final MapEntry<String, String> item = matches[index];
+      return ListTile(title: Text(item.value, style: AppTextStyles.bodyLarge),
+        onTap: () => close(context, item.key));
+    });
+  }
+}
