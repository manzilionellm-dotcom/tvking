index 0000000..af739ac
--- /dev/null
+++ b/lib/features/mobile_services/data/background_guide.dart
@@ -0,0 +1,128 @@
+import 'dart:io';
+import 'dart:ui';
+
+import 'package:flutter/widgets.dart';
+import 'package:http/http.dart' as http;
+import 'package:path_provider/path_provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:workmanager/workmanager.dart';
+
+import '../../../core/flavor/flavor.dart';
+import '../../epg/data/epg_repository.dart';
+import '../../playlists/data/playlist_database.dart';
+import '../../playlists/data/playlist_repository.dart';
+import '../../playlists/domain/playlist.dart';
+
+/// Le guide seulement : aucune route panel, aucun changement de source,
+/// d'abonnement ou de chaîne. Le système choisit l'heure d'exécution.
+@pragma('vm:entry-point')
+void mobileGuideDispatcher() {
+  Workmanager().executeTask((String task, Map<String, dynamic>? input) async {
+    WidgetsFlutterBinding.ensureInitialized();
+    DartPluginRegistrant.ensureInitialized();
+    if (task != BackgroundGuide.taskName) return true;
+    try {
+      final SharedPreferences p = await SharedPreferences.getInstance();
+      await p.reload();
+      if (p.getBool('mobile.background_guide') != true ||
+          await BackgroundGuide.foreground())
+        return true;
+      FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+      final List<Playlist> playlists = await PlaylistRepository.instance
+          .getAllPlaylists();
+      for (final Playlist playlist
+          in playlists
+              .where((Playlist p) => !p.hidden && p.epgUrl?.isNotEmpty == true)
+              .take(2)) {
+        if (await BackgroundGuide.foreground()) break;
+        // La base mobile possède déjà ses alias Xtream : le moteur EPG
+        // existant les relit. Aucune source ni liste n'est rechargée ici.
+        final rows = await (await PlaylistDatabase.instance.database).query(
+          'channels',
+          columns: <String>['external_id'],
+          where: 'playlist_id = ?',
+          whereArgs: <Object?>[playlist.id],
+        );
+        final Set<String> ids = rows
+            .map((Map<String, Object?> r) => r['external_id'] as String)
+            .toSet();
+        if (ids.isEmpty) continue;
+        final http.Client client = http.Client();
+        try {
+          await EpgRepository.instance
+              .downloadAndImport(
+                url: playlist.epgUrl!,
+                knownChannelIds: ids,
+                httpClient: client,
+              )
+              .timeout(const Duration(minutes: 4));
+        } finally {
+          client.close();
+        }
+      }
+      await p.setInt(
+        'mobile.background_guide_last',
+        DateTime.now().millisecondsSinceEpoch,
+      );
+      return true;
+    } catch (_) {
+      return false;
+    }
+  });
+}
+
+class BackgroundGuide {
+  static const String taskName = '7motion.guide.refresh';
+  static bool _ready = false;
+  static Future<File> _lease() async => File(
+    '${(await getApplicationSupportDirectory()).path}/mobile-foreground.lease',
+  );
+  static Future<void> markForeground(bool value) async {
+    try {
+      await (await _lease()).writeAsString(
+        value ? '${DateTime.now().millisecondsSinceEpoch}' : '0',
+        flush: true,
+      );
+    } catch (_) {}
+  }
+
+  static Future<bool> foreground() async {
+    final File f = await _lease();
+    if (!await f.exists()) return false;
+    final int at = int.tryParse(await f.readAsString()) ?? 0;
+    return DateTime.now().millisecondsSinceEpoch - at < 90000;
+  }
+
+  static Future<bool> enabled() async =>
+      (await SharedPreferences.getInstance()).getBool(
+        'mobile.background_guide',
+      ) ??
+      false;
+  static Future<void> configure(bool value) async {
+    if (!Platform.isAndroid)
+      throw StateError('Actualisation en arrière-plan disponible sur Android.');
+    if (!_ready) {
+      await Workmanager().initialize(mobileGuideDispatcher);
+      _ready = true;
+    }
+    if (value) {
+      await Workmanager().registerPeriodicTask(
+        taskName,
+        taskName,
+        frequency: const Duration(hours: 6),
+        initialDelay: const Duration(minutes: 20),
+        constraints: Constraints(
+          networkType: NetworkType.unmetered,
+          requiresBatteryNotLow: true,
+        ),
+        existingWorkPolicy: ExistingPeriodicWorkPolicy.keep,
+      );
+    } else {
+      await Workmanager().cancelByUniqueName(taskName);
+    }
+    await (await SharedPreferences.getInstance()).setBool(
+      'mobile.background_guide',
+      value,
+    );
+  }
+}
diff --git a/lib/features/mobile_services/data/mobile_services.dart b/lib/features/mobile_services/data/mobile_services.dart
new file mode 100644
index 0000000..83a7c65
--- /dev/null
+++ b/lib/features/mobile_services/data/mobile_services.dart
@@ -0,0 +1,160 @@
+// Services facultatifs, indépendants du canal panel. Les clés ci-dessous
+// sont des clés SDK publiques : aucun secret serveur n'entre dans l'APK.
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:growthbook_sdk_flutter/growthbook_sdk_flutter.dart';
+import 'package:posthog_flutter/posthog_flutter.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../../support/data/support_repository.dart';
+
+class MobileServices extends ChangeNotifier {
+  MobileServices._();
+  static final MobileServices instance = MobileServices._();
+  static const String growthKey = String.fromEnvironment(
+    'GROWTHBOOK_CLIENT_KEY',
+  );
+  static const String growthHost = String.fromEnvironment(
+    'GROWTHBOOK_HOST',
+    defaultValue: 'https://cdn.growthbook.io',
+  );
+  static const String posthogKey = String.fromEnvironment(
+    'POSTHOG_PROJECT_KEY',
+  );
+  static const String posthogHost = String.fromEnvironment(
+    'POSTHOG_HOST',
+    defaultValue: 'https://eu.i.posthog.com',
+  );
+  bool wifiDownloads = true;
+  bool analyticsConsent = false;
+  bool visualMotion = true;
+  Future<void>? _initializing;
+  bool _analyticsReady = false;
+  GrowthBookSDK? _growth;
+  static bool httpsHost(String value) {
+    final Uri? u = Uri.tryParse(value);
+    return u != null &&
+        u.scheme == 'https' &&
+        u.host.isNotEmpty &&
+        u.userInfo.isEmpty;
+  }
+
+  Future<void> initialize() => _initializing ??= _initialize();
+
+  Future<void> _initialize() async {
+    try {
+      final SharedPreferences p = await SharedPreferences.getInstance();
+      wifiDownloads = p.getBool('mobile.wifi_downloads') ?? true;
+      analyticsConsent = p.getBool('mobile.analytics_consent') ?? false;
+      visualMotion = p.getBool('mobile.visual_motion') ?? true;
+      notifyListeners();
+      if (analyticsConsent) unawaited(_startAnalytics());
+      unawaited(_startExperiments(p));
+    } catch (_) {
+      /* Une panne de service externe ne bloque pas l'app. */
+    }
+  }
+
+  Future<void> _startExperiments(SharedPreferences p) async {
+    try {
+      if (growthKey.isNotEmpty && httpsHost(growthHost)) {
+        final String id =
+            p.getString('mobile.experiment_id') ??
+            SupportRepository.newMessageId();
+        await p.setString('mobile.experiment_id', id);
+        _growth = await GBSDKBuilderApp(
+          hostURL: growthHost,
+          apiKey: growthKey,
+          attributes: <String, dynamic>{
+            'id': id,
+            'platform': defaultTargetPlatform.name,
+          },
+          backgroundSync: false,
+          growthBookTrackingCallBack: (_) {},
+        ).initialize().timeout(const Duration(seconds: 8));
+        // Le seul interrupteur distant concerne l'animation des pubs.
+        // Activation, source, réseau et chat ne sont jamais pilotés ici.
+        notifyListeners();
+      }
+    } catch (_) {
+      /* La présentation reste disponible hors ligne. */
+    }
+  }
+
+  bool get allowVisualMotion {
+    if (!visualMotion) return false;
+    final Object? value = _growth?.feature('motion_ads_3d').value;
+    return value is bool ? value : true;
+  }
+
+  Future<void> setWifiDownloads(bool value) async {
+    wifiDownloads = value;
+    await (await SharedPreferences.getInstance()).setBool(
+      'mobile.wifi_downloads',
+      value,
+    );
+    notifyListeners();
+  }
+
+  Future<void> setVisualMotion(bool value) async {
+    visualMotion = value;
+    await (await SharedPreferences.getInstance()).setBool(
+      'mobile.visual_motion',
+      value,
+    );
+    notifyListeners();
+  }
+
+  Future<void> setAnalytics(bool value) async {
+    analyticsConsent = value;
+    await (await SharedPreferences.getInstance()).setBool(
+      'mobile.analytics_consent',
+      value,
+    );
+    if (value) {
+      await _startAnalytics();
+    } else if (_analyticsReady) {
+      await Posthog().optOut();
+    }
+    notifyListeners();
+  }
+
+  Future<void> _startAnalytics() async {
+    if (posthogKey.isEmpty || !httpsHost(posthogHost) || !analyticsConsent)
+      return;
+    try {
+      if (!_analyticsReady) {
+        final PostHogConfig config = PostHogConfig(posthogKey)
+          ..host = posthogHost
+          ..captureApplicationLifecycleEvents = false
+          ..sessionReplay = false;
+        await Posthog().setup(config);
+        _analyticsReady = true;
+      }
+      if (analyticsConsent)
+        await Posthog().optIn();
+      else
+        await Posthog().optOut();
+    } catch (_) {
+      /* Aucun événement si le service n'est pas disponible. */
+    }
+  }
+
+  Future<void> used(String feature) async {
+    if (!_analyticsReady ||
+        !analyticsConsent ||
+        !<String>[
+          'download_started',
+          'studio_opened',
+          'guide_background_enabled',
+        ].contains(feature))
+      return;
+    try {
+      await Posthog().capture(
+        eventName: 'mobile_feature_used',
+        properties: <String, Object>{'feature': feature},
+      );
+    } catch (_) {}
+  }
+}
