+
+String stamp(DateTime d) => '${d.year}${d.month.toString().padLeft(2, '0')}${d.day.toString().padLeft(2, '0')}'
+    '${d.hour.toString().padLeft(2, '0')}${d.minute.toString().padLeft(2, '0')}00 +0000';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  SharedPreferences.setMockInitialValues(<String, Object>{});
+  test('deux imports concurrents sont servis et un tvg-id partagé ne mélange pas leurs programmes', () async {
+    final db = await databaseFactoryFfi.openDatabase(inMemoryDatabasePath);
+    await PlaylistDatabase.instance.debugCreate(db);
+    PlaylistDatabase.instance.debugUseDatabase(db);
+    addTearDown(() async { PlaylistDatabase.instance.debugUseDatabase(null); await db.close(); });
+    final epg = EpgRepository.instance;
+    await epg.saveAliases(<String, List<String>>{'shared.tv': <String>['xtream-1@p1', 'xtream-1@p2']});
+    final firstStarted = Completer<void>();
+    final releaseFirst = Completer<void>();
+    final now = DateTime.now().toUtc();
+    final client = MockClient((http.Request req) async {
+      if (req.url.host == 'one.invalid') { firstStarted.complete(); await releaseFirst.future; }
+      final xml = '<tv><programme start="${stamp(now.subtract(const Duration(minutes: 10)))}" '
+          'stop="${stamp(now.add(const Duration(hours: 1)))}" channel="shared.tv">'
+          '<title>${req.url.host}</title></programme></tv>';
+      return http.Response(xml, 200);
+    });
+    addTearDown(client.close);
+    final first = epg.downloadAndImport(url: 'https://one.invalid/guide', knownChannelIds: <String>{'xtream-1@p1'}, httpClient: client);
+    await firstStarted.future;
+    final second = epg.downloadAndImport(url: 'https://two.invalid/guide', knownChannelIds: <String>{'xtream-1@p2'}, httpClient: client);
+    releaseFirst.complete();
+    expect(await Future.wait(<Future<int>>[first, second]), <int>[1, 1]);
+    final rows = await db.query('epg_programs', orderBy: 'channel_id');
+    expect(rows, hasLength(2));
+    expect(rows.first['channel_id'], 'xtream-1@p1');
+    expect(rows.first['title'], 'one.invalid');
+    expect(rows.last['channel_id'], 'xtream-1@p2');
+    expect(rows.last['title'], 'two.invalid');
+  });
+}
