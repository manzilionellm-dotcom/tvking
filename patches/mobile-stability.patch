diff --git a/lib/features/epg/data/xmltv_transport.dart b/lib/features/epg/data/xmltv_transport.dart
new file mode 100644
index 00000000..e8a53a31
--- /dev/null
+++ b/lib/features/epg/data/xmltv_transport.dart
@@ -0,0 +1,33 @@
+import 'dart:async';
+import 'dart:io';
+
+/// Décompresse seulement des octets réellement gzip. HttpClient peut déjà
+/// avoir décompressé la réponse tout en conservant Content-Encoding: gzip.
+/// Se fier à cet en-tête ou au suffixe .gz provoquait une seconde inflation
+/// et « Filter error, bad data ». Deux octets suffisent ; le guide entier
+/// reste un flux, jamais une allocation de plusieurs centaines de Mo.
+Stream<List<int>> decodeXmltvTransport(Stream<List<int>> source) async* {
+  final StreamIterator<List<int>> input = StreamIterator<List<int>>(source);
+  final List<List<int>> prefix = <List<int>>[];
+  final List<int> signature = <int>[];
+  try {
+    while (signature.length < 2 && await input.moveNext()) {
+      final List<int> chunk = input.current;
+      if (chunk.isEmpty) continue;
+      prefix.add(chunk);
+      signature.addAll(chunk.take(2 - signature.length));
+    }
+    Stream<List<int>> replay() async* {
+      for (final List<int> chunk in prefix) { yield chunk; }
+      while (await input.moveNext()) { yield input.current; }
+    }
+    final Stream<List<int>> bytes = replay();
+    if (signature.length == 2 && signature[0] == 0x1f && signature[1] == 0x8b) {
+      yield* bytes.transform<List<int>>(gzip.decoder);
+    } else {
+      yield* bytes;
+    }
+  } finally {
+    await input.cancel();
+  }
+}
