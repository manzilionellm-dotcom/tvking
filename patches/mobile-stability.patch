@@ -0,0 +1,92 @@
+import 'dart:convert';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+// ignore: depend_on_referenced_packages
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+import 'package:tv_king/features/vod/data/catalog_source.dart';
+import 'package:tv_king/features/vod/data/vod_repository.dart';
+import 'package:tv_king/features/vod/data/series_repository.dart';
+
+class _Paths extends PathProviderPlatform {
+  _Paths(this.root);
+  final String root;
+  @override Future<String?> getApplicationDocumentsPath() async => root;
+  @override Future<String?> getApplicationSupportPath() async => root;
+  @override Future<String?> getTemporaryPath() async => root;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+  SharedPreferences.setMockInitialValues(<String, Object>{});
+  test('10 Xtream partagent le catalogue, jamais les identifiants ni les épisodes', () async {
+    final Directory dir = Directory.systemTemp.createTempSync('multi-catalog-');
+    PathProviderPlatform.instance = _Paths(dir.path);
+    final Database db = await databaseFactoryFfi.openDatabase(inMemoryDatabasePath);
+    await PlaylistDatabase.instance.debugCreate(db);
+    PlaylistDatabase.instance.debugUseDatabase(db);
+    final repo = PlaylistRepository.instance;
+    final movies = VodRepository.instance;
+    final series = SeriesRepository.instance;
+    final List<Uri> requests = <Uri>[];
+    CatalogSource.httpForTesting = () => MockClient((http.Request req) async {
+      requests.add(req.url);
+      final String host = req.url.host;
+      final String? action = req.url.queryParameters['action'];
+      Object body = <Object>[];
+      if (action == 'get_vod_streams' || action == 'get_series') {
+        body = <Object>[<String, Object>{'stream_id': 10, 'series_id': 11, 'name': 'Catalogue $host', 'category_id': '1', 'container_extension': 'mp4'}];
+      } else if (action == 'get_vod_info') {
+        body = <String, Object>{'info': <String, Object>{'plot': host}};
+      } else if (action == 'get_series_info') {
+        body = <String, Object>{'info': <String, Object>{'plot': host}, 'episodes': <String, Object>{'1': <Object>[
+          <String, Object>{'id': '99', 'title': 'Episode $host', 'season': 1, 'episode_num': 1, 'container_extension': 'mp4'}
+        ]}};
+      }
+      return http.Response(jsonEncode(body), 200);
+    });
+    addTearDown(() async {
+      await repo.deleteAllPlaylists();
+      CatalogSource.httpForTesting = null;
+      PlaylistDatabase.instance.debugUseDatabase(null);
+      await db.close();
+    });
+    final List<int> ids = <int>[];
+    for (int i = 0; i < 10; i++) {
+      final int id = await db.insert('playlists', Playlist(id: null, name: 'Compte $i', type: PlaylistType.xtream,
+          xtreamServer: 'https://source$i.invalid', xtreamUsername: 'user$i', xtreamPassword: 'test', createdAt: i).toMap());
+      ids.add(id);
+      await repo.setActivePlaylist(id);
+    }
+    final films = await movies.fetchMovies();
+    final shows = await series.fetchSeries();
+    expect(films, hasLength(10));
+    expect(shows, hasLength(10));
+    expect(films.map((m) => m.id).toSet(), hasLength(10));
+    expect(shows.map((s) => s.id).toSet(), hasLength(10));
+    for (int i = 0; i < 10; i++) {
+      expect((await movies.fetchInfo('vod-10@p${ids[i]}'))?.plot, 'source$i.invalid');
+      final detail = await series.fetchDetail('11@p${ids[i]}');
+      expect(detail.info?.plot, 'source$i.invalid');
+      expect(detail.episodes.single.id, 'ep-99@p${ids[i]}');
+      expect(Uri.parse(detail.episodes.single.streamUrl).host, 'source$i.invalid');
+    }
+    expect(await CatalogSource.forItem('vod-10'), isNull, reason: 'ne jamais deviner un compte ambigu');
+    await repo.deletePlaylist(ids.first);
+    final int before = requests.length;
+    expect(await movies.fetchInfo('vod-10@p${ids.first}'), isNull);
+    expect((await series.fetchDetail('11@p${ids.first}')).episodes, isEmpty);
+    expect(requests, hasLength(before));
+    expect(await movies.fetchMovies(), hasLength(9));
+    expect(await series.fetchSeries(), hasLength(9));
+  });
+}
