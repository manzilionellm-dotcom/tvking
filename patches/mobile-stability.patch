index 00000000..48b5c63a
--- /dev/null
+++ b/test/features/vod/source_deletion_test.dart
@@ -0,0 +1,93 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+// ignore: depend_on_referenced_packages
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+import 'package:tv_king/features/vod/data/vod_repository.dart';
+import 'package:tv_king/features/vod/data/series_repository.dart';
+
+class _Paths extends PathProviderPlatform {
+  _Paths(this.root);
+  final String root;
+  @override
+  Future<String?> getApplicationDocumentsPath() async => root;
+  @override
+  Future<String?> getApplicationSupportPath() async => root;
+  @override
+  Future<String?> getTemporaryPath() async => root;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  databaseFactory = databaseFactoryFfiNoIsolate;
+  final Directory dir = Directory.systemTemp.createTempSync('catalog-removal-');
+  PathProviderPlatform.instance = _Paths(dir.path);
+  final VodRepository movies = VodRepository.instance;
+  final SeriesRepository series = SeriesRepository.instance;
+  late int playlistId;
+  Completer<void>? started;
+  Completer<void>? release;
+
+  http.Client client() => MockClient((http.Request req) async {
+    final String? action = req.url.queryParameters['action'];
+    if (action == 'get_vod_streams' || action == 'get_series') {
+      if (started != null && !started!.isCompleted) started!.complete();
+      if (release != null) await release!.future;
+      return http.Response(jsonEncode(<Object?>[
+        <String, Object?>{'stream_id': 10, 'series_id': 11, 'name': 'Catalogue privé', 'category_id': '1', 'container_extension': 'mp4'},
+      ]), 200);
+    }
+    return http.Response('[]', 200);
+  });
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    started = null;
+    release = null;
+    await PlaylistRepository.instance.deleteAllPlaylists();
+    final Database db = await PlaylistDatabase.instance.database;
+    await db.delete('deleted_sources');
+    playlistId = await db.insert('playlists', Playlist(id: null, name: 'Test', type: PlaylistType.xtream,
+      xtreamServer: 'http://catalog.invalid', xtreamUsername: 'test', xtreamPassword: 'test', createdAt: 1).toMap());
+    await PlaylistRepository.instance.setActivePlaylist(playlistId);
+  });
+
+  test('effacer la source vide les films et séries déjà en mémoire', () async {
+    await http.runWithClient(() async {
+      expect(await movies.fetchMovies(), hasLength(1));
+      expect(await series.fetchSeries(), hasLength(1));
+      await PlaylistRepository.instance.deletePlaylist(playlistId);
+      expect(await movies.fetchMovies(), isEmpty);
+      expect(await series.fetchSeries(), isEmpty);
+      expect(movies.cachedMovies, isEmpty);
+      expect(movies.categories(), isEmpty);
+      expect(series.categories(), isEmpty);
+    }, client);
+  });
+
+  for (final bool isFilm in <bool>[true, false]) {
+    test('réponse ${isFilm ? "films" : "séries"} tardive après DELETE ignorée', () async {
+      started = Completer<void>();
+      release = Completer<void>();
+      await http.runWithClient(() async {
+        final Future<List<Object>> request = isFilm ? movies.fetchMovies() : series.fetchSeries();
+        await started!.future;
+        await PlaylistRepository.instance.deletePlaylist(playlistId);
+        release!.complete();
+        expect(await request, isEmpty);
+        expect(await movies.fetchMovies(), isEmpty);
+        expect(await series.fetchSeries(), isEmpty);
+      }, client);
+    });
+  }
+}
