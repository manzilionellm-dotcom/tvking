new file mode 100644
index 00000000..500730b5
--- /dev/null
+++ b/lib/features/recordings/data/bounded_recording_writer.dart
@@ -0,0 +1,76 @@
+import 'dart:async';
+import 'dart:io';
+import 'dart:typed_data';
+
+/// Le disque peut être plus lent que le direct. La file est bornée : une
+/// carte pleine/lente arrête la capture, sans gonfler la RAM ni couper le player.
+class BoundedRecordingWriter {
+  BoundedRecordingWriter._(this._write, this._finish, this._onFailure, this.maxPendingBytes);
+
+  static Future<BoundedRecordingWriter> open(String path, {void Function(Object)? onFailure}) async {
+    final File file = File(path);
+    await file.parent.create(recursive: true);
+    final RandomAccessFile handle = await file.open(mode: FileMode.write);
+    return BoundedRecordingWriter._(
+      (List<int> data) async { await handle.writeFrom(data); },
+      () async { try { await handle.flush(); } finally { await handle.close(); } },
+      onFailure, 8 * 1024 * 1024,
+    );
+  }
+
+  /// Même ordonnanceur, avec un disque lent ou défaillant contrôlé en test.
+  BoundedRecordingWriter.forTesting({
+    required Future<void> Function(List<int>) write,
+    required Future<void> Function() finish,
+    void Function(Object)? onFailure,
+    this.maxPendingBytes = 8 * 1024 * 1024,
+  }) : _write = write, _finish = finish, _onFailure = onFailure;
+
+  final Future<void> Function(List<int>) _write;
+  final Future<void> Function() _finish;
+  final void Function(Object)? _onFailure;
+  final int maxPendingBytes;
+  Future<void> _tail = Future<void>.value();
+  Future<int>? _closing;
+  int _pending = 0;
+  int bytesWritten = 0;
+  Object? failure;
+  bool get isOpen => _closing == null && failure == null;
+
+  void _fail(Object error) {
+    if (failure != null) return;
+    failure = error;
+    try { _onFailure?.call(error); } catch (_) { /* Le diagnostic ne bloque jamais la fermeture. */ }
+  }
+
+  void add(List<int> bytes) {
+    if (!isOpen || bytes.isEmpty) return;
+    if (_pending + bytes.length > maxPendingBytes) {
+      _fail(const FileSystemException('Le stockage ne suit plus le débit du flux.'));
+      unawaited(close());
+      return;
+    }
+    final Uint8List owned = Uint8List.fromList(bytes);
+    _pending += owned.length;
+    _tail = _tail.then((_) async {
+      try {
+        if (failure != null) return;
+        await _write(owned);
+        bytesWritten += owned.length;
+      } catch (error) {
+        _fail(error);
+        // Ne pas attendre close ici : il attend lui-même cette écriture.
+        unawaited(close());
+      } finally {
+        _pending -= owned.length;
+      }
+    });
+  }
+
+  Future<int> close() => _closing ??= _close();
+  Future<int> _close() async {
+    await _tail;
+    try { await _finish(); } catch (error) { _fail(error); }
+    return bytesWritten;
+  }
+}
