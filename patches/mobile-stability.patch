@@ -0,0 +1,42 @@
+import 'dart:convert';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/epg/data/xmltv_transport.dart';
+
+Future<String> decode(List<List<int>> chunks) =>
+    decodeXmltvTransport(Stream<List<int>>.fromIterable(chunks))
+        .transform(utf8.decoder).join();
+
+void main() {
+  const xml = '<?xml version="1.0"?><tv><channel id="test"/></tv>';
+  test('XML déjà décompressé accepté sans seconde inflation', () async {
+    expect(await decode([utf8.encode(xml)]), xml);
+  });
+  test('vrai HttpClient : gzip HTTP déjà décodé malgré son en-tête conservé', () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen((request) async {
+      request.response.headers.set(HttpHeaders.contentEncodingHeader, 'gzip');
+      request.response.add(gzip.encode(utf8.encode(xml)));
+      await request.response.close();
+    });
+    final client = HttpClient();
+    addTearDown(() async { client.close(force: true); await server.close(force: true); });
+    final response = await (await client.getUrl(Uri.parse('http://127.0.0.1:${server.port}/xmltv.gz'))).close();
+    expect(response.headers.value(HttpHeaders.contentEncodingHeader), 'gzip');
+    expect(await decodeXmltvTransport(response).transform(utf8.decoder).join(), xml);
+  });
+  test('gzip réel accepté même sans extension ou en-tête', () async {
+    expect(await decode([gzip.encode(utf8.encode(xml))]), xml);
+  });
+  test('signature gzip coupée entre plusieurs paquets', () async {
+    final bytes = gzip.encode(utf8.encode(xml));
+    expect(await decode([[], [bytes[0]], [], bytes.sublist(1, 2), bytes.sublist(2)]), xml);
+  });
+  test('un fichier gzip corrompu reste une erreur explicite', () async {
+    await expectLater(decode([[0x1f, 0x8b, 0, 0, 0]]), throwsA(isA<FormatException>()));
+  });
+  test('réponse vide ou très courte ne perd pas ses octets', () async {
+    expect(await decode([]), '');
+    expect(await decode([[60]]), '<');
+  });
+}
