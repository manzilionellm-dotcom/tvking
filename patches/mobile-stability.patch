@@ -0,0 +1,50 @@
+import 'dart:async';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/recordings/data/bounded_recording_writer.dart';
+
+void main() {
+  test('close attend toutes les écritures puis ferme une seule fois', () async {
+    final Completer<void> gate = Completer<void>();
+    final List<int> output = <int>[];
+    int closes = 0;
+    final writer = BoundedRecordingWriter.forTesting(write: (bytes) async { await gate.future; output.addAll(bytes); }, finish: () async { closes++; });
+    writer.add(<int>[1,2]); writer.add(<int>[3]);
+    final Future<int> close = writer.close();
+    expect(writer.bytesWritten, 0);
+    gate.complete();
+    expect(await close, 3);
+    expect(await writer.close(), 3);
+    expect(output, <int>[1,2,3]);
+    expect(closes, 1);
+  });
+  test('erreur disque asynchrone ferme sans exception non consommée', () async {
+    int failures = 0; int closes = 0;
+    final writer = BoundedRecordingWriter.forTesting(write: (_) async { throw const FileSystemException('plein'); }, finish: () async { closes++; }, onFailure: (_) { failures++; });
+    writer.add(<int>[1,2]); writer.add(<int>[3]);
+    expect(await writer.close(), 0);
+    expect(writer.failure, isA<FileSystemException>());
+    expect(failures, 1); expect(closes, 1);
+  });
+  test('disque lent : la file reste bornée et la capture s’arrête', () async {
+    final Completer<void> gate = Completer<void>();
+    final writer = BoundedRecordingWriter.forTesting(maxPendingBytes: 4,
+      write: (_) => gate.future, finish: () async {});
+    writer.add(<int>[1,2,3,4]);
+    writer.add(<int>[5]);
+    expect(writer.isOpen, isFalse);
+    expect(writer.failure, isNotNull);
+    gate.complete();
+    await writer.close();
+  });
+  test('fichier réel : les octets sont relisibles après clôture', () async {
+    final Directory dir = Directory.systemTemp.createTempSync('record-writer-');
+    try {
+      final File file = File('${dir.path}/capture.ts');
+      final writer = await BoundedRecordingWriter.open(file.path);
+      writer.add(<int>[0x47, 1, 2, 3]);
+      expect(await writer.close(), 4);
+      expect(await file.readAsBytes(), <int>[0x47, 1, 2, 3]);
+    } finally { await dir.delete(recursive: true); }
+  });
+}
diff --git a/test/features/recordings/data/http_recording_lifecycle_test.dart b/test/features/recordings/data/http_recording_lifecycle_test.dart
new file mode 100644
index 00000000..a22be720
--- /dev/null
+++ b/test/features/recordings/data/http_recording_lifecycle_test.dart
@@ -0,0 +1,70 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/recordings/data/http_recording_downloader.dart';
+
+void main() {
+  final downloader = HttpRecordingDownloader.instance;
+  late Directory directory;
+  late HttpServer server;
+  late StreamIterator<HttpRequest> requests;
+  setUp(() async {
+    directory = await Directory.systemTemp.createTemp('recording-lifecycle-');
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    requests = StreamIterator<HttpRequest>(server);
+  });
+  tearDown(() async {
+    await downloader.stop();
+    await requests.cancel();
+    await server.close(force: true);
+    await directory.delete(recursive: true);
+  });
+  Future<HttpRequest> nextRequest() async {
+    expect(await requests.moveNext().timeout(const Duration(seconds: 5)), isTrue);
+    final request = requests.current;
+    unawaited(request.response.done.then<void>((_) {}, onError: (Object _) {}));
+    return request;
+  }
+  String url(String suffix) => 'http://127.0.0.1:${server.port}/$suffix';
+
+  for (final suffix in <String>['live.ts', 'live.m3u8']) {
+    test('annulation et double départ avant les en-têtes : $suffix', () async {
+      final path = '${directory.path}/video.ts';
+      final starting = downloader.start(streamUrl: url(suffix), filePath: path);
+      await nextRequest(); // Le serveur retient volontairement ses en-têtes.
+      expect(downloader.activeCount, 1);
+      expect(await downloader.start(streamUrl: url(suffix), filePath: path), isFalse);
+      await downloader.stop(filePath: path).timeout(const Duration(seconds: 5));
+      expect(await starting.timeout(const Duration(seconds: 5)), isFalse);
+      expect(downloader.isRecordingFile(path), isFalse);
+      expect(downloader.activeCount, 0);
+    });
+  }
+
+  test('échec HLS libère le fichier et stop attend les octets réels', () async {
+    final path = '${directory.path}/video.ts';
+    final rejected = downloader.start(streamUrl: url('denied.m3u8'), filePath: path);
+    final denied = await nextRequest();
+    denied.response.statusCode = HttpStatus.forbidden;
+    await denied.response.close();
+    expect(await rejected, isFalse);
+    expect(downloader.activeCount, 0);
+
+    final accepted = downloader.start(streamUrl: url('live.ts'), filePath: path);
+    final request = await nextRequest();
+    final bytes = List<int>.generate(188 * 4, (i) => i % 256);
+    request.response.contentLength = bytes.length;
+    request.response.add(bytes);
+    await request.response.close();
+    expect(await accepted, isTrue);
+    // Attendre la réception, puis vérifier que stop attend aussi l'écriture.
+    for (int i = 0; i < 300 && downloader.bytesWrittenFor(path) < bytes.length; i++) {
+      await Future<void>.delayed(const Duration(milliseconds: 10));
+    }
+    expect(downloader.bytesWrittenFor(path), bytes.length);
+    expect(await downloader.stop(filePath: path), bytes.length);
+    expect(await File(path).readAsBytes(), bytes);
+    expect(downloader.activeCount, 0);
+  });
+}
