diff --git a/lib/features/vod/data/catalog_source.dart b/lib/features/vod/data/catalog_source.dart
new file mode 100644
index 00000000..4cd2cab7
--- /dev/null
+++ b/lib/features/vod/data/catalog_source.dart
@@ -0,0 +1,65 @@
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/foundation.dart';
+import 'package:http/http.dart' as http;
+
+import '../../playlists/data/playlist_repository.dart';
+import '../../playlists/data/xtream_client.dart';
+import '../../playlists/domain/playlist.dart';
+
+/// Capture immuable : la clé disque et la requête utilisent TOUJOURS le même
+/// compte, même si la source active change pendant un téléchargement.
+class CatalogSource {
+  CatalogSource(this.playlist, this.key);
+  final Playlist playlist;
+  final String key;
+  @visibleForTesting
+  static http.Client Function()? httpForTesting;
+
+  /// Seules les sources activées participent au catalogue commun.
+  static Future<List<CatalogSource>> active() async {
+    final List<Playlist> rows = await PlaylistRepository.instance.getAllPlaylists();
+    final List<Playlist> selected = rows.where((Playlist p) => p.isActive &&
+        p.id != null && p.type == PlaylistType.xtream &&
+        (p.xtreamServer ?? '').isNotEmpty).toList()
+      ..sort((Playlist a, Playlist b) => a.id!.compareTo(b.id!));
+    return <CatalogSource>[for (final Playlist p in selected)
+      CatalogSource(p, sha256.convert(utf8.encode(signature(<Playlist>[p]))).toString())];
+  }
+
+  static Future<CatalogSource?> current() async {
+    final List<CatalogSource> sources = await active();
+    return sources.isEmpty ? null : sources.first;
+  }
+
+  static String collectionKey(List<CatalogSource> sources) =>
+      sha256.convert(utf8.encode(sources.map((CatalogSource s) => s.key).join(':'))).toString();
+
+  /// Le suffixe conserve les préfixes historiques vod-/ep- tout en
+  /// distinguant deux fournisseurs qui utilisent le même numéro.
+  String qualify(String id) => '$id@p${playlist.id}';
+  bool owns(String id) => id.endsWith('@p${playlist.id}');
+  String rawId(String id) => owns(id) ? id.substring(0, id.lastIndexOf('@p')) : id;
+
+  static Future<CatalogSource?> forItem(String id) async {
+    final List<CatalogSource> sources = await active();
+    for (final CatalogSource source in sources) {
+      if (source.owns(id)) return source;
+    }
+    // Ancien favori non qualifié : jamais deviner entre plusieurs comptes.
+    if (!RegExp(r'@p[0-9]+$').hasMatch(id) && sources.length == 1) return sources.single;
+    return null;
+  }
+
+  static String signature(List<Playlist> rows) => jsonEncode(<Object?>[
+    for (final Playlist p in rows)
+      <Object?>[p.id, p.type.name, p.isActive, p.m3uUrl, p.xtreamServer, p.xtreamUsername, p.xtreamPassword],
+  ]);
+
+  XtreamClient client({Duration timeout = const Duration(seconds: 20)}) => XtreamClient(
+    serverUrl: playlist.xtreamServer!, username: playlist.xtreamUsername ?? '',
+    password: playlist.xtreamPassword ?? '', timeout: timeout,
+    httpClient: httpForTesting?.call(),
+  );
+}
