@@ -0,0 +1,38 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+import 'package:tv_king/features/vod/domain/content_partition.dart';
+import 'package:tv_king/features/vod/data/m3u_vod_source.dart';
+
+void main() {
+  Channel channel(String url, {String category = 'Cinéma', int source = 1, String name = 'Cinéma en direct'}) => Channel(
+      id: '1@p$source', playlistId: source, name: name, category: category, streamUrl: url, isLive: true);
+  test('les API reçoivent le numéro fournisseur sans le suffixe local', () {
+    const item = Channel(id: 'xtream-42@p7', playlistId: 7, name: 'Test', category: '', streamUrl: '', isLive: true);
+    expect(item.sourceRawId, 'xtream-42');
+    expect(item.sourceScopedId, 'xtream-42@p7');
+  });
+  test('une chaîne cinéma reste du direct ; un fichier film même ancien ne devient pas live', () {
+    expect(ContentPartition.isLive(channel('https://test.invalid/live/1.ts')), isTrue);
+    expect(ContentPartition.isLive(channel('https://test.invalid/movie/1.ts')), isFalse);
+    expect(ContentPartition.isLive(channel('https://test.invalid/film.mp4')), isFalse);
+  });
+  test('adultes et public restent séparés pour chaque type de contenu', () {
+    for (final String category in <String>['18+', 'ADULT FILMS', 'XXX LIVE', 'Adult Series']) {
+      expect(ContentPartition.visible('Programme', category, adultOnly: false), isFalse);
+      expect(ContentPartition.visible('Programme', category, adultOnly: true), isTrue);
+    }
+    expect(ContentPartition.visible('Programme', 'Cinéma', adultOnly: true), isFalse);
+    expect(ContentPartition.visible('Programme', 'Cinéma', adultOnly: false), isTrue);
+  });
+  test('deux séries M3U homonymes gardent leurs épisodes chez le bon fournisseur', () {
+    final entries = <Channel>[
+      channel('https://one.invalid/series/1.mp4', name: 'Série Test S01E01'),
+      channel('https://two.invalid/series/1.mp4', source: 2, name: 'Série Test S01E01'),
+    ];
+    final series = groupM3uEpisodesIntoSeries(entries);
+    expect(series, hasLength(2));
+    final first = m3uEpisodesForSeries(entries, series.first.id);
+    expect(first, hasLength(1));
+    expect(first.single.streamUrl, startsWith('https://one.invalid/'));
+  });
+}
