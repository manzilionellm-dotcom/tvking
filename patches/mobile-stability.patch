diff --git a/lib/features/device/data/device_secret.dart b/lib/features/device/data/device_secret.dart
new file mode 100644
index 00000000..41d9c9b4
--- /dev/null
+++ b/lib/features/device/data/device_secret.dart
@@ -0,0 +1,64 @@
+import 'dart:convert';
+import 'dart:math';
+
+import 'package:http/http.dart' as http;
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../../subscription/data/subscription_backend.dart';
+import 'device_identity.dart';
+
+/// Preuve d'appareil compatible avec le Worker : la MAC affichée à l'écran
+/// ne suffit plus à lire une sauvegarde ou les identifiants d'une source.
+/// Aucun secret ne doit apparaître dans les journaux.
+class DeviceSecret {
+  DeviceSecret._();
+  static final DeviceSecret instance = DeviceSecret._();
+  Future<String>? _creating;
+  final Map<String, Future<void>> _enrolling = <String, Future<void>>{};
+  final Map<String, DateTime> _lastAttempt = <String, DateTime>{};
+
+  Future<String> getOrCreate() => _creating ??= _load().whenComplete(() => _creating = null);
+
+  Future<String> _load() async {
+    final SharedPreferences prefs = await SharedPreferences.getInstance();
+    final String? existing = prefs.getString('device.secret.v1');
+    if (existing != null && existing.length >= 32) return existing;
+    final Random random = Random.secure();
+    final String secret = base64Url.encode(List<int>.generate(32, (_) => random.nextInt(256)));
+    if (!await prefs.setString('device.secret.v1', secret)) {
+      throw StateError('Impossible de conserver la preuve de cet appareil.');
+    }
+    return secret;
+  }
+
+  Future<void> enroll(String mac) {
+    final String key = '$kSubscriptionBaseUrl|$mac';
+    if (_enrolling.containsKey(key)) return _enrolling[key]!;
+    final DateTime now = DateTime.now();
+    if (_lastAttempt[key] != null && now.difference(_lastAttempt[key]!) < const Duration(minutes: 1)) return Future<void>.value();
+    _lastAttempt[key] = now;
+    return _enrolling[key] = _enroll(mac).whenComplete(() => _enrolling.remove(key));
+  }
+
+  Future<void> _enroll(String mac) async {
+    if (!mac.startsWith('MK:')) return;
+    try {
+      final String secret = await getOrCreate();
+      final String androidId = await DeviceIdentity.instance.androidId();
+      await http.post(Uri.parse('$kSubscriptionBaseUrl/api/device-proof'),
+        headers: const <String, String>{'Content-Type': 'application/json', 'Accept': 'application/json'},
+        body: jsonEncode(<String, String>{'mac': mac, 'androidId': androidId, 'secret': secret}),
+      ).timeout(const Duration(seconds: 8));
+    } catch (_) { /* Repli réseau borné ; les requêtes gardent leur preuve. */ }
+  }
+
+  Future<Map<String, String>> headers({bool jsonBody = false}) async {
+    final String mac = await DeviceIdentity.instance.mac;
+    await enroll(mac);
+    return <String, String>{
+      'Accept': 'application/json',
+      if (jsonBody) 'Content-Type': 'application/json',
+      'X-Device-Secret': await getOrCreate(),
+    };
+  }
+}
