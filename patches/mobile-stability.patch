+import 'dart:async';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+import 'package:tv_king/features/player/data/local_stream_relay.dart';
+import 'package:tv_king/features/player/data/stream_blocked_fallback.dart';
+
+void main() {
+  for (final bool decoded in <bool>[false, true]) {
+    test('redirection black.ts : aucun octet transmis, aucune fausse panne réseau (frames=$decoded)', () async {
+      final HttpServer server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      int requests = 0;
+      server.listen((HttpRequest req) async {
+        requests++;
+        if (req.uri.path == '/video/black.ts') {
+          req.response.headers.contentType = ContentType('video', 'mp2t');
+          req.response.add(List<int>.filled(188, 0x47));
+          await req.response.close();
+        } else {
+          await req.response.redirect(Uri.parse('http://127.0.0.1:${server.port}/video/black.ts'));
+        }
+      });
+      final String url = 'http://127.0.0.1:${server.port}/live/test/test/1.ts';
+      final Channel channel = Channel(id: 'placeholder-$decoded', name: 'Chaîne test', category: 'Tests', streamUrl: url, isLive: true);
+      final Completer<BlockedVerdict> blocked = Completer<BlockedVerdict>();
+      int reopened = 0;
+      final StreamBlockedFallback fallback = StreamBlockedFallback(
+          getChannel: () => channel, getOverrideUrl: () => null, getEffectiveUrl: () => url,
+          isAlive: () => true, hasDecodedFrames: () => decoded, getAdoptedAltUrl: () => null,
+          setAdoptedAltUrl: (_) {}, resetWatchdogBudget: () {}, reopen: (_) { reopened++; },
+          showBlocked: (BlockedVerdict v) { if (!blocked.isCompleted) blocked.complete(v); })..attach();
+      final HttpClient client = HttpClient();
+      addTearDown(() async { fallback.detach(); client.close(force: true); await server.close(force: true); });
+      final String local = await LocalStreamRelay.instance.playUrlFor(url);
+      final HttpClientResponse response = await (await client.getUrl(Uri.parse(local))).close();
+      final List<int> bytes = await response.fold<List<int>>(<int>[], (List<int> a, List<int> b) => a..addAll(b)).timeout(const Duration(seconds: 5));
+      final verdict = await blocked.future.timeout(const Duration(seconds: 5));
+      expect(verdict.kind, BlockedKind.channelBlocked);
+      expect(bytes, isEmpty);
+      expect(reopened, 0);
+      expect(requests, 2, reason: 'pas de reconnexions ni de sondes concurrentes');
+    });
+  }
+}
