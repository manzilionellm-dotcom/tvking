+import '../../channels/domain/channel.dart';
+import 'm3u_vod_classifier.dart';
+
+/// Le type (direct / film / épisode) et l'accès 18+ sont deux axes séparés.
+/// Une chaîne cinéma en direct reste du direct ; un film 18+ ne rejoint
+/// jamais le rayon public simplement parce qu'il se trouve dans « Films ».
+abstract final class ContentPartition {
+  static bool isAdult(String name, String category) =>
+      ChannelClassifier.classifyGenre(name, category) == ChannelGenre.adult;
+
+  static bool isLive(Channel channel) => channel.isLive &&
+      M3uVodClassifier.classify(url: channel.streamUrl, name: channel.name) == M3uVodKind.live;
+
+  static bool visible(String name, String category, {required bool adultOnly}) =>
+      isAdult(name, category) == adultOnly;
+}
