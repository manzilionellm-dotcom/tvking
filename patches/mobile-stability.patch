index 00000000..d5469f68
--- /dev/null
+++ b/lib/features/vod/data/catalog_source.dart
@@ -0,0 +1,35 @@
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+
+import '../../playlists/data/playlist_repository.dart';
+import '../../playlists/data/xtream_client.dart';
+import '../../playlists/domain/playlist.dart';
+
+/// Capture immuable : la clé disque et la requête utilisent TOUJOURS le même
+/// compte, même si la source active change pendant un téléchargement.
+class CatalogSource {
+  CatalogSource(this.playlist, this.key);
+  final Playlist playlist;
+  final String key;
+
+  static Future<CatalogSource?> current() async {
+    final List<Playlist> rows = await PlaylistRepository.instance.getAllPlaylists();
+    final List<Playlist> xtream = rows.where((Playlist p) =>
+        p.type == PlaylistType.xtream && (p.xtreamServer ?? '').isNotEmpty).toList();
+    if (xtream.isEmpty) return null;
+    final Playlist selected = xtream.firstWhere((Playlist p) => p.isActive, orElse: () => xtream.first);
+    final Digest digest = sha256.convert(utf8.encode(signature(<Playlist>[selected])));
+    return CatalogSource(selected, digest.bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join());
+  }
+
+  static String signature(List<Playlist> rows) => jsonEncode(<Object?>[
+    for (final Playlist p in rows)
+      <Object?>[p.id, p.type.name, p.isActive, p.m3uUrl, p.xtreamServer, p.xtreamUsername, p.xtreamPassword],
+  ]);
+
+  XtreamClient client({Duration timeout = const Duration(seconds: 20)}) => XtreamClient(
+    serverUrl: playlist.xtreamServer!, username: playlist.xtreamUsername ?? '',
+    password: playlist.xtreamPassword ?? '', timeout: timeout,
+  );
+}
