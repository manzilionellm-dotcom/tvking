diff --git a/test/features/playlists/cloud_backup_panel_removal_test.dart b/test/features/playlists/cloud_backup_panel_removal_test.dart
new file mode 100644
index 0000000..befc018
--- /dev/null
+++ b/test/features/playlists/cloud_backup_panel_removal_test.dart
@@ -0,0 +1,294 @@
+// Suppression réelle SQLite + ancien instantané cloud : une liste effacée
+// au panel ne doit pas revenir au prochain démarrage. Les sources privées
+// et la restauration sur une installation neuve restent disponibles.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+// Interface fournie par path_provider, déjà utilisée par les tests SQLite.
+// ignore: depend_on_referenced_packages
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/features/playlists/data/cloud_backup_repository.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/data/remote_source_repository.dart';
+import 'package:tv_king/features/playlists/data/source_opt_outs.dart';
+import 'package:tv_king/features/playlists/domain/panel_source_decision.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+
+const String _mac = 'MK:24:2A:D0:0E:F3';
+const String _panelUrl = 'http://panel-source.invalid/list.m3u';
+const String _personalUrl = 'http://personal-source.invalid/list.m3u';
+
+class _Paths extends PathProviderPlatform {
+  _Paths(this.root);
+  final String root;
+  @override
+  Future<String?> getApplicationDocumentsPath() async => root;
+  @override
+  Future<String?> getApplicationSupportPath() async => root;
+  @override
+  Future<String?> getTemporaryPath() async => root;
+}
+
+Playlist _playlist(String url) => Playlist(
+      id: null,
+      name: 'Source de test',
+      type: PlaylistType.m3u,
+      createdAt: 1,
+      m3uUrl: url,
+    );
+
+class _Server {
+  List<Map<String, Object?>> sources = <Map<String, Object?>>[];
+  List<Map<String, Object?>> backup = <Map<String, Object?>>[];
+  final List<String> downloads = <String>[];
+  int backupReads = 0;
+  Completer<void>? backupStarted;
+  Completer<void>? finishBackup;
+  Completer<void>? downloadStarted;
+  Completer<void>? finishDownload;
+
+  http.Client client() => MockClient((http.Request request) async {
+        if (request.url.path.startsWith('/api/device-source/')) {
+          return http.Response(
+            jsonEncode(<String, Object?>{'mac': _mac, 'sources': sources}),
+            200,
+          );
+        }
+        if (request.url.path.startsWith('/api/backup/')) {
+          backupReads++;
+          backupStarted?.complete();
+          if (finishBackup != null) await finishBackup!.future;
+          return http.Response(
+            jsonEncode(<String, Object?>{
+              'data': <String, Object?>{
+                'v': 1,
+                'playlists': backup,
+                'favorites': <String>[],
+              },
+            }),
+            200,
+          );
+        }
+        if (request.url.host.endsWith('-source.invalid')) {
+          downloads.add(request.url.toString());
+          downloadStarted?.complete();
+          if (finishDownload != null) await finishDownload!.future;
+          return http.Response(
+            '#EXTM3U\n#EXTINF:-1 group-title="Test",Chaîne\n'
+            'http://stream.invalid/1.ts\n',
+            200,
+          );
+        }
+        return http.Response('{}', 404);
+      });
+
+  Future<void> sync() =>
+      http.runWithClient(() async => RemoteSourceRepository.sync(), client);
+  Future<void> restore() => http.runWithClient(
+        CloudBackupRepository.instance.restoreIfNeeded,
+        client,
+      );
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  databaseFactory = databaseFactoryFfiNoIsolate;
+  final Directory directory = Directory.systemTemp.createTempSync(
+    'mobile-backup-removal-',
+  );
+  PathProviderPlatform.instance = _Paths(directory.path);
+  FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'device.virtual_mac.v1': _mac,
+    });
+    final Database db = await PlaylistDatabase.instance.database;
+    await db.delete('channels');
+    await db.delete('playlists');
+  });
+
+  test('suppression volontaire dans app bloque un ancien backup', () async {
+    await SourceOptOuts.markDeleted(_playlist(_panelUrl));
+    final server = _Server()
+      ..backup = [
+        _playlist(_panelUrl).toMap(),
+        _playlist(_personalUrl).toMap()
+      ];
+    await server.restore();
+    final lists = await PlaylistRepository.instance.getAllPlaylists();
+    expect(lists.map((p) => p.m3uUrl), [_personalUrl]);
+  });
+
+  test(
+    'source panel effacée puis redémarrage : le backup ne la recrée pas',
+    () async {
+      final _Server server = _Server()
+        ..sources = <Map<String, Object?>>[
+          <String, Object?>{'type': 'm3u', 'm3u_url': _panelUrl},
+        ];
+      await server.sync();
+      final List<Playlist> before =
+          await PlaylistRepository.instance.getAllPlaylists();
+      expect(before, hasLength(1));
+      server.backup = before.map((Playlist p) => p.toMap()).toList();
+      server.sources = <Map<String, Object?>>[];
+      await server.sync();
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+
+      await server.restore();
+
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+      expect(server.downloads, <String>[_panelUrl]);
+    },
+  );
+
+  test(
+    'une suppression ciblée conserve la source personnelle du backup',
+    () async {
+      await CloudBackupRepository.instance.rememberPanelRemoval(
+        _playlist(_panelUrl),
+      );
+      final _Server server = _Server()
+        ..backup = <Map<String, Object?>>[
+          _playlist(_panelUrl).toMap(),
+          _playlist(_personalUrl).toMap(),
+        ];
+      await server.restore();
+      final List<Playlist> restored =
+          await PlaylistRepository.instance.getAllPlaylists();
+      expect(restored, hasLength(1));
+      expect(restored.single.m3uUrl, _personalUrl);
+      expect(server.downloads, <String>[_personalUrl]);
+    },
+  );
+
+  test(
+    'une source supprimée en Xtream ne revient pas sous son lien get.php',
+    () async {
+      await CloudBackupRepository.instance.rememberPanelRemoval(
+        const Playlist(
+          id: null,
+          name: 'Compte test',
+          type: PlaylistType.xtream,
+          createdAt: 1,
+          xtreamServer: 'http://panel-source.invalid',
+          xtreamUsername: 'test',
+        ),
+      );
+      final _Server server = _Server()
+        ..backup = <Map<String, Object?>>[
+          _playlist(
+            'http://panel-source.invalid/get.php?username=test&password=test',
+          ).toMap(),
+        ];
+      await server.restore();
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+      expect(server.downloads, isEmpty);
+    },
+  );
+
+  test(
+    'nouvelle provision : seule cette source retrouve le droit de restaurer',
+    () async {
+      await CloudBackupRepository.instance.rememberPanelRemoval(
+        _playlist(_panelUrl),
+      );
+      await CloudBackupRepository.instance.rememberPanelRemoval(
+        _playlist(_personalUrl),
+      );
+      await CloudBackupRepository.instance.forgetPanelRemoval(
+        const ProvisionKey.m3u(_panelUrl),
+      );
+      final _Server server = _Server()
+        ..backup = <Map<String, Object?>>[
+          _playlist(_panelUrl).toMap(),
+          _playlist(_personalUrl).toMap(),
+        ];
+      await server.restore();
+      expect(server.downloads, <String>[_panelUrl]);
+    },
+  );
+
+  test(
+    'restauration déjà réussie : pas de répétition après un effacement',
+    () async {
+      SharedPreferences.setMockInitialValues(<String, Object>{
+        'device.virtual_mac.v1': _mac,
+        'backup.restored.v1': true,
+      });
+      final _Server server = _Server()
+        ..backup = <Map<String, Object?>>[_playlist(_personalUrl).toMap()];
+      await server.restore();
+      expect(server.backupReads, 0);
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+    },
+  );
+
+  test('installation neuve : la récupération personnelle fonctionne', () async {
+    final _Server server = _Server()
+      ..backup = <Map<String, Object?>>[_playlist(_personalUrl).toMap()];
+    await server.restore();
+    expect(await PlaylistRepository.instance.getAllPlaylists(), hasLength(1));
+    expect(server.downloads, <String>[_personalUrl]);
+  });
+
+  test(
+    'suppression pendant le téléchargement : pas de résurrection tardive',
+    () async {
+      final _Server server = _Server()
+        ..backup = <Map<String, Object?>>[_playlist(_panelUrl).toMap()]
+        ..downloadStarted = Completer<void>()
+        ..finishDownload = Completer<void>();
+      final Future<void> restore = server.restore();
+      await server.downloadStarted!.future;
+      await CloudBackupRepository.instance.rememberPanelRemoval(
+        _playlist(_panelUrl),
+      );
+      server.finishDownload!.complete();
+      await restore;
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+    },
+  );
+  test('panel vidé pendant la lecture du backup, avant toute insertion locale',
+      () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'device.virtual_mac.v1': _mac,
+      'panel.provisioned_v1': <String>['m3u|$_panelUrl'],
+    });
+    final _Server server = _Server()
+      ..backup = <Map<String, Object?>>[_playlist(_panelUrl).toMap()]
+      ..backupStarted = Completer<void>()
+      ..finishBackup = Completer<void>();
+    final Future<void> restore = server.restore();
+    await server.backupStarted!.future;
+    expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+    await server.sync();
+    server.finishBackup!.complete();
+    await restore;
+    expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+    expect(server.downloads, isEmpty);
+  });
+  test('réassignation Xtream : l’ancien alias M3U du compte est autorisé',
+      () async {
+    const String url =
+        'http://panel-source.invalid/get.php?username=test&password=test';
+    await CloudBackupRepository.instance.rememberPanelRemoval(_playlist(url));
+    await CloudBackupRepository.instance.forgetPanelRemoval(
+        const ProvisionKey.xtream('http://panel-source.invalid', 'test'));
+    final _Server server = _Server()
+      ..backup = <Map<String, Object?>>[_playlist(url).toMap()];
+    await server.restore();
+    expect(await PlaylistRepository.instance.getAllPlaylists(), hasLength(1));
+    expect(server.downloads, <String>[url]);
+  });
+}
