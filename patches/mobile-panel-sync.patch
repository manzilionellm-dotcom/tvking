@@ -0,0 +1,12 @@
+/// Lie une preuve de lecture au lecteur réellement ouvert pour la sélection.
+/// Un zap révoque immédiatement l’ancien lecteur, avant le debounce et son
+/// arrêt asynchrone. Seule la nouvelle ouverture peut réautoriser des preuves.
+class PlaybackEvidenceGate<T extends Object> {
+  T? _source;
+
+  void revoke() => _source = null;
+
+  void bind(T source) => _source = source;
+
+  bool accepts(T source) => identical(_source, source);
+}
