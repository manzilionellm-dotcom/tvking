<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://zuno.7themotion.com/tv" version="1.0.0" viewmodes="maximized">
  <!-- Identité provisoire : conserver celle du Seller Office si une fiche existe déjà. -->
  <tizen:application id="ZunoTV2026.ZunoTV" package="ZunoTV2026" required_version="5.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>ZUNO</name>
  <tizen:profile name="tv-samsung"/>
  <!-- Sources personnelles : requêtes réseau autorisées, navigation externe interdite. -->
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable"
                 background-support="disable" encryption="disable" install-location="auto"/>
</widget>
