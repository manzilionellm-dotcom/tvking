<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Le serveur des régressions HTTP écoute uniquement dans l'émulateur. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">
        <!-- Hôte de test seulement : aucune activité ajoutée à l'application publiée. -->
        <activity
            android:name="com.manzilionellm.native_video_player.ContrastTestActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
    </application>
</manifest>
