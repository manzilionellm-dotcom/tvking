# Noms uniquement. Provisionner via le gestionnaire de secrets Cloudflare.
# Ne jamais placer de valeur réelle dans Git.
DEVICE_TOKEN_SECRET=
# Au moins 32 caractères aléatoires, dédié aux jetons appareils.
ACCOUNT_ENCRYPTION_KEY=
# Clé stable dédiée AES-GCM des secrets TOTP. Ne pas la faire tourner sans migration.
# Repli existant : ADMIN_SECRET si ACCOUNT_ENCRYPTION_KEY manque.
PANEL_ORIGINS=https://atlas-console-k7q2.vercel.app
# Aucun joker, ajouter uniquement les origines Atlas réellement contrôlées.
# Secours maître historique DÉSACTIVÉ par défaut, ne pas activer en routine.
ADMIN_MASTER_RECOVERY_ENABLED=0
