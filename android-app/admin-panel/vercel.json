{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://seven-motion-backend.manzilionel-lm.workers.dev/api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://seven-motion-backend.manzilionel-lm.workers.dev https://seven-motion-backend.manzilionel-lm.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ]},
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store, private" },
      { "key": "CDN-Cache-Control", "value": "no-store" },
      { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
    ]},
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}