// Recette Android : Worker/DO locaux réels, plugins natifs, SQLite et widgets.
// Le transport, les synchroniseurs et les accusés sont ceux de l'application.
import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:http/http.dart' as http;
import 'package:integration_test/integration_test.dart';
import 'package:tv_king/core/flavor/flavor.dart';
import 'package:tv_king/features/device/data/device_identity.dart';
import 'package:tv_king/features/device/data/device_secret.dart';
import 'package:tv_king/features/playlists/data/playlist_repository.dart';
import 'package:tv_king/features/subscription/data/subscription_backend.dart';
import 'package:tv_king/features/subscription/data/subscription_state.dart';
import 'package:tv_king/features/simple_home/presentation/widgets/announcement_banner.dart';
import 'package:tv_king/l10n/generated/app_localizations.dart';
// ADAPTER_IMPORTS

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
  testWidgets('panel → WebSocket → état, SQLite, écran et APPLIED sous 2 s', (tester) async {
    const String variant = String.fromEnvironment('REALTIME_VARIANT');
    FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
    expect(kSubscriptionBaseUrl, 'http://127.0.0.1:8787');
    final String mac = await DeviceIdentity.instance.mac;
    final String androidId = await DeviceIdentity.instance.androidId();
    expect(androidId, isNotEmpty);
    final info = jsonDecode((await http.get(Uri.parse('$kSubscriptionBaseUrl/__fixture/info'))).body) as Map;
    final Map<String, String> adminHeaders = <String, String>{
      'Authorization': 'Bearer ${info['token']}', 'Content-Type': 'application/json',
    };
    Future<Map<String, dynamic>> panel(String path, String method, [Object? body]) async {
      final request = http.Request(method, Uri.parse('$kSubscriptionBaseUrl$path'));
      request.headers.addAll(adminHeaders);
      if (body != null) request.body = jsonEncode(body);
      final response = await http.Response.fromStream(await request.send());
      expect(response.statusCode, inInclusiveRange(200, 299), reason: '$path: ${response.body}');
      return jsonDecode(response.body) as Map<String, dynamic>;
    }
    await panel('/__fixture/register', 'POST', <String, String>{'mac': mac, 'androidId': androidId});
    await DeviceSecret.instance.enroll(mac);
    await PlaylistRepository.instance.initialize();
    expect(PlaylistRepository.instance.currentChannels, isEmpty, reason: 'émulateur de recette neuf');
    await SubscriptionState.instance.initialize();
    final ticket = await panel('/api/v1/rt/ticket', 'POST', <String, Object>{});
    final WebSocket panelSocket = await WebSocket.connect('ws://127.0.0.1:8787/api/v1/rt/ws?ticket=${ticket['ticket']}');
    final List<Map<String, dynamic>> events = <Map<String, dynamic>>[];
    final listener = panelSocket.listen((dynamic raw) {
      events.add(jsonDecode(raw as String) as Map<String, dynamic>);
    });
    final keepalive = Timer.periodic(const Duration(seconds: 10), (_) {
      panelSocket.add('{"type":"hello"}');
    });
    await tester.pumpWidget(MaterialApp(
      locale: const Locale('fr'), localizationsDelegates: AppLocalizations.localizationsDelegates,
      supportedLocales: AppLocalizations.supportedLocales,
      home: Scaffold(body: Column(children: <Widget>[
        const AnnouncementBanner(),
        AnimatedBuilder(animation: SubscriptionState.instance, builder: (_, __) => Text(
          'paid=${SubscriptionState.instance.remote.paid}; frozen=${SubscriptionState.instance.remote.frozen}',
        )),
        StreamBuilder(stream: PlaylistRepository.instance.channelsStream,
          builder: (_, __) => Text('channels=${PlaylistRepository.instance.currentChannels.length}')),
      ])),
    ));
    // ADAPTER_START
    Future<void> until(bool Function() condition, {int limit = 10000}) async {
      final watch = Stopwatch()..start();
      while (!condition() && watch.elapsedMilliseconds < limit) {
        await Future<void>.delayed(const Duration(milliseconds: 15));
        await tester.pump();
      }
      expect(condition(), isTrue, reason: 'condition non réalisée en ${limit}ms');
    }
    try {
      await until(() => events.any((e) => e['type'] == 'presence' && e['mac'] == mac && e['online'] == true));
      final live = await panel('/api/v1/boxes/live?mac=$mac', 'GET');
      expect((live['items'] as List).single['online'], isTrue);
      // Laisser se terminer le contrôle initial avant la première action mesurée.
      await Future<void>.delayed(const Duration(milliseconds: 500));

      Future<void> action(String name, String path, String method, Object? body,
          String kind, bool Function() applied, {Finder? visible, int limit = 2000}) async {
        final int first = events.length;
        final watch = Stopwatch()..start();
        await panel(path, method, body);
        await until(() => applied() && events.skip(first).any((e) =>
          e['type'] == 'receipt' && e['kind'] == kind && e['state'] == 'applied' && e['mac'] == mac), limit: 10000);
        if (visible != null) expect(visible, findsOneWidget);
        final int elapsed = watch.elapsedMilliseconds;
        debugPrint('RT_LATENCY ${jsonEncode(<String, Object>{'app': variant, 'action': name, 'milliseconds': elapsed})}');
        expect(elapsed, lessThan(limit), reason: '$name : application ET accusé panel');
      }
      await action('essai', '/api/v1/trial-extend', 'POST', <String, Object>{'mac': mac, 'days': 1}, 'license',
        () => SubscriptionState.instance.remote.trialUntil > DateTime.now().millisecondsSinceEpoch);
      await action('activation', '/api/v1/activate', 'POST', <String, Object>{'mac': mac, 'plan': 'yearly'}, 'activate',
        () => SubscriptionState.instance.remote.paid, visible: find.text('paid=true; frozen=false'));
      await action('ajout de liste', '/api/v1/sources/$mac', 'PUT', <String, Object>{
        'type': 'm3u', 'label': 'Recette RT', 'm3u_url': '$kSubscriptionBaseUrl/__fixture/list.m3u',
      }, 'source', () => PlaylistRepository.instance.currentChannels.isNotEmpty, visible: find.text('channels=1'));
      await action('message', '/api/v1/announcements', 'POST', <String, Object>{'title': 'Message RT Android', 'body': 'Reçu sans redémarrer'},
        'message', () => find.text('Message RT Android').evaluate().isNotEmpty, visible: find.text('Message RT Android'));
      await action('suspension', '/api/v1/devices/fixture-$mac', 'PATCH', <String, Object>{'block_status': 'frozen'}, 'suspend',
        () => SubscriptionState.instance.remote.frozen);
      expect(PlaylistRepository.instance.currentChannels.length, 1,
        reason: 'une suspension verrouille l’accès sans supprimer la liste');
      await action('réactivation', '/api/v1/devices/fixture-$mac', 'PATCH', <String, Object>{'block_status': 'active'}, 'resume',
        () => !SubscriptionState.instance.remote.frozen);
      await action('retrait de liste', '/api/v1/sources/$mac', 'DELETE', null, 'source_clear',
        () => PlaylistRepository.instance.currentChannels.isEmpty, visible: find.text('channels=0'));
      final int cut = events.length;
      await panel('/__fixture/socket-mode', 'POST', <String, Object>{'mac': mac, 'blocked': true});
      await until(() => events.skip(cut).any((e) => e['type'] == 'presence' && e['online'] == false));
      await action('repli HTTP socket coupé', '/api/v1/devices/fixture-$mac', 'PATCH',
        <String, Object>{'block_status': 'frozen'}, 'suspend', () => SubscriptionState.instance.remote.frozen, limit: 7000);
      final int restored = events.length;
      await panel('/__fixture/socket-mode', 'POST', <String, Object>{'mac': mac, 'blocked': false});
      await until(() => events.skip(restored).any((e) => e['type'] == 'presence' && e['online'] == true), limit: 35000);
      await action('ordre après reconnexion', '/api/v1/devices/fixture-$mac', 'PATCH',
        <String, Object>{'block_status': 'active'}, 'resume', () => !SubscriptionState.instance.remote.frozen);
    } finally {
      // ADAPTER_STOP
      keepalive.cancel();
      await listener.cancel();
      await panelSocket.close();
      await tester.pumpWidget(const SizedBox.shrink());
    }
  }, timeout: const Timeout(Duration(minutes: 3)));
}
