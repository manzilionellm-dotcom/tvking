 RELEASE_BASE="${BUILD_LABEL_RELEASE_BASE:-https://github.com/${REPO}/releases/download}"
 
+# ---------------------------------------------------------
+#  Lire les publications immuables, sans inventer de manifeste.
+# ---------------------------------------------------------
+#  Un tag seul, une release brouillon ou un fichier encore vide ne
+#  consomme pas de numéro. L'API est publique : aucun secret n'est
+#  transmis. On suit toutes les pages, avec une borne qui fait échouer
+#  la lecture plutôt que tronquer silencieusement le maximum.
+#  Rien n'est émis avant la fin : une panne à la page 2 ne doit pas
+#  transformer le résultat partiel de la page 1 en preuve complète.
+lire_releases_immuables() {
+  python3 - "$PREFIX" "${BUILD_LABEL_FIXTURE_DIR:-}" \
+    "${BUILD_LABEL_RELEASES_API:-https://api.github.com/repos/${REPO}/releases}" <<'PYRELEASES'
+import json
+import re
+import sys
+import urllib.request
+from pathlib import Path
+
+prefix, fixtures, endpoint = sys.argv[1:]
+pattern = re.compile(r"7motion-(" + re.escape(prefix) + r"[0-9]+)")
+page_size = 100
+max_pages = 100
+max_bytes = 16 * 1024 * 1024
+labels = {}
+page = 1
+try:
+    for page in range(1, max_pages + 1):
+        if fixtures:
+            path = Path(fixtures, "releases", f"page-{page}.json")
+            if page == 1 and not path.exists():
+                payload = b"[]"
+            else:
+                with path.open("rb") as stream:
+                    payload = stream.read(max_bytes + 1)
+        else:
+            request = urllib.request.Request(
+                f"{endpoint}?per_page={page_size}&page={page}",
+                headers={"Accept": "application/vnd.github+json",
+                         "User-Agent": "7motion-build-label"},
+            )
+            with urllib.request.urlopen(request, timeout=12) as response:
+                if response.status != 200:
+                    raise ValueError("HTTP inattendu")
+                payload = response.read(max_bytes + 1)
+        if len(payload) > max_bytes:
+            raise ValueError("Page trop grande")
+        releases = json.loads(payload)
+        if not isinstance(releases, list) or len(releases) > page_size:
+            raise ValueError("Page de releases invalide")
+        for release in releases:
+            if not isinstance(release, dict):
+                raise ValueError("Release invalide")
+            tag = release.get("tag_name")
+            match = pattern.fullmatch(tag) if isinstance(tag, str) else None
+            published = release.get("published_at")
+            if (match is None or release.get("draft") is not False or
+                    not isinstance(published, str) or not published.strip()):
+                continue
+            assets = release.get("assets")
+            if not isinstance(assets, list):
+                raise ValueError("Fichiers de release invalides")
+            if any(isinstance(asset, dict) and
+                   asset.get("name") == "7motion.apk" and
+                   asset.get("state") == "uploaded" and
+                   type(asset.get("size")) is int and asset["size"] > 0
+                   for asset in assets):
+                labels[tag] = match.group(1)
+        if len(releases) < page_size:
+            break
+    else:
+        raise ValueError("Pagination trop longue")
+except Exception:
+    # Ne pas recopier le corps d'une réponse, une URL de test ou des
+    # détails réseau. La page suffit à localiser la lecture à reprendre.
+    sys.stderr.write(f"build_label: index des releases inaccessible ou invalide (page {page})\n")
+    sys.exit(1)
+for tag, label in labels.items():
+    sys.stdout.write(f"{tag}\t{label}\n")
+PYRELEASES
+}
