+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/repair_flags.dart';
+import 'package:tv_king/core/theme/app_theme.dart';
+import 'package:tv_king/features/sports/data/followed_matches_service.dart';
+import 'package:tv_king/features/sports/data/live_scores_service.dart';
+import 'package:tv_king/features/sports/data/public_football_repository.dart';
+import 'package:tv_king/features/sports/domain/sport_models.dart';
+import 'package:tv_king/features/sports/presentation/sport_screen.dart';
+import 'package:tv_king/l10n/generated/app_localizations.dart';
+
+import '../../support/premium_capture_fonts.dart';
+
+// Le transport est couvert par public_football_http_test. Ici, un dépôt
+// contrôlé et un vrai flux rejouent ce que le service périodique remet à
+// l'écran : le test doit échouer si le listener ne remplace que le diagnostic.
+class _FixtureFootballRepository extends PublicFootballRepository {
+  _FixtureFootballRepository(this.result)
+      : super.forTesting(
+          publicBase: Uri.parse('https://public.invalid/'),
+          legacyBase: Uri.parse('https://legacy.invalid/'),
+        );
+
+  FootballLoad result;
+  int loads = 0;
+
+  @override
+  FootballLoad get latest => result;
+
+  @override
+  Future<FootballLoad> load({
+    bool scores = false,
+    bool manual = false,
+    Iterable<SportEvent> followed = const <SportEvent>[],
+  }) async {
+    loads++;
+    return result;
+  }
+}
+
+SportEvent _match(String id, String name, int day,
+    {String sport = 'Soccer', int hour = 19}) {
+  final DateTime kickoff = DateTime.utc(2026, 10, day, hour);
+  return SportEvent(
+    id: 'oldb:$id',
+    name: name,
+    date: '2026-10-${day.toString().padLeft(2, '0')}',
+    time: '${hour.toString().padLeft(2, '0')}:00:00',
+    timestamp: kickoff.toIso8601String(),
+    sport: sport,
+  );
+}
+
+FootballLoad _loaded(List<SportEvent> matches,
+        {String? diagnostic, bool available = true}) =>
+    FootballLoad(
+      matches: matches,
+      available: available,
+      diagnostic: diagnostic,
+      receivedAt: DateTime.utc(2026, 10, 20, 12),
+    );
+
+Future<void> _mount(WidgetTester tester, _FixtureFootballRepository repository,
+    Stream<void> changes) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = const Size(390, 844);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  addTearDown(tester.view.resetPhysicalSize);
+  await tester.pumpWidget(MaterialApp(
+    locale: const Locale('fr'),
+    supportedLocales: AppLocalizations.supportedLocales,
+    localizationsDelegates: AppLocalizations.localizationsDelegates,
+    // Le scénario porte sur les données et les gestes. Il ne dépend pas
+    // du shader GPU InkSparkle, absent de certains moteurs de test Linux.
+    theme: AppTheme.cinema.copyWith(splashFactory: NoSplash.splashFactory),
+    home: SportScreen.forTesting(
+      footballRepository: repository,
+      scoreChanges: changes,
+    ),
+  ));
+  await tester.pumpAndSettle();
+}
+
+void main() {
+  setUpAll(preparePremiumCaptureFonts);
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    await FollowedMatchesService.instance.clear();
+    LiveScoresService.instance.debugSeed(const <SportEvent>[]);
+    RepairFlags.mobileSportsLegacy = false;
+  });
+  tearDown(() {
+    RepairFlags.mobileSportsLegacy = false;
+    LiveScoresService.instance.debugSeed(const <SportEvent>[]);
+  });
+
+  testWidgets('une notification apporte les 20–21 et corrige le 17 reporté',
+      (WidgetTester tester) async {
+    final StreamController<void> changes = StreamController<void>.broadcast();
+    addTearDown(changes.close);
+    final _FixtureFootballRepository repository = _FixtureFootballRepository(
+      _loaded(<SportEvent>[
+        _match('1', 'Rencontre reportée', 17),
+        _match('2', 'Ancienne journée', 16),
+      ]),
+    );
+    await _mount(tester, repository, changes.stream);
+    expect(find.text('Rencontre reportée'), findsOneWidget);
+    expect(find.text('17/10 · 19:00'), findsOneWidget);
+    expect(find.text('Nouvelle rencontre'), findsNothing);
+
+    repository.result = _loaded(<SportEvent>[
+      _match('1', 'Rencontre reportée', 21, hour: 18),
+      _match('3', 'Nouvelle rencontre', 20),
+    ]);
+    changes.add(null);
+    await tester.pumpAndSettle();
+
+    expect(find.text('Nouvelle rencontre'), findsOneWidget);
+    expect(find.text('20/10 · 19:00'), findsOneWidget);
+    expect(find.text('Rencontre reportée'), findsOneWidget);
+    expect(find.text('21/10 · 18:00'), findsOneWidget);
+    expect(find.text('17/10 · 19:00'), findsNothing);
+    expect(find.text('Ancienne journée'), findsNothing);
+    expect(repository.loads, 1,
+        reason: 'le listener consomme la réponse reçue sans retélécharger');
+    expect(tester.takeException(), isNull);
+
+    await tester.pumpWidget(const SizedBox.shrink());
+    changes.add(null);
+    await tester.pump();
+    expect(tester.takeException(), isNull,
+        reason: 'la fermeture de l’écran annule son abonnement');
+  });
+
+  testWidgets(
+      'une reprise périodique sort de la panne et garde le cache lisible',
+      (WidgetTester tester) async {
+    final StreamController<void> changes = StreamController<void>.broadcast();
+    addTearDown(changes.close);
+    final _FixtureFootballRepository repository = _FixtureFootballRepository(
+      const FootballLoad(diagnostic: 'Source indisponible'),
+    );
+    await _mount(tester, repository, changes.stream);
+    expect(find.text('Pas de connexion'), findsOneWidget);
+
+    final List<SportEvent> matches = <SportEvent>[
+      _match('1', 'Match revenu', 21),
+    ];
+    repository.result = _loaded(matches);
+    changes.add(null);
+    await tester.pumpAndSettle();
+    expect(find.text('Pas de connexion'), findsNothing);
+    expect(find.text('Source indisponible'), findsNothing);
+    expect(find.text('Match revenu'), findsOneWidget);
+    expect(find.byType(CircularProgressIndicator), findsNothing);
+
+    repository.result = _loaded(matches,
+        available: false, diagnostic: 'Dernières données conservées');
+    changes.add(null);
+    await tester.pumpAndSettle();
+    expect(find.text('Match revenu'), findsOneWidget);
+    expect(find.text('Dernières données conservées'), findsOneWidget);
+    expect(find.text('Pas de connexion'), findsNothing);
+
+    repository.result = _loaded(const <SportEvent>[]);
+    changes.add(null);
+    await tester.pumpAndSettle();
+    expect(find.text('Aucune grande affiche'), findsOneWidget);
+    expect(find.text('Match revenu'), findsNothing);
+    expect(find.text('Dernières données conservées'), findsNothing);
+    expect(find.text('Pas de connexion'), findsNothing);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('Actualiser ne réinjecte pas le vieux score du minuteur',
+      (WidgetTester tester) async {
+    final StreamController<void> changes = StreamController<void>.broadcast();
+    addTearDown(changes.close);
+    final SportEvent stale = _match('1', 'Score corrigé', 20)
+        .copyWith(homeScore: '1', awayScore: '0', status: '1H');
+    LiveScoresService.instance.debugSeed(<SportEvent>[stale]);
+    final _FixtureFootballRepository repository = _FixtureFootballRepository(
+      _loaded(<SportEvent>[
+        stale.copyWith(homeScore: '2', awayScore: '1', status: 'FT'),
+      ]),
+    );
+    await _mount(tester, repository, changes.stream);
+    expect(find.text('2–1'), findsOneWidget);
+    expect(find.text('1–0'), findsNothing);
+    expect(find.text('1H'), findsNothing,
+        reason: 'un ancien statut live ne remplace pas le résultat reçu');
+
+    repository.result = _loaded(<SportEvent>[
+      stale.copyWith(homeScore: '3', awayScore: '1', status: 'FT'),
+    ]);
+    await tester.tap(find.byTooltip('Actualiser'));
+    await tester.pumpAndSettle();
+    expect(find.text('3–1'), findsOneWidget);
+    expect(find.text('2–1'), findsNothing);
+    expect(find.text('1–0'), findsNothing);
+    expect(repository.loads, 2);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('les filtres choisis survivent, un filtre disparu ne masque rien',
+      (WidgetTester tester) async {
+    final StreamController<void> changes = StreamController<void>.broadcast();
+    addTearDown(changes.close);
+    final SportEvent football = _match('1', 'Affiche football', 20);
+    final SportEvent basket =
+        _match('2', 'Affiche basket', 20, sport: 'Basketball');
+    final _FixtureFootballRepository repository = _FixtureFootballRepository(
+      _loaded(<SportEvent>[football, basket]),
