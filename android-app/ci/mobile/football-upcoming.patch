+ok "$([[ "$got" == 1988126 ]] && echo 1 || echo 0)" \
+  "un manifeste plus avancé garde la priorité dans le maximum [got=${got}]"
+poser phone-latest 1988118
+
+indice paginated
+got="$(appeler 7motion-test)"
+ok "$([[ "$got" == 1988131 ]] && echo 1 || echo 0)" \
+  "le label supérieur de la deuxième page n'est pas perdu [got=${got}]"
+
