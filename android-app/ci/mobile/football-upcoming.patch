+refus_sans_numero error-object
+refus_sans_numero invalid-entry
+
+#  Le refus fermé vise la chaîne 7motion-test qui livre ces APK.
+#  Le contrat de repli des anciens canaux n'est pas changé.
+got="$(appeler seventv-latest)"
+ok "$([[ "$got" == 1988119 ]] && echo 1 || echo 0)" \
+  "index invalide : ancien canal conserve le repli manifeste [got=${got}]"
+
+statut=0
+got="$(BUILD_LABEL_RELEASE_BASE="http://127.0.0.1:1" \
+  BUILD_LABEL_RELEASES_API="http://127.0.0.1:1/releases" \
+  BUILD_LABEL_FAMILY="phone-latest" \
+  "$SCRIPT" manzilionellm-dotcom/tvking 7motion-test 2>/dev/null)" || statut=$?
+ok "$([[ "$statut" -ne 0 && -z "$got" ]] && echo 1 || echo 0)" \
+  "API réellement injoignable : 7motion-test échoue sans numéro [status=${statut}]"
+
 echo
