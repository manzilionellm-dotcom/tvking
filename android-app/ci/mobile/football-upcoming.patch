+
+indice() {
+  python3 - "$WORKDIR" "$1" <<'PYFIXTURES'
+import copy
+import json
+import sys
+from pathlib import Path
+
+root, scenario = sys.argv[1:]
+directory = Path(root, "releases")
+directory.mkdir(exist_ok=True)
+for path in directory.glob("page-*.json"):
+    path.unlink()
+
+published = {
+    "tag_name": "7motion-1988119", "draft": False,
+    "published_at": "2026-10-20T00:25:55Z",
+    "assets": [{"name": "7motion.apk", "state": "uploaded", "size": 72089508}],
+}
+
+def changed(**values):
+    result = copy.deepcopy(published)
+    result.update(values)
+    return result
+
+first = [published]
+if scenario == "excluded":
+    first.extend([
+        changed(tag_name="7motion-1988999", draft=True),
+        changed(tag_name="7motion-1988998", published_at=None),
+        changed(tag_name="7motion-1988997", published_at=" "),
+        changed(tag_name="7motion-1988996", assets=[]),
+        changed(tag_name="7motion-1988995", assets=[{
+            "name": "7motion.apk", "state": "new", "size": 123}]),
+        changed(tag_name="7motion-1988994", assets=[{
+            "name": "7motion.apk", "state": "uploaded", "size": 0}]),
+        changed(tag_name="7motion-1988993", assets=[{
+            "name": "7motion.aab", "state": "uploaded", "size": 123}]),
+        changed(tag_name="7motion-1988992", assets=[{
+            "name": "7motion.apk", "state": "uploaded", "size": True}]),
+        changed(tag_name="7motion-1988999-rc"),
+        changed(tag_name="7motion-1988"),
+        changed(tag_name="other-1988999"),
+        changed(tag_name="7motion-2988999"),
+    ])
+elif scenario in ("paginated", "incomplete"):
+    first.extend({"tag_name": f"unrelated-{index}"} for index in range(99))
+    if scenario == "paginated":
+        Path(directory, "page-2.json").write_text(json.dumps([
