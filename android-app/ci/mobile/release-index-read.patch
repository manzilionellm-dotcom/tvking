@@ -209,6 +209,9 @@ lire_releases_immuables() {
     "${BUILD_LABEL_RELEASES_API:-https://api.github.com/repos/${REPO}/releases}" <<'PYRELEASES'
 import json
+import os
 import re
 import sys
+import time
+import urllib.error
 import urllib.request
 from pathlib import Path
@@ -219,4 +222,32 @@ page_size = 100
 max_pages = 100
 max_bytes = 16 * 1024 * 1024
+
+def read_page(page):
+    request = urllib.request.Request(
+        f"{endpoint}?per_page={page_size}&page={page}",
+        headers={"Accept": "application/vnd.github+json", "User-Agent": "7motion-build-label"},
+    )
+    # Le jeton de lecture du job ne quitte pas l'API GitHub officielle,
+    # même en présence d'un endpoint de test ou d'une redirection HTTP.
+    token = os.environ.get("GH_TOKEN")
+    if (token and not os.environ.get("BUILD_LABEL_RELEASES_API") and
+            re.fullmatch(r"https://api\.github\.com/repos/[\w.-]+/[\w.-]+/releases", endpoint)):
+        request.add_unredirected_header("Authorization", f"Bearer {token}")
+    for attempt in range(3):
+        try:
+            with urllib.request.urlopen(request, timeout=12) as response:
+                if response.status != 200:
+                    raise ValueError("HTTP inattendu")
+                return response.read(max_bytes + 1)
+        except urllib.error.HTTPError as error:
+            if error.code not in (408, 429, 500, 502, 503, 504) or attempt == 2:
+                raise
+            error.close()
+        except (urllib.error.URLError, TimeoutError):
+            if attempt == 2:
+                raise
+        time.sleep(2 ** attempt)
+
+
