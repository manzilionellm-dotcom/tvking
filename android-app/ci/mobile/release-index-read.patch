diff --git a/ci/build_label_test.sh b/ci/build_label_test.sh
index 01c8d96..c85c601 100755
--- a/ci/build_label_test.sh
+++ b/ci/build_label_test.sh
@@ -294,4 +294,58 @@ ok "$([[ "$statut" -ne 0 && -z "$got" ]] && echo 1 || echo 0)" \
   "API réellement injoignable : 7motion-test échoue sans numéro [status=${statut}]"

+# Une page 503 doit être relue. Un endpoint de test ne reçoit jamais le
+# jeton CI, y compris lorsque le premier appel est en échec.
+python3 - "$SCRIPT" <<'PYRETRY'
+import json
+import os
+import subprocess
+import sys
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+
+class Releases(BaseHTTPRequestHandler):
+    index_requests = 0
+    received_credentials = False
+
+    def do_GET(self):
+        if self.headers.get("Authorization") is not None:
+            Releases.received_credentials = True
+        if not self.path.startswith("/releases?"):
+            self.send_error(404)
+            return
+        Releases.index_requests += 1
+        if Releases.index_requests == 1:
+            self.send_error(503)
+            return
+        data = [{"tag_name": "7motion-1988127", "draft": False,
+                 "published_at": "2026-10-20T00:25:55Z",
+                 "assets": [{"name": "7motion.apk", "state": "uploaded", "size": 1}]}]
+        self.send_response(200)
+        self.end_headers()
+        self.wfile.write(json.dumps(data).encode())
+
+    def log_message(self, *args):
+        pass
+
+
+with HTTPServer(("127.0.0.1", 0), Releases) as server:
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    base = f"http://127.0.0.1:{server.server_port}"
+    result = subprocess.run([sys.argv[1], "exemple/telephone", "7motion-test"],
+                            env={**os.environ, "GH_TOKEN": "synthetic-header-check",
+                                 "BUILD_LABEL_RELEASES_API": base + "/releases",
+                                 "BUILD_LABEL_RELEASE_BASE": base, "BUILD_LABEL_FAMILY": "7motion-test",
+                                 "BUILD_LABEL_FIXTURE_DIR": ""},
+                            text=True, capture_output=True, timeout=20)
+    server.shutdown()
+    thread.join()
+if (result.returncode or result.stdout.strip() != "1988128" or
+        Releases.index_requests != 2 or Releases.received_credentials):
+    raise SystemExit("Relecture 503 ou isolation du jeton incorrecte")
+PYRETRY
+ok 1 "un 503 transitoire est relu sans transmettre le jeton au serveur de test"
+
 echo
 echo "${pass} pass, ${fail} fail"
