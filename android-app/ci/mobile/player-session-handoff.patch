+import 'dart:async';
+
+import 'package:fake_async/fake_async.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+import 'package:tv_king/features/player/data/playback_transition.dart';
+import 'package:tv_king/features/player/data/stream_blocked_fallback.dart';
+import 'package:tv_king/features/playlists/data/xtream_client.dart';
+
+void main() {
+  const Channel channel = Channel(
+    id: 'transition-test',
+    name: 'Chaîne de test',
+    category: 'Tests',
+    streamUrl: 'http://panel.example/live/test/test/1.ts',
+    isLive: true,
+  );
+
+  test(
+      'la fermeture doit finir avant le contrôle du compte, puis le '
+      'contrôle doit finir avant toute ouverture', () async {
+    final Completer<void> released = Completer<void>();
+    final Completer<void> slotFree = Completer<void>();
+    final List<String> events = <String>[];
+    final Future<bool> ready = preparePlaybackTransition(
+      release: () async {
+        events.add('fermeture');
+        await released.future;
+        events.add('fermé');
+      },
+      waitForSlot: () async {
+        events.add('compte');
+        await slotFree.future;
+        events.add('libre');
+      },
+      isCancelled: () => false,
+    );
+    final Future<void> opening = ready.then((bool value) {
+      if (value) events.add('ouverture');
+    });
+    await Future<void>.value();
+    expect(events, <String>['fermeture']);
+    released.complete();
+    await Future<void>.delayed(Duration.zero);
+    expect(events, <String>['fermeture', 'fermé', 'compte']);
+    slotFree.complete();
+    await opening;
+    expect(events, <String>[
+      'fermeture',
+      'fermé',
+      'compte',
+      'libre',
+      'ouverture',
+    ]);
+  });
+
+  test('une sélection déjà abandonnée ne ferme ni ne sonde', () async {
+    int releases = 0;
+    int probes = 0;
+    expect(
+      await preparePlaybackTransition(
+        release: () async => releases++,
+        waitForSlot: () async => probes++,
+        isCancelled: () => true,
+      ),
+      isFalse,
+    );
+    expect(releases, 0);
+    expect(probes, 0);
+  });
+
+  test('un zap pendant la fermeture empêche le sondage devenu obsolète',
+      () async {
+    final Completer<void> released = Completer<void>();
+    bool cancelled = false;
+    int probes = 0;
+    final Future<bool> ready = preparePlaybackTransition(
+      release: () => released.future,
+      waitForSlot: () async => probes++,
+      isCancelled: () => cancelled,
+    );
+    cancelled = true;
+    released.complete();
+    expect(await ready, isFalse);
+    expect(probes, 0);
+  });
+
+  test('un zap pendant la réponse du compte interdit encore l’ouverture',
+      () async {
+    final Completer<void> slotFree = Completer<void>();
+    final Completer<void> probing = Completer<void>();
+    bool cancelled = false;
+    final Future<bool> ready = preparePlaybackTransition(
+      release: () async {},
+      waitForSlot: () {
+        probing.complete();
+        return slotFree.future;
+      },
+      isCancelled: () => cancelled,
+    );
+    await probing.future;
+    cancelled = true;
+    slotFree.complete();
+    expect(await ready, isFalse);
+  });
+
+  test('une fermeture échouée remonte son erreur et ne sonde pas', () async {
+    final StateError failure = StateError('fermeture test');
+    int probes = 0;
+    await expectLater(
+      preparePlaybackTransition(
+        release: () async => throw failure,
+        waitForSlot: () async => probes++,
+        isCancelled: () => false,
+      ),
+      throwsA(same(failure)),
+    );
+    expect(probes, 0);
+  });
+
+  test('le contrôle annulé avant son entrée ne fait aucune requête de compte',
+      () async {
+    int probes = 0;
+    await StreamBlockedFallback.awaitProviderSlot(
+      channel,
+      isCancelled: () => true,
+      probeOverride: () async {
+        probes++;
+        return const XtreamAccountInfo(maxConnections: 1, activeCons: 0);
+      },
+    );
+    expect(probes, 0);
+  });
+
+  test(
+      'une réponse occupée arrivée après annulation ne programme plus '
+      'de délai ni de sondage', () {
+    fakeAsync((FakeAsync fake) {
+      final Completer<XtreamAccountInfo> response =
+          Completer<XtreamAccountInfo>();
+      bool cancelled = false;
+      bool done = false;
+      int probes = 0;
+      StreamBlockedFallback.awaitProviderSlot(
+        channel,
+        isCancelled: () => cancelled,
+        probeOverride: () {
+          probes++;
+          return response.future;
+        },
+      ).then((_) => done = true);
+      fake.flushMicrotasks();
+      expect(probes, 1);
+
+      cancelled = true;
+      response.complete(
+        const XtreamAccountInfo(maxConnections: 1, activeCons: 1),
+      );
+      fake.flushMicrotasks();
+      expect(done, isTrue,
+          reason: 'la réponse tardive doit rendre la main immédiatement');
+      expect(fake.pendingTimers, isEmpty);
+      expect(probes, 1);
+    });
+  });
+
+  test(
+      'une réponse de compte bloquée ne dépasse pas le budget de 10 s '
+      'et sa réponse tardive ne relance rien', () {
+    fakeAsync((FakeAsync fake) {
+      final Completer<XtreamAccountInfo> response =
+          Completer<XtreamAccountInfo>();
+      bool done = false;
+      int probes = 0;
+      StreamBlockedFallback.awaitProviderSlot(
+        channel,
+        probeOverride: () {
+          probes++;
+          return response.future;
+        },
+      ).then((_) => done = true);
+      fake.elapse(const Duration(milliseconds: 9999));
+      expect(done, isFalse);
+      expect(probes, 1);
+      fake.elapse(const Duration(milliseconds: 1));
+      expect(done, isTrue,
+          reason: 'le budget doit aussi borner une réponse HTTP en attente');
+
+      response.complete(
+        const XtreamAccountInfo(maxConnections: 1, activeCons: 1),
+      );
+      fake.flushMicrotasks();
+      fake.elapse(const Duration(seconds: 5));
+      expect(probes, 1);
+      expect(fake.pendingTimers, isEmpty,
+          reason: 'le résultat tardif ne doit plus armer de pause');
+    });
+  });
+
+  test('les réponses lentes et les pauses partagent le même budget réel', () {
+    fakeAsync((FakeAsync fake) {
+      bool done = false;
+      int probes = 0;
+      StreamBlockedFallback.awaitProviderSlot(
+        channel,
+        probeOverride: () {
+          probes++;
+          return Future<XtreamAccountInfo>.delayed(
+            const Duration(seconds: 4),
+            () => const XtreamAccountInfo(maxConnections: 1, activeCons: 1),
+          );
+        },
+      ).then((_) => done = true);
+      // Réponses à 4 s et 9,6 s, avec la pause de 1,6 s entre elles.
+      // Une borne par nombre de sondages dépasserait largement 10 s.
+      fake.elapse(const Duration(milliseconds: 9999));
+      expect(done, isFalse);
+      expect(probes, 2);
+      fake.elapse(const Duration(milliseconds: 1));
+      expect(done, isTrue);
+      fake.elapse(const Duration(seconds: 5));
+      expect(probes, 2,
+          reason: 'la pause déjà commencée ne doit pas lancer de 3e requête');
+      expect(fake.pendingTimers, isEmpty);
+    });
+  });
+}
