new file mode 100644
index 0000000..051ba61
--- /dev/null
+++ b/test/features/player/playback_transition_integration_test.dart
@@ -0,0 +1,436 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/channels/domain/channel.dart';
+import 'package:tv_king/features/player/data/local_stream_relay.dart';
+import 'package:tv_king/features/player/data/playback_transition.dart';
+import 'package:tv_king/features/player/data/stream_blocked_fallback.dart';
+import 'package:tv_king/features/player/data/stream_diagnostics.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+
+/// Fournisseur local à une connexion. Le compteur conserve la session
+/// après la fermeture de sa socket ; le test choisit quand ce délai finit.
+/// Toute demande média trop tôt reçoit une redirection HTTP 200 black.ts,
+/// comme le rapport terrain. Le contrôle utilise le vrai player_api.php.
+class _XtreamPanel {
+  _XtreamPanel(this.server) {
+    server.listen(_handle);
+  }
+
+  final HttpServer server;
+  final List<String> events = <String>[];
+  final List<int> mediaRequests = <int>[];
+  final List<int> accountValues = <int>[];
+  final Set<int> alwaysBlack = <int>{};
+  final List<Timer> _feeds = <Timer>[];
+  final Map<int, Completer<void>> _closed = <int, Completer<void>>{};
+  final Map<int, Completer<void>> _accountWaiters = <int, Completer<void>>{};
+  int _activeStreams = 0;
+  bool _coolingDown = false;
+  int simultaneousAttempts = 0;
+  int blackResponses = 0;
+
+  String get baseUrl => 'http://127.0.0.1:${server.port}';
+
+  Playlist get playlist => Playlist(
+        id: 971,
+        name: 'Source locale de test',
+        type: PlaylistType.xtream,
+        createdAt: 0,
+        xtreamServer: baseUrl,
+        xtreamUsername: 'test',
+        xtreamPassword: 'test',
+      );
+
+  Channel channel(int id) => Channel(
+        id: 'transition-$id',
+        playlistId: 971,
+        name: 'Chaîne $id',
+        category: 'Tests',
+        streamUrl: '$baseUrl/live/test/test/$id.ts',
+        isLive: true,
+      );
+
+  Future<void> closed(int id) => (_closed[id] ??= Completer<void>()).future;
+
+  Future<void> accountReads(int count) {
+    if (accountValues.length >= count) return Future<void>.value();
+    return (_accountWaiters[count] ??= Completer<void>()).future;
+  }
+
+  void finishCooldown() {
+    // Une attente lancée avant la fermeture ne peut pas réussir en
+    // libérant artificiellement une socket qui serait encore ouverte.
+    expect(_activeStreams, 0);
+    _coolingDown = false;
+    events.add('créneau libre');
+  }
+
+  Future<void> _handle(HttpRequest request) async {
+    final String path = request.uri.path;
+    if (path == '/player_api.php') {
+      final int active = _activeStreams > 0 || _coolingDown ? 1 : 0;
+      accountValues.add(active);
+      events.add('compte:$active');
+      request.response.headers.contentType = ContentType.json;
+      request.response.write(jsonEncode(<String, Object>{
+        'user_info': <String, Object>{
+          'auth': 1,
+          'status': 'Active',
+          'max_connections': '1',
+          'active_cons': active.toString(),
+        },
+      }));
+      await request.response.close();
+      for (final MapEntry<int, Completer<void>> waiter
+          in _accountWaiters.entries) {
+        if (accountValues.length >= waiter.key && !waiter.value.isCompleted) {
+          waiter.value.complete();
+        }
+      }
+      return;
+    }
+    if (path == '/video/black.ts') {
+      blackResponses++;
+      request.response.headers.contentType = ContentType('video', 'mp2t');
+      request.response.add(List<int>.filled(188, 0x47));
+      await request.response.close();
+      return;
+    }
+    final int? id = int.tryParse(
+      request.uri.pathSegments.last.replaceAll('.ts', ''),
+    );
+    if (id == null || !path.startsWith('/live/test/test/')) {
+      request.response.statusCode = HttpStatus.notFound;
+      await request.response.close();
+      return;
+    }
+    mediaRequests.add(id);
+    if (_activeStreams > 0 || _coolingDown || alwaysBlack.contains(id)) {
+      if (_activeStreams > 0) simultaneousAttempts++;
+      await request.response.redirect(Uri.parse('$baseUrl/video/black.ts'));
+      return;
+    }
+
+    _activeStreams++;
+    events.add('ouverture:$id');
+    request.response.headers.contentType = ContentType('video', 'mp2t');
+    request.response.bufferOutput = false;
+    bool finished = false;
+    late final Timer feed;
+    void onClosed() {
+      if (finished) return;
+      finished = true;
+      feed.cancel();
+      _activeStreams--;
+      _coolingDown = true;
+      events.add('fermeture:$id');
+      final Completer<void> done = _closed[id] ??= Completer<void>();
+      if (!done.isCompleted) done.complete();
+    }
+
+    feed = Timer.periodic(const Duration(milliseconds: 20), (_) {
+      try {
+        request.response.add(List<int>.filled(188 * 5, 0x47));
+      } catch (_) {
+        onClosed();
+      }
+    });
+    _feeds.add(feed);
+    unawaited(request.response.done.then(
+      (_) => onClosed(),
+      onError: (Object _, StackTrace __) => onClosed(),
+    ));
+  }
+
+  Future<void> close() async {
+    for (final Timer feed in _feeds) {
+      feed.cancel();
+    }
+    await server.close(force: true);
+  }
+}
+
+/// Consommateur HTTP du vrai relais, à la place du décodeur natif. Il ne
+/// possède aucune logique de transition : celle-ci vient du séquenceur
+/// de production et de awaitProviderSlot dans les tests ci-dessous.
+class _RelayReader {
+  _RelayReader(this.client, this.reading);
+
+  final HttpClient client;
+  final StreamSubscription<List<int>> reading;
+  bool _closed = false;
+
+  static Future<_RelayReader> open(
+    LocalStreamRelay relay,
+    Channel channel,
+  ) async {
+    final String localUrl = await relay.playUrlFor(channel.streamUrl);
+    final HttpClient client = HttpClient();
+    final HttpClientResponse response =
+        await (await client.getUrl(Uri.parse(localUrl))).close();
+    final Completer<void> firstBytes = Completer<void>();
+    final StreamSubscription<List<int>> reading = response.listen(
+      (List<int> bytes) {
+        if (bytes.isNotEmpty && !firstBytes.isCompleted) firstBytes.complete();
+      },
+      onDone: () {
+        if (!firstBytes.isCompleted) {
+          firstBytes.completeError(StateError('aucun octet média reçu'));
+        }
+      },
+      onError: (Object error, StackTrace stack) {
+        if (!firstBytes.isCompleted) firstBytes.completeError(error, stack);
+      },
+    );
+    final _RelayReader reader = _RelayReader(client, reading);
+    try {
+      await firstBytes.future.timeout(const Duration(seconds: 5));
+      return reader;
+    } catch (_) {
+      await reader.close();
+      rethrow;
+    }
+  }
+
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    client.close(force: true);
+    await reading.cancel().timeout(const Duration(seconds: 5));
+  }
+}
+
+void main() {
+  final LocalStreamRelay relay = LocalStreamRelay.instance;
+  late _XtreamPanel panel;
+  late Channel current;
+  late StreamBlockedFallback fallback;
+  late Completer<BlockedVerdict> blocked;
+  final List<BlockedVerdict> verdicts = <BlockedVerdict>[];
+  final List<String> reopens = <String>[];
+  final List<_RelayReader> readers = <_RelayReader>[];
+
+  Future<void> waitForSlot(Channel channel, {bool Function()? cancelled}) =>
+      StreamBlockedFallback.awaitProviderSlot(
+        channel,
+        budget: const Duration(seconds: 2),
+        pollEvery: const Duration(milliseconds: 20),
+        isCancelled: cancelled,
+      );
+
+  Future<_RelayReader> read(Channel channel) async {
+    StreamDiagnostics.instance.beginSession(
+      url: channel.streamUrl,
+      userAgent: 'Test local',
+      playlistId: channel.playlistId,
+    );
+    final _RelayReader reader = await _RelayReader.open(relay, channel);
+    readers.add(reader);
+    return reader;
+  }
+
+  setUp(() async {
+    await relay.closeOtherPlaybacks('');
+    panel = _XtreamPanel(
+      await HttpServer.bind(InternetAddress.loopbackIPv4, 0),
+    );
+    PlaylistRepository.instance.debugSeedPlaylists(<Playlist>[panel.playlist]);
+    StreamDiagnostics.instance.recordXtreamAccount();
+    current = panel.channel(1);
+    blocked = Completer<BlockedVerdict>();
+    verdicts.clear();
+    reopens.clear();
+    readers.clear();
+    fallback = StreamBlockedFallback(
+      getChannel: () => current,
+      getOverrideUrl: () => null,
+      getEffectiveUrl: () => current.streamUrl,
+      isAlive: () => true,
+      hasDecodedFrames: () => false,
+      getAdoptedAltUrl: () => null,
+      setAdoptedAltUrl: (_) {},
+      resetWatchdogBudget: () {},
+      reopen: reopens.add,
+      retryBackoff: const Duration(milliseconds: 100),
+      showBlocked: (BlockedVerdict verdict) {
+        verdicts.add(verdict);
+        if (!blocked.isCompleted) blocked.complete(verdict);
+      },
+    )..attach();
+  });
+
+  tearDown(() async {
+    fallback.detach();
+    for (final _RelayReader reader in readers) {
+      await reader.close();
+    }
+    await relay.closeOtherPlaybacks('');
+    await panel.close();
+    PlaylistRepository.instance.debugSeedPlaylists(const <Playlist>[]);
+    StreamDiagnostics.instance.recordXtreamAccount();
+  });
+
+  test(
+      'le zap attend le vrai compteur 0/1 après fermeture ; une ancienne '
+      'mesure multi-connexions ne permet pas de sauter ce contrôle', () async {
+    final Channel first = current;
+    expect(
+      await preparePlaybackTransition(
+        release: () => relay.closeOtherPlaybacks(''),
+        waitForSlot: () => waitForSlot(first),
+        isCancelled: () => false,
+      ),
+      isTrue,
+    );
+    final _RelayReader firstReader = await read(first);
+
+    // Mesure d'une autre source : elle ne doit pas dispenser la nouvelle
+    // chaîne du contrôle réel de son compte à une seule connexion.
+    StreamDiagnostics.instance.recordXtreamAccount(
+      status: 'Active',
+      maxConnections: 10,
+      activeCons: 0,
+      serverHost: 'autre-source.example',
+      username: 'autre-test',
+    );
+    current = panel.channel(2);
+    fallback.beginPlaybackAttempt(resetDiagnosis: true);
+    final Channel next = current;
+    final Future<_RelayReader?> opening = preparePlaybackTransition(
+      release: () async {
+        await firstReader.close();
+        await relay.closeSession(first.streamUrl);
+      },
+      waitForSlot: () => waitForSlot(next),
+      isCancelled: () => false,
+    ).then((bool ready) async => ready ? read(next) : null);
+
+    await panel.accountReads(2).timeout(const Duration(seconds: 5));
+    await panel.closed(1).timeout(const Duration(seconds: 5));
+    expect(panel.accountValues.last, 1);
+    expect(panel.mediaRequests, <int>[1],
+        reason: '1/1 après fermeture ne doit pas déclencher black.ts');
+    panel.finishCooldown();
+    expect(await opening.timeout(const Duration(seconds: 5)), isNotNull);
+    expect(panel.accountValues.last, 0);
+    expect(panel.mediaRequests, <int>[1, 2]);
+    expect(panel.events.indexOf('fermeture:1'),
+        lessThan(panel.events.indexOf('ouverture:2')));
+    expect(panel.simultaneousAttempts, 0);
+    expect(panel.blackResponses, 0);
+    expect(verdicts, isEmpty);
+    expect(reopens, isEmpty);
+  });
+
+  test(
+      'black.ts avec un compte déjà libre reste terminal, puis un autre '
+      'choix de chaîne peut démarrer', () async {
+    current = panel.channel(2);
+    panel.alwaysBlack.add(2);
+    expect(
+      await preparePlaybackTransition(
+        release: () => relay.closeOtherPlaybacks(''),
+        waitForSlot: () => waitForSlot(current),
+        isCancelled: () => false,
+      ),
+      isTrue,
+    );
+    expect(panel.accountValues, <int>[0]);
+    final String localUrl = await relay.playUrlFor(current.streamUrl);
+    final HttpClient client = HttpClient();
+    addTearDown(() => client.close(force: true));
+    final HttpClientResponse response =
+        await (await client.getUrl(Uri.parse(localUrl))).close();
+    final List<int> bytes = await response.fold<List<int>>(
+        <int>[],
+        (List<int> all, List<int> part) =>
+            all..addAll(part)).timeout(const Duration(seconds: 5));
+    expect(bytes, isEmpty);
+    final BlockedVerdict verdict =
+        await blocked.future.timeout(const Duration(seconds: 5));
+    expect(verdict.kind, BlockedKind.channelBlocked);
+    expect(panel.blackResponses, 1);
+
+    fallback.onPlaybackRefused('erreur native tardive de test');
+    expect(fallback.onContainerUnsupported(), isTrue);
+    await fallback.run();
+    await Future<void>.delayed(const Duration(milliseconds: 150));
+    final HttpClientResponse retry =
+        await (await client.getUrl(Uri.parse(localUrl))).close();
+    expect(retry.statusCode, HttpStatus.gone);
+    await retry.drain<void>();
+    expect(panel.mediaRequests, <int>[2]);
+    expect(panel.accountValues, <int>[0]);
+    expect(reopens, isEmpty);
+    expect(verdicts, hasLength(1));
+
+    current = panel.channel(3);
+    fallback.beginPlaybackAttempt(resetDiagnosis: true);
+    expect(
+      await preparePlaybackTransition(
+        release: () => relay.closeOtherPlaybacks(''),
+        waitForSlot: () => waitForSlot(current),
+        isCancelled: () => false,
+      ),
+      isTrue,
+    );
+    await read(current);
+    expect(panel.mediaRequests, <int>[2, 3]);
+    expect(panel.simultaneousAttempts, 0);
+  });
+
+  test(
+      'B annulée pendant le contrôle ne demande aucun média ; seule C '
+      'ouvre après libération de A', () async {
+    final Channel first = current;
+    await preparePlaybackTransition(
+      release: () => relay.closeOtherPlaybacks(''),
+      waitForSlot: () => waitForSlot(first),
+      isCancelled: () => false,
+    );
+    final _RelayReader firstReader = await read(first);
+    int generation = 1;
+    current = panel.channel(2);
+    final Channel abandoned = current;
+    final Future<bool> preparingB = preparePlaybackTransition(
+      release: () async {
+        await firstReader.close();
+        await relay.closeSession(first.streamUrl);
+      },
+      waitForSlot: () => waitForSlot(
+        abandoned,
+        cancelled: () => generation != 1,
+      ),
+      isCancelled: () => generation != 1,
+    );
+    await panel.accountReads(2).timeout(const Duration(seconds: 5));
+    await panel.closed(1).timeout(const Duration(seconds: 5));
+    generation = 2;
+    current = panel.channel(3);
+    expect(await preparingB.timeout(const Duration(seconds: 5)), isFalse);
+
+    final Channel selected = current;
+    final Future<bool> preparingC = preparePlaybackTransition(
+      release: () => relay.closeOtherPlaybacks(''),
+      waitForSlot: () => waitForSlot(
+        selected,
+        cancelled: () => generation != 2,
+      ),
+      isCancelled: () => generation != 2,
+    );
+    await panel.accountReads(3).timeout(const Duration(seconds: 5));
+    expect(panel.mediaRequests, <int>[1]);
+    panel.finishCooldown();
+    expect(await preparingC.timeout(const Duration(seconds: 5)), isTrue);
+    await read(selected);
+    expect(panel.mediaRequests, <int>[1, 3]);
+    expect(panel.simultaneousAttempts, 0);
+    expect(panel.blackResponses, 0);
+    expect(verdicts, isEmpty);
+    expect(reopens, isEmpty);
+  });
+}
