diff --git a/lib/features/player/data/playback_transition.dart b/lib/features/player/data/playback_transition.dart
new file mode 100644
index 0000000..de07702
--- /dev/null
+++ b/lib/features/player/data/playback_transition.dart
@@ -0,0 +1,29 @@
+/// Prépare une nouvelle lecture en libérant d'abord la précédente, puis
+/// en attendant que le fournisseur rende son créneau disponible.
+///
+/// Fermer une socket locale ne remet pas nécessairement le compteur du
+/// fournisseur à zéro immédiatement. Cet ordre évite aussi de consulter
+/// ce compteur alors que notre propre ancienne lecture l'occupe encore.
+///
+/// L'appelant conserve sa file d'ouvertures et les délais de fermeture.
+/// Il fournit une garde liée à la sélection courante : un zap pendant
+/// l'une des attentes doit rendre cette préparation obsolète. Seul un
+/// résultat vrai autorise ensuite l'ouverture du nouveau média.
+///
+/// Les erreurs des callbacks remontent à l'appelant, qui connaît la
+/// stratégie de fermeture et de récupération de son moteur de lecture.
+Future<bool> preparePlaybackTransition({
+  required Future<void> Function() release,
+  required Future<void> Function() waitForSlot,
+  required bool Function() isCancelled,
+}) async {
+  if (isCancelled()) return false;
+
+  await release();
+  // Cette garde couvre à la fois le retour de la fermeture et l'entrée
+  // dans l'attente réseau : une ancienne sélection ne doit plus sonder.
+  if (isCancelled()) return false;
+
+  await waitForSlot();
+  return !isCancelled();
+}
