+// Le service est un singleton. Chaque scénario retire ses propres jetons
+// et fait passer le délai de reprise dans une horloge virtuelle, sans I/O.
+void _withPlaybackHolds(
+    void Function(VodDownloadService service, Object a, Object b) scenario) {
+  fakeAsync((FakeAsync clock) {
+    final VodDownloadService service = VodDownloadService.instance;
+    final Object a = Object();
+    final Object b = Object();
+    try {
+      service.setPlaybackHold(false);
+      scenario(service, a, b);
+    } finally {
+      service.releasePlaybackHold(a);
+      service.releasePlaybackHold(b);
+      service.setPlaybackHold(false);
+      clock.elapse(const Duration(seconds: 12));
+    }
+  });
+}
+
 void main() {
+  group('suspension des téléchargements par détenteur', () {
+    testWidgets('le teardown du créneau ne pose pas un verrou legacy permanent',
+        (WidgetTester tester) async {
+      final StreamSlot slot = StreamSlot.instance;
+      slot.resetForTest();
+      // Premier accès au singleton : son inscription au créneau doit être
+      // celle de production, afin de tester le vrai callback de teardown.
+      final VodDownloadService service = VodDownloadService.instance;
+      final Object reader = Object();
+      slot.register(reader, label: 'lecteur test', teardown: () async {});
+      try {
+        await slot.claim(reader);
+        expect(service.playbackHold, isTrue);
+        service.claimPlaybackHold(reader, network: true);
+        service.releasePlaybackHold(reader);
+        expect(service.playbackHold, isFalse);
+      } finally {
+        service.releasePlaybackHold(reader);
+        service.setPlaybackHold(false);
+        slot.unregister(reader);
+        await tester.pump(const Duration(seconds: 12));
+      }
+    });
+
+    test('annuler B en attente ne libère pas A toujours actif', () {
+      _withPlaybackHolds((VodDownloadService service, Object a, Object b) {
+        service.claimPlaybackHold(a, network: true);
+        service.claimPlaybackHold(b, network: true);
+        service.releasePlaybackHold(b);
+        expect(service.playbackHold, isTrue);
+        service.releasePlaybackHold(a);
+        expect(service.playbackHold, isFalse);
+      });
+    });
+
+    test('la fermeture tardive de A laisse B protégé', () {
+      _withPlaybackHolds((VodDownloadService service, Object a, Object b) {
