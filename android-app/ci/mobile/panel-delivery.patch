+          'received_at': received, 'applied_at': DateTime.now().millisecondsSinceEpoch,
+          'app_version': version, 'result': 'refreshed',
+          if (<String>{'source', 'source_clear', 'reset'}.contains(item['kind']) && RemoteSourceRepository.lastConfigRev != null)
+            'config_rev': RemoteSourceRepository.lastConfigRev,
+        },
+      ]);
+      if (!confirmed) throw StateError('accusé non confirmé');
