+  Future<bool> _ack(String mac, List<Map<String, Object?>> orders) async {
+    if (orders.isEmpty) return true;
+    final http.Client client = clientFactory();
+    try {
+      final http.Response response = await client.post(
+        Uri.parse('$kSubscriptionBaseUrl/api/box/ack/$mac'),
+        headers: await DeviceSecret.instance.headers(jsonBody: true),
+        body: jsonEncode(<String, Object?>{'orders': orders}),
+      ).timeout(const Duration(seconds: 8));
+      if (response.statusCode != 200) return false;
+      final Object? decoded = jsonDecode(response.body);
+      if (decoded is! Map || decoded['results'] is! List) return false;
+      final List<dynamic> results = decoded['results'] as List<dynamic>;
+      return orders.every((order) => results.any((result) => result is Map &&
+        result['order_id'] == order['order_id'] && result['status'] == 200 &&
+        result['error'] == null && (result['state'] == order['state'] ||
+          (order['state'] == 'received' && result['state'] == 'applied'))));
+    } catch (_) { return false; }
+    finally { client.close(); }
+  }
+
+  Future<void> _applyTracked(Object? body, int cursor, String mac, int gen) async {
+    final List<Map<String, Object?>> tracked = <Map<String, Object?>>[];
+    if (body is Map && body['box'] is List) {
+      for (final Object? item in body['box'] as List) {
+        if (item is! Map || item['id'] is! num || (item['id'] as num) <= cursor) continue;
+        final String id = '${item['order_id'] ?? ''}';
+        if (!RegExp(r'^[A-Za-z0-9_.:-]{8,80}$').hasMatch(id)) continue;
+        tracked.add(<String, Object?>{'order_id': id, 'kind': '${item['kind'] ?? ''}'});
+      }
+    }
+    final int received = DateTime.now().millisecondsSinceEpoch;
+    String version = '';
+    if (tracked.isNotEmpty) {
+      try { version = (await PackageInfo.fromPlatform()).version; } catch (_) {}
+      unawaited(_ack(mac, <Map<String, Object?>>[
+        for (final item in tracked) <String, Object?>{
+          'order_id': item['order_id'], 'state': 'received',
+          'received_at': received, 'app_version': version,
+        },
+      ]));
+    }
+    try {
+      await trigger();
+      if (gen != _generation) throw StateError('veille arrêtée');
+      final bool confirmed = await _ack(mac, <Map<String, Object?>>[
