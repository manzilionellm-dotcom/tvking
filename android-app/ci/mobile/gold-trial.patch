diff --git a/lib/features/subscription/data/gold_trial_backend.dart b/lib/features/subscription/data/gold_trial_backend.dart
new file mode 100644
index 0000000..4b26421
--- /dev/null
+++ b/lib/features/subscription/data/gold_trial_backend.dart
@@ -0,0 +1,169 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:http/http.dart' as http;
+
+/// L'essai utilise son adresse dédiée, sans déplacer le heartbeat ni
+/// l'activation habituelle. Aucune réponse brute n'est transmise à l'UI.
+const String kGoldTrialBaseUrl =
+    'https://seven-motion-backend.manzilionel-lm.workers.dev';
+const String kGoldTrialPlaylistName = '7 MOTION Essai';
+
+enum GoldTrialOutcome {
+  idle,
+  activated,
+  alreadyUsed,
+  alreadyCustomer,
+  inProgress,
+  disabled,
+  dailyCap,
+  error,
+}
+
+class GoldTrialResult {
+  const GoldTrialResult(this.outcome, {this.expire});
+  final GoldTrialOutcome outcome;
+  final DateTime? expire;
+}
+
+class GoldTrialIdentity {
+  const GoldTrialIdentity({
+    required this.mac,
+    required this.androidId,
+    required this.appVersion,
+  });
+  final String mac;
+  final String androidId;
+  final String appVersion;
+}
+
+class GoldTrialBackend {
+  GoldTrialBackend({
+    this.baseUrl = kGoldTrialBaseUrl,
+    http.Client Function()? clientFactory,
+  }) : _clientFactory = clientFactory ?? http.Client.new;
+
+  final String baseUrl;
+  final http.Client Function() _clientFactory;
+  final Set<http.Client> _pending = <http.Client>{};
+
+  /// Un client par requête permet d'arrêter réellement le réseau au timeout,
+  /// au départ de l'écran et au bout des 30 secondes de sondage.
+  Future<http.Response> _request(
+    Future<http.Response> Function(http.Client) send,
+    Duration timeout,
+  ) async {
+    final http.Client client = _clientFactory();
+    _pending.add(client);
+    try {
+      return await send(client).timeout(timeout);
+    } finally {
+      _pending.remove(client);
+      client.close();
+    }
+  }
+
+  Future<GoldTrialResult> activate(GoldTrialIdentity identity) async {
+    try {
+      final String mac = identity.mac.toUpperCase();
+      if (!RegExp(r'^MK(?::[0-9A-F]{2}){5}$').hasMatch(mac) ||
+          identity.androidId.trim().isEmpty ||
+          identity.appVersion.trim().isEmpty) {
+        return const GoldTrialResult(GoldTrialOutcome.error);
+      }
+      final http.Response response = await _request(
+        (http.Client client) => client.post(
+          Uri.parse('$baseUrl/api/gold-trial'),
+          headers: const <String, String>{
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+          },
+          body: jsonEncode(<String, String>{
+            'mac': mac,
+            'android_id': identity.androidId,
+            'app_version': identity.appVersion,
+          }),
+        ),
+        const Duration(seconds: 15),
+      );
+      final Object? body = jsonDecode(response.body);
+      if (body is! Map<String, dynamic>) {
+        return const GoldTrialResult(GoldTrialOutcome.error);
+      }
+      if (response.statusCode == 201 && body['ok'] == true) {
+        final DateTime? expire = parseExpiration(body['expire']);
+        return expire == null
+            ? const GoldTrialResult(GoldTrialOutcome.error)
+            : GoldTrialResult(GoldTrialOutcome.activated, expire: expire);
+      }
+      final Object? code = body['error'] is String ? body['error'] : body['code'];
+      final GoldTrialOutcome outcome = switch ((response.statusCode, code)) {
+        (409, 'trial_already_used') => GoldTrialOutcome.alreadyUsed,
+        (409, 'already_customer') => GoldTrialOutcome.alreadyCustomer,
+        (409, 'in_progress') => GoldTrialOutcome.inProgress,
+        (403, 'trial_disabled') => GoldTrialOutcome.disabled,
+        (429, 'daily_cap_reached' || 'rate_limited') => GoldTrialOutcome.dailyCap,
+        _ => GoldTrialOutcome.error,
+      };
+      return GoldTrialResult(outcome);
+    } catch (_) {
+      // Ne jamais afficher une exception, un message serveur, une clé ou
+      // une adresse fournisseur, même si le serveur renvoie du HTML.
+      return const GoldTrialResult(GoldTrialOutcome.error);
+    }
+  }
+
+  /// Lecture uniquement : le chargement reste assuré par le synchroniseur
+  /// existant, avec ses protections contre les doublons et suppressions.
+  Future<bool> hasAssignedTrial(
+    String mac, {
+    required Map<String, String> headers,
+    required Duration timeout,
+  }) async {
+    final http.Response response = await _request(
+      (http.Client client) => client.get(
+        Uri.parse('$baseUrl/api/device-source/${Uri.encodeComponent(mac)}'),
+        headers: <String, String>{'Accept': 'application/json', ...headers},
+      ),
+      timeout,
+    );
+    if (response.statusCode != 200) return false;
+    final Object? body = jsonDecode(response.body);
+    if (body is! Map<String, dynamic> || body['blocked'] != null) return false;
+    final Object? sources = body['sources'];
+    final List<Object?> candidates = sources is List && sources.isNotEmpty
+        ? List<Object?>.from(sources)
+        : <Object?>[body['source']];
+    return candidates.whereType<Map<String, dynamic>>().any(
+          (Map<String, dynamic> source) =>
+              source['enabled'] != false &&
+              source['label'] == kGoldTrialPlaylistName,
+        );
+  }
+
+  /// Le contrat peut fournir une date ISO ou un timestamp Unix (secondes
+  /// ou millisecondes). Une date invalide ne doit pas devenir une fausse fin.
+  static DateTime? parseExpiration(Object? value) {
+    final num? epoch = value is num
+        ? value
+        : value is String
+            ? num.tryParse(value)
+            : null;
+    if (epoch != null && epoch.isFinite && epoch > 0) {
+      final int ms = (epoch < 100000000000 ? epoch * 1000 : epoch).toInt();
+      try {
+        return DateTime.fromMillisecondsSinceEpoch(ms, isUtc: true);
+      } catch (_) {
+        return null;
+      }
+    }
+    return value is String ? DateTime.tryParse(value) : null;
+  }
+
+  void cancelPending() {
+    for (final http.Client client in _pending.toList()) {
+      client.close();
+    }
+    _pending.clear();
+  }
+}
diff --git a/lib/features/subscription/data/gold_trial_controller.dart b/lib/features/subscription/data/gold_trial_controller.dart
new file mode 100644
index 0000000..6b0af91
--- /dev/null
+++ b/lib/features/subscription/data/gold_trial_controller.dart
@@ -0,0 +1,260 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../../device/data/device_identity.dart';
+import '../../device/data/device_secret.dart';
+import '../../playlists/data/playlist_repository.dart';
+import '../../playlists/data/remote_source_repository.dart';
+import 'gold_trial_backend.dart';
+import 'subscription_state.dart';
+
+/// Un seul contrôleur vit dans l'accueil, même lorsque l'arrivée des
+/// chaînes remplace l'écran vide. Un double clic ne crée jamais deux POST.
+class GoldTrialController extends ChangeNotifier {
+  GoldTrialController({
+    GoldTrialBackend? backend,
+    Future<GoldTrialIdentity> Function()? loadIdentity,
+    Future<Map<String, String>> Function()? sourceHeaders,
+    Future<RemoteSyncResult> Function()? importSource,
+    bool Function()? hasSubscription,
+    bool Function()? hasLoadedTrial,
+    Listenable? subscriptionChanges,
+    Listenable? sourceChanges,
+  })  : _backend = backend ?? GoldTrialBackend(),
+        _loadIdentity = loadIdentity ?? _deviceIdentity,
+        _sourceHeaders = sourceHeaders ?? DeviceSecret.instance.headers,
+        _importSource = importSource ?? RemoteSourceRepository.sync,
+        _hasSubscription = hasSubscription ?? _deviceHasSubscription,
+        _hasLoadedTrial = hasLoadedTrial ?? _deviceHasTrial,
+        _subscriptionChanges = subscriptionChanges ?? SubscriptionState.instance,
+        _sourceChanges = sourceChanges ?? RemoteSourceRepository.pushedTick {
+    _subscriptionChanges.addListener(_changed);
+    _sourceChanges.addListener(_sourcePushed);
+  }
+
+  final GoldTrialBackend _backend;
+  final Future<GoldTrialIdentity> Function() _loadIdentity;
+  final Future<Map<String, String>> Function() _sourceHeaders;
+  final Future<RemoteSyncResult> Function() _importSource;
+  final bool Function() _hasSubscription;
+  final bool Function() _hasLoadedTrial;
+  final Listenable _subscriptionChanges;
+  final Listenable _sourceChanges;
+  GoldTrialIdentity? _identity;
+  GoldTrialResult result = const GoldTrialResult(GoldTrialOutcome.idle);
+  bool ready = false;
+  bool requesting = false;
+  bool waitingForSource = false;
+  bool importing = false;
+  bool sourceFailed = false;
+  bool sourceLoaded = false;
+  bool _disposed = false;
+  bool _checkingSource = false;
+  int _generation = 0;
+  Timer? _poll;
+  Timer? _deadline;
+  Stopwatch? _elapsed;
+
+  bool get busy => requesting || waitingForSource || importing;
+  bool get visible => ready && !_hasSubscription() &&
+      result.outcome != GoldTrialOutcome.alreadyCustomer;
+  bool get canRequest => visible && !busy &&
+      result.outcome != GoldTrialOutcome.activated &&
+      result.outcome != GoldTrialOutcome.alreadyUsed;
+
+  static bool _deviceHasSubscription() {
+    final SubscriptionState subscription = SubscriptionState.instance;
+    // Attendre la lecture du cache évite d'offrir un essai à un abonné
+    // pendant le tout premier rendu, y compris hors connexion.
+    return !subscription.isLoaded || subscription.remote.paid ||
+        subscription.status == SubscriptionStatus.paid;
+  }
+
+  static bool _deviceHasTrial() =>
+      PlaylistRepository.instance.currentPlaylists.any((p) =>
+          p.name == kGoldTrialPlaylistName && p.channelCount > 0);
+
+  static Future<GoldTrialIdentity> _deviceIdentity() async {
+    final String mac = await DeviceIdentity.instance.mac;
+    final String androidId = await DeviceIdentity.instance.androidId();
+    final PackageInfo package = await PackageInfo.fromPlatform();
+    return GoldTrialIdentity(
+      mac: mac,
+      androidId: androidId,
+      // versionName Android : ni versionCode, ni numéro de build humain.
+      appVersion: package.version,
+    );
+  }
+
+  String get _cacheKey => 'gold_trial.${_identity!.mac}';
+
+  Future<void> initialize() async {
+    try {
+      _identity = await _loadIdentity();
+      if (_disposed) return;
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      if (_disposed) return;
+      if (prefs.getBool('$_cacheKey.customer') == true) {
+        result = const GoldTrialResult(GoldTrialOutcome.alreadyCustomer);
+      } else if (prefs.getInt('$_cacheKey.expire') case final int ms) {
+        result = ms > DateTime.now().millisecondsSinceEpoch
+            ? GoldTrialResult(GoldTrialOutcome.activated,
+                expire: DateTime.fromMillisecondsSinceEpoch(ms, isUtc: true))
+            : const GoldTrialResult(GoldTrialOutcome.alreadyUsed);
+      } else if (prefs.getBool('$_cacheKey.used') == true) {
+        result = const GoldTrialResult(GoldTrialOutcome.alreadyUsed);
+      }
+    } catch (_) {
+      // La lecture de l'identité sera retentée au clic si nécessaire.
+    }
+    if (_disposed) return;
+    ready = true;
+    if (result.outcome == GoldTrialOutcome.activated) _startWaiting();
+    _changed();
+  }
+
+  Future<void> request() async {
+    if (!canRequest || _disposed) return;
+    // Ce verrou est posé AVANT le premier await, pas après le POST.
+    requesting = true;
+    sourceFailed = false;
+    _changed();
+    try {
+      _identity ??= await _loadIdentity();
+      if (_disposed) return;
+      result = await _backend.activate(_identity!);
+      if (_disposed) return;
+      await _rememberResult();
+      if (_disposed) return;
+      if (result.outcome == GoldTrialOutcome.activated ||
+          result.outcome == GoldTrialOutcome.inProgress) {
+        _startWaiting();
+      }
+    } catch (_) {
+      if (!_disposed) result = const GoldTrialResult(GoldTrialOutcome.error);
+    } finally {
+      requesting = false;
+      _changed();
+    }
+  }
+
+  Future<void> _rememberResult() async {
+    try {
+      final SharedPreferences prefs = await SharedPreferences.getInstance();
+      switch (result.outcome) {
+        case GoldTrialOutcome.alreadyCustomer:
+          await prefs.setBool('$_cacheKey.customer', true);
+          return;
+        case GoldTrialOutcome.alreadyUsed:
+          await prefs.setBool('$_cacheKey.used', true);
+          return;
+        case GoldTrialOutcome.activated:
+          await prefs.setInt('$_cacheKey.expire', result.expire!.millisecondsSinceEpoch);
+          return;
+        default:
+          break;
+      }
+    } catch (_) {
+      // Une écriture locale impossible n'annule pas un essai confirmé.
+    }
+  }
+
+  /// Reprend uniquement la lecture de la source, sans jamais recréer l'essai.
+  void retrySource() {
+    if (_disposed || busy || (result.outcome != GoldTrialOutcome.activated &&
+        result.outcome != GoldTrialOutcome.inProgress)) {
+      return;
+    }
+    _startWaiting();
+    _changed();
+  }
+
+  void _startWaiting() {
+    _stopWaiting();
+    sourceFailed = false;
+    sourceLoaded = _hasLoadedTrial();
+    if (sourceLoaded) return;
+    waitingForSource = true;
+    _elapsed = Stopwatch()..start();
+    _poll = Timer.periodic(const Duration(seconds: 2), (_) => _sourcePushed());
+    _deadline = Timer(const Duration(seconds: 30), () {
+      _stopWaiting();
+      _backend.cancelPending();
+      sourceFailed = true;
+      _changed();
+    });
+  }
+
+  void _sourcePushed() {
+    if (waitingForSource && !_checkingSource && !_disposed) {
+      unawaited(_checkSource());
+    }
+  }
+
+  Future<void> _checkSource() async {
+    _checkingSource = true;
+    final int generation = _generation;
+    try {
+      if (_hasLoadedTrial()) {
+        _stopWaiting();
+        sourceLoaded = true;
+        return;
+      }
+      // La preuve existante est réutilisée, sans en exposer la valeur ni
+      // modifier l'inscription de l'appareil au backend.
+      final Map<String, String> headers = await _sourceHeaders()
+          .timeout(const Duration(seconds: 2));
+      if (_disposed || generation != _generation) return;
+      final Duration remaining = const Duration(seconds: 30) - _elapsed!.elapsed;
+      if (remaining <= Duration.zero) return;
+      final bool assigned = await _backend.hasAssignedTrial(
+        _identity!.mac,
+        headers: headers,
+        timeout: remaining < const Duration(seconds: 2)
+            ? remaining : const Duration(seconds: 2),
+      );
+      if (!assigned || _disposed || generation != _generation) return;
+      // Le synchroniseur existant sérialise les imports concurrents (push
+      // box, démarrage, vérification manuelle). On garde cette unique voie.
+      _stopWaiting();
+      importing = true;
+      _changed();
+      await _importSource();
+      if (_disposed) return;
+      sourceLoaded = _hasLoadedTrial();
+      sourceFailed = !sourceLoaded;
+    } catch (_) {
+      // Une panne de GET se retente au prochain tick, jusqu'à la limite.
+      if (importing && !_disposed) sourceFailed = true;
+    } finally {
+      _checkingSource = false;
+      importing = false;
+      _changed();
+    }
+  }
+
+  void _stopWaiting() {
+    _generation++;
+    waitingForSource = false;
+    _poll?.cancel();
+    _deadline?.cancel();
+    _elapsed?.stop();
+  }
+
+  void _changed() {
+    if (!_disposed) notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _stopWaiting();
+    _backend.cancelPending();
+    _subscriptionChanges.removeListener(_changed);
+    _sourceChanges.removeListener(_sourcePushed);
+    super.dispose();
+  }
+}
diff --git a/lib/features/subscription/presentation/gold_trial_card.dart b/lib/features/subscription/presentation/gold_trial_card.dart
new file mode 100644
index 0000000..af476cf
--- /dev/null
+++ b/lib/features/subscription/presentation/gold_trial_card.dart
@@ -0,0 +1,107 @@
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../../../core/theme/app_colors.dart';
+import '../../../core/theme/app_text_styles.dart';
+import '../data/gold_trial_backend.dart';
+import '../data/gold_trial_controller.dart';
+
+/// Les textes sont volontairement fermés : jamais de message ou d'URL
+/// provenant du fournisseur dans cette carte, même pour les erreurs.
+class GoldTrialCard extends StatelessWidget {
+  const GoldTrialCard({super.key, required this.controller});
+  final GoldTrialController controller;
+
+  static final Uri whatsapp = Uri.parse('https://wa.me/447307410512');
+
+  @override
+  Widget build(BuildContext context) => ListenableBuilder(
+        listenable: controller,
+        builder: (BuildContext context, _) {
+          if (!controller.visible) return const SizedBox.shrink();
+          final colors = AppColors.lumiere(context);
+          final GoldTrialOutcome outcome = controller.result.outcome;
+          final String? message = switch (outcome) {
+            GoldTrialOutcome.activated => 'Essai activé ✔',
+            GoldTrialOutcome.alreadyUsed =>
+              'Tu as déjà utilisé ton essai gratuit. Contacte-nous sur WhatsApp pour t’abonner.',
+            GoldTrialOutcome.inProgress =>
+              'Activation en cours, patiente quelques secondes.',
+            GoldTrialOutcome.disabled => 'Les essais sont fermés pour le moment.',
+            GoldTrialOutcome.dailyCap =>
+              'Plus d’essais disponibles aujourd’hui, reviens demain.',
+            GoldTrialOutcome.error => 'Erreur, réessaie.',
+            _ => null,
+          };
+          final bool showWhatsApp = outcome == GoldTrialOutcome.alreadyUsed ||
+              outcome == GoldTrialOutcome.disabled || outcome == GoldTrialOutcome.dailyCap;
+          final DateTime? expire = controller.result.expire;
+          return Padding(
+            padding: const EdgeInsets.symmetric(vertical: 12),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: <Widget>[
+                if (outcome != GoldTrialOutcome.activated &&
+                    outcome != GoldTrialOutcome.alreadyUsed)
+                  FilledButton.icon(
+                    key: const ValueKey<String>('gold-trial-button'),
+                    onPressed: controller.canRequest ? controller.request : null,
+                    icon: controller.requesting
+                        ? SizedBox.square(
+                            dimension: 18,
+                            child: CircularProgressIndicator(
+                              strokeWidth: 2, color: colors.textPrimary),
+                          )
+                        : const Icon(Icons.play_circle_outline),
+                    label: Text(controller.requesting
+                        ? 'Activation de ton essai…' : 'Je teste'),
+                  ),
+                if (message != null) ...<Widget>[
+                  const SizedBox(height: 8),
+                  Semantics(
+                    liveRegion: true,
+                    child: Text(message, textAlign: TextAlign.center,
+                        style: AppTextStyles.bodyMedium.copyWith(color: colors.textPrimary)),
+                  ),
+                ],
+                if (expire != null) Text(
+                  'Expiration : ${DateFormat('dd/MM/yyyy à HH:mm').format(expire.toLocal())}',
+                  textAlign: TextAlign.center,
+                  style: AppTextStyles.bodyMedium.copyWith(color: colors.textSecondary),
+                ),
+                if (controller.waitingForSource || controller.importing) ...<Widget>[
+                  const SizedBox(height: 8),
+                  const LinearProgressIndicator(),
+                ],
+                if (controller.sourceFailed) ...<Widget>[
+                  Text('Erreur, réessaie.', textAlign: TextAlign.center,
+                      style: AppTextStyles.bodyMedium.copyWith(color: colors.textPrimary)),
+                  OutlinedButton(
+                    onPressed: controller.busy ? null : controller.retrySource,
+                    child: const Text('Réessayer le chargement'),
+                  ),
+                ],
+                if (showWhatsApp) OutlinedButton.icon(
+                  onPressed: () => _openWhatsApp(context),
+                  icon: const Icon(Icons.chat_outlined),
+                  label: const Text('WhatsApp'),
+                ),
+              ],
+            ),
+          );
+        },
+      );
+
+  Future<void> _openWhatsApp(BuildContext context) async {
+    try {
+      if (await launchUrl(whatsapp, mode: LaunchMode.externalApplication)) return;
+    } catch (_) {
+      // Même message fermé si WhatsApp/le navigateur n'est pas disponible.
+    }
+    if (!context.mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      const SnackBar(content: Text('Erreur, réessaie.')),
+    );
+  }
+}
