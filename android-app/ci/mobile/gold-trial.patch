+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/theme/app_theme.dart';
+import 'package:tv_king/features/subscription/data/gold_trial_backend.dart';
+import 'package:tv_king/features/subscription/data/gold_trial_controller.dart';
+import 'package:tv_king/features/subscription/presentation/gold_trial_card.dart';
+
+import '../../support/premium_capture_fonts.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUpAll(preparePremiumCaptureFonts);
+  setUp(() => SharedPreferences.setMockInitialValues(<String, Object>{}));
+
+  GoldTrialController create(int status, String body, {Completer<http.Response>? pending, bool customer=false}) =>
+      GoldTrialController(
+        backend: GoldTrialBackend(clientFactory: () => MockClient((_) async {
+          if (pending != null) return await pending.future;
+          return http.Response(body, status);
+        })),
+        loadIdentity: () async => const GoldTrialIdentity(mac:'MK:11:22:33:44:55', androidId:'test', appVersion:'1'),
+        hasSubscription: () => customer,
+        hasLoadedTrial: () => true,
+      );
+
+  Future<void> show(WidgetTester tester, GoldTrialController controller) async {
+    await controller.initialize();
+    await tester.pumpWidget(MaterialApp(theme: AppTheme.cinema,
+      home: Scaffold(body: SingleChildScrollView(child: GoldTrialCard(controller: controller)))));
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('chargement exact et bouton réellement désactivé', (tester) async {
+    final Completer<http.Response> pending=Completer<http.Response>();
+    final GoldTrialController controller=create(500, '{}', pending:pending);
+    addTearDown(controller.dispose);
+    await show(tester,controller);
+    await tester.tap(find.text('Je teste')); await tester.pump();
+    expect(find.text('Activation de ton essai…'), findsOneWidget);
+    final FilledButton button=tester.widget(find.byType(FilledButton));
+    expect(button.onPressed,isNull);
+    pending.complete(http.Response('{}',500)); await tester.pumpAndSettle();
+    expect(find.text('Erreur, réessaie.'),findsOneWidget);
+    expect(find.text('Je teste'),findsOneWidget);
+  });
+
+  for (final (int status, String code, String text, bool whatsapp) in <(int, String, String, bool)>[
+    (409,'trial_already_used','Tu as déjà utilisé ton essai gratuit. Contacte-nous sur WhatsApp pour t’abonner.',true),
+    (409,'in_progress','Activation en cours, patiente quelques secondes.',false),
+    (403,'trial_disabled','Les essais sont fermés pour le moment.',true),
+    (429,'daily_cap_reached','Plus d’essais disponibles aujourd’hui, reviens demain.',true),
+    (429,'rate_limited','Plus d’essais disponibles aujourd’hui, reviens demain.',true),
+    (500,'private-provider','Erreur, réessaie.',false),
+  ]) {
+    testWidgets('$code : texte demandé et WhatsApp, aucune donnée fournisseur', (tester) async {
+      final GoldTrialController controller=create(status,'{"error":"$code","message":"private-provider-secret"}');
+      addTearDown(controller.dispose);
+      await show(tester,controller);
+      await tester.tap(find.text('Je teste')); await tester.pumpAndSettle();
+      expect(find.text(text),findsOneWidget);
+      expect(find.text('WhatsApp'), whatsapp?findsOneWidget:findsNothing);
+      expect(find.textContaining('private-provider'),findsNothing);
+      expect(GoldTrialCard.whatsapp.toString(),'https://wa.me/447307410512');
+    });
+  }
+
+  testWidgets('succès : confirmation et date ; déjà client : carte cachée', (tester) async {
+    final GoldTrialController controller=create(201,'{"ok":true,"expire":"2026-10-27T12:00:00Z"}');
+    addTearDown(controller.dispose);
+    await show(tester,controller);
+    await tester.tap(find.text('Je teste')); await tester.pumpAndSettle();
+    expect(find.text('Essai activé ✔'),findsOneWidget);
+    expect(find.textContaining('27/10/2026'),findsOneWidget);
+    expect(find.text('Je teste'),findsNothing);
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    final GoldTrialController customer=create(409,'{"error":"already_customer"}');
+    addTearDown(customer.dispose);
+    await show(tester,customer);
+    await tester.tap(find.text('Je teste')); await tester.pumpAndSettle();
+    expect(find.byType(FilledButton),findsNothing);
+  });
+
+  testWidgets('abonné : aucun bouton Je teste', (tester) async {
+    final GoldTrialController controller=create(500,'{}',customer:true);
+    addTearDown(controller.dispose); await show(tester,controller);
+    expect(find.text('Je teste'),findsNothing);
+  });
+}
diff --git a/test/features/subscription/gold_trial_controller_test.dart b/test/features/subscription/gold_trial_controller_test.dart
new file mode 100644
index 0000000..c4beeb0
--- /dev/null
+++ b/test/features/subscription/gold_trial_controller_test.dart
@@ -0,0 +1,145 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/features/playlists/data/remote_source_repository.dart';
+import 'package:tv_king/features/subscription/data/gold_trial_backend.dart';
+import 'package:tv_king/features/subscription/data/gold_trial_controller.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  const GoldTrialIdentity identity = GoldTrialIdentity(
+      mac:'MK:11:22:33:44:55', androidId:'test-id', appVersion:'1.2.3');
+  late ValueNotifier<bool> subscription;
+  late ValueNotifier<int> push;
+  late GoldTrialController controller;
+  int posts = 0;
+  int gets = 0;
+  int imports = 0;
+  bool assigned = false;
+  bool loaded = false;
+  int status = 201;
+  String body = '';
+  Completer<http.Response>? pending;
+
+  GoldTrialController create() => GoldTrialController(
+    backend: GoldTrialBackend(clientFactory: () => MockClient((request) async {
+      if (request.method == 'POST') {
+        posts++;
+        if (pending != null) return await pending!.future;
+        return http.Response(body, status);
+      }
+      gets++;
+      return http.Response(assigned
+          ? '{"source":{"label":"7 MOTION Essai"}}' : '{"source":null}', 200);
+    })),
+    loadIdentity: () async => identity,
+    sourceHeaders: () async => <String, String>{},
+    importSource: () async { imports++; loaded=true; return RemoteSyncResult.loaded; },
+    hasSubscription: () => subscription.value,
+    hasLoadedTrial: () => loaded,
+    subscriptionChanges: subscription, sourceChanges: push,
+  );
+
+  setUp(() {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    subscription = ValueNotifier<bool>(false);
+    push = ValueNotifier<int>(0);
+    posts=0; gets=0; imports=0; assigned=false; loaded=false;
+    status=201; body='{"ok":true,"expire":1793102400}'; pending=null;
+    controller=create();
+  });
+  tearDown(() { controller.dispose(); subscription.dispose(); push.dispose(); });
+
+  test('abonné : bouton absent avant et après une notification', () async {
+    subscription.value=true;
+    await controller.initialize();
+    expect(controller.visible, isFalse);
+    await controller.request();
+    expect(posts, 0);
+    subscription.value=false;
+    expect(controller.visible, isTrue);
+    subscription.value=true;
+    expect(controller.visible, isFalse);
+  });
+
+  testWidgets('double clic : un seul POST puis arrivée automatique de la liste', (tester) async {
+    await controller.initialize();
+    pending=Completer<http.Response>();
+    final Future<void> first=controller.request();
+    final Future<void> second=controller.request();
+    await tester.pump();
+    expect(posts, 1);
+    expect(controller.requesting, isTrue);
+    expect(controller.canRequest, isFalse);
+    pending!.complete(http.Response(body, status));
+    await first; await second;
+    expect(controller.result.outcome, GoldTrialOutcome.activated);
+    await tester.pump(const Duration(seconds: 2));
+    expect(gets, 1); expect(imports, 0);
+    assigned=true;
+    await tester.pump(const Duration(seconds: 2));
+    expect(imports, 1); expect(loaded, isTrue);
+    expect(controller.busy, isFalse);
+    await tester.pump(const Duration(seconds: 40));
+    expect(gets, 2); expect(posts, 1);
+  });
+
+  testWidgets('push box : relecture immédiate, sans attendre 2 secondes', (tester) async {
+    await controller.initialize();
+    await controller.request();
+    assigned=true;
+    push.value++;
+    await tester.pump();
+    expect(gets, 1); expect(imports, 1);
+    expect(controller.sourceLoaded, isTrue);
+  });
+
+  testWidgets('sondage arrêté à 30 secondes ; reprise sans second POST', (tester) async {
+    await controller.initialize(); await controller.request();
+    for (int i=0; i<16; i++) { await tester.pump(const Duration(seconds: 2)); }
+    final int total=gets;
+    expect(total, inInclusiveRange(14, 15));
+    expect(controller.busy, isFalse);
+    expect(controller.sourceFailed, isTrue);
+    await tester.pump(const Duration(seconds: 60));
+    expect(gets, total);
+    assigned=true; controller.retrySource();
+    await tester.pump(const Duration(seconds: 2));
+    expect(imports, 1); expect(posts, 1);
+  });
+
+  test('already_customer reste masqué après retour à l’accueil', () async {
+    status=409; body='{"error":"already_customer"}';
+    await controller.initialize(); await controller.request();
+    expect(controller.visible, isFalse);
+    controller.dispose(); controller=create();
+    await controller.initialize();
+    expect(controller.visible, isFalse);
+    await controller.request(); expect(posts, 1);
+  });
+
+  testWidgets('in_progress attend la source et interdit les doubles POST', (tester) async {
+    status=409; body='{"error":"in_progress"}';
+    await controller.initialize(); await controller.request();
+    expect(controller.waitingForSource, isTrue);
+    await controller.request(); expect(posts, 1);
+    assigned=true; await tester.pump(const Duration(seconds: 2));
+    expect(imports, 1);
+  });
+
+  testWidgets('quitter pendant le POST ne démarre aucun sondage tardif', (tester) async {
+    await controller.initialize(); pending=Completer<http.Response>();
+    final Future<void> request=controller.request();
+    await tester.pump();
+    controller.dispose();
+    pending!.complete(http.Response(body, 201));
+    await request;
+    controller=create();
+    await tester.pump(const Duration(seconds: 40));
+    expect(gets, 0); expect(imports, 0);
+  });
+}
