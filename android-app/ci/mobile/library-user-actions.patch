@@ -0,0 +1,42 @@
+import '../../vod/data/series_repository.dart';
+import '../../vod/data/vod_repository.dart';
+import 'playlist_repository.dart';
+import 'remote_source_repository.dart';
+
+/// Résultat du travail réellement terminé, jamais un simple délai d'animation.
+class LibraryRefreshResult {
+  const LibraryRefreshResult({required this.channels, required this.movies,
+    required this.series, required this.incomplete});
+  final int channels;
+  final int movies;
+  final int series;
+  final bool incomplete;
+}
+
+/// Un seul bouton logique pour l'accueil, le Cinéma et le geste d'actualisation.
+/// Le panel est relu sans lever les suppressions, les fichiers M3U sont
+/// retéléchargés, puis les API films/séries sont interrogées sans leur cache.
+abstract final class LibraryRefresh {
+  static Future<LibraryRefreshResult>? _work;
+
+  static Future<LibraryRefreshResult> refresh() =>
+      _work ??= _refresh().whenComplete(() => _work = null);
+
+  static Future<LibraryRefreshResult> _refresh() async {
+    final RemoteSyncResult sync = await RemoteSourceRepository.sync();
+    final int expected = (await PlaylistRepository.instance.getAllPlaylists()).length;
+    final int updated = await PlaylistRepository.instance.refreshAll();
+    // Les émissions SQLite ont fini avant la nouvelle génération de catalogue.
+    final movies = await VodRepository.instance.fetchMovies(forceRefresh: true);
+    final series = await SeriesRepository.instance.fetchSeries(forceRefresh: true);
+    return LibraryRefreshResult(
+      channels: (await PlaylistRepository.instance.getAllChannels()).length,
+      movies: movies.length,
+      series: series.length,
+      incomplete: sync == RemoteSyncResult.networkError ||
+          sync == RemoteSyncResult.sourceFailed || updated < expected ||
+          VodRepository.instance.lastRefreshFailureCount > 0 ||
+          SeriesRepository.instance.lastRefreshFailureCount > 0,
+    );
+  }
+}
