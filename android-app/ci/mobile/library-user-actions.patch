+    expect(PlaylistRepository.instance.currentPlaylists,isEmpty);
+    expect(await PlaylistRepository.instance.getAllChannels(),isEmpty);
+  });
+
+  test('Tout actualiser ne restaure jamais une source effacée encore envoyée par le panel', () async {
