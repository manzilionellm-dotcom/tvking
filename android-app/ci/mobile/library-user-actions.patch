@@ -0,0 +1,47 @@
+import 'package:flutter/material.dart';
+
+import '../../../../core/i18n/l10n_extension.dart';
+import '../../../../core/theme/app_colors.dart';
+import '../../data/library_refresh.dart';
+
+/// Le bouton reste occupé jusqu'à la fin des vraies requêtes fournisseur.
+class LibraryRefreshButton extends StatefulWidget {
+  const LibraryRefreshButton({super.key, this.onComplete});
+  final VoidCallback? onComplete;
+
+  @override
+  State<LibraryRefreshButton> createState() => _LibraryRefreshButtonState();
+}
+
+class _LibraryRefreshButtonState extends State<LibraryRefreshButton> {
+  bool _busy = false;
+
+  Future<void> _refresh() async {
+    if (_busy) return;
+    setState(() => _busy = true);
+    try {
+      final LibraryRefreshResult result = await LibraryRefresh.refresh();
+      if (!mounted) return;
+      widget.onComplete?.call();
+      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(
+        result.incomplete ? context.l10n.libraryRefreshIncomplete :
+          context.l10n.libraryRefreshDone(result.channels, result.movies, result.series),
+      )));
+    } catch (_) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(context.l10n.libraryRefreshIncomplete)));
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => IconButton(
+    key: const ValueKey<String>('library-refresh'),
+    tooltip: _busy ? context.l10n.libraryRefreshRunning : context.l10n.libraryRefreshAction,
+    onPressed: _busy ? null : _refresh,
+    icon: _busy ? const SizedBox.square(dimension: 20,
+      child: CircularProgressIndicator(strokeWidth: 2, color: AppColors.accent)) :
+      const Icon(Icons.sync_rounded),
+  );
+}
