diff --git a/test/features/playlists/import_return_test.dart b/test/features/playlists/import_return_test.dart
new file mode 100644
index 0000000..ad249c6
--- /dev/null
+++ b/test/features/playlists/import_return_test.dart
@@ -0,0 +1,56 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:google_fonts/google_fonts.dart';
+import 'package:tv_king/l10n/generated/app_localizations.dart';
+import 'package:tv_king/features/playlists/data/import_progress.dart';
+import 'package:tv_king/features/playlists/presentation/import_progress_screen.dart';
+
+void main() {
+  GoogleFonts.config.allowRuntimeFetching = false;
+
+  for (final bool systemBack in <bool>[false, true]) {
+    testWidgets('import manuel : succès conservé avec ${systemBack ? 'le retour système' : 'le bouton Retour'}', (WidgetTester tester) async {
+      final Completer<int> done = Completer<int>();
+      ImportOutcome<int>? result;
+      late ImportProgressCallback progress;
+      await tester.pumpWidget(MaterialApp(
+        locale: const Locale('fr'),
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        home: Builder(builder: (BuildContext context) => Scaffold(body: TextButton(
+          onPressed: () async {
+            result = await runImportWithProgress<int>(context, title: 'Import',
+              waitForConfirmation: true,
+              task: (ImportProgressCallback p) { progress = p; return done.future; });
+          }, child: const Text('Ajouter'),
+        ))),
+      ));
+      await tester.tap(find.text('Ajouter'));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 300));
+      await tester.binding.handlePopRoute();
+      expect(find.byType(ImportProgressScreen<int>), findsOneWidget);
+      // La phase "done" ne suffit pas : le vrai travail doit être terminé.
+      progress(const ImportProgress(phase: ImportPhase.done, channelsFound: 25000));
+      await tester.pump();
+      expect(find.byKey(const ValueKey<String>('import-return')), findsNothing);
+      done.complete(25000);
+      await tester.pump();
+      await tester.pump(const Duration(seconds: 2));
+      expect(find.text('Retour aux chaînes'), findsOneWidget);
+      if (systemBack) {
+        await tester.binding.handlePopRoute();
+      } else {
+        await tester.ensureVisible(find.byKey(const ValueKey<String>('import-return')));
+        await tester.tap(find.byKey(const ValueKey<String>('import-return')));
+      }
+      await tester.pumpAndSettle();
+      expect(result?.ok, isTrue);
+      expect(result?.value, 25000);
+      expect(find.text('Ajouter'), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    });
+  }
+}
diff --git a/test/features/playlists/library_refresh_test.dart b/test/features/playlists/library_refresh_test.dart
new file mode 100644
index 0000000..fcbc6b8
--- /dev/null
+++ b/test/features/playlists/library_refresh_test.dart
@@ -0,0 +1,139 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+// ignore: depend_on_referenced_packages
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/features/playlists/data/library_refresh.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/data/source_opt_outs.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+import 'package:tv_king/features/vod/data/catalog_source.dart';
+import 'package:tv_king/features/vod/data/vod_repository.dart';
+import 'package:tv_king/features/vod/data/series_repository.dart';
+
+class _Paths extends PathProviderPlatform {
+  _Paths(this.path);
+  final String path;
+  @override Future<String?> getApplicationDocumentsPath() async => path;
+  @override Future<String?> getApplicationSupportPath() async => path;
+  @override Future<String?> getTemporaryPath() async => path;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  databaseFactory = databaseFactoryFfiNoIsolate;
+  FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+  final Directory dir = Directory.systemTemp.createTempSync('library-refresh-');
+  PathProviderPlatform.instance = _Paths(dir.path);
+  const Playlist source = Playlist(id: null, name: 'Test', type: PlaylistType.xtream,
+    xtreamServer: 'http://catalog.invalid', xtreamUsername: 'test', xtreamPassword: 'test', createdAt: 1);
+  int count = 1;
+  int movieRequests = 0;
+  bool fail = false;
+  bool serveDeleted = false;
+  late int id;
+
+  http.Client client() => MockClient((http.Request request) async {
+    if (request.url.path.startsWith('/api/device-source/')) {
+      return http.Response(jsonEncode(<String, Object>{'sources': <Object>[
+        if (serveDeleted) <String, Object>{'type':'xtream', 'server_url':'http://catalog.invalid', 'username':'test', 'password':'test'},
+      ]}), 200);
+    }
+    if (request.url.path.startsWith('/api/')) return http.Response('{}', 404);
+    final String? action = request.url.queryParameters['action'];
+    if (action == 'get_vod_streams') movieRequests++;
+    if (fail) return http.Response('offline', 503);
+    if (action == 'get_live_categories' || action == 'get_vod_categories' || action == 'get_series_categories') {
+      return http.Response('[{"category_id":"1","category_name":"FR Test"}]', 200);
+    }
+    if (action == 'get_live_streams' || action == 'get_vod_streams' || action == 'get_series') {
+      return http.Response(jsonEncode(<Object>[
+        for (int n=1;n<=count;n++) <String, Object>{'stream_id':n, 'series_id':n,
+          'name': action == 'get_vod_streams' ? 'Film $n' : 'Titre $n', 'category_id':'1', 'container_extension':'mp4'},
+      ]), 200);
+    }
+    return http.Response('{"user_info":{"auth":1,"status":"Active"}}', 200);
+  });
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{'device.virtual_mac.v1':'MK:11:22:33:44:55'});
+    count=1; movieRequests=0; fail=false; serveDeleted=false;
+    CatalogSource.httpForTesting=client;
+    await PlaylistRepository.instance.deleteAllPlaylists();
+    final Database db=await PlaylistDatabase.instance.database;
+    await db.delete('deleted_sources');
+    id=await db.insert('playlists',source.toMap());
+    await PlaylistRepository.instance.setActivePlaylist(id);
+  });
+  tearDown(() { CatalogSource.httpForTesting=null; });
+
+  test('un seul nouveau film dans une catégorie existante apparaît après Tout actualiser', () async {
+    await http.runWithClient(() async {
+      final movies=VodRepository.instance;
+      expect(await movies.fetchMovies(),hasLength(1));
+      final int before=movieRequests;
+      count=2;
+      final LibraryRefreshResult result=await LibraryRefresh.refresh();
+      expect(result.movies,2);
+      expect(result.series,2);
+      expect(result.incomplete,isFalse);
+      expect(movieRequests,greaterThan(before));
+      expect((await movies.fetchMovies()).map((m)=>m.name),contains('Film 2'));
+    },client);
+  });
+
+  test('deux demandes simultanées attendent la même fin réelle', () async {
+    await http.runWithClient(() async {
+      final Future<LibraryRefreshResult> first=LibraryRefresh.refresh();
+      final Future<LibraryRefreshResult> second=LibraryRefresh.refresh();
+      expect(identical(first,second),isTrue);
+      expect((await second).movies,1);
+      expect((await first).movies,1);
+    },client);
+  });
+
+  test('une panne garde le dernier catalogue et ne prétend pas avoir tout actualisé', () async {
+    await http.runWithClient(() async {
+      expect(await VodRepository.instance.fetchMovies(),hasLength(1));
+      expect(await SeriesRepository.instance.fetchSeries(),hasLength(1));
+      // Ne pas retélécharger le Direct : les catalogues gardent leur repli.
+      fail=true;
+      expect(await VodRepository.instance.fetchMovies(forceRefresh:true),hasLength(1));
+      expect(VodRepository.instance.lastRefreshFailureCount,greaterThan(0));
+      expect(await SeriesRepository.instance.fetchSeries(forceRefresh:true),hasLength(1));
+      expect(SeriesRepository.instance.lastRefreshFailureCount,greaterThan(0));
+    },client);
+  });
+
+  test('suppression interrompue : terminer le nettoyage avant le premier affichage', () async {
+    final Playlist deleted=(await PlaylistRepository.instance.getAllPlaylists()).single;
+    // État exact laissé par une coupure après le refus, avant le gros DELETE.
+    await SourceOptOuts.markDeleted(deleted);
+    final Database db=await PlaylistDatabase.instance.database;
+    await db.close();
+    PlaylistDatabase.instance.debugUseDatabase(null);
