diff --git a/test/features/playlists/source_endpoint_detection_test.dart b/test/features/playlists/source_endpoint_detection_test.dart
new file mode 100644
index 0000000..5503aeffdb7af1387dd050e42b6de21f1a63fbd6
--- /dev/null
+++ b/test/features/playlists/source_endpoint_detection_test.dart
@@ -0,0 +1,73 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/playlists/data/source_input_normalizer.dart';
+import 'package:tv_king/features/playlists/data/source_link_utils.dart';
+
+void main() {
+  test('un vrai fichier M3U protégé reste M3U avec son chemin et sa query', () {
+    for (final String extension in <String>['m3u', 'm3u8']) {
+      final String url = 'https://source.invalid/catalogue.$extension'
+          '?username=viewer&password=p%2Bass%26word&token=a%2Bb%3Dc';
+      final SourceInputAnalysis input = SourceInputNormalizer.analyze(url);
+      expect(input.kind, SourceInputKind.m3u);
+      expect(input.url, url);
+      expect(input.hasXtreamCredentials, isFalse);
+      expect(SourceLinkUtils.tryExtractXtreamPlaylistCredentials(url), isNull);
+    }
+  });
+
+  test('les paramètres seuls ne créent pas un endpoint Xtream', () {
+    for (final String path in <String>[
+      '/',
+      '/catalogue',
+      '/get.php/catalogue.m3u',
+      '/catalogue.m3u/player_api.php.backup',
+    ]) {
+      expect(
+        SourceLinkUtils.tryExtractXtreamPlaylistCredentials(
+          'https://source.invalid$path?username=viewer&password=pass',
+        ),
+        isNull,
+      );
+    }
+  });
+
+  test('les vrais endpoints gardent serveur, sous-chemin et identifiants', () {
+    for (final String endpoint in <String>[
+      'get.php',
+      'PLAYER_API.PHP',
+      'panel_api.php',
+    ]) {
+      final String url = 'https://source.invalid:8443/xtream/$endpoint'
+          '?username=viewer&password=p%2Bass%26word';
+      final credentials =
+          SourceLinkUtils.tryExtractXtreamPlaylistCredentials(url);
+      expect(credentials, isNotNull);
+      expect(credentials!.server, 'https://source.invalid:8443/xtream');
+      expect(credentials.username, 'viewer');
+      expect(credentials.password, 'p+ass&word');
+      final SourceInputAnalysis input = SourceInputNormalizer.analyze(url);
+      expect(input.kind, SourceInputKind.xtream);
+      expect(input.xtreamPassword, 'p+ass&word');
+    }
+  });
+
+  test('une promotion Xtream exige HTTP(S) et les deux identifiants', () {
+    for (final String url in <String>[
+      'file://source.invalid/get.php?username=viewer&password=pass',
+      'rtmp://source.invalid/get.php?username=viewer&password=pass',
+      'https://source.invalid/get.php?username=viewer',
+      'https://source.invalid/get.php?username=&password=pass',
+    ]) {
+      expect(SourceLinkUtils.tryExtractXtreamPlaylistCredentials(url), isNull);
+    }
+  });
+
+  test('le champ serveur explicite conserve son extraction générique', () {
+    final credentials = SourceLinkUtils.tryExtractXtreamCredentials(
+      'https://source.invalid/catalogue.m3u?username=viewer&password=pass',
+    );
+    expect(credentials, isNotNull);
+    expect(credentials!.username, 'viewer');
+    expect(credentials.password, 'pass');
+  });
+}
diff --git a/test/features/playlists/m3u_credentials_import_test.dart b/test/features/playlists/m3u_credentials_import_test.dart
new file mode 100644
index 0000000..5b1e090ed56ee1c59e5412c3b76f5247a78ce1f2
--- /dev/null
+++ b/test/features/playlists/m3u_credentials_import_test.dart
@@ -0,0 +1,140 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+// ignore: depend_on_referenced_packages
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:tv_king/core/flavor/flavor.dart';
+import 'package:tv_king/features/playlists/data/playlist_database.dart';
+import 'package:tv_king/features/playlists/data/playlist_repository.dart';
+import 'package:tv_king/features/playlists/data/remote_source_repository.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+
+class _Paths extends PathProviderPlatform {
+  _Paths(this.root);
+  final String root;
+  @override
+  Future<String?> getApplicationDocumentsPath() async => root;
+  @override
+  Future<String?> getApplicationSupportPath() async => root;
+  @override
+  Future<String?> getTemporaryPath() async => root;
+}
+
+// Hérite du vrai client Dart : une surcharge null reprendrait la surcharge
+// globale de Flutter et ne garantirait pas la connexion au serveur local.
+class _RealHttpOverrides extends HttpOverrides {}
+
+/// Vrai serveur HTTP local : la query protège un fichier, sans API Xtream.
+/// Toute tentative d'API est enregistrée, puis refusée ; un repli qui finit
+/// par réussir ne peut donc pas masquer le détour réseau dans le test.
+class _M3uServer {
+  _M3uServer(this.server) {
+    server.listen((HttpRequest request) async {
+      requests.add(request.uri);
+      if (request.uri.toString() == target) {
+        request.response.headers.contentType =
+            ContentType('audio', 'x-mpegurl', charset: 'utf-8');
+        request.response.write('#EXTM3U\n'
+            '#EXTINF:-1 group-title="Test",Chaîne test\n'
+            'http://stream.invalid/test.ts\n');
+      } else {
+        request.response.statusCode = HttpStatus.notFound;
+      }
+      await request.response.close();
+    });
+  }
+
+  final HttpServer server;
+  final List<Uri> requests = <Uri>[];
+  static const String target = '/catalogue.m3u'
+      '?username=viewer&password=p%2Bass%26word&token=a%2Bb%3Dc';
+  String get url => 'http://127.0.0.1:${server.port}$target';
+
+  static Future<_M3uServer> start() async =>
+      _M3uServer(await HttpServer.bind(InternetAddress.loopbackIPv4, 0));
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  databaseFactory = databaseFactoryFfiNoIsolate;
+  FlavorConfig.setCurrent(FlavorConfig.sevenMotion);
+  PathProviderPlatform.instance =
+      _Paths(Directory.systemTemp.createTempSync('m3u-credentials-').path);
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    RemoteSourceRepository.storeBuild = false;
+    RemoteSourceRepository.m3uLinkAsM3u = false;
+    RemoteSourceRepository.xtreamHttpForTest = null;
+    final Database db = await PlaylistDatabase.instance.database;
+    await db.delete('channels');
+    await db.delete('playlists');
+    await db.delete('deleted_sources');
+    await PlaylistRepository.instance.initialize();
+  });
+
+  test('deux ordres panel importent le M3U une seule fois, sans appel API', () async {
+    // Le binding Flutter simule HTTP par défaut : utiliser ici le vrai
+    // transport local, pour exercer le chemin réseau de production.
+    await HttpOverrides.runWithHttpOverrides(() async {
+      final _M3uServer provider = await _M3uServer.start();
+      addTearDown(() => provider.server.close(force: true));
+      final List<Map<String, dynamic>> sources = <Map<String, dynamic>>[
+        <String, dynamic>{
+          'type': 'm3u',
+          'label': 'Liste protégée',
+          'm3u_url': provider.url,
+        },
+      ];
+
+      expect(await RemoteSourceRepository.applySources(sources),
+          RemoteSyncResult.loaded);
+      final Database db = await PlaylistDatabase.instance.database;
+      expect(await db.query('channels'), hasLength(1),
+          reason: 'le résultat attend la véritable écriture SQLite');
+      expect(await PlaylistRepository.instance.getAllChannels(), hasLength(1));
+
+      // Golden envoie renouvellement puis source : la seconde application
+      // retrouve la liste réelle et ne sonde aucun endpoint inventé.
+      expect(await RemoteSourceRepository.applySources(sources),
+          RemoteSyncResult.loaded);
+      final Playlist saved =
+          (await PlaylistRepository.instance.getAllPlaylists()).single;
+      expect(saved.type, PlaylistType.m3u);
+      expect(saved.m3uUrl, provider.url);
+      expect(provider.requests.map((Uri uri) => uri.toString()).toList(),
+          <String>[_M3uServer.target]);
+
+      // Les anciens alias de suppression restent valables : aucun push
+      // ne ressuscite cette même URL après son retrait volontaire.
+      await PlaylistRepository.instance.deletePlaylist(saved.id!);
+      expect(await db.query('deleted_sources'), isNotEmpty);
+      expect(await RemoteSourceRepository.applySources(sources),
+          RemoteSyncResult.noSource);
+      expect(await PlaylistRepository.instance.getAllPlaylists(), isEmpty);
+      expect(await db.query('channels'), isEmpty);
+      expect(provider.requests, hasLength(1));
+    }, _RealHttpOverrides());
+  });
+
+  test('un M3U personnel protégé garde son URL sans essai Xtream', () async {
+    await HttpOverrides.runWithHttpOverrides(() async {
+      final _M3uServer provider = await _M3uServer.start();
+      addTearDown(() => provider.server.close(force: true));
+      final Playlist saved =
+          await PlaylistRepository.instance.addM3uPlaylistSmart(
+        name: 'Liste personnelle',
+        url: provider.url,
+        allowHttpCompatibility: true,
+      );
+      expect(saved.type, PlaylistType.m3u);
+      expect(saved.m3uUrl, provider.url);
+      expect(saved.channelCount, 1);
+      expect(provider.requests.map((Uri uri) => uri.toString()).toList(),
+          <String>[_M3uServer.target]);
+    }, _RealHttpOverrides());
+  });
+}
