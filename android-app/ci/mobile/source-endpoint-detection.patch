+  /// Reconnaît les liens qui autorisent une promotion AUTOMATIQUE vers
+  /// l'API Xtream. Des paramètres username/password protègent aussi de
+  /// vrais fichiers M3U : ils ne prouvent pas que player_api.php existe.
+  /// Sans endpoint connu, le chemin et la query du fournisseur restent
+  /// ceux de la playlist, sans tentative d'API avant chaque relecture.
+  static ({String server, String username, String password})?
+      tryExtractXtreamPlaylistCredentials(String raw) {
+    final String normalized = ensureScheme(raw);
+    final Uri? uri = Uri.tryParse(normalized);
+    if (uri == null ||
+        uri.host.isEmpty ||
+        !_allowedSourceSchemes.contains(uri.scheme.toLowerCase()) ||
+        uri.pathSegments.isEmpty) {
+      return null;
+    }
+    const Set<String> endpoints = <String>{
+      'get.php',
+      'player_api.php',
+      'panel_api.php',
+    };
+    if (!endpoints.contains(uri.pathSegments.last.toLowerCase())) return null;
+    return tryExtractXtreamCredentials(normalized);
+  }
