+# Retour prédictif Android : appliqué APRÈS la génération native et à chaque
+# build, pour ne pas perdre le réglage lors du prochain flutter create.
+python3 - "$MANIFEST" <<'PYBACK'
+from pathlib import Path
+import re
+import sys
+p = Path(sys.argv[1])
+s = p.read_text()
+s = re.sub(r'android:enableOnBackInvokedCallback="[^"]*"',
+           'android:enableOnBackInvokedCallback="true"', s)
+start = s.index('<application')
+end = s.index('>', start)
+if 'android:enableOnBackInvokedCallback=' not in s[start:end]:
+    s = s[:end] + '\n        android:enableOnBackInvokedCallback="true"' + s[end:]
+p.write_text(s)
+PYBACK
