diff --git a/test/features/player/mobile_gestures_test.dart b/test/features/player/mobile_gestures_test.dart
new file mode 100644
index 0000000..26153c5
--- /dev/null
+++ b/test/features/player/mobile_gestures_test.dart
@@ -0,0 +1,146 @@
+// Parcours utilisateur sans moteur vidéo : les vraies routes, le vrai thème
+// et la couche tactile de production doivent rendre le geste au bon écran.
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/theme/app_theme.dart';
+import 'package:tv_king/features/player/presentation/player_gesture_layer.dart';
+
+import '../../support/premium_capture_fonts.dart';
+
+Future<void> _systemGesture(
+  WidgetTester tester,
+  String method, [
+  Map<String, Object>? arguments,
+]) async {
+  await tester.binding.defaultBinaryMessenger.handlePlatformMessage(
+    'flutter/backgesture',
+    const StandardMethodCodec().encodeMethodCall(MethodCall(method, arguments)),
+    (ByteData? _) {},
+  );
+  await tester.pump();
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUpAll(preparePremiumCaptureFonts);
+
+  Future<void> openPlayer(
+    WidgetTester tester,
+    TargetPlatform platform,
+    ValueChanged<Duration> seek,
+  ) async {
+    debugDefaultTargetPlatformOverride = platform;
+    addTearDown(() => debugDefaultTargetPlatformOverride = null);
+    final key = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(
+      MaterialApp(
+        navigatorKey: key,
+        theme: AppTheme.cinema,
+        home: const Scaffold(body: Text('catalogue')),
+      ),
+    );
+    key.currentState!.push<void>(
+      MaterialPageRoute<void>(
+        builder: (_) => const Scaffold(body: Text('fiche précédente')),
+      ),
+    );
+    await tester.pumpAndSettle();
+    key.currentState!.push<void>(
+      MaterialPageRoute<void>(
+        builder: (_) => Scaffold(
+          body: PlayerGestureLayer(
+            onTap: () {},
+            seekEnabled: true,
+            verticalGesturesEnabled: true,
+            position: () => const Duration(minutes: 1),
+            duration: () => const Duration(minutes: 10),
+            onSeekTo: seek,
+            volume: () => 50,
+            onSetVolume: (_) {},
+            onDoubleTapCenter: () {},
+            child: const Center(child: Text('lecture')),
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('Android : bouton retour ne saute pas la fiche', (tester) async {
+    await openPlayer(tester, TargetPlatform.android, (_) {});
+    await tester.binding.handlePopRoute();
+    await tester.pumpAndSettle();
+    expect(find.text('fiche précédente'), findsOneWidget);
+    expect(find.text('catalogue'), findsNothing);
+  });
+
+  testWidgets('Android : retour prédictif annulé puis validé', (tester) async {
+    await openPlayer(tester, TargetPlatform.android, (_) {});
+    for (final commit in <bool>[false, true]) {
+      await _systemGesture(tester, 'startBackGesture', <String, Object>{
+        'touchOffset': <double>[5, 300],
+        'progress': 0.0,
+        'swipeEdge': 0,
+      });
+      await _systemGesture(
+        tester,
+        'updateBackGestureProgress',
+        <String, Object>{
+          'touchOffset': <double>[220, 300],
+          'progress': 0.6,
+          'swipeEdge': 0,
+        },
+      );
+      await _systemGesture(
+        tester,
+        commit ? 'commitBackGesture' : 'cancelBackGesture',
+      );
+      await tester.pumpAndSettle();
+      expect(
+        find.text(commit ? 'fiche précédente' : 'lecture'),
+        findsOneWidget,
+      );
+      expect(find.text('catalogue'), findsNothing);
+    }
+  });
+
+  testWidgets('iPhone : bord retour prioritaire sur le scrub vidéo', (
+    tester,
+  ) async {
+    final seeks = <Duration>[];
+    await openPlayer(tester, TargetPlatform.iOS, seeks.add);
+    await tester.dragFrom(const Offset(5, 300), const Offset(650, 0));
+    await tester.pumpAndSettle();
+    expect(find.text('fiche précédente'), findsOneWidget);
+    expect(find.text('catalogue'), findsNothing);
+    expect(seeks, isEmpty);
+  });
+
+  testWidgets('iPhone : geste annulé conserve la lecture', (tester) async {
+    final seeks = <Duration>[];
+    await openPlayer(tester, TargetPlatform.iOS, seeks.add);
+    final gesture = await tester.startGesture(const Offset(5, 300));
+    await gesture.moveBy(const Offset(180, 0));
+    await tester.pump();
+    await gesture.moveBy(const Offset(-175, 0));
+    await tester.pump(const Duration(milliseconds: 400));
+    await gesture.up();
+    await tester.pumpAndSettle();
+    expect(find.text('lecture'), findsOneWidget);
+    expect(seeks, isEmpty);
+  });
+
+  testWidgets('iPhone : glisser au centre avance toujours la vidéo', (
+    tester,
+  ) async {
+    final seeks = <Duration>[];
+    await openPlayer(tester, TargetPlatform.iOS, seeks.add);
+    await tester.dragFrom(const Offset(300, 300), const Offset(200, 0));
+    await tester.pumpAndSettle();
+    expect(find.text('lecture'), findsOneWidget);
+    expect(seeks, isNotEmpty);
+    expect(seeks.last, greaterThan(const Duration(minutes: 1)));
+  });
+}
