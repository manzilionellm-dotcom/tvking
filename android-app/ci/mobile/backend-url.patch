diff --git a/test/core/backend/backend_hosts_test.dart b/test/core/backend/backend_hosts_test.dart
new file mode 100644
index 0000000..4be91f6
--- /dev/null
+++ b/test/core/backend/backend_hosts_test.dart
@@ -0,0 +1,41 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/backend/backend_hosts.dart';
+import 'package:tv_king/features/subscription/data/gold_trial_backend.dart';
+import 'package:tv_king/features/subscription/data/subscription_backend.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('une préférence ancienne ne restaure pas un backend retiré', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'backend.preferred_host':
+          'https://seven-motion-backend.manzilionel-lm.workers.dev',
+    });
+
+    await BackendHosts.loadPreferred();
+
+    expect(BackendHosts.current, kSubscriptionBaseUrl);
+    expect(BackendHosts.candidates(), <String>[kSubscriptionBaseUrl]);
+    expect(GoldTrialBackend().baseUrl, kSubscriptionBaseUrl);
+    expect(kGoldTrialBaseUrl, kSubscriptionBaseUrl);
+  });
+
+  test('une réponse réseau ne remplace pas le backend configuré', () async {
+    await BackendHosts.markGood('https://retired.example');
+
+    expect(BackendHosts.current, kSubscriptionBaseUrl);
+    expect(BackendHosts.candidates(), <String>[kSubscriptionBaseUrl]);
+    expect(GoldTrialBackend().baseUrl, kSubscriptionBaseUrl);
+  });
+
+  test('la surcharge au build est partagée avec le temps réel et l’essai', () {
+    const String configured = String.fromEnvironment(
+      'BACKEND_URL',
+      defaultValue: 'https://api.zuno8k.com',
+    );
+    expect(BackendHosts.primary, configured);
+    expect(kSubscriptionBaseUrl, configured);
+    expect(GoldTrialBackend().baseUrl, configured);
+  });
+}
