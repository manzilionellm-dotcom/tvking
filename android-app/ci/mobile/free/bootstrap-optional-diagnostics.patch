+++ b/test/core/observability/early_diagnostics_test.dart
@@ -0,0 +1,39 @@
+import 'dart:async';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/core/crash/crash_reporting.dart';
+import 'package:tv_king/core/observability/black_box.dart';
+import 'package:tv_king/core/observability/structured_logger.dart';
+
+void main() {
+  test('les messages précoces sont caviardés, bornés et enregistrés une seule fois', () async {
+    final box = BlackBox.instance;
+    final location = Completer<Directory>();
+    final folder = await Directory.systemTemp.createTemp('seven-boot-');
+    addTearDown(() async {
+      await box.dispose();
+      await folder.delete(recursive: true);
+    });
+    final binding = box.initialize(directory: location.future);
+    for (var i = 0; i < BlackBox.kMaxRingEntries + 1; i++) {
+      box.record(level: 'info', domain: 'fixture', event: 'sample');
+    }
+    CrashReporting.instance.recordError(
+        StateError('https://fixture.invalid/get.php?username=synthetic_user&password=synthetic_secret'),
+        null, context: 'earlyProbe');
+    StructuredLogger.instance.info(domain: 'fixture', event: 'earlyStructured');
+    expect(box.recent(BlackBox.kMaxRingEntries + 10), hasLength(BlackBox.kMaxRingEntries));
+    final early = box.recent().join('\n');
+    expect(early, contains('earlyProbe'));
+    expect(early, contains('earlyStructured'));
+    expect(early, isNot(contains('synthetic_secret')));
+    location.complete(folder);
+    await binding;
+    await box.initialize(directory: folder);
+    await box.flushNow();
+    final log = await File('${folder.path}/black_box/blackbox.jsonl').readAsString();
+    expect('earlyProbe'.allMatches(log), hasLength(1));
+    expect('earlyStructured'.allMatches(log), hasLength(1));
+    expect(log, isNot(contains('synthetic_secret')));
+  });
+}
