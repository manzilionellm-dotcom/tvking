+Future<Directory> _diagnosticDirectory() async {
+  try {
+    return await getApplicationSupportDirectory();
+  } catch (error, stack) {
+    CrashReporting.instance.recordError(error, stack, context: 'boot.supportDirectory');
+    return Directory.systemTemp;
+  }
+}
+
+Future<void> _attachCrashDiagnostics() async {
+  await CrashReporting.instance.initialize();
+  RemoteErrorReporter.instance.attach();
+  RessourcesMoniteur.instance.demarrer();
+  await attachCrashlytics();
+}
