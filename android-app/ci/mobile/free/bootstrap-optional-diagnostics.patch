+import 'dart:async';
+import 'dart:ui';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:tv_king/core/app/guarded_main.dart';
+import 'package:tv_king/core/observability/black_box.dart';
+
+class _SilentSupportDirectory extends PathProviderPlatform {
+  final called = Completer<void>();
+  final resume = Completer<void>();
+  @override
+  Future<String?> getApplicationSupportPath() async {
+    if (!called.isCompleted) called.complete();
+    await resume.future;
+    throw StateError('unavailable synthetic storage');
+  }
+}
+
+void main() {
+  final binding = TestWidgetsFlutterBinding.ensureInitialized();
+  test('le corps du démarrage avance même si le plugin du répertoire ne répond pas', () async {
+    final original = PathProviderPlatform.instance;
+    final report = FlutterError.onError;
+    final dispatch = PlatformDispatcher.instance.onError;
+    final builder = ErrorWidget.builder;
+    final silent = _SilentSupportDirectory();
+    PathProviderPlatform.instance = silent;
+    addTearDown(() {
+      PathProviderPlatform.instance = original;
+      FlutterError.onError = report;
+      PlatformDispatcher.instance.onError = dispatch;
+      ErrorWidget.builder = builder;
+    });
+    final opened = Completer<void>();
+    runGuarded(() async {
+      binding.attachRootWidget(binding.wrapWithDefaultView(const SizedBox(key: ValueKey('test-home'))));
+      opened.complete();
+    });
+    await silent.called.future.timeout(const Duration(seconds:2));
+    await opened.future.timeout(const Duration(milliseconds:650), onTimeout: () {
+      throw StateError('Le répertoire de diagnostics bloque encore la création du widget racine.');
+    });
+    expect(binding.rootElement, isNotNull);
+    silent.resume.complete();
+    await Future<void>.delayed(const Duration(milliseconds: 25));
+    expect(BlackBox.instance.recent().join('\n'), contains('boot.supportDirectory'));
+  });
+}
