diff --git a/test/free_play/epg_foreground_priority_test.dart b/test/free_play/epg_foreground_priority_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..3141b63a6cd4b362d86a6bca86818e7e4c6bd695
--- /dev/null
+++ b/test/free_play/epg_foreground_priority_test.dart
@@ -0,0 +1,114 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:tv_king/core/playback/stream_slot.dart';
+import 'package:tv_king/features/cast/data/stream_probe.dart';
+import 'package:tv_king/features/epg/data/idle_epg_sync.dart';
+import 'package:tv_king/features/playlists/data/source_calibrator.dart';
+import 'package:tv_king/features/playlists/data/xtream_client.dart';
+import 'package:tv_king/features/playlists/domain/playlist.dart';
+
+class _Connection extends http.BaseClient {
+  final closed = Completer<void>();
+  @override
+  void close() => closed.complete();
+  @override
+  Future<http.StreamedResponse> send(http.BaseRequest request) =>
+      throw UnimplementedError();
+}
+
+void main() {
+  final slot = StreamSlot.instance;
+  setUp(slot.resetForTest);
+  tearDown(slot.resetForTest);
+
+  for (final byPlayerHold in [false, true]) {
+    test('priorité lecteur et reprise XMLTV (signal=$byPlayerHold)', () async {
+      final hold = ValueNotifier(true);
+      addTearDown(hold.dispose);
+      final ready = Completer<_Connection>();
+      final clients = <_Connection>[];
+      final job =
+          IdleEpgSync(
+            playback: hold,
+            quietPeriod: const Duration(milliseconds: 2),
+            clientFactory: () {
+              final client = _Connection();
+              clients.add(client);
+              return client;
+            },
+          ).run((client) async {
+            if (clients.length == 1) {
+              final connection = client as _Connection;
+              ready.complete(connection);
+              await connection.closed.future;
+              throw const SocketException('lecture prioritaire');
+            }
+            return 12;
+          });
+      await Future<void>.delayed(const Duration(milliseconds: 10));
+      expect(clients, isEmpty);
+      hold.value = false;
+      final started = await ready.future.timeout(const Duration(seconds: 2));
+      final screen = Object();
+      if (byPlayerHold) {
+        hold.value = true;
+      } else {
+        slot.register(screen, teardown: () async {});
+        await slot.claim(screen);
+      }
+      expect(started.closed.isCompleted, isTrue);
+      await Future<void>.delayed(const Duration(milliseconds: 10));
+      expect(clients, hasLength(1));
+      if (byPlayerHold) {
+        hold.value = false;
+      } else {
+        slot.unregister(screen);
+      }
+      expect(await job.timeout(const Duration(seconds: 2)), 12);
+      expect(clients.length, 2);
+      expect(clients.last.closed.isCompleted, isTrue);
+    });
+  }
+
+  test('le clip black.ts redirigé ne valide ni format ni signature', () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    addTearDown(() => server.close(force: true));
+    final paths = <String>[];
+    server.listen((req) async {
+      paths.add(req.uri.path);
+      req.response.statusCode = HttpStatus.found;
+      req.response.headers.set('Location', '/video/black.ts?token=example');
+      await req.response.close();
+    });
+    final url = 'http://127.0.0.1:${server.port}/live/u/p/1.ts';
+    final result = await StreamProbe.instance.probeUserAgents(
+      url,
+      candidates: ['Current', 'Alternative'],
+    );
+    expect(result.workingUserAgent, isNull);
+    expect(result.attempts.values.single.providerPlaceholder, isTrue);
+    expect(paths, ['/live/u/p/1.ts']);
+  });
+
+  test('compte 1/1 : la calibration ne sonde aucune chaîne', () async {
+    final result = await SourceCalibrator(
+      playlist: const Playlist(
+        id: 12,
+        name: 'Test',
+        type: PlaylistType.xtream,
+        createdAt: 0,
+      ),
+      accountFetcher: () async => const XtreamAccountInfo(
+        status: 'Active',
+        maxConnections: 1,
+        activeCons: 1,
+      ),
+      sampleUrls: () async => throw StateError('échantillon inattendu'),
+    ).run();
+    expect(result.verdict, CalibrationVerdict.connectionBusy);
+  });
+}
