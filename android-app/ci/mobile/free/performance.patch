+        expect(requests, 2);
+        expect(receivedHeaders.last['if-none-match'], '"v1"');
+        expect((await db.query('channels')).single, before);
+
+        responsePhase = 2;
+        await repo.refreshPlaylist(playlist);
+        expect(receivedHeaders.last['if-none-match'], '"v2"');
+        expect((await db.query('channels')).single, before);
+        await repo.refreshPlaylist(playlist);
