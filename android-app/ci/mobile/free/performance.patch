+       clientFactory = clientFactory ?? http.Client.new;
+
+  final ValueListenable<bool> playback;
+  final Duration quietPeriod;
+  final http.Client Function() clientFactory;
+
+  Future<T> run<T>(Future<T> Function(http.Client) download) async {
+    final StreamSlot slot = StreamSlot.instance;
+    final Object owner = Object();
+    while (true) {
+      // Plusieurs imports sont déjà sérialisés dans EpgRepository. Un seul
+      // travail attend ici et le premier clic sur une chaîne garde la priorité.
+      await Future<void>.delayed(quietPeriod);
+      if (playback.value) continue;
+      http.Client? client;
+      bool interrupted = false;
+      void stop() {
+        interrupted = true;
+        client?.close();
+        client = null;
+      }
+
+      if (!slot.tryStartBackground(owner, () async => stop())) continue;
+      void onPlayback() {
+        if (playback.value) stop();
+      }
+
+      playback.addListener(onPlayback);
+      try {
+        final http.Client connection = clientFactory();
+        client = connection;
+        return await download(connection);
+      } catch (_) {
+        if (!interrupted) rethrow;
+        // Le lecteur a la priorité. La reprise XMLTV est sérialisée et son
+        // import SQLite est idempotent si un premier lot était déjà écrit.
+      } finally {
+        playback.removeListener(onPlayback);
+        slot.unregister(owner);
+        client?.close();
+      }
+    }
+  }
+}
