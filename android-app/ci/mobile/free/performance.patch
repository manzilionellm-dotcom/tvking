+    () async {
+      const body = '#EXTM3U\n#EXTINF:-1,Un\nhttps://media.example.invalid/1.ts';
+      final pending = Completer<void>();
+      final started = Completer<void>();
+      var requests = 0;
+      var responsePhase = 0;
+      final receivedHeaders = <Map<String, String>>[];
+      http.Client create() => MockClient((request) async {
+        requests++;
+        receivedHeaders.add(
+          request.headers.map(
+            (key, value) => MapEntry(key.toLowerCase(), value),
+          ),
+        );
+        if (responsePhase == 1) {
+          started.complete();
+          await pending.future;
+          return http.Response('', 304, headers: {'etag': '"v2"'});
+        }
+        // Le fournisseur peut ignorer le validateur ou le retirer.
+        return http.Response(
+          body,
+          200,
+          headers: responsePhase == 0 ? {'etag': '"v1"'} : {},
+        );
+      });
+      await http.runWithClient(() async {
