+            return Scaffold(
+              body: TextButton(
+                onPressed: () async {
+                  final result = await runImportWithProgress<int>(
+                    context,
+                    title: 'Import',
+                    task: (_) => done.future,
+                  );
+                  count = result.value;
+                },
+                child: const Text('Ajouter'),
+              ),
+            );
+          },
+        ),
+      ),
+    );
+    await tester.tap(find.text('Ajouter'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 250));
+    expect(count, isNull);
