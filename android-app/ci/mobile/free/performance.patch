+  test(
+    'un refresh en échec préserve les chaînes et le validateur applicables',
+    () async {
+      String body(int count) => [
+        '#EXTM3U',
+        for (var i = 0; i < count; i++)
+          '#EXTINF:-1,Canal $i\nhttps://media.example.invalid/$i.ts',
+      ].join('\n');
+      var count = 2;
+      var etag = '"original"';
+      final sent = <String?>[];
+      http.Client create() => MockClient((request) async {
+        sent.add(request.headers['if-none-match']);
+        return http.Response(body(count), 200, headers: {'etag': etag});
+      });
+      await http.runWithClient(() async {
+        final playlist = await repo.addM3uPlaylist(
+          name: 'Test',
+          url: 'https://source.example.invalid/test.m3u',
+        );
+        final previous = await db.query('channels', orderBy: 'local_id');
+        count = 1200;
+        etag = '"changed"';
+        await db.execute(
+          "CREATE TEMP TRIGGER reject_fixture BEFORE INSERT ON channels "
+          "WHEN NEW.name='Canal 1001' BEGIN SELECT RAISE(ABORT,'fixture'); END",
+        );
+        await expectLater(
+          repo.refreshPlaylist(playlist),
+          throwsA(isA<DatabaseException>()),
+        );
+        expect(await db.query('channels', orderBy: 'local_id'), previous);
+        expect((await db.query('m3u_http_cache')).single['etag'], '"original"');
+        await db.execute('DROP TRIGGER reject_fixture');
+        expect(await repo.refreshPlaylist(playlist), isTrue);
+        expect(sent.last, '"original"');
+        expect(
+          (await db.rawQuery('SELECT COUNT(*) AS n FROM channels')).single['n'],
+          1200,
+        );
+        expect((await db.query('m3u_http_cache')).single['etag'], '"changed"');
+        await db.delete('playlists');
+        expect(await db.query('m3u_http_cache'), isEmpty);
+      }, create);
+    },
+  );
+}
