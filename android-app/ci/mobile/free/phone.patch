+  final Map<String, Future<void> Function()> readers =
+      <String, Future<void> Function()>{
+        'thème': () => RemoteThemeRepository.fetchAndApply(strict: true),
+        'tarifs': () => PricingRepository.fetch(strict: true),
+        'accueil': () => HomeLayoutRepository.instance.refresh(strict: true),
+        'vedette': () => FeaturedRepository.instance.refresh(strict: true),
+        'publicité': () async {
+          await StartupAdRepository.instance.fetch(strict: true);
+        },
+        'avis': () => FeedbackRepository.instance.reload(strict: true),
+        'serveurs': () async {
+          await DefaultServersApi.fetch(forceRefresh: true, strict: true);
+        },
+      };
+  for (final entry in readers.entries) {
+    test(
+      '${entry.key} : une panne HTTP ou un JSON invalide ne vaut pas application',
+      () async {
+        for (final response in <http.Response>[
+          http.Response('indisponible', 503),
+          http.Response('[]', 200),
+        ]) {
+          await expectLater(
+            http.runWithClient(
+              entry.value,
+              () => MockClient((_) async => response),
+            ),
+            throwsA(anyOf(isA<StateError>(), isA<FormatException>())),
+          );
+        }
+      },
+    );
+  }
+  test(
+    'les valeurs distantes remplacent les réglages courants sans redémarrage',
+    () async {
+      final data = <String, Object>{
+        '/api/theme': <String, Object>{
+          'appName': 'Nom du panel',
+          'accent': '#884422',
+        },
+        '/api/pricing': <String, Object>{
+          'currency': '€',
+          'yearly': '7',
+          'lifetime': '15',
+          'trialDays': 0,
+          'promoEnabled': false,
+        },
+        '/api/home-layout': <String, Object>{
+          'items': <Object>[
+            <String, Object>{
+              'key': 'recent',
+              'position': 0,
+              'enabled': true,
+              'ribbon': 'Nouveau',
+              'featured': false,
+            },
+          ],
+        },
+        '/api/featured': <String, Object>{
+          'name': 'Chaîne locale',
+          'note': 'À voir',
+        },
+        '/api/ad': <String, Object>{
+          'enabled': false,
+          'url': '',
+          'skip': 9,
+          'freq': 'daily',
+        },
+        '/api/feedback-prompt': <String, Object>{
+          'enabled': true,
+          'message': 'Votre avis',
+        },
+        '/api/servers': <String, Object>{
+          'servers': <Object>[
+            <String, Object>{
+              'id': 'fixture',
+              'label': 'Fixture',
+              'url': 'https://example.invalid',
+            },
+          ],
+        },
+      };
+      await http.runWithClient(
+        () async {
+          for (final reader in readers.values) {
+            await reader();
+          }
+        },
+        () => MockClient(
+          (request) async => http.Response.bytes(
+            utf8.encode(jsonEncode(data[request.url.path])),
+            200,
+            headers: {'content-type': 'application/json; charset=utf-8'},
+          ),
+        ),
+      );
+      expect(BrandConfig.instance.appName, 'Nom du panel');
+      expect(PricingRepository.current.yearly, '7');
+      expect(HomeLayoutRepository.instance.config('recent')?.ribbon, 'Nouveau');
+      expect(FeaturedRepository.instance.note, 'À voir');
+      expect(StartupAdRepository.instance.config.skip, 9);
+      expect(FeedbackRepository.instance.message, 'Votre avis');
+      expect((await DefaultServersApi.fetch()).single.id, 'fixture');
+    },
+  );
+}
