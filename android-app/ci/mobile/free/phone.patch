@@ -0,0 +1,101 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/panel_live_wait.dart';
+import 'package:tv_king/core/update/build_flags.dart';
+import 'package:tv_king/features/playlists/presentation/free_player_sources.dart';
+import 'package:tv_king/features/subscription/data/subscription_state.dart';
+import 'package:tv_king/l10n/generated/app_localizations.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  setUp(() {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'device.virtual_mac.v1': 'MK:01:23:45:67:89',
+    });
+  });
+
+  test('expiration allows personal playback; an explicit suspension survives offline', () async {
+    final sub = SubscriptionState.instance;
+    await sub.resetForTesting();
+    await sub.initialize();
+    for (final reason in ['expired', 'loaned', 'frozen', 'banned']) {
+      await sub.markBlockedFromSource(reason);
+      final suspended = reason == 'frozen' || reason == 'banned';
+      expect(sub.shouldBlockUser, suspended);
+      expect(sub.canStream, !suspended);
+      sub.simulateOfflineForTesting();
+      expect(sub.shouldBlockUser, suspended);
+      expect(sub.canStream, !suspended);
+    }
+    await sub.markBlockedFromSource('expired');
+    expect(sub.canStream, isTrue);
+  }, skip: !kIsPlayBuild);
+
+  for (final xtream in [false, true]) {
+    testWidgets('opens the correct personal source form: xtream=$xtream', (
+      tester,
+    ) async {
+      await _showEntry(tester);
+      await tester.tap(find.text(xtream ? 'Xtream Codes' : 'Add an M3U list'));
+      await tester.pumpAndSettle();
+      expect(find.text(xtream ? 'Xtream server' : 'M3U URL'), findsOneWidget);
+      expect(find.text(xtream ? 'M3U URL' : 'Xtream server'), findsNothing);
+      if (xtream) {
+        expect(
+          tester
+              .widgetList<TextField>(find.byType(TextField))
+              .where((field) => field.obscureText),
+          hasLength(1),
+        );
+      }
+    }, skip: !kIsPlayBuild);
+  }
+
+  testWidgets('panel confirms explicit refresh and reports failure on retry', (
+    tester,
+  ) async {
+    final panel = PanelLiveWait.instance;
+    final original = panel.onChange;
+    addTearDown(() => panel.onChange = original);
+    bool succeeds = true;
+    var calls = 0;
+    panel.onChange = () async {
+      calls++;
+      if (!succeeds) throw StateError('offline');
+    };
+    await _showEntry(tester);
+    await tester.tap(find.text('Device management'));
+    await tester.pumpAndSettle();
+    expect(find.text('01:23:45:67:89'), findsOneWidget);
+    final context = tester.element(find.byType(FreePlayerPanelTile));
+    final strings = AppLocalizations.of(context);
+    expect(find.text(strings.freePanelSynced), findsNothing);
+    await tester.tap(find.text(strings.buttonSyncNow));
+    await tester.pumpAndSettle();
+    expect(find.text(strings.freePanelSynced), findsOneWidget);
+    succeeds = false;
+    await tester.tap(find.text(strings.buttonSyncNow));
+    await tester.pumpAndSettle();
+    expect(calls, 2);
+    expect(find.text(strings.freePanelSynced), findsNothing);
+    expect(find.text(strings.playlistResyncFailed), findsOneWidget);
+  }, skip: !kIsPlayBuild);
+}
+
+Future<void> _showEntry(WidgetTester tester) async {
+  tester.view.physicalSize = const Size(700, 1100);
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  await tester.pumpWidget(
+    const MaterialApp(
+      locale: Locale('en'),
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: Scaffold(body: SingleChildScrollView(child: FreePlayerSources())),
+    ),
+  );
+  await tester.pumpAndSettle();
+}
