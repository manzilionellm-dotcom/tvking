+class FreePlayerSources extends StatelessWidget {
+  const FreePlayerSources({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: <Widget>[
+        Text(context.l10n.emptyAddYourFirst),
+        const SizedBox(height: 12),
+        FilledButton.icon(
+          onPressed: () => showM3uLoginSheet(context),
+          icon: const Icon(Icons.playlist_add),
+          label: Text(context.l10n.tvSourceAddM3uTitle),
+        ),
+        OutlinedButton.icon(
+          onPressed: () => showM3uLoginSheet(context, xtream: true),
+          icon: const Icon(Icons.key),
+          label: Text(context.l10n.playlistTypeXtream),
+        ),
+        const SizedBox(height: 12),
+        const FreePlayerPanelTile(),
+      ],
+    );
+  }
+}
+
+class FreePlayerPanelTile extends StatefulWidget {
+  const FreePlayerPanelTile({super.key});
+
+  @override
+  State<FreePlayerPanelTile> createState() => _FreePlayerPanelTileState();
+}
+
+enum _SyncStatus { idle, running, success, failure }
+
+class _FreePlayerPanelTileState extends State<FreePlayerPanelTile> {
+  _SyncStatus _status = _SyncStatus.idle;
+
+  Future<void> _synchronize() async {
+    if (_status == _SyncStatus.running) return;
+    setState(() => _status = _SyncStatus.running);
+    try {
+      await PanelLiveWait.instance.trigger();
+      if (mounted) setState(() => _status = _SyncStatus.success);
+    } catch (_) {
+      if (mounted) setState(() => _status = _SyncStatus.failure);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final DeviceIdentity identity = DeviceIdentity.instance;
+    return ExpansionTile(
+      title: Text(context.l10n.freePanelTitle),
+      leading: const Icon(Icons.sync),
+      childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+      expandedCrossAxisAlignment: CrossAxisAlignment.stretch,
+      children: <Widget>[
+        ListenableBuilder(
+          listenable: identity,
+          builder: (context, _) => FutureBuilder<String>(
+            key: ValueKey(identity.macSync),
+            future: identity.mac,
+            builder: (context, snapshot) {
+              final String? id = snapshot.hasData
+                  ? DeviceIdentity.stripPrefix(snapshot.data!)
+                  : null;
+              return ListTile(
+                contentPadding: EdgeInsets.zero,
+                title: Text(context.l10n.deviceIdLabel),
+                subtitle: id == null ? null : SelectableText(id),
+                trailing: IconButton(
+                  tooltip: context.l10n.buttonCopy,
+                  onPressed: id == null
+                      ? null
+                      : () async {
+                          await Clipboard.setData(ClipboardData(text: id));
+                          if (!context.mounted) return;
+                          ScaffoldMessenger.of(context).showSnackBar(
+                            SnackBar(content: Text(context.l10n.idCopied(id))),
+                          );
+                        },
+                  icon: const Icon(Icons.copy),
+                ),
+              );
+            },
+          ),
+        ),
+        OutlinedButton.icon(
+          onPressed: _status == _SyncStatus.running ? null : _synchronize,
+          icon: _status == _SyncStatus.running
+              ? const SizedBox.square(
+                  dimension: 18,
+                  child: CircularProgressIndicator(strokeWidth: 2),
+                )
+              : const Icon(Icons.refresh),
+          label: Text(context.l10n.buttonSyncNow),
+        ),
+        if (_status == _SyncStatus.success || _status == _SyncStatus.failure)
+          Semantics(
+            liveRegion: true,
+            child: Text(
+              _status == _SyncStatus.success
+                  ? context.l10n.freePanelSynced
+                  : context.l10n.playlistResyncFailed,
+            ),
+          ),
+      ],
+    );
+  }
+}
