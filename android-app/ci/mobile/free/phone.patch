+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/update/build_flags.dart';
+import 'package:tv_king/features/playlists/data/cloud_backup_repository.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('le lecteur Play ne sauvegarde pas les accès sans choix explicite', () async {
+    SharedPreferences.setMockInitialValues(<String, Object>{'backup.restored.v1': true});
+    final backup = CloudBackupRepository.instance;
+    expect(await backup.backupEnabled(), isFalse);
+    await backup.debugUpload();
+    await backup.restoreIfNeeded();
+    await backup.setBackupEnabled(true);
+    expect(await backup.backupEnabled(), isTrue);
+    await backup.setBackupEnabled(false);
+    expect(await backup.backupEnabled(), isFalse);
+    await backup.debugUpload();
+  }, skip: !kIsPlayBuild);
+}
diff --git a/test/free_play/panel_roundtrip_test.dart b/test/free_play/panel_roundtrip_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..ae1b6d89f33b2f170b8ae7e55ac43475ee937858
--- /dev/null
+++ b/test/free_play/panel_roundtrip_test.dart
@@ -0,0 +1,267 @@
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/panel_live_wait.dart';
+import 'package:tv_king/core/backend/backend_hosts.dart';
+import 'package:tv_king/features/device/data/device_identity.dart';
+import 'package:tv_king/features/subscription/data/subscription_state.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test('une confirmation perdue est rejouée par HTTP avant le signal WebSocket suivant', () async {
+    const mac = 'MK:FA:00:00:00:01';
+    const channel = MethodChannel('com.manzilionellm.tvking/device');
+    final messenger =
+        TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+    messenger.setMockMethodCallHandler(
+      channel,
+      (call) async => call.method == 'getDeviceInfo'
+          ? <String, String>{'model': 'test'}
+          : 'fixture-phone',
+    );
+    addTearDown(() => messenger.setMockMethodCallHandler(channel, null));
+    SharedPreferences.setMockInitialValues({'device.virtual_mac.v1': mac});
+    PackageInfo.setMockInitialValues(
+      appName: '7 MOTION',
+      packageName: 'com.manzilionellm.tvking',
+      version: '1.0',
+      buildNumber: '1',
+      buildSignature: '',
+    );
+    DeviceIdentity.instance.debugResetCache();
+    final state = SubscriptionState.instance;
+    await state.resetForTesting();
+    addTearDown(state.resetForTesting);
+    final panel = PanelLiveWait.instance;
+    final originalClient = panel.clientFactory;
+    addTearDown(() {
+      panel.stop();
+      panel.clientFactory = originalClient;
+    });
+    final calls = <String>[];
+    bool rejectFirst = true;
+    bool forceFailed = false;
+    bool frozen = false;
+    final body0 = {'id': 1, 'kind': 'source', 'order_id': 'ord_00000001'};
+    final body1 = {'id': 2, 'kind': 'suspend', 'order_id': 'ord_00000002'};
+    http.Response reply(Object data) => http.Response(jsonEncode(data), 200);
+    Future<http.Response> handler(http.Request request) async {
+      expect(request.url.host, 'api.zuno8k.com');
+      final path = request.url.path;
+      if (path == '/api/device-proof') return reply({'ok': true});
+      if (path == '/api/heartbeat') {
+        final body = jsonDecode(request.body) as Map<String, dynamic>;
+        expect(body['mac'], mac);
+        expect(body['platform'], 'mobile');
+        expect(body['store'], const bool.fromEnvironment('PLAY_BUILD'));
+        return reply({
+          'exists': true,
+          'paid': true,
+          'status': 'active',
+          'frozen': frozen,
+        });
+      }
+      if (path == '/api/device-source/$mac') {
+        calls.add('sources');
+        return reply({'rev': 9, 'sources': <Object?>[], 'source': null});
+      }
+      if (path == '/api/box/wait/$mac') {
+        calls.add('replay');
+        expect(request.url.queryParameters['after'], '0');
+        return reply({
+          'box': [body0, body1],
+        });
+      }
+      if (path == '/api/box/ack/$mac') {
+        expect(request.headers['X-Device-Secret'], isNotEmpty);
+        final acknowledgements =
+            (jsonDecode(request.body) as Map<String, dynamic>)['orders']
+                as List;
+        final results = <Object>[];
+        for (final ack in acknowledgements.cast<Map<String, dynamic>>()) {
+          final id = ack['order_id'];
+          final status = ack['state'];
+          final reject = status == 'applied' && rejectFirst;
+          if (reject) rejectFirst = false;
+          calls.add('$id:$status:${reject ? 503 : 200}');
+          if (id == 'ord_00000001' && status == 'applied')
+            expect(ack['config_rev'], 9);
+          if (id == 'ord_00000006') {
+            if (status == 'failed') {
+              expect(ack['error_code'], 'update_managed_by_play');
+              expect(forceFailed, isFalse);
+              forceFailed = true;
+              return http.Response('', 503); // Le Worker a persisté le refus.
+            }
+            expect(status, 'received');
+            results.add({
+              'order_id': id,
+              'status': 200,
+              'state': forceFailed ? 'failed' : 'expired',
+            });
+            continue;
+          }
+          results.add({
+            'order_id': id,
+            'status': reject ? 503 : 200,
+            'state': status,
+          });
+        }
+        return reply({'results': results});
+      }
+      throw StateError('Requête inattendue $path');
+    }
+
+    panel.clientFactory = () => MockClient(handler);
+    await http.runWithClient(() async {
+      Map<String, dynamic> frame(Map<String, Object?> event) => {
+        'mac': mac,
+        'seq': event['id'],
+        'type': event['kind'],
+        'order_id': event['order_id'],
+      };
+      expect(BackendHosts.current, BackendHosts.primary);
+      await expectLater(
+        panel.acceptSocketFrame(frame(body0)),
+        throwsStateError,
+      );
+      expect(await panel.cursorFor(mac), 0);
+      await panel.acceptSocketFrame(frame(body1));
+      expect(calls, contains('replay'));
+      expect(
+        calls,
+        containsAllInOrder([
+          'ord_00000001:applied:503',
+          'replay',
+          'ord_00000001:applied:200',
+          'ord_00000002:applied:200',
+        ]),
+      );
+      expect(await panel.cursorFor(mac), 2);
+      final count = calls.length;
+      await panel.acceptSocketFrame(frame(body0));
+      expect(calls.length, count);
+      frozen = true;
+      await panel.acceptSocketFrame({
+        'seq': 3,
+        'mac': mac,
+        'type': 'suspend',
+        'order_id': 'ord_00000003',
+      });
+      expect(state.remote.frozen, isTrue);
+      final readsWhileFrozen = calls.where((call) => call == 'sources').length;
+      await panel.acceptSocketFrame({
+        'seq': 4,
+        'mac': mac,
+        'type': 'source',
+        'order_id': 'ord_00000005',
+      });
+      expect(calls, contains('ord_00000005:failed:200'));
+      frozen = false;
+      await panel.acceptSocketFrame({
+        'seq': 5,
+        'mac': mac,
+        'type': 'resume',
+        'order_id': 'ord_00000004',
+      });
+      expect(state.remote.frozen, isFalse);
+      expect(
+        calls.where((call) => call == 'sources').length,
+        greaterThan(readsWhileFrozen),
+      );
+      expect(
+        (await SharedPreferences.getInstance()).getInt(liveWaitCursorKey(mac)),
+        5,
+      );
+      if (const bool.fromEnvironment('PLAY_BUILD')) {
+        final forceUpdate = {
+          'mac': mac,
+          'seq': 6,
+          'type': 'force_update',
+          'order_id': 'ord_00000006',
+        };
+        await expectLater(
+          panel.acceptSocketFrame(forceUpdate),
+          throwsStateError,
+        );
+        expect(await panel.cursorFor(mac), 5);
+        await panel.acceptSocketFrame(forceUpdate);
+        expect(forceFailed, isTrue);
+        expect(await panel.cursorFor(mac), 6);
+        expect(calls, isNot(contains('ord_00000006:applied:200')));
+      }
+    }, () => MockClient(handler));
+  });
+
+  test(
+    'un journal de 32 signaux est confirmé en lots acceptés par le Worker',
+    () async {
+      const mac = 'MK:FA:00:00:00:02';
+      SharedPreferences.setMockInitialValues({'device.virtual_mac.v1': mac});
+      DeviceIdentity.instance.debugResetCache();
+      final panel = PanelLiveWait.instance;
+      final previousChange = panel.onChange;
+      final previousClient = panel.clientFactory;
+      addTearDown(() {
+        panel.stop();
+        panel.onChange = previousChange;
+        panel.clientFactory = previousClient;
+      });
+      final batches = <int>[];
+      final orders = List.generate(
+        32,
+        (i) => {
+          'id': i + 1,
+          'kind': 'activate',
+          'order_id': 'ord_${(i + 1).toString().padLeft(8, '0')}',
+        },
+      );
+      panel.onChange = () async {};
+      Future<http.Response> handler(http.Request r) async {
+        if (r.url.path == '/api/device-proof') return http.Response('{}', 200);
+        if (r.method == 'GET')
+          return http.Response(jsonEncode({'box': orders}), 200);
+        final rows = (jsonDecode(r.body)['orders'] as List)
+            .cast<Map<String, dynamic>>();
+        batches.add(rows.length);
+        expect(rows.length, lessThanOrEqualTo(20));
+        return http.Response(
+          jsonEncode({
+            'results': rows
+                .map(
+                  (row) => {
+                    'order_id': row['order_id'],
+                    'status': 200,
+                    'state': row['state'],
+                  },
+                )
+                .toList(),
+          }),
+          200,
+        );
+      }
+
+      panel.clientFactory = () => MockClient(handler);
+      await http.runWithClient(() async {
+        final first = {
+          'mac': mac,
+          'seq': 32,
+          'type': 'activate',
+          'order_id': 'ord_00000032',
+        };
+        await Future.wait([
+          panel.acceptSocketFrame(first),
+          panel.acceptSocketFrame(first),
+        ]);
+        expect(await panel.cursorFor(mac), 32);
+        expect(batches, [20, 20, 12, 12]);
+      }, () => MockClient(handler));
+    },
+  );
+}
