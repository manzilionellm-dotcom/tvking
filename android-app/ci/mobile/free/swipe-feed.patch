+import 'dart:async';
+import 'dart:io';
+
+/// At most two prospective TS connections, each paused after its first 256 KiB.
+/// Promotion continues the SAME HTTP response, including the buffered prefix.
+class FeedLookahead {
+  final Map<String, PreparedTransport> _entries = {};
+  static const maxItems = 2;
+
+  void update(Iterable<String> urls, String userAgent) {
+    final desired = urls.toSet().take(maxItems).toSet();
+    for (final url in _entries.keys.toList()) {
+      if (!desired.contains(url)) _entries.remove(url)?.close();
+    }
+    for (final url in desired) {
+      if (_entries.containsKey(url)) continue;
+      final item = PreparedTransport();
+      _entries[url] = item;
+      item.start(url, userAgent, () {
+        if (identical(_entries[url], item)) _entries.remove(url);
+      });
+    }
+  }
+
+  void retainOnly(String url) {
+    for (final other in _entries.keys.where((key) => key != url).toList()) {
+      _entries.remove(other)?.close();
+    }
+  }
+
+  bool ready(String url) => _entries[url]?.ready == true;
+  PreparedTransport? take(String url) {
+    final item = _entries.remove(url);
+    if (item?.ready == true) {
+      item!.claim();
+      return item;
+    }
+    item?.close();
+    return null;
+  }
+
+  void clear() => update(const [], '');
+}
+
+class PreparedTransport {
+  final _client = HttpClient()..connectionTimeout = const Duration(seconds: 3);
+  final List<List<int>> _prefix = [];
+  StreamIterator<List<int>>? _source;
+  Timer? _expiry;
+  bool _closed = false;
+  bool ready = false;
+  bool consumed = false;
+
+  Future<void> start(String url, String ua, void Function() evict) async {
+    void abandon() {
+      close();
+      evict();
+    }
+
+    _expiry = Timer(const Duration(seconds: 12), abandon);
+    try {
+      _client.autoUncompress = false;
+      _client.userAgent = ua;
+      final req = await _client.getUrl(Uri.parse(url));
+      final res = await req.close();
+      var address = Uri.parse(url);
+      for (final hop in res.redirects) {
+        address = address.resolveUri(hop.location);
+      }
+      final mime = res.headers.contentType?.mimeType ?? '';
+      if (_closed ||
+          res.statusCode != 200 ||
+          mime.startsWith('text/') ||
+          address.pathSegments.lastOrNull?.toLowerCase() == 'black.ts') {
+        abandon();
+        return;
+      }
+      final frames = _source = StreamIterator(res);
+      var bytes = 0;
+      while (bytes < 256 * 1024 && await frames.moveNext()) {
+        if (_closed) return;
+        _prefix.add(frames.current);
+        bytes += frames.current.length;
+      }
+      if (_closed || bytes == 0) {
+        abandon();
+        return;
+      }
+      // A server can label an HTML error or an HLS manifest as transport stream.
+      final probe = _prefix.expand((part) => part).take(564).toList();
+      ready = false;
+      for (var i = 0; i < 188 && i + 376 < probe.length; i++) {
+        if (probe[i] == 0x47 &&
+            probe[i + 188] == 0x47 &&
+            probe[i + 376] == 0x47) {
+          ready = true;
+          break;
+        }
+      }
+      if (!ready) abandon();
+    } catch (_) {
+      abandon();
+    }
+  }
+
+  void claim() {
+    _expiry?.cancel();
+  }
+
+  Stream<List<int>> consume() {
+    consumed = true;
+    return _drain();
+  }
+
+  Stream<List<int>> _drain() async* {
+    try {
+      for (final part in _prefix) {
+        yield part;
+      }
+      _prefix.clear();
+      final frames = _source!;
+      while (!_closed && await frames.moveNext()) {
+        yield frames.current;
+      }
+    } finally {
+      close();
+    }
+  }
+
+  void close() {
+    if (_closed) return;
+    _closed = true;
+    ready = false;
+    _expiry?.cancel();
+    _client.close(force: true);
+    unawaited(_source?.cancel());
+    // consume() may be suspended in the prefix loop. It owns that list until
+    // cancellation completes; dropping the owning session releases the prefix.
+  }
+}
+
+int feedConnectionBudget(Uri uri,
+    {required bool isXtream,
+    String? sourceUser,
+    String? host,
+    String? accountUser,
+    DateTime? checkedAt,
+    String? status,
+    int? activeConnections,
+    int? maxConnections,
+    required DateTime now}) {
+  final credentialPath = uri.pathSegments;
+  final accountLike = isXtream ||
+      uri.userInfo.isNotEmpty ||
+      uri.queryParameters.containsKey('username') ||
+      uri.queryParameters.containsKey('password') ||
+      (credentialPath.length >= 3 &&
+          const {'live', 'movie', 'series'}.contains(credentialPath.first)) ||
+      (credentialPath.length == 3 &&
+          RegExp(r'^\d+(?:\.\w+)?$').hasMatch(credentialPath.last)) ||
+      host == uri.host;
+  if (!accountLike) return 2;
+  final checked = checkedAt;
+  final user = accountUser;
+  if (checked == null ||
+      now.difference(checked) > const Duration(seconds: 30) ||
+      status?.toLowerCase() != 'active' ||
+      host != uri.host ||
+      user == null ||
+      user.isEmpty ||
+      !(uri.pathSegments.contains(user) ||
+          uri.queryParameters['username'] == user) ||
+      (isXtream && sourceUser != user)) return 0;
+  final occupied = activeConnections;
+  if (occupied == null) return 0;
+  return ((maxConnections ?? 0) - (occupied < 1 ? 1 : occupied)).clamp(0, 2);
+}
