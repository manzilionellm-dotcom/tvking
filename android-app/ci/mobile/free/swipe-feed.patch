+import 'dart:async';
+import 'dart:io';
+import 'dart:typed_data';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/player/data/feed_lookahead.dart';
+
+void main() {
+  test('source, freshness and remaining connections bound the window', () {
+    final now = DateTime.utc(2026, 11, 25);
+    final link = Uri.parse('https://demo.test/live/user/pass/1.ts');
+    int budget(int max, int active, {String user = 'user', int age = 0}) =>
+        feedConnectionBudget(link,
+            isXtream: true,
+            sourceUser: 'user',
+            host: 'demo.test',
+            accountUser: user,
+            checkedAt: now.subtract(Duration(seconds: age)),
+            status: 'Active',
+            activeConnections: active,
+            maxConnections: max,
+            now: now);
+    expect(budget(1, 0), 0);
+    expect(budget(2, 0), 1);
+    expect(budget(4, 1), 2);
+    expect(budget(2, 2), 0);
+    expect(budget(4, 1, user: 'other'), 0);
+    expect(budget(4, 1, age: 60), 0);
+    expect(feedConnectionBudget(link, isXtream: false, now: now), 0);
+    expect(
+        feedConnectionBudget(Uri.parse('https://cdn.test/sample.ts'),
+            isXtream: false, now: now),
+        2);
+  });
+
+  test('two slots, promotion replays the exact bytes without a second GET',
+      () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    final hits = <String>[];
+    final data = Uint8List(188 * 2200);
+    for (var i = 0; i < data.length; i += 188) {
+      data[i] = 0x47;
+      data[i + 1] = (i ~/ 188) % 256;
+    }
+    server.listen((req) async {
+      hits.add(req.uri.path);
+      req.response.headers.contentType = ContentType('video', 'mp2t');
+      req.response.add(data);
+      try {
+        await req.response.close();
+      } catch (_) {}
+    });
+    final pool = FeedLookahead();
+    addTearDown(() async {
+      pool.clear();
+      await server.close(force: true);
+    });
+    final urls =
+        List.generate(3, (i) => 'http://127.0.0.1:${server.port}/$i.ts');
+    pool.update(urls, '7 MOTION QA');
+    for (var i = 0; i < 200 && !pool.ready(urls.first); i++) {
+      await Future<void>.delayed(const Duration(milliseconds: 10));
+    }
+    expect(pool.ready(urls.first), isTrue);
+    final prepared = pool.take(urls.first)!;
+    final bytes = await prepared.consume().expand((b) => b).toList();
+    expect(bytes, orderedEquals(data));
+    expect(hits.where((p) => p == '/0.ts').length, 1);
+    expect(hits, isNot(contains('/2.ts')));
+    expect(pool.take(urls.first), isNull);
+  });
+}
