diff --git a/test/core/update/phone_update_channel_test.dart b/test/core/update/phone_update_channel_test.dart
new file mode 100644
--- /dev/null
+++ b/test/core/update/phone_update_channel_test.dart
@@ -0,0 +1,68 @@
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/core/app/app_platform.dart';
+import 'package:tv_king/core/update/update_service.dart';
+import 'package:tv_king/features/about/data/update_checker.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  const String expectedTag = String.fromEnvironment(
+    'PHONE_UPDATE_TAG',
+    defaultValue: 'phone-latest',
+  );
+
+  setUp(() {
+    AppPlatform.isTv = false;
+    AppPlatform.isWindows = false;
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    PackageInfo.setMockInitialValues(
+      appName: '7 MOTION',
+      packageName: 'com.manzilionellm.tvking.tv_king',
+      version: '0.3.8',
+      buildNumber: '1',
+      buildSignature: '',
+    );
+  });
+
+  test('le manifeste utilise le canal réellement configuré au build', () {
+    expect(
+      UpdateService.manifestUrl,
+      'https://github.com/manzilionellm-dotcom/tvking/releases/download/'
+      '$expectedTag/version.json',
+    );
+  });
+
+  test('le contrôle manuel vise la même release et le même APK', () async {
+    final List<Uri> requests = <Uri>[];
+    final String apkUrl =
+        'https://github.com/manzilionellm-dotcom/tvking/releases/download/'
+        '$expectedTag/7motion.apk';
+    final info = await http.runWithClient(
+      () => UpdateChecker.instance.check(),
+      () => MockClient((request) async {
+        requests.add(request.url);
+        return http.Response(jsonEncode(<String, Object>{
+          'assets': <Object>[
+            <String, Object>{
+              'name': '7motion.apk',
+              'browser_download_url': apkUrl,
+              'updated_at': '2026-10-29T00:00:00Z',
+            },
+          ],
+        }), 200);
+      }),
+    );
+    expect(requests, <Uri>[
+      Uri.parse('https://api.github.com/repos/manzilionellm-dotcom/'
+          'tvking/releases/tags/$expectedTag'),
+    ]);
+    expect(info, isNotNull);
+    expect(info!.releaseUrl, apkUrl);
+    expect(info.hasUpdate, isFalse, reason: 'Le premier contrôle reste silencieux.');
+  });
+}
