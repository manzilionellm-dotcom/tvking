import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:media_kit/media_kit.dart';
import 'package:novatube_video/novatube_video.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();
  const channel = MethodChannel('novatube_video/4');
  final messenger =
      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
  late List<MethodCall> commands;
  late PhoneVideoPlayer player;
  Media media(String name) => Media('https://example.invalid/$name');
  Future<void> event(String method, dynamic data) async {
    await messenger.handlePlatformMessage(
      channel.name,
      const StandardMethodCodec().encodeMethodCall(MethodCall(method, data)),
      (_) {},
    );
  }

  setUp(() {
    commands = [];
    messenger.setMockMethodCallHandler(channel, (call) async {
      commands.add(call);
      return null;
    });
    player = PhoneVideoPlayer(vod: false, userAgent: () => 'Mobile');
  });
  tearDown(() async {
    await player.dispose();
    messenger.setMockMethodCallHandler(channel, null);
  });
  test(
    'deux zaps avant la surface ouvrent seulement la dernière chaîne',
    () async {
      player.forceHls();
      await player.open(media('a'));
      await player.open(media('b'));
      await player.attach(4);
      final opens = commands.where((c) => c.method == 'setUrl');
      expect(opens.length, 1);
      expect(opens.single.arguments['url'], endsWith('/b'));
      expect(opens.single.arguments['mime'], isNull);
      expect(opens.single.arguments['headers']['User-Agent'], 'Mobile');
      await event('ack', 1);
      await event('firstFrame', null);
      expect(player.firstFrame, isFalse);
      await event('ack', 2);
      await event('videoSize', {'width': 1920, 'height': 1080});
      expect(player.state.width, isNull);
      await event('firstFrame', null);
      expect(player.state.width, 1920);
    },
  );
  test(
    'un flux PAL anamorphique conserve son 16:9 et sa résolution mesurée',
    () async {
      await player.attach(4);
      await player.open(media('pal'));
      await event('ack', 1);
      await event('phoneVideoGeometry', {
        'width': 720,
        'height': 576,
        'pixelRatio': 64 / 45,
      });
      await event('videoSize', {'width': 720, 'height': 576});
      await event('firstFrame', null);
      expect(player.displayAspect.value, closeTo(16 / 9, 0.0001));
      expect(player.state.width, 720);
      expect(player.state.height, 576);

      await event('phoneVideoGeometry', {
        'width': 720,
        'height': 576,
        'pixelRatio': 16 / 15,
      });
      expect(player.displayAspect.value, closeTo(4 / 3, 0.0001));
      await player.open(media('hd'));
      expect(player.displayAspect.value, isNull);
      await event('phoneVideoGeometry', {
        'width': 720,
        'height': 576,
        'pixelRatio': 64 / 45,
      });
      expect(player.displayAspect.value, isNull);
      await event('ack', 2);
      await event('phoneVideoGeometry', {
        'width': 1920,
        'height': 1080,
        'pixelRatio': 1.0,
      });
      expect(player.displayAspect.value, closeTo(16 / 9, 0.0001));
    },
  );

  testWidgets(
      'la vue Android occupe le cadre natif de MAX après rotation et zoom',
      (tester) async {
    // La composition hybride crée un canal par vue. Une réponse vide simule
    // la création, sans substituer un widget au PlatformViewLink du produit.
    final viewChannels = <MethodChannel>[];
    tester.view.devicePixelRatio = 1;
    addTearDown(tester.view.resetDevicePixelRatio);
    addTearDown(tester.view.resetPhysicalSize);
    messenger.setMockMethodCallHandler(SystemChannels.platform_views,
        (call) async {
      if (call.method == 'create') {
        final local = MethodChannel('novatube_video/${call.arguments['id']}');
        viewChannels.add(local);
        messenger.setMockMethodCallHandler(local, (_) async => null);
      }
      return null;
    });
    addTearDown(() {
      for (final local in viewChannels) {
        messenger.setMockMethodCallHandler(local, null);
      }
      messenger.setMockMethodCallHandler(SystemChannels.platform_views, null);
    });

    const referenceKey = ValueKey<String>('novatube-reference');
    Future<void> show(Size viewport, BoxFit fit) async {
      tester.view.physicalSize = viewport;
      await tester.pumpWidget(Directionality(
        textDirection: TextDirection.ltr,
        child: Stack(fit: StackFit.expand, children: [
          const Center(
              child: AspectRatio(
                  key: referenceKey,
                  aspectRatio: 16 / 9,
                  child: SizedBox.expand())),
          PhoneVideoSurface(
              player: player,
              fit: fit,
              aspect: 16 / 9,
              subtitleStyle: const TextStyle(),
              subtitlePadding: EdgeInsets.zero),
        ]),
      ));
      await tester.pump();
    }

    final view = find.byType(PlatformViewLink);
    // Même layout que le Center/AspectRatio de MAX, sans réduction à la peinture.
    await show(const Size(360, 800), BoxFit.contain);
    expect(tester.getSize(view), tester.getSize(find.byKey(referenceKey)));
    expect(tester.getSize(view), const Size(360, 202.5));
    await show(const Size(800, 360), BoxFit.contain);
    expect(tester.getRect(view), tester.getRect(find.byKey(referenceKey)));
    expect(tester.getSize(view), const Size(640, 360));

    // « Remplir » recadre les bords dans le cadre sans étirer les pixels.
    await show(const Size(800, 360), BoxFit.cover);
    expect(tester.getSize(view), const Size(800, 450));
    expect(tester.getTopLeft(view), const Offset(0, -45));
    await show(const Size(800, 360), BoxFit.fill);
    expect(tester.getSize(view), const Size(800, 360));
    expect(viewChannels.length, 1); // même vue, sans réouvrir le flux
    await tester.pumpWidget(const SizedBox.shrink());
  });

  test('l’arrêt avant attachement annule le flux et ses callbacks', () async {
    await player.open(media('a'));
    await player.stop();
    await player.attach(4);
    expect(commands.any((c) => c.method == 'setUrl'), isFalse);
    await event('ack', 1);
    await event('playing', true);
    expect(player.state.playing, isFalse);
  });
  test(
    'reprise native, pistes et pause gardent les commandes du téléphone',
    () async {
      await player.attach(4);
      player.forceHls();
      await player.open(media('hls'), play: false);
      await event('ack', 1);
      expect(commands.last.method, 'pause');
      expect(
        commands.firstWhere((c) => c.method == 'setUrl').arguments['mime'],
        'application/x-mpegURL',
      );
      await event('reconnecting', true);
      expect(player.recovering, isTrue);
      await event('firstFrame', null);
      expect(player.recovering, isFalse);
      await event('tracks', [
        {
          'type': 'audio',
          'group': 0,
          'index': 1,
          'language': 'fr',
          'selected': true,
        },
      ]);
      expect(player.audioWithoutVideo, isTrue);
      await player.setAudioTrack(player.state.track.audio);
      expect(commands.last.arguments, {'group': 0, 'index': 1});
      await player.setSubtitleTrack(SubtitleTrack.no());
      expect(commands.last.arguments, {'type': 'text', 'disable': true});
    },
  );
}
