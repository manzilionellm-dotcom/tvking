diff --git a/test/features/player/video_quality_selection_test.dart b/test/features/player/video_quality_selection_test.dart
new file mode 100644
--- /dev/null
+++ b/test/features/player/video_quality_selection_test.dart
@@ -0,0 +1,55 @@
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:tv_king/features/player/domain/video_quality_selection.dart';
+
+void main() {
+  test('la HD attend la confirmation du lecteur et Auto reste disponible', () async {
+    final ready = Completer<void>();
+    final calls = <String?>[];
+    final selection = VideoQualitySelection(apply: (id) {
+      calls.add(id);
+      return calls.length == 1 ? ready.future : Future<void>.value();
+    });
+    final pending = selection.select('1080');
+    expect(selection.busy, isTrue);
+    expect(selection.selectedId, isNull);
+    expect(await selection.select('2160'), isFalse);
+    expect(calls, <String?>['1080']);
+    ready.complete();
+    expect(await pending, isTrue);
+    expect(selection.selectedId, '1080');
+    expect(selection.busy, isFalse);
+    expect(await selection.select(null), isTrue);
+    expect(selection.selectedId, isNull);
+    expect(calls, <String?>['1080', null]);
+  });
+
+  test('un refus du décodeur conserve la dernière qualité confirmée', () async {
+    int calls = 0;
+    final selection = VideoQualitySelection(initialId: '720', apply: (id) async {
+      if (++calls == 1) throw StateError('piste indisponible');
+    });
+    expect(await selection.select('2160'), isFalse);
+    expect(selection.selectedId, '720');
+    expect(selection.busy, isFalse);
+    expect(await selection.select('1080'), isTrue);
+    expect(selection.selectedId, '1080');
+  });
+
+  test('quitter pendant la sélection invalide la confirmation tardive', () async {
+    final ready = Completer<void>();
+    int calls = 0;
+    final selection = VideoQualitySelection(initialId: '720', apply: (id) {
+      calls++;
+      return ready.future;
+    });
+    final pending = selection.select('1080');
+    selection.dispose();
+    ready.complete();
+    expect(await pending, isFalse);
+    expect(selection.selectedId, '720');
+    expect(await selection.select(null), isFalse);
+    expect(calls, 1);
+  });
+}
