new file mode 100644
--- /dev/null
+++ b/lib/features/player/domain/video_quality_selection.dart
@@ -0,0 +1,32 @@
+/// Une qualité n'est confirmée qu'après l'acceptation du lecteur.
+/// Le verrou évite deux commandes concurrentes et la fermeture de la feuille
+/// invalide une réponse tardive, sans interrompre le flux en cours.
+class VideoQualitySelection {
+  VideoQualitySelection({
+    required Future<void> Function(String? id) apply,
+    String? initialId,
+  }) : _apply = apply, selectedId = initialId;
+
+  final Future<void> Function(String? id) _apply;
+  String? selectedId;
+  bool busy = false;
+  bool _disposed = false;
+
+  Future<bool> select(String? id) async {
+    if (busy || _disposed) return false;
+    busy = true;
+    try {
+      await _apply(id);
+      if (_disposed) return false;
+      selectedId = id;
+      return true;
+    } catch (_) {
+      // L'ancienne sélection reste affichée : l'échec n'est pas une HD reçue.
+      return false;
+    } finally {
+      busy = false;
+    }
+  }
+
+  void dispose() => _disposed = true;
+}
