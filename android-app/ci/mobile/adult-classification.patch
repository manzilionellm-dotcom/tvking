new file mode 100644
index 0000000..59839b2
--- /dev/null
+++ b/test/features/security/age_confirmation_test.dart
@@ -0,0 +1,17 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:tv_king/features/security/data/age_gate_settings.dart';
+
+void main() {
+  test('confirmation conservée après relecture et isolée par profil', () async {
+    SharedPreferences.setMockInitialValues({});
+    final settings = AgeGateSettings.instance;
+    expect(await settings.isConfirmed(profileId: 'one'), isFalse);
+    await settings.markConfirmed(profileId: 'one');
+    expect(await settings.isConfirmed(profileId: 'one'), isTrue);
+    expect(await settings.isConfirmed(profileId: 'two'), isFalse);
+    expect(await settings.isConfirmed(), isFalse);
+    await settings.clear(profileId: 'one');
+    expect(await settings.isConfirmed(profileId: 'one'), isFalse);
+  });
+}
