@@ -0,0 +1,58 @@
+package com.manzilionellm.native_video_player
+
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.os.Debug
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+import java.io.File
+
+/** Private QA request polled on a thread independent of Flutter, Media3 and the main looper. */
+internal object FreezeThreadDump {
+    private var started = false
+
+    @Synchronized
+    fun start(context: Context) {
+        if (started || context.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE == 0) return
+        started = true
+        val dir = context.applicationContext.filesDir
+        Thread({
+            val request = File(dir, "freeze-diag.request")
+            while (true) {
+                try {
+                    if (request.exists()) consume(dir, request)
+                } catch (e: Exception) {
+                    Log.w("NovaTubeFreeze", "kind=thread_probe_failed type="+e.javaClass.simpleName)
+                }
+                try { Thread.sleep(250) } catch (_: InterruptedException) { return@Thread }
+            }
+        }, "NovaTubeFreezeProbe").apply { isDaemon = true }.start()
+    }
+
+    private fun consume(dir: File, request: File) {
+        val id = request.readText().trim()
+        if (!id.matches(Regex("[0-9]{1,20}"))) { request.delete(); return }
+        val pending = File(dir, "freeze-diag-$id.tmp")
+        val complete = File(dir, "freeze-diag-$id.txt")
+        if (complete.exists()) { request.delete(); return }
+        pending.bufferedWriter().use { out ->
+            out.appendLine("pid=${Process.myPid()} mono_ms=${SystemClock.elapsedRealtime()} utc_ms=${System.currentTimeMillis()} request=$id")
+            val runtime = Runtime.getRuntime()
+            out.appendLine("native_heap_alloc=${Debug.getNativeHeapAllocatedSize()} java_heap_total=${runtime.totalMemory()} java_heap_free=${runtime.freeMemory()}")
+            for ((thread, stack) in Thread.getAllStackTraces().entries.sortedBy { it.key.id }) {
+                out.appendLine("thread id=${thread.id} name=${thread.name} state=${thread.state}")
+                for (frame in stack) out.appendLine("    at $frame")
+            }
+            val tasks = File("/proc/self/task").listFiles().orEmpty()
+            for (task in tasks) {
+                val name = runCatching { File(task, "comm").readText().trim() }.getOrDefault("?")
+                val wait = runCatching { File(task, "wchan").readText().trim() }.getOrDefault("?")
+                out.appendLine("linux tid=${task.name} name=$name wait=$wait")
+            }
+        }
+        check(pending.renameTo(complete))
+        if (request.readText().trim() == id) request.delete()
+        Log.i("NovaTubeFreeze", "kind=thread_dump_ready request=$id")
+    }
+}
