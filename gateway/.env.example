# =========================================================
#  .env.example — copie en .env et remplis
# =========================================================

# --- Réseau de la passerelle ---
HOST=0.0.0.0
PORT=8088
# URL publique vue par les apps (sert à réécrire les playlists). Sans slash final.
PUBLIC_BASE=https://tv.mondomaine.com

# --- Ligne fournisseur (principale + secours) ---
UPSTREAM_BASE=http://mon-fournisseur.com:8080
# Lignes de SECOURS (failover), séparées par des virgules. Si la principale
# meurt (réseau/5xx/refus), la passerelle bascule dessus SANS couper les
# spectateurs. Vide = une seule ligne (comportement historique).
UPSTREAM_BASE_FALLBACKS=
UPSTREAM_USER=ma_ligne_user
UPSTREAM_PASS=ma_ligne_pass
# Connexions simultanées AUTORISÉES par le fournisseur sur cette ligne.
# La passerelle ne dépassera JAMAIS ce nombre (anti-ban).
PROVIDER_MAX_CONNECTIONS=5

# User-Agent d'un vrai lecteur (souvent exigé par les fournisseurs).
UPSTREAM_USER_AGENT=VLC/3.0.18 LibVLC/3.0.18
# Accepter les certificats TLS invalides côté fournisseur (fréquent en IPTV).
ALLOW_INSECURE_TLS=true
UPSTREAM_MAX_REDIRECTS=5

# --- Streaming / mutualisation ---
STREAM_IDLE_GRACE_MS=8000
CLIENT_BUFFER_MAX_BYTES=8388608
# Plafond mémoire GLOBAL des files clients (anti-OOM du conteneur). 0 = off.
GLOBAL_CLIENT_BUFFER_MAX_BYTES=134217728
BACKPRESSURE_SWEEP_MS=2000
UPSTREAM_RETRIES=6
UPSTREAM_RETRY_BASE_MS=500

# --- Robustesse connexions (anti-slots fantômes) ---
# Keepalive TCP : détecte les box disparues sans FIN/RST → libère leur slot.
SOCKET_KEEPALIVE_MS=30000
# Borne la PHASE REQUÊTE entrante uniquement (anti slow-loris). 0 = illimité.
# N'affecte PAS la durée du flux de réponse (live/VOD restent illimités).
HEADERS_TIMEOUT_MS=60000
REQUEST_TIMEOUT_MS=60000

# --- Sécurité / admin ---
# Jeton pour /metrics et /admin/* (Authorization: Bearer … ou ?token=…).
# Laisse vide pour désactiver ces endpoints.
ADMIN_TOKEN=change-moi-un-long-secret
USERS_FILE=/data/users.json

# --- Logs ---
LOG_LEVEL=info
