# ============================================================================
# Gateway 7 MOTION — fichier d'exemple de configuration.
#
# Copiez ce fichier en « .env » et remplissez les valeurs. Ne committez JAMAIS
# le .env réel (il contient des secrets). Seul .env.example est versionné.
#
#   cp .env.example .env && nano .env
# ============================================================================

# ---- Amont (la ligne fournisseur réelle — NE JAMAIS exposer) ----------------
# Base du serveur fournisseur (schéma + hôte + port, sans slash final).
UPSTREAM_BASE=http://ligne.fournisseur.tld:8080
# Identifiants de la ligne fournisseur.
UPSTREAM_USER=votre_user_fournisseur
UPSTREAM_PASS=votre_pass_fournisseur

# CONTRAINTE DURE : nombre de connexions simultanées autorisées par la ligne.
# C'est le nombre MAXIMUM de chaînes DISTINCTES tirables en même temps.
# Souvent 1. Le gateway ne le dépassera JAMAIS (au-delà → refus 503 propre).
# Pour du multi-chaînes massif, prenez une ligne à plus de connexions.
PROVIDER_MAX_CONNECTIONS=1

# ---- Diffusion (l'identité que les apps / le panel utilisent) ---------------
# C'est cette identité (pas celle du fournisseur) que voient les spectateurs.
BROADCAST_USER=diffusion
BROADCAST_PASS=changez_moi_svp
# Nombre max de spectateurs (sockets) simultanés, toutes chaînes confondues.
# Objectif de l'installation : 500+.
BROADCAST_MAX_STREAMS=500

# ---- Façade publique (domaine réel + HTTPS via Caddy) -----------------------
# URL publique HTTPS du gateway. C'est ce que vous mettrez comme « façade »
# dans le panel. Doit pointer (DNS A record) vers l'IP du VPS.
PUBLIC_BASE=https://gateway.votre-domaine.tld
# Domaine géré par Caddy pour obtenir le certificat Let's Encrypt automatiquement.
# (Repris par le Caddyfile via docker-compose.)
CADDY_DOMAIN=gateway.votre-domaine.tld
# E-mail pour Let's Encrypt (avis d'expiration de certificat).
CADDY_EMAIL=admin@votre-domaine.tld

# ---- Mémoire / backpressure (500 sockets) -----------------------------------
# Tampon max par client avant de le considérer « lent » et de le couper (octets).
# 8 Mo/client : absorbe un hoquet réseau sans exploser la RAM.
CLIENT_BUFFER_MAX_BYTES=8388608
# Plafond GLOBAL de mémoire tampon cumulée sur TOUS les clients (octets).
# À 500 clients : 512 Mo ≈ 1 Mo/client. Montez à 1 Go (1073741824) si le VPS a
# ≥ 4 Go de RAM et des débits élevés ; descendez à 256 Mo sur un petit VPS.
GLOBAL_CLIENT_BUFFER_MAX_BYTES=536870912
# Fréquence du balayage de backpressure (ms) : coupe des clients lents.
SWEEP_INTERVAL_MS=1000

# ---- Réseau / robustesse ----------------------------------------------------
# Port d'écoute HTTP interne (Caddy termine le TLS et proxifie ici).
PORT=8088
HOST=0.0.0.0
# Délai d'inactivité amont avant de considérer la source morte (ms).
UPSTREAM_TIMEOUT_MS=30000
# keep-alive TCP (ms).
KEEPALIVE_MS=15000
# Reconnexions amont : nombre d'essais + délai de base (backoff exponentiel).
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RETRY_BASE_MS=500

# ---- Journalisation ---------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
