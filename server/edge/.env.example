# =========================================================
#  Edge proxy — configuration de déploiement
# =========================================================
#  Copier en `.env` puis remplir. Tout est optionnel SAUF un compte
#  maître (EDGE_ACCOUNTS) et le jeton d'administration : sans le jeton,
#  le tableau de bord et donc l'onglet « Cinéma / VOD » n'existent pas.
#
#  Les valeurs par défaut de tous les autres réglages sont documentées
#  dans README.md (« Démarrer »).
# =========================================================

# --- OBLIGATOIRE : la ou les lignes d'abonnement en amont ------------
#  JSON sur UNE ligne. `maxConnections: 1` est le cœur du système :
#  une seule socket vers le fournisseur, quel que soit le nombre de
#  clients. `device` fait mentir toutes les requêtes avec la même
#  signature (edge, vlc, kodi, tivimate, exoplayer).
EDGE_ACCOUNTS=[{"id":"master","label":"Ligne principale","playlistUrl":"https://fournisseur.example/get.php?username=XXX&password=YYY&type=m3u_plus","maxConnections":1,"device":"vlc"}]

# --- OBLIGATOIRE : accès au tableau de bord --------------------------
#  Jeton long et aléatoire, p. ex. `openssl rand -hex 32`.
#  VIDE = plan d'administration DÉSACTIVÉ (pas de dashboard, pas de VOD
#  pilotable). Cette API peut repointer le proxy : ne la laisse jamais
#  ouverte.
EDGE_ADMIN_TOKEN=

# --- Cinéma / VOD ----------------------------------------------------
#  EDGE_DB commande TOUT le plan abonnés : sans base, ni portails MAC /
#  Xtream ni médiathèque. Les chemins ci-dessous sont ceux du volume
#  Docker — ne les change pas sans changer le montage.
EDGE_DB=/data/edge.db
EDGE_VOD_DIR=/data/vod
EDGE_VOD=1
# Refuse un fichier plus gros que N octets (0 = pas de limite).
# Exemple : 21474836480 = 20 Gio.
EDGE_VOD_MAX_FILE_BYTES=0

# --- Portails abonnés (MAG / Stalker + Xtream Codes) -----------------
EDGE_PORTAL=1
# URL publique par laquelle les box joignent ce serveur — sert à
# fabriquer les liens de flux rendus aux clients. Mets l'URL du reverse
# proxy, pas l'adresse interne du conteneur.
EDGE_PUBLIC_BASE=

# --- Réseau ----------------------------------------------------------
#  0.0.0.0 dans un conteneur : c'est le mapping de ports de compose qui
#  décide de l'exposition réelle (127.0.0.1 par défaut).
EDGE_HOST=0.0.0.0
EDGE_PORT=8787

# --- Garde-fou SSRF (recommandé) -------------------------------------
#  Liste blanche des hôtes d'origine autorisés, séparés par des
#  virgules. Vide = aucune restriction.
EDGE_ALLOWED_HOSTS=

# --- Débit et capacité ------------------------------------------------
# EDGE_EGRESS_BPS=3145728
# EDGE_MAX_CLIENTS=200
# EDGE_RING_BYTES=16777216
