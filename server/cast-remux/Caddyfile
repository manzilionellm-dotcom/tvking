# Caddy : TLS automatique (Let's Encrypt) + reverse proxy vers le service.
# Le domaine et l'email viennent de l'environnement (docker-compose .env).

{
	email {$CAST_EMAIL}
}

{$CAST_DOMAIN} {
	encode zstd gzip

	# Receiver Cast custom (mpegts.js) servi en STATIQUE et en HTTPS.
	# C'est cette page que le Chromecast charge ; la VIDEO, elle, ne passe
	# PAS par ici (le Chromecast tire le flux direct chez le fournisseur).
	# URL a enregistrer dans la Cast Developer Console :
	#   https://cast.7themotion.com/receiver/
	handle_path /receiver/* {
		root * /srv/receiver
		file_server
	}

	# Reste : ancien service de remux (legacy, repli). Inutile pour le
	# chemin on-device, mais conserve si on veut le receiver par defaut.
	handle {
		reverse_proxy remux:8080
	}
}
