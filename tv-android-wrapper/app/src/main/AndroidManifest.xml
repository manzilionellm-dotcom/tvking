<?xml version="1.0" encoding="utf-8"?>
<!--
=========================================================
 AndroidManifest.xml — APK wrapper Android TV (7 MOTION TV)
=========================================================
 Points cles :
   1. uses-feature LEANBACK = false   -> l'APK reste installable
      sur un telephone si l'utilisateur veut tester (pas bloquant).
   2. uses-feature TOUCHSCREEN = false -> declare qu'on N'A PAS
      besoin du tactile, donc on apparait dans le store des Android
      TV (sinon les Android TV sans tactile rejettent).
   3. Activity LEANBACK_LAUNCHER + LAUNCHER -> visible a la fois
      sur l'ecran d'accueil Android TV (banner Leanback) ET sur
      le drawer d'un telephone si jamais sideloade.
   4. usesCleartextTraffic = true -> les flux IPTV sont en HTTP
      (pas HTTPS chez la quasi-totalite des fournisseurs). Sans
      ca, Android 9+ refuse les connexions http://.
   5. networkSecurityConfig -> autorise http:// explicitement
      pour les hostnames IPTV (defense en profondeur).
=========================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions reseau (les flux IPTV passent par HTTP). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Fonctionnalites materielles : tactile NON requis (= TV OK),
         Leanback (= forme TV) optionnel (= telephone OK). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.TvKing"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER = visible dans le drawer telephone -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LEANBACK_LAUNCHER = visible sur Android TV home -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
